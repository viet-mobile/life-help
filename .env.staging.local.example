# LIFE.HELP integrated STAGING environment - variable NAMES ONLY. Never commit real values.
# Copy to .env.staging.local (git-ignored, same directory) and fill in values from the STAGING project only.
# Staging project ref: wreebowcbiymodswajwe. Any value that contains the PRODUCTION project reference is refused by
# scripts/staging/contract.mjs before anything runs. Check readiness without printing values:
#   node scripts/staging/preflight.mjs
# Then the single validation command is:  npm run staging:integrated

# --- service core harness (scripts/staging/service-core-staging.mjs) ---
SERVICE_CORE_SUPABASE_URL=
SERVICE_CORE_SUPABASE_SECRET_KEY=
EXPECTED_SERVICE_CORE_SUPABASE_REF=
SERVICE_CORE_STAGING_CONFIRM=
SERVICE_CORE_STAGING_ANON_KEY=

# --- learning staging suites + fixtures (tests/staging/helpers.ts) ---
TEST_SUPABASE_URL=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_SUPABASE_ANON_KEY=

# --- staging browser journey: admin sign-in on the staging Worker (equal to the Worker's admin secrets) ---
TEST_LIFE_HELP_SYS_ADMIN_ID=
TEST_LIFE_HELP_SYS_ADMIN_PASSWORD=

# NOT in this file - Worker-side staging secrets, set by the operator with
#   npx wrangler secret put <NAME> --config wrangler.staging.jsonc
# (names and classification: WORKER_BINDINGS in scripts/staging/contract.mjs)
