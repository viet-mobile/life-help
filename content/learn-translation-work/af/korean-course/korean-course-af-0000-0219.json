  },
  "126": {
    "sourceHash": "73bcc9cfd45200fc908e4543ffb536f9f624aa761a856a5e148815a9f8cda448",
    "translation": "Koreaanse kursusstap 10 · Kultuur, media en idiome",
    "role": "localized_instruction_or_meaning"
  },
  "127": {
    "sourceHash": "1f98a3a8b39c86545ba952eb0e0a3d8fcd6cc71dbbdf64aa942302601f647c99",
    "translation": "Kultuurwoud",
    "role": "localized_instruction_or_meaning"
  },
  "128": {
    "sourceHash": "37d799e3cd473d32164541c6b17d7a0a76be7c2b2bb59c2bb7816b5aaaca7462",
    "translation": "Verken die Koreaanse samelewing deur nuus, idiome en spreekwoorde",
    "role": "localized_instruction_or_meaning"
  },
  "129": {
    "sourceHash": "991a8a71bc8a36c8a371f537f835b4c11c8203cb9379070d6d64c7ad5292086a",
    "translation": "Vokale, medeklinkers en eerste woorde",
    "role": "localized_instruction_or_meaning"
  },
  "130": {
    "sourceHash": "7343355665fda5f74a3e4a2f70b57cb756899f3e71db5fb427b1021926673afe",
    "translation": "Groete en basiese uitdrukkings",
    "role": "localized_instruction_or_meaning"
  },
  "131": {
    "sourceHash": "2dbb01930547e0e5e427863a6f05cdb70ecf05fa56c28bbcfd3cb11394608bb4",
    "translation": "Ek, my gesin en getalle",
    "role": "localized_instruction_or_meaning"
  },
  "132": {
    "sourceHash": "4cc5287ef678be2fe01d6723a854fb9483c809a1d3c3ae098778774f358616df",
    "translation": "Handelinge, plekke en dinge",
    "role": "localized_instruction_or_meaning"
  },
  "133": {
    "sourceHash": "ceaee34dd630436bb21be29addb92c1872bc9369e670195f0e195f4d61d1aa6e",
    "translation": "Gister, vandag en môre",
    "role": "localized_instruction_or_meaning"
  },
  "134": {
    "sourceHash": "3a1785138cfb5fa8da2cbe6774b2103ae052fcbdf6933b5f19b76b06d771efd9",
    "translation": "Inkopies, rigtings en wense",
    "role": "localized_instruction_or_meaning"
  },
  "135": {
    "sourceHash": "2d17e5902452a4eace064a84b70c6704adf19402933ba0865cbb9dd759d796a0",
    "translation": "Indirekte spraak en komplekse verbindings",
    "role": "localized_instruction_or_meaning"
  },
  "136": {
    "sourceHash": "5af6dad8dafc83d3f3ec4a4aa49c76727afdfc3a8d217cbec7e5835160e8d1a2",
    "translation": "Akkurate eerbiedsvorme en werkwoordsvorme",
    "role": "localized_instruction_or_meaning"
  },
  "137": {
    "sourceHash": "edc421843a26f4d50a3a2f42628c8ca9ed067d4dd63245f077a64258156ca35f",
    "translation": "Koreaans vir werk en sake",
    "role": "localized_instruction_or_meaning"
  },
  "138": {
    "sourceHash": "e08eae5f59b3a29f65ca2c161dd4a41729621b94101c2180598606f5accd0f1d",
    "translation": "Kultuur, media en idiome",
    "role": "localized_instruction_or_meaning"
  },
  "139": {
    "sourceHash": "190b3db5e3569e4c91d71f5d6fef58b9bd7d66a7af91a26223ce3b017a8c2da2",
    "translation": "Hangul is die Koreaanse alfabet. Elke lettergreep vorm ’n blok. ’n Vokaal alleen kry **ㅇ** vooraan, wat aan die begin stil is: 아 is net “a”.",
    "role": "localized_instruction_or_meaning"
  },
  "140": {
    "sourceHash": "e554b91ffc3a1396e0f2f56ce7ca85aa6276d5684cbf6f2bc68912d9f18a8481",
    "translation": "아 · 어 · 오 · 우 · 으 · 이 (a · eo · o · u · eu · i)",
    "role": "preserved_learning_target"
  },
  "141": {
    "sourceHash": "279a3f98f35c78e7cb88f161c339c43fd58df63a0348768233a47da2e3e16931",
    "translation": "Sit ’n medeklinker voor ’n vokaal om ’n lettergreepblok te maak: **ㄱ + ㅏ = 가** (ga). Lees die blok van links na regs.",
    "role": "localized_instruction_or_meaning"
  },
  "142": {
    "sourceHash": "07f91df828d74b540c6fb22001ca1d5d1cce87303bd3adbd7508e319bc336c2f",
    "translation": "가 · 나 · 다 · 마 · 바 · 사 · 하 (ga · na · da · ma · ba · sa · ha)",
    "role": "preserved_learning_target"
  },
  "143": {
    "sourceHash": "9f69f6d8d663964e571dae164996f5fb048593a0c9a0bd9e431ac82413ced000",
    "translation": "Verbind lettergreepblokke om woorde te maak. Lees elke blok en sê dit dan saam.",
    "role": "localized_instruction_or_meaning"
  },
  "144": {
    "sourceHash": "b65c0d677f32b2c869e66eb53ebdbf9e10d7ff93c5357876618fce94ce885581",
    "translation": "우유 (uyu) = melk / 나무 (namu) = boom",
    "role": "localized_instruction_or_meaning"
  },
  "145": {
    "sourceHash": "b31c038b06be846b4aed89a2723c51d03a0f8f8d210faafa472dd18e31f6a2fa",
    "translation": "Y-vokale",
    "role": "localized_instruction_or_meaning"
  },
  "146": {
    "sourceHash": "7347b9985f60f2d746abd012b649c3a078613ebdca3c0c85956b059940adfaf1",
    "translation": "’n Kort ekstra strepie maak ’n **y**-klank: ㅏ → ㅑ (ya), ㅓ → ㅕ (yeo), ㅗ → ㅛ (yo), ㅜ → ㅠ (yu). ㅐ (ae) en ㅔ (e) klink baie eenders in moderne Koreaans.",
    "role": "localized_instruction_or_meaning"
  },
  "147": {
    "sourceHash": "f6dfd2c4adb0ab7a0ede918b453d676ee8ace14b22f3500018f9cee4a69cd7b3",
    "translation": "야 · 여 · 요 · 유 (ya · yeo · yo · yu)",
    "role": "preserved_learning_target"
  },
  "148": {
    "sourceHash": "23141122ca94c30b878db64363a19a5a13161729a44f32584cb48f9eb80b9c5f",
    "translation": "ㄹ klink tussen “r” en “l”. ㅈ (j), ㅊ (ch, met ’n lugstoot), ㅋ (k, met ’n lugstoot), ㅌ (t, met ’n lugstoot) en ㅍ (p, met ’n lugstoot) voltooi die basiese medeklinkers.",
    "role": "localized_instruction_or_meaning"
  },
  "149": {
    "sourceHash": "51a72470bc89d924976fca4f627d1affc7f7258f2435227dee51ca837caf3c5a",
    "translation": "라 · 자 · 차 · 카 · 타 · 파 (ra · ja · cha · ka · ta · pa)",
    "role": "preserved_learning_target"
  },
  "150": {
    "sourceHash": "6f704ff5338976b79cfc86cfd5b2abdc26a9d88897506f38a33bf51038b02e93",
    "translation": "ㄲ, ㄸ, ㅃ, ㅆ en ㅉ is gespanne klanke: sê dit met ’n stywe keel en sonder ’n lugstoot, soos die eerste klank in “skate”.",
    "role": "localized_instruction_or_meaning"
  },
  "151": {
    "sourceHash": "32f1a2ae034077b67bc1c3c77c9d2244e232de16b8184470264818621a0f3a95",
    "translation": "까 · 따 · 빠 · 싸 · 짜 (kka · tta · ppa · ssa · jja)",
    "role": "preserved_learning_target"
  },
  "152": {
    "sourceHash": "b1b52284a5951bef68eb58b4228d7424f1e593c04dcf5763e599ed486d1bd612",
    "translation": "Slotmedeklinkers",
    "role": "localized_instruction_or_meaning"
  },
  "153": {
    "sourceHash": "7ce99496ada2b563555ae5ccb08819a46d357b9dd973a8b1bf873e51cf0e1a71",
    "translation": "’n Medeklinker onderaan die lettergreep heet **받침 (batchim)**. Dit sluit die lettergreep: 안 (an), 말 (mal), 밤 (bam), 강 (gang), 집 (jip), 책 (chaek). Net sewe klanke is aan die einde moontlik: ㄱ ㄴ ㄷ ㄹ ㅁ ㅂ ㅇ.",
    "role": "localized_instruction_or_meaning"
  },
  "154": {
    "sourceHash": "90820be6a47ce62bb40e3aae6a58ea9ed2ec5ed32014854fc9dfc4ed99281edb",
    "translation": "안 · 말 · 밤 · 강 · 집 (an · mal · bam · gang · jip)",
    "role": "preserved_learning_target"
  },
  "155": {
    "sourceHash": "e8fd7b48e04560c34c279cb5efef60bf8e80726ffabc5133cca85777a129a1f0",
    "translation": "Lees elke woord lettergreep vir lettergreep. 학교 word “hakgyo” gelees: sluit die finale ㄱ van 학 en spreek die volgende lettergreep gespanne uit.",
    "role": "localized_instruction_or_meaning"
  },
  "156": {
    "sourceHash": "34f126a938ce8643cca0ad8898da8569354d61ca1712f73053f208b80c361eb2",
    "translation": "사과 (sagwa) = appel / 학교 (hakgyo) = skool",
    "role": "localized_instruction_or_meaning"
  },
  "157": {
    "sourceHash": "8a6f5a4acc2b1d551967f85c68ca770d46542b0a122461e10cec510f4535cefe",
    "translation": "Mense en natuur: 사람 (persoon), 나라 (land), 하늘 (lug), 산 (berg), 강 (rivier), 꽃 (blom).",
    "role": "localized_instruction_or_meaning"
  },
  "158": {
    "sourceHash": "98d0b8e6286f71ff23bbe9ba760735c114983fd780a20e4a018efb12be981965",
    "translation": "사람 (saram) = persoon / 꽃 (kkot) = blom",
    "role": "localized_instruction_or_meaning"
  },
  "159": {
    "sourceHash": "e72a61dbbb1ae358988514efe8f53e5ab13c5f002b693a3daf604b475ce2a9c6",
    "translation": "Groet en bedank",
    "role": "localized_instruction_or_meaning"
  },
  "160": {
    "sourceHash": "02ea25e9ceb7a7630a48115cb540221385749562590712fbed3faac0e1349c4f",
    "translation": "Beleefde groete eindig op **-요** of **-니다**. 안녕하세요 werk enige tyd van die dag.",
    "role": "localized_instruction_or_meaning"
  },
  "161": {
    "sourceHash": "4ee958cc7628af0b0333aa083573458d50238451fcbe4c1712539027e08986c3",
    "translation": "안녕하세요. (annyeonghaseyo.) = Hallo. / 감사합니다. (gamsahamnida.) = Dankie.",
    "role": "localized_instruction_or_meaning"
  },
  "162": {
    "sourceHash": "5189771abddb36088a168cf86eceecb074d8940179885360d142ef00ec82307f",
    "translation": "Ja, nee en goed",
    "role": "localized_instruction_or_meaning"
  },
  "163": {
    "sourceHash": "acceebd464bcfb946eaa256f2ffbff3d44b5bb44f74038a8f406880a0db609cd",
    "translation": "Kort beleefde antwoorde vir elke dag. Koreaans voeg **요** aan die einde by om beleefd te wees.",
    "role": "localized_instruction_or_meaning"
  },
  "164": {
    "sourceHash": "d5850a25ae422d3e055087235911fd81080bdffa58adac84978aa3e40fd2ebe9",
    "translation": "네. (ne.) = Ja. / 아니요. (aniyo.) = Nee.",
    "role": "localized_instruction_or_meaning"
  },
  "165": {
    "sourceHash": "097e2b325aa24de76f7f9522b101cf0d2a05635cdaf001588b7b22fa0cd0b37b",
    "translation": "Aangename kennis",
    "role": "localized_instruction_or_meaning"
  },
  "166": {
    "sourceHash": "af7b490880d2cecef090197c9e493733f88f132929fba98f411fdc608752c610",
    "translation": "Sê 만나서 반갑습니다 wanneer jy iemand nuut ontmoet. Daar is twee afskeidsgroete: een vir die persoon wat vertrek en een vir die persoon wat bly.",
    "role": "localized_instruction_or_meaning"
  },
  "167": {
    "sourceHash": "8be3128a1275c2f3c2dabbc0214c9c70a70319ee44686ac7e5346c2fe50b1669",
    "translation": "만나서 반갑습니다. (mannaseo bangapseumnida.) = Aangename kennis.",
    "role": "localized_instruction_or_meaning"
  },
  "168": {
    "sourceHash": "46ad79ccf3c4bc187313caab5a46ca5a1209f5dc0daf8bcb1c1ebe680cff67a2",
    "translation": "Gebruik 실례합니다 om aandag te kry of verby te gaan, 고마워요 om vriendelik te bedank, 천만에요 om op dank te antwoord en 축하해요 om geluk te wens.",
    "role": "localized_instruction_or_meaning"
  },
  "169": {
    "sourceHash": "26f83a3ab466c410c290408d46419a320037a76125a02a13a664a918e1b70277",
    "translation": "실례합니다. (sillyehamnida.) = Verskoon my. / 고마워요. (gomawoyo.) = Dankie. (vriendelik)",
    "role": "localized_instruction_or_meaning"
  },
  "170": {
    "sourceHash": "40b6a59da2af482492c02ad983de4bd590b026af05d9ef6659833e2996197ca1",
    "translation": "Vra ’n naam met 이름이 뭐예요? en ’n land met 어느 나라 사람이에요? Antwoord met 제 이름은 ___예요 of 저는 ___ 사람이에요.",
    "role": "localized_instruction_or_meaning"
  },
  "171": {
    "sourceHash": "5b4c9f58717dc60ff615e7d5cfc1e17f3a60c6f6a9e15c14c04562b9d4a06192",
    "translation": "이름이 뭐예요? (ireumi mwoyeyo?) = Wat is jou naam?",
    "role": "localized_instruction_or_meaning"
  },
  "172": {
    "sourceHash": "5d02edc1c8063e299bec9cca50485376c5eb560b4ec4b5b6b5d156d507dec99e",
    "translation": "Onder vriende kan jy 잘 가요 (totsiens), 내일 봐요 (tot môre), 또 만나요 (sien jou weer) en 잘 자요 (slaap lekker) sê.",
    "role": "localized_instruction_or_meaning"
  },
  "173": {
    "sourceHash": "aec51ac992b4f2e050d1540b7c6a6b127f28b36fadf006a28421116f5a986340",
    "translation": "잘 가요. (jal gayo.) = Totsiens. (vriendelik) / 내일 봐요. (naeil bwayo.) = Tot môre.",
    "role": "localized_instruction_or_meaning"
  },
  "174": {
    "sourceHash": "e107d9c1651786db5ab999c227236277c85d2897e7029979b04cccbba58f8892",
    "translation": "Vra 잘 지냈어요? (Het dit goed gegaan?) en antwoord 잘 지내요 (Dit gaan goed). 좋은 아침이에요 beteken “Dit is ’n goeie oggend.”",
    "role": "localized_instruction_or_meaning"
  },
  "175": {
    "sourceHash": "96dcc022dc215899d438afe8119d5af74a3fccb36e4b7eba2dcfc9def4273301",
    "translation": "잘 지내요. (jal jinaeyo.) = Dit gaan goed.",
    "role": "localized_instruction_or_meaning"
  },
  "176": {
    "sourceHash": "f5aae30c80c0e5c6d2b241ec09b07b4e8e22affc50eaaf8d4fe2abb101ebb9cb",
    "translation": "Sê 도와주세요 om hulp te vra, 모르겠어요 wanneer jy nie weet nie, 알겠어요 wanneer jy verstaan en 다시 말해 주세요 om te vra dat iemand dit herhaal.",
    "role": "localized_instruction_or_meaning"
  },
  "177": {
    "sourceHash": "295dfafbd8b2240f3a133bd18023d6397e37c49bd612e950728d9d5014446fb2",
    "translation": "도와주세요. (dowajuseyo.) = Help my asseblief. / 알겠어요. (algesseoyo.) = Ek verstaan.",
    "role": "localized_instruction_or_meaning"
  },
  "178": {
    "sourceHash": "832bc6a3d4de47a61ef4f5274ccd18b342e2ec5b3d0c166eaca6438dfd08e673",
    "translation": "좋아요 beteken goed of reg, 싫어요 beteken jy hou nie daarvan nie, 맞아요 beteken “dit is reg” en 틀려요 beteken “dit is verkeerd”.",
    "role": "localized_instruction_or_meaning"
  },
  "179": {
    "sourceHash": "37382fae89dab0814c08ce56bfd3bc1bf83022e6195517f32863479aae751143",
    "translation": "좋아요. (joayo.) = Dit is goed. / 싫어요. (sireoyo.) = Ek hou nie daarvan nie.",
    "role": "localized_instruction_or_meaning"
  },
  "180": {
    "sourceHash": "79cd1f792244a8bee20c6eb884ea3821f6e29bdabe41970f90bc9c47c383eec7",
    "translation": "Tekens wat jy sal sien",
    "role": "localized_instruction_or_meaning"
  },
  "181": {
    "sourceHash": "e34b0cce15671157824e7666933f63c56ddfec53f3407f36c1e8091aa259e45d",
    "translation": "Kort tekens is oral in Korea. **입구** is die ingang, **출구** die uitgang en **화장실** die toilet. Op deure beteken **미세요** stoot en **당기세요** trek.",
    "role": "localized_instruction_or_meaning"
  },
  "182": {
    "sourceHash": "d93539af14b23e21115838dbacb6b094700295782ebe84f5e12cbe807e877d6d",
    "translation": "입구 (ipgu) = Ingang / 출구 (chulgu) = Uitgang",
    "role": "localized_instruction_or_meaning"
  },
  "183": {
    "sourceHash": "cf4e4ecb319bb3167490016503e09f4d48a4fec28bf206e884608231abf7ce72",
    "translation": "Dankie vir die kos",
    "role": "localized_instruction_or_meaning"
  },
  "184": {
    "sourceHash": "7a88d41b67a9bb7307f65464153348be69357bf3da00c09b738250467b83d6e5",
    "translation": "Sê **잘 먹겠습니다** vóór ’n maaltyd en **잘 먹었습니다** wanneer jy klaar is. ’n Gasheer verwelkom jou met **어서 오세요**, en **맛있어요** prys die kos.",
    "role": "localized_instruction_or_meaning"
  },
  "185": {
    "sourceHash": "145ff0a9843caf9fedf3132d79d07c3104ebbf70e1bc9350761f7440ed879da7",
    "translation": "잘 먹겠습니다. (jal meokgetseumnida.) = Voor ete: “Ek sal lekker eet.” / 잘 먹었습니다. (jal meogeotseumnida.) = Ná ete: “Ek het lekker geëet.”",
    "role": "localized_instruction_or_meaning"
  },
  "186": {
    "sourceHash": "982153ce34bd71dfdbfc4982783864de0da65e8497f486349335f4d9417694fd",
    "translation": "Ek is ’n leerder",
    "role": "localized_instruction_or_meaning"
  },
  "187": {
    "sourceHash": "a83a28d99bf000ab16e5f6fc86a971990412cb8e05be5e86ede89d11a2bc07b0",
    "translation": "**저는** beteken “ek” (beleefd). Sit **이에요** ná ’n medeklinker en **예요** ná ’n vokaal om “Ek is …” te sê.",
    "role": "localized_instruction_or_meaning"
  },
  "188": {
    "sourceHash": "ac280c4894e07c31dd51f7d91c82571bfae3f29de13d7ea6517ba56cc5c9b395",
    "translation": "저는 학생이에요. (jeoneun haksaengieyo.) = Ek is ’n leerder.",
    "role": "localized_instruction_or_meaning"
  },
  "189": {
    "sourceHash": "952704ccac1ac9a6f3f948f69bc10dd4e2f6c8a9ff4b62830749e03ab2ed3a96",
    "translation": "My gesin",
    "role": "localized_instruction_or_meaning"
  },
  "190": {
    "sourceHash": "645143d1b02d2f98726b25b799ff2a935495b27550c3d58a475b4c562c2bef9e",
    "translation": "Familiewoorde word dikwels in Koreaans gebruik, selfs vir mense wat nie familie is nie.",
    "role": "localized_instruction_or_meaning"
  },
  "191": {
    "sourceHash": "5f68a19c6ed7eac66e470c4fb1b4994da3be03018b0a02a2dd562f315f516b1c",
    "translation": "가족 (gajok) = gesin / 어머니 (eomeoni) = ma",
    "role": "localized_instruction_or_meaning"
  },
  "192": {
    "sourceHash": "ce3d843ea3eba387b24e5632e809ccd0f66b46b6e44c8f3d3bb00526185304d8",
    "translation": "Tel",
    "role": "localized_instruction_or_meaning"
  },
  "193": {
    "sourceHash": "3069ef74e8afa39d143fdb2111ecf5bbb535ac20579a5ce29750fb15f0828f48",
    "translation": "Koreaans het twee getalstelsels: inheems Koreaans (하나, 둘, 셋 …) om dinge te tel en Sino-Koreaans (일, 이, 삼 …) vir geld, datums en minute.",
    "role": "localized_instruction_or_meaning"
  },
  "194": {
    "sourceHash": "5121e31b70e3d56667d9f135259e3193bc224df010eefd8511eaff1563245211",
    "translation": "하나 · 둘 · 셋 (hana · dul · set)",
    "role": "preserved_learning_target"
  },
  "195": {
    "sourceHash": "f668c85ec65c6ded5f380a51222fec6892b309499213ae37edeb0e886cb289e3",
    "translation": "Gaan voort met die inheemse Koreaanse getalle: 여섯 (6), 일곱 (7), 여덟 (8), 아홉 (9), 열 (10).",
    "role": "localized_instruction_or_meaning"
  },
  "196": {
    "sourceHash": "e7321ac8df78c3bfe209e9d0c31d98dd903638d921414f3991f8d1a53042ff53",
    "translation": "여섯 · 일곱 · 여덟 · 아홉 · 열 (yeoseot · ilgop · yeodeol · ahop · yeol)",
    "role": "preserved_learning_target"
  },
  "197": {
    "sourceHash": "ff57f729bb01607f2d2a2d815b6048d23caf28316cf0e60466d3d1781004a763",
    "translation": "Sino-Koreaanse getalle: 일 (1), 이 (2), 삼 (3), 사 (4), 오 (5), 육 (6), 칠 (7), 팔 (8), 구 (9), 십 (10). Dit word vir geld, datums, telefoonnommers en minute gebruik.",
    "role": "localized_instruction_or_meaning"
  },
  "198": {
    "sourceHash": "eb46be339b762237d7b0a7d4b349f77071256d170114995eef613e9772be4fa4",
    "translation": "일 · 이 · 삼 · 사 · 오 · 육 · 칠 · 팔 · 구 · 십 (il · i · sam · sa · o · yuk · chil · pal · gu · sip)",
    "role": "preserved_learning_target"
  },
  "199": {
    "sourceHash": "aca5bc1369d4e011f1101163f4ed114054b67de7c966dbecfa4b2e8b0c4a7d0e",
    "translation": "Vra 몇 살이에요? (Hoe oud is jy?). Ouderdomme gebruik inheemse getalle plus 살: 열 살 (10 jaar oud), 스무 살 (20), 서른 살 (30).",
    "role": "localized_instruction_or_meaning"
  },
  "200": {
    "sourceHash": "f7a60b804d7f0e4fe30d1727963ff24d634d7afc83565b775b8290376bbf29a6",
    "translation": "몇 살이에요? (myeot sarieyo?) = Hoe oud is jy?",
    "role": "localized_instruction_or_meaning"
  },
  "201": {
    "sourceHash": "903dee982b3bd5b4c6f11e52ea84c003f500d40478dd5d1bd6ad00e759dca017",
    "translation": "친구 (vriend), 의사 (dokter), 사람 (persoon), 남자 (man), 여자 (vrou).",
    "role": "localized_instruction_or_meaning"
  },
  "202": {
    "sourceHash": "895d22dd4cb83d328a8938ea9f9c00359c34b1167463f03f8f30e7704e6c1274",
    "translation": "친구 (chingu) = vriend / 사람 (saram) = persoon",
    "role": "localized_instruction_or_meaning"
  },
  "203": {
    "sourceHash": "fb52ca300b49f539bee300a760d5423ba3a4296bd7d8ff3596b87c1ed33495a7",
    "translation": "Die spreker bepaal die woorde vir broers en susters: ’n vrou sê 오빠 (ouer broer) en 언니 (ouer suster). Ook 아들 (seun), 딸 (dogter), 부모님 (ouers).",
    "role": "localized_instruction_or_meaning"
  },
  "204": {
    "sourceHash": "86b64fc413af8a93b7d411579623526e87c7b92b863aca44487d2646c2857b89",
    "translation": "오빠 (oppa) = ouer broer (deur ’n vrou gesê) / 언니 (eonni) = ouer suster (deur ’n vrou gesê)",
    "role": "localized_instruction_or_meaning"
  },
  "205": {
    "sourceHash": "ed5275dd24923de6be1af62611e8c700903d35d10e7a9e363810f664629bd8a9",
    "translation": "Koreane sê dikwels 우리 (ons) in plaas van “my”: 우리 가족 beteken “my gesin”. Tel mense met 명: 네 명 (vier mense).",
    "role": "localized_instruction_or_meaning"
  },
  "206": {
    "sourceHash": "0fe0b7a7b592c25679a969f77a63f0fc35b12db2996a13f6213a6072603f6b20",
    "translation": "우리 가족 (uri gajok) = ons gesin",
    "role": "localized_instruction_or_meaning"
  },
  "207": {
    "sourceHash": "1e6b44b5546f4ef726759366dad4de655d914bfa1185393f112efa88951c610d",
    "translation": "’n Vriend ’n teksboodskap stuur",
    "role": "localized_instruction_or_meaning"
  },
  "208": {
    "sourceHash": "4c9ed5913bbeeef70094336b15db4bc2b3bd39000c6b4f46ddd41891f24bdfc1",
    "translation": "Teksboodskappe gebruik kort beleefde sinne wat op **-요** eindig. **지금 어디예요?** vra waar jy is, **곧 가요** beteken “Ek kom binnekort” en **늦어요** beteken “Ek is laat”.",
    "role": "localized_instruction_or_meaning"
  },
  "209": {
    "sourceHash": "b7c0f45ba6008777d7a3012d595c56d46b5c30e0ebe2f4dbe2f7ec43f26da723",
    "translation": "지금 어디예요? (jigeum eodiyeyo?) = Waar is jy nou? / 곧 가요. (got gayo.) = Ek kom binnekort.",
    "role": "localized_instruction_or_meaning"
  },
  "210": {
    "sourceHash": "ee576b374d0f57230f4f618fecaef30c9ccb386ba2bcc3b716d92b765a57367c",
    "translation": "Woorde hardop lees",
    "role": "localized_instruction_or_meaning"
  },
  "211": {
    "sourceHash": "3d4987813c5de90987721153a437a793e305296dba7f01ab30e3afe8e0ff18be",
    "translation": "Wanneer ’n lettergreep op ’n medeklinker eindig en die volgende met ’n vokaal begin, skuif die klank oor: 책이 word **chaegi** en 밥을 **babeul** gelees. Party klanke verander hul bure ook: 국물 word **gungmul** en 같이 **gachi** gelees.",
    "role": "localized_instruction_or_meaning"
  },
  "212": {
    "sourceHash": "dac7221bb9d34358bfa8a159d9b5fe3f9f6443c913af033add41b218b9afbac5",
    "translation": "책이 (chaegi) / 밥을 (babeul)",
    "role": "preserved_learning_target"
  },
  "213": {
    "sourceHash": "830286a3c90a42db41c57bc56750ae0c0b80cb206105a29b2e7268a249503e7b",
    "translation": "Beleefde werkwoorde in die teenwoordige tyd eindig op **-아요 / -어요 / -해요**. Dieselfde vorm word vir “ek”, “jy” en “hulle” gebruik.",
    "role": "localized_instruction_or_meaning"
  },
  "214": {
    "sourceHash": "d58728f4f079f97a3cdbcf3750fbe526e22fda793da8e69e723ab6a27362a4c2",
    "translation": "먹어요. (meogeoyo.) = (Ek) eet. / 마셔요. (masyeoyo.) = (Ek) drink.",
    "role": "localized_instruction_or_meaning"
  },
  "215": {
    "sourceHash": "12e88276fd3356007eaa4b7483c32b545206a58bff9d05704eeb21514bb4eb74",
    "translation": "Na plekke gaan",
    "role": "localized_instruction_or_meaning"
  },
  "216": {
    "sourceHash": "82c4d3a4c99800e79e25457fd6ad4b462ec2f51bdb2a6da5d32d1d6c7aa2b06c",
    "translation": "Sit **에** ná ’n plek om te sê waarheen jy gaan of kom: 학교에 가요. Die werkwoord kom laaste.",
    "role": "localized_instruction_or_meaning"
  },
  "217": {
    "sourceHash": "316b7fc15aedbb9f148e06d989c30d356a60fa5c7ceb7d347b71611ef418fe5b",
    "translation": "학교에 가요. (hakgyoe gayo.) = Ek gaan skool toe.",
    "role": "localized_instruction_or_meaning"
  },
  "218": {
    "sourceHash": "08d334fa4a07f54f481dd33d9b64b9483a12aca3e4899b8137d1d05e6b814fb2",
    "translation": "Eet, drink, lees",
    "role": "localized_instruction_or_meaning"
  },
  "219": {
    "sourceHash": "16d76fffd79abad342aa4e1c9bec05eeb54794c0c7aab70a4e6e9881df96b755",
    "translation": "Die voorwerp van ’n werkwoord kry **을** ná ’n medeklinker en **를** ná ’n vokaal: 밥을 먹어요, 커피를 마셔요.",
    "role": "localized_instruction_or_meaning"
  }
}
