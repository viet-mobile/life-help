    "sourceHash": "54dd47107a7d2bbc2f3ca743c3313c4caec1097a9efa76dbb24b3aec0258fdbc",
    "translation": "Statistiese vrae en steekproewe"
  },
  "109": {
    "sourceHash": "fef9a430493a8872aefae50f2832aa795ead9f297d06dd8b80af8be703020f2d",
    "translation": "Skatting en hipotesetoetse"
  },
  "110": {
    "sourceHash": "8594dcc39ff63d19ad4ab2900b5fad4f9a13b3f3f4cfa736db54edd4b4fa6d9d",
    "translation": "Navorsingsmetodes"
  },
  "111": {
    "sourceHash": "82517261ddfdaf679b8827b3abf364da5e5383f3fe3f15e3d5cd81681ed7997f",
    "translation": "Navorsingstappe en etiek"
  },
  "112": {
    "sourceHash": "7945839df93581e2e8455ca5e849cd1c41dcad325c572b6284e27f00bc54e0a1",
    "translation": "Matrikse en hul bewerkings"
  },
  "113": {
    "sourceHash": "3de00e282423109de7766e934b7a91cc5e5bb3db49d9f76639d5809e597c14a1",
    "translation": "Versamelings en bewerings"
  },
  "114": {
    "sourceHash": "716c8d473410fd63fef73e2735678bdd5a6601d928ad835f111a6d379339d7ee",
    "translation": "Saamgestelde en inverse funksies"
  },
  "115": {
    "sourceHash": "aaf276ebc0b8914001dadc7d01aebcb72f767e91f6a7bd5cd15811b5890f10b1",
    "translation": "Faktoriseer en los derde- en vierdegraadsvergelykings op"
  },
  "116": {
    "sourceHash": "945048c662debb8439d0b0c25d50cfb2b778178ba7c5c1c1c90e50bb8ac86ecc",
    "translation": "Differensieer eksponensiële, logaritmiese en trigonometriese funksies"
  },
  "117": {
    "sourceHash": "dfd3e3573a6629074d1925a9988ab768bb2952193745ccd6c036228ef4b22e81",
    "translation": "Permutasies en kombinasies met herhaling, en die binomiaalstelling"
  },
  "118": {
    "sourceHash": "59aa223bbec236825bbbfb42425b0466951fd13fdf1179bd249d4f458083d6cb",
    "translation": "Graad 1 Wiskunde · Getalle en Vorms"
  },
  "119": {
    "sourceHash": "c71bd0567c9e5a1112262e3a8319da3c68f449558d16ff0d3da6bb8ef1f8fea4",
    "translation": "Getalleweide"
  },
  "120": {
    "sourceHash": "f8f73aec61fb16ff2fe5e102db218cb3693a02f643ef96fc7f9b8b7331bf5048",
    "translation": "Maak vriende met getalle en vorms"
  },
  "121": {
    "sourceHash": "b06a883cb4f3730d95e9138c85c6a60125e8b22ee73f9be8b616b1fd16d92bac",
    "translation": "Graad 2 Wiskunde · 2-Syfergetalle en Vermenigvuldiging"
  },
  "122": {
    "sourceHash": "ffe043ff76d68cb18e0676c9a9efdc60672914bad16047321761b95bb5f5b03e",
    "translation": "Vermenigvuldigingsberg"
  },
  "123": {
    "sourceHash": "af1d01004644758ec4d97c09669456ac855a91dd1edcf8f82d2fe8c6d7326ea8",
    "translation": "Tel in groepe terwyl jy die berg klim"
  },
  "124": {
    "sourceHash": "901a98533fb6abf40a88dcffee9f70a46810757465b57e1c88fe8f0f7b28c08a",
    "translation": "Graad 3 Wiskunde · Vermenigvuldiging, Deling, Breuke"
  },
  "125": {
    "sourceHash": "9001aad177efc850a81e4097fa7cbcfe4d499698a61e2a9e7f162914c9acc9ad",
    "translation": "Breuke-eiland"
  },
  "126": {
    "sourceHash": "a17439ae1b4093d6a371e60dcface3750a74e062a5041370ef10a449d3dadde7",
    "translation": "Verdeel gelykop en verken die eiland"
  },
  "127": {
    "sourceHash": "b60611501a85392bb055a513ab58b12d392985f4c7addf3422830baed202567c",
    "translation": "Graad 4 Wiskunde · Groot Getalle, Breuke en Desimale"
  },
  "128": {
    "sourceHash": "b57549dcde927993a3e066338cae1ca33d768b7ec62cb8e10e0638b259eca6ee",
    "translation": "Grootgetalkloof"
  },
  "129": {
    "sourceHash": "a0b7148157825ea0adb4e8a4a22a75fb542ccbed8cde4facb2b4459d13f7b751",
    "translation": "Steek die kloof van reusegetalle oor"
  },
  "130": {
    "sourceHash": "2458099a3f56fef08838ce9cc46c0254ff2d5e4fd6ec2274eed7a4ca48dedcae",
    "translation": "Graad 5 Wiskunde · Breuke, Desimale, Faktore en Veelvoude, Oppervlakte"
  },
  "131": {
    "sourceHash": "594e74369db275a8d96839ea8b92526e4012c0a53aee4e0706d2cfc184923f7f",
    "translation": "Priemspits"
  },
  "132": {
    "sourceHash": "5106b6e7dea4d09e7162447d1471e6ca5697cf29cd292da61d38086a4d0ec850",
    "translation": "Klim die spits van faktore en veelvoude"
  },
  "133": {
    "sourceHash": "0ea39cfb978a8f3e24fbdd627d64607c7a9c8b846d9536ef1a200bdf60c78d2a",
    "translation": "Graad 6 Wiskunde · Breuk- en Desimale Bewerkings, Eweredighede, Sirkels"
  },
  "134": {
    "sourceHash": "2a55b39562d0d6c25c17c10d727e66f160d2993247b8bb73b3e738316674dfa2",
    "translation": "Verhoudingsrif"
  },
  "135": {
    "sourceHash": "409357eb8613b6d1aa900351bab1b484ec0a15afcb2ab5bc93e0b9b59b5cc06a",
    "translation": "Swem deur die see van verhoudings"
  },
  "136": {
    "sourceHash": "90ed0582b120453ea62d9a6800d6e50b0d708ffd1ed37cee40c2c3a10baa270d",
    "translation": "Graad 10 Wiskunde: Polinome, Komplekse Getalle, Tel, Vergelykings van Figure"
  },
  "137": {
    "sourceHash": "5031408367d334ee86230835414b0cd58e02612e93832195c6cfe961a972dd08",
    "translation": "Kernwiskundekloof"
  },
  "138": {
    "sourceHash": "c741b770c5704461a6e74e6f8a559fdb3482d6b9369bdf1fb8c8bc7238afee03",
    "translation": "Bou van polinome tot vergelykings van figure 'n sterk grondslag vir hoërskoolwiskunde."
  },
  "139": {
    "sourceHash": "2dc58e0c5328edb6e5546e9b273c86e159065ec37b2868fe6d4e5c955adc9907",
    "translation": "Graad 11 Wiskunde: Logaritmes, Trigonometriese Funksies, Rye, Limiete, Afgeleides"
  },
  "140": {
    "sourceHash": "cd960c9e63de6ef4c23314b8d6c95e874d8d43e30b8de12974c4341d7d98b5c9",
    "translation": "Rekeningspits"
  },
  "141": {
    "sourceHash": "e1737402e105ff0e05346dcb6488f87b647a0470cd53e35cb85717a9a85fd50b",
    "translation": "Begin by eksponente en logaritmes en klim tot by die spits van differensiasie."
  },
  "142": {
    "sourceHash": "f7488968583b21a66d51f7d7badd6316587e3163311932d27bcedef8f9b43c02",
    "translation": "Graad 12 Wiskunde: Integrale, Reekse, Waarskynlikheidsverdelings"
  },
  "143": {
    "sourceHash": "e754eb25d02d1caa5ca9ba67cae0b24337d538249be01663c14b56a37b28fb24",
    "translation": "Integraalvlaktes en Statistieksee"
  },
  "144": {
    "sourceHash": "19cdd643ec92b643a4a0ff8c8f86f2735215651d8e3cbde5aaeb98d3b4a7d142",
    "translation": "Meet oppervlaktes met integrale en lees onsekerheid met waarskynlikheidsverdelings."
  },
  "145": {
    "sourceHash": "ceb09d55689f927b126336f80297f8b4206b7b45eb9313a1075684a8e08a4ccb",
    "translation": "Graad 7 Wiskunde · Lineêre Vergelykings"
  },
  "146": {
    "sourceHash": "d253bc72de74c9c1400a0d9dbb77746c7dd43fb5eb193f60b4464634a9350da5",
    "translation": "Algebrawoud"
  },
  "147": {
    "sourceHash": "6697510810749f9e6b4b2034a8f1ba090494537c0b2c4f069eebfaa0681295f1",
    "translation": "Verken die woud van letters en uitdrukkings"
  },
  "148": {
    "sourceHash": "76fce7a058570e4688b1a9d2c7c574bced9f7b44dbe4bceaa87e8224c376dc20",
    "translation": "Graad 8 Wiskunde: Uitdrukkings, Funksies en Waarskynlikheid"
  },
  "149": {
    "sourceHash": "592dc7317fabb815002dd8f6a7bf8dc8011b2715948a8dc36acdf56d6eb83653",
    "translation": "Funksiewoud"
  },
  "150": {
    "sourceHash": "42517ce13c44e996bc56b8a3273ebae7c4c3eae57cbb3ab3e82960b226c7cf57",
    "translation": "Werk met uitdrukkings, lees grafieke en voorspel met waarskynlikheid."
  },
  "151": {
    "sourceHash": "4c678d9c21d8d592f4da3f8b71e8ccce41a5ecc1f9be02ea2a01eba1ca6808a9",
    "translation": "Graad 9 Wiskunde: Vierkantswortels, Kwadratiese Uitdrukkings, Trigonometriese Verhoudings"
  },
  "152": {
    "sourceHash": "11cf4940c87b3eae2fbec7d269928effaf8d1bff9bf00de2d2b06c95364a6f3f",
    "translation": "Kwadratiese Heuwel"
  },
  "153": {
    "sourceHash": "73b861b07d36e3a8e01d6b59de47d8d3ccc9cab5861034534b7daca445ed04fa",
    "translation": "Begin by vierkantswortels en klim tot bo-op die parabool en die geheime van driehoeke."
  },
  "154": {
    "sourceHash": "030e9fea414fc4be8d6c95c97e10fb40e95cc361f0bf29543c2ce37c45e4263f",
    "translation": "Ekonomiese Wiskunde"
  },
  "155": {
    "sourceHash": "c3acb56757de5a0f71110b902ab3c7f7fa7eeeb601eb080f0702dcb8c68d7108",
    "translation": "Ekonomiedorp"
  },
  "156": {
    "sourceHash": "32d060a3ca9affb205e71d8a42d78edb8af7049b9bcf2a3cd27f0a0e30decd4e",
    "translation": "Leer die wiskunde van geld en markte"
  },
  "157": {
    "sourceHash": "d69f985330d34b085afee2f371954e11e5872fc534a87e13bcc61dea3ed3d7ad",
    "translation": "Wiskunde vir KI"
  },
  "158": {
    "sourceHash": "2b8a754b55d93cec5c95897761463e1c42073ca821d9e6bcec7746c5e2c5fa98",
    "translation": "KI-laboratorium"
  },
  "159": {
    "sourceHash": "fb22cb52a43bd416b82984732cf7e5671994be9da8cf67d8256470cd4fefcdf7",
    "translation": "Ontmoet die wiskunde binne data en optimalisering"
  },
  "160": {
    "sourceHash": "2ec55a0fca94414e0efd5966b7700391228b83cf01fe4f733d5a87ac133250d3",
    "translation": "Wiskunde in die Werkplek"
  },
  "161": {
    "sourceHash": "b62604ca8e33890977e829ac87571578b63b58c8a55b4385436abc3d5486c675",
    "translation": "Werkswinkeldorp"
  },
  "162": {
    "sourceHash": "4185afd71279b78508aad4862192ccce59ae4b307ffb4ccbdabe0b23fb85fd3d",
    "translation": "Oefen die wiskunde wat by die werk gebruik word"
  },
  "163": {
    "sourceHash": "177418bc9ae652f3b26638c48e250e102291972243016cd7f616fe8f3ced1ac5",
    "translation": "Wiskunde en Kultuur"
  },
  "164": {
    "sourceHash": "8dd5b1345795076f230331752b1aeb7896c646e5fecf7aff9f88a648a570380e",
    "translation": "Kultuurplein"
  },
  "165": {
    "sourceHash": "1d604395435444340f987b38dc320a2ace585d487d420ccceee7283c4f66a8ea",
    "translation": "Vind wiskunde in kuns en die daaglikse lewe"
  },
  "166": {
    "sourceHash": "00fe03b26800392010098e914f54d9f4be987f0b178caef053f3234297a4a540",
    "translation": "Praktiese Statistiek"
  },
  "167": {
    "sourceHash": "95a3fc15318c5118792b8a1afdd5edeb37be62940f355eee04f5681f1c3ab95a",
    "translation": "Statistieklaboratorium"
  },
  "168": {
    "sourceHash": "6362311e6d64f77d660c17a63ecb78189e603e9b7151c4ed102769a33971eefc",
    "translation": "Bou die vaardigheid om op grond van data te oordeel"
  },
  "169": {
    "sourceHash": "d6780a90c809b24c552ee4d763dd24e83e9880b273f3ca8e96d370f9e8b1e453",
    "translation": "Wiskundige Navorsingsprojekte"
  },
  "170": {
    "sourceHash": "9e229f81b7d345503698bdb76d6b9c28ed61975b4240253d2df3e2f54e6df5ef",
    "translation": "Navorsingswerkswinkel"
  },
  "171": {
    "sourceHash": "76f14d4ad9cdcf2b00d4b0bce669655ead3a580062dbc147d6d5f34e1ef115d2",
    "translation": "Leer die metodes en etiek van navorsing"
  },
  "172": {
    "sourceHash": "ea64223bb0712fb429beede407fd99989eea4c39906befa1851766513c538dbd",
    "translation": "Getalle, bewerkings en vorms"
  },
  "173": {
    "sourceHash": "c9f392a24fcaebf43596d6d0cda2882a2e58d25d1748e7348b23a38159291837",
    "translation": "Plekwaarde, optelling, aftrekking en eerste vermenigvuldiging"
  },
  "174": {
    "sourceHash": "b7f6e1d0432c7782c61058cab73b0606a4e0ef09ae6c5ea524c3a0f898b144cd",
    "translation": "Vermenigvuldiging en deling, breuke, meting, vorms, data"
  },
  "175": {
    "sourceHash": "354b6b4facd4d4da692fd9641ad32660bd9fc6fabb50d619a41213846b1152b8",
    "translation": "Groot getalle, vermenigvuldiging en deling, breuke en desimale, hoeke, grafieke"
  },
  "176": {
    "sourceHash": "fc96ef325673490f7f09a99bcc1d5691aa87e42e23bb6fa01b8fe71e2d6be6c5",
    "translation": "Breuke, desimale, faktore en veelvoude, oppervlakte en volume, verhoudings"
  },
  "177": {
    "sourceHash": "b77bbcb72cf9df9ef8903ce430dd59f11902e2d8b20b9059af2d1b4219eda1f4",
    "translation": "Breuk- en desimale bewerkings, eweredigheid, persentasies, sirkels en volume, gemiddeldes"
  },
  "178": {
    "sourceHash": "312e9a2ab332fb9a565efbcf0adc90af20ad54e59cafab3e6139bd48e481ddf7",
    "translation": "Graad 10 Wiskunde"
  },
  "179": {
    "sourceHash": "050fb22542cc19b2713b7f30e5456e1aac9ef89c9c9eee1fbf2b16065e233b57",
    "translation": "Graad 11 Wiskunde"
  },
  "180": {
    "sourceHash": "c5e5eb1df24cffd320e2da89064dc1a50bcc92a03b3edf03dee2d2320ff26e36",
    "translation": "Graad 12 Wiskunde"
  },
  "181": {
    "sourceHash": "8186730e01b83fc3baae1eba674ce608502024b877d8c139e7dd3cec9f484e5a",
    "translation": "Lineêre vergelykings"
  },
  "182": {
    "sourceHash": "b50e9c35f4c99ae9fead94438c741d02c374cc63b29710c7530dfff35cc09ffc",
    "translation": "Graad 8 Wiskunde"
  },
  "183": {
    "sourceHash": "49be912ce5c7e2990a68f9a187dca3a4f2088d4e66fb21c285405781e3fe1d23",
    "translation": "Graad 9 Wiskunde"
  },
  "184": {
    "sourceHash": "137f628591a1d8dfdd2d17fe7a57b12e345d734f4fa7b0ebbe5c16314a9cc446",
    "translation": "Getalle en ekonomie, funksies en ekonomie"
  },
  "185": {
    "sourceHash": "7ff9dfda23ed9a7f4f3e92ed983734fd7cec3bd84a9949c5d79c0204ab0361ef",
    "translation": "Dataverwerking, voorspelling en optimalisering"
  },
  "186": {
    "sourceHash": "04fb8d99a4165986fd093bf8e5ad20085f4f99feff23c71f54099a0ab2ebc3e4",
    "translation": "Getalle en eenhede, verhouding, oppervlakte en tel"
  },
  "187": {
    "sourceHash": "d64549f500b34aa015245cd6b265a50536a57462a6daeae0d557f9238b8146de",
    "translation": "Kuns en lewe, samelewing en omgewing"
  },
  "188": {
    "sourceHash": "cfecedd4884a63fc99d43cd6c8dff66276d37bb4241d51f0809f00816614149c",
    "translation": "Data en steekproewe, skatting en toetsing"
  },
  "189": {
    "sourceHash": "d1bc7c3cc36385dea18a43ff65049ad6fd75c54b16044830475946067b1048a4",
    "translation": "Metodes, prosedure en etiek"
  },
  "190": {
    "sourceHash": "b83d8bd76023f9767130b148288210897b91c12cc3757d11ac46b0ed0426e75f",
    "translation": "Wys een vir een na elke voorwerp om te vind hoeveel daar is. Ná 10 is dit makliker om in groepe van 5 of 10 te tel."
  },
  "191": {
    "sourceHash": "4eb2fe9b8a1c3bda866e168cb3b0a1cd4516b3b84daca799c8bb0bddd81d50e7",
    "translation": "🍎🍎🍎🍎🍎 → Daar is 5 appels."
  },
  "192": {
    "sourceHash": "22820dda6bd010b4fa5809bbbd8536045ad8c981cb25ea70fc267711e7f8694d",
    "translation": "**Optelling (+)** voeg twee getalle saam. **Aftrekking (-)** neem 'n kleiner hoeveelheid van 'n groter getal weg."
  },
  "193": {
    "sourceHash": "6ac8bac29a0bf131e316b1db81c310733fd51959c1d699e49041f961794ea96d",
    "translation": "$3 + 4 = 7$, $8 - 3 = 5$"
  },
  "194": {
    "sourceHash": "1b6f2263d7081c0c5db534e88899b0c8f153494a000038099e50f5267916489f",
    "translation": "Gebruik **>** wanneer die eerste getal groter is en **<** wanneer dit kleiner is. Die teken maak na die groter getal oop."
  },
  "195": {
    "sourceHash": "2b4b7f63eebaee539679fb0c1e3e84b635e429a5913b7ba1031d7da5179697d9",
    "translation": "$8 > 5$, $4 < 7$"
  },
  "196": {
    "sourceHash": "f124245bd9d2d1ce2a6123c3b31f55690e44d2459caa5f3ebb9a9bcffebccf99",
    "translation": "'n **Driehoek** het 3 sye en 'n **vierhoek** het 4 sye. 'n **Sirkel** is rond en het geen hoeke nie."
  },
  "197": {
    "sourceHash": "103bcba7bb024d97d642911ff75d11025c80315784894be91271c2f6d2f7a869",
    "translation": "Driehoek: 3 sye, 3 hoeke"
  },
  "198": {
    "sourceHash": "4b7254615c87c9fc6193f7d579838e68674423d7572e2167f85bec646a2f9a52",
    "translation": "Ons meet lengte in **cm**. Op 'n horlosie wys die kort wyser die 'uur' en die lang wyser die 'minute'."
  },
  "199": {
    "sourceHash": "74d9fdea55a2b53516c593eb15f4fdde4e3b00fda30c2d441e8e52eff9460284",
    "translation": "Kort wyser op 4, lang wyser op 12 → 4-uur"
  },
  "200": {
    "sourceHash": "0b038967bb2e5b7581fee82582642ef3c89cda7a199aa03d890e74483bb2bf77",
    "translation": "In 'n 2-syfergetal is die linkersyfer in die **tieneplek** en die regtersyfer in die **eneplek**. 10 groepe van 10 maak 100."
  },
  "201": {
    "sourceHash": "b98299b3b3f6ce807e5903d0c79207345cb31c1312515b5b297b776f3eadfd19",
    "translation": "$47$ = 4 tiene en 7 ene"
  },
  "202": {
    "sourceHash": "33cc0983e9328b3eaa6a5e33d9b8cc239344a4b636c97bcbffcbceb2b3bf799e",
    "translation": "Werk die ene uit en dan die tiene. As 'n som meer as 10 is, dra oor. As jy nie kan aftrek nie, hergroepeer (leen)."
  },
  "203": {
    "sourceHash": "acfe9765fb44b888cd54c0885e6a03ff05a09697dc959d8caa03fb58424246a6",
    "translation": "$45 + 27 = 72$, $61 - 28 = 33$"
  },
  "204": {
    "sourceHash": "17777c9dc5df7e2591ddd82f460e73a48173b44e0e08b512b4ad2a821a19ba7e",
    "translation": "Die optelling van dieselfde getal baie keer kan korter met **vermenigvuldiging (×)** geskryf word."
  },
  "205": {
    "sourceHash": "130796c3f3eb9d13a5cc6e0ec68c166f21eca3121478a92852ad9b8daa48dfd3",
    "translation": "$3 + 3 + 3 + 3 = 3 \\times 4 = 12$"
  },
  "206": {
    "sourceHash": "449031c39f51c6992919869bbf3f239c22c26f12043c80dd42dfcd8abd75d70f",
    "translation": "**1m = 100cm**. Elke keer as die lang wyser een getal op die horlosie verbygaan, verloop 5 minute."
  },
  "207": {
    "sourceHash": "ea3e095aeca8e4576b912a5c191361a16bae8c1478288b4d9bb1be09d47f0fbf",
    "translation": "Lang wyser op 6 → 30 minute"
  },
  "208": {
    "sourceHash": "af586e146a4ad01b246faee99164c0e2943ed9c90c04f4fa5a26417ef2576a62",
    "translation": "Vind die **patroon** van hoe die getalle toeneem of afneem, en jy kan die volgende getal voorspel."
  },
  "209": {
    "sourceHash": "ad201368e1980c764166f019e985b092d125903d3053453d09b0f13bf3964251",
    "translation": "$2, 4, 6, 8, \\square$ → neem elke keer met 2 toe, □ = 10"
  },
  "210": {
    "sourceHash": "24f228de93ae41ee94e585fe2c3675f28536c2e24907a8b14752cec2630fc42b",
    "translation": "Vermenigvuldiging is om dieselfde getal baie keer op te tel, en **deling** is om gelykop te verdeel. As jy jou maaltafels ken, is deling ook maklik."
  },
  "211": {
    "sourceHash": "a5adf183686a91910db03b22a67d00c7a65a7a1a650f23f483defa699af517ef",
    "translation": "$6 \\times 7 = 42$, $42 \\div 6 = 7$"
  },
  "212": {
    "sourceHash": "e4c2e11b26df67c4bde55d1eff32b9b7a1c23bcf39a38cc9cbdd62e9cbf58d87",
    "translation": "'n **Breuk** wys 'n deel van 'n geheel wat in gelyke dele verdeel is. Die onderste getal is die **noemer** en die boonste getal is die **teller**."
  },
  "213": {
    "sourceHash": "e840fbfa9c208c0927e20e9d442e7974cc224369b609fb416184236df956ad60",
    "translation": "$\\frac{3}{8}$ : 3 stukke uit 8"
  },
  "214": {
    "sourceHash": "a3f6c4ec74079d280937beffd05b385b8c72775510710f214659f8d6f8ff69cf",
    "translation": "**1km = 1000m**, **1L = 1000mL**, **1kg = 1000g**. Om na die kleiner eenheid om te skakel, vermenigvuldig met 1000."
  },
  "215": {
    "sourceHash": "a6fb2ae128e6aa00dea98d9c89ec14cfae080528bfeaf77cdbec080bf0851a81",
    "translation": "$3\\text{km} = 3000\\text{m}$"
  },
  "216": {
    "sourceHash": "05356fbc70899984a2a52371ceb739980befad016866a9f27a033a788715e8b1",
    "translation": "'n **Regte hoek** is 90°. In 'n sirkel is die **deursnee** 2 keer die **radius**."
  },
  "217": {
    "sourceHash": "a4580288fa71b2ea597b4503c37c2fc4002031781973b862f8d94b61c9465bfa",
    "translation": "Radius 5cm → deursnee 10cm"
  },
  "218": {
    "sourceHash": "faaff92ad13edbb869a2bc6efbe8382838c03ecf06518312332c30e74b1341ac",
    "translation": "Plaas opnameresultate in 'n tabel om die meeste, die minste en die totaal maklik te sien."
  },
  "219": {
    "sourceHash": "73ec572983cb752ed1cbedc87ae462bab145302605cfbf9f60fd131b22076f79",
    "translation": "$7 + 5 + 9 + 4 = 25$ mense"
  },
  "220": {
    "sourceHash": "aaef65d06a79df52205c618a62b18028ead51d4520433aecd3f7c1b3c4528b1b",
    "translation": "Lees en skryf groot getalle in groepe van tienduisend (10000). Elke syfer het 'n waarde volgens sy **plekwaarde**."
  },
  "221": {
    "sourceHash": "50de37f7fc20ff8418ccb7579ec2992aa25056ea08e0779a0dc3faba826fa625",
    "translation": "$5 \\times 10000 + 3 \\times 1000 = 53000$"
  },
  "222": {
    "sourceHash": "90f99482b2f11c9a2e083d057971fa4d31c52786aa3e62cf7eb370f86aa996b1",
    "translation": "Verdeel die getal waarmee jy vermenigvuldig, vermenigvuldig elke deel en tel dan op. Vir deling, skat die kwosiënt en kontroleer dit."
  },
  "223": {
    "sourceHash": "daff3aa8bc8534e69e5e6a54e16cf648afeb2be4aab12605e4968c890c8ba3fd",
    "translation": "$34 \\times 12 = 408$"
  },
  "224": {
    "sourceHash": "a45f1c66fec789b06e001a43079e7eefd271ce355734fe476e91ab0d10884e7e",
    "translation": "Vir breuke met dieselfde noemer, tel **die tellers** op of trek hulle af. Vir desimale, belyn die desimale kommas voordat jy bereken."
  },
  "225": {
    "sourceHash": "96ea1417743378757d8cef0d8602a895a100741a03259c67dc27bf28e1c92dd3",
    "translation": "$\\frac{3}{5} + \\frac{1}{5} = \\frac{4}{5}$"
  },
  "226": {
    "sourceHash": "61db665a7235febcdb1d31c0d4ae24ce1b7d9890e788122489f55ebd6a857107",
    "translation": "Die drie hoeke van 'n driehoek tel op tot **180°**, en die vier hoeke van 'n vierhoek tel op tot **360°**."
  },
  "227": {
    "sourceHash": "a7fbc45983a4b290e6279ca33ce936105bba62932170711c0cf679909c38512e",
    "translation": "$180 - 50 - 60 = 70$"
  },
  "228": {
    "sourceHash": "7ada664d5e0c5b9d558a2b79b229526a12ebac7b7f0c0687f707915d617ea031",
    "translation": "Lees die data om totale en verskille te vind. Die **gemiddelde** is die totaal gedeel deur die aantal waardes."
  },
  "229": {
    "sourceHash": "57df51c38a16e96d092b60dd4000086afa64f1b61cdb15765f3e183b34dfd2ef",
    "translation": "$60 \\div 4 = 15$"
  },
  "230": {
    "sourceHash": "c4b0473b7b80801f20266032eff4f29e436aa9e900e698a5b75fb22c2ba14dd0",
    "translation": "As die noemers verskil, vind eers 'n **gemene noemer**. Dit is die maklikste om die kleinste gemene veelvoud van die twee noemers te gebruik."
  },
  "231": {
    "sourceHash": "7c038a53ad716b2605e8f160de23f97aa632a3d6c2a436f9a6f2c147258d2bf8",
    "translation": "$\\frac{1}{2} + \\frac{1}{3} = \\frac{3}{6} + \\frac{2}{6} = \\frac{5}{6}$"
  },
  "232": {
    "sourceHash": "eaf3fc33b33dd3303548b552481d17e9bcc7491574d4eefec66ea6290236365b",
    "translation": "Ignoreer die desimale kommas en vermenigvuldig soos heelgetalle. Plaas dan die desimale komma terug sodat die antwoord soveel desimale plekke het as die getalle wat jy vermenigvuldig het saam."
  },
  "233": {
    "sourceHash": "96920471bca5f7894bfaf9eb6db5e7a98dbab1da896040e0024038038697be2e",
    "translation": "$0.6 \\times 4 = 2.4$"
  },
  "234": {
    "sourceHash": "327e9c04ab34066979aaa678d6b378db0e497e3569ca5bbc57bbd30c67669f67",
    "translation": "'n **Faktor** van 'n getal deel daarin sonder 'n res. 'n **Veelvoud** is die getal maal 1, 2, 3..."
  },
  "235": {
    "sourceHash": "36cf852a00a7f02a13d60b560d7f27193a85817a47ea0938773caebc3a163bbf",
    "translation": "Faktore van 12: 1, 2, 3, 4, 6, 12"
  },
  "236": {
    "sourceHash": "bae7559c2e54a8cacdad164669f6923762b355ca223ad0f4b7121af077b7b99e",
    "translation": "Reghoek: **lengte × breedte**; driehoek: **basis × hoogte ÷ 2**; volume van 'n reghoekige prisma: **lengte × breedte × hoogte**."
  },
  "237": {
    "sourceHash": "0251841d00fd605b3c60c2eb3987c1926400833c7de08913ba2fbd68b035bd87",
    "translation": "$8 \\times 5 = 40$ cm²"
  },
  "238": {
    "sourceHash": "b8a50676bd57d6e2b532423dcd4cbe31f38caf967d907bfc299e07e812c83183",
    "translation": "'n **Koers** is die vergelykte hoeveelheid gedeel deur die basishoeveelheid. Vermenigvuldig 'n koers met 100 om 'n **persentasie (%)** te kry."
  },
  "239": {
    "sourceHash": "9939d089afdef33bb4af1a1a7e414a106906ca3b07336c14a81614901b777f7d",
    "translation": "$3 : 5 \\to 3 \\div 5 = 0.6$"
  },
  "240": {
    "sourceHash": "3007fd8c27bf38f9a886883c7126ef27b22d66f9771abe7411575f16e852c567",
    "translation": "Om breuke te vermenigvuldig, vermenigvuldig die tellers en die noemers. Om deur 'n breuk te deel, vermenigvuldig met sy **omgekeerde**."
  },
  "241": {
    "sourceHash": "932b8f4db1951d7e98be375879f4973ac5252bc6f80859893758c46cb8b06fa0",
    "translation": "$\\frac{3}{4} \\times \\frac{2}{5} = \\frac{3}{10}$"
  },
  "242": {
    "sourceHash": "6c19f0ab9efa9618c26fc9057270e0bdb7b455808adcfe28b34e754c4c92c1df",
    "translation": "In 'n eweredigheid is **produk van die binneterme = produk van die buiteterme**. Verdeling van 'n totaal in 'n gegewe verhouding word **eweredige verdeling** genoem."
  },
  "243": {
    "sourceHash": "ecf5689a1cda9f73367fd248467d6b002696a9df149679d7d2e946c4f6a9ce7c",
    "translation": "$3 : 4 = 12 : \\square \\to \\square = 16$"
  },
  "244": {
    "sourceHash": "71d30d615ad2b4daa9d648312f9f47e979adc03d1dfd11d2b98730ecd4d1dc5f",
    "translation": "'n **Persentasie (%)** is 'n koers wanneer die basishoeveelheid as 100 geneem word. Vermenigvuldig 'n desimaal met 100 om 'n % te kry."
  },
  "245": {
    "sourceHash": "93c46b2d019bf31e4f30fe828c73d770c22c142d2414f13fbadb322e697f3a93",
    "translation": "25% van 80 = $80 \\times 25 \\div 100 = 20$"
  },
  "246": {
    "sourceHash": "7097328338362d122690ff5d1fbeb105a656bed813d8936e806b155baf0897ca",
    "translation": "Die omtrek van 'n sirkel is **deursnee × 3.14**, en die oppervlakte van 'n sirkel is **radius × radius × 3.14**."
  },
  "247": {
    "sourceHash": "b8cacd37f923cee6812ff4d9b057228f9699f85840546dbd482b5107b59a08bc",
    "translation": "$10 \\times 3.14 = 31.4$"
  },
  "248": {
    "sourceHash": "e4d6ebef7a8084f47ba11b6512d8660538d9b04b08d500efdc05c65161e9f113",
    "translation": "Die **gemiddelde** is totaal ÷ aantal, die **mediaan** is die middelste getal en die **modus** is die getal wat die meeste voorkom."
  },
  "249": {
    "sourceHash": "0c3f367aeb8283ec20bd2afd65e24b476ed75481b3fa4f22355f623ff0fef471",
    "translation": "$(80 + 90 + 70 + 100) \\div 4 = 85$"
  }
}
