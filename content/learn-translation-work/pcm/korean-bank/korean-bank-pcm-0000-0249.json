  },
  "3": {
    "sourceHash": "5a591789667c4334f500f6f2144d7dc00b6f45474fd12a1d5beb9e2764bd179f",
    "translation": "“{ko}” ({rr}) mean “{meaning}”.",
    "role": "localized_instruction_or_meaning"
  },
  "4": {
    "sourceHash": "f5cf65fddf104fda2806deb8ecdfd1dbb6e1f60ccd6c90fd419f0e18fab72572",
    "translation": "Talk am out slowly, one syllable after another.",
    "role": "localized_instruction_or_meaning"
  },
  "5": {
    "sourceHash": "282b339e7ddbb02d01426386b15e3898299763c33133249011ecc887381d043b",
    "translation": "Choose the Korean wey mean “{gloss}”.",
    "role": "localized_instruction_or_meaning"
  },
  "6": {
    "sourceHash": "297b20e834654d63c12c1c35bc03e496cba828badd98ed92262da32dfad3b0c8",
    "translation": "Think about the situation or the group wey the words belong.",
    "role": "localized_instruction_or_meaning"
  },
  "7": {
    "sourceHash": "80b83a4a448369db05e701c17fffbb7422d0777c15db8d2752d596787f11a782",
    "translation": "Compare how many syllables dey each option.",
    "role": "localized_instruction_or_meaning"
  },
  "8": {
    "sourceHash": "83ca52997994a7cbf6ed6116e82cae92e4449319bf81a5f66e640b71e8b48bbd",
    "translation": "“{meaning}” na “{ko}” ({rr}).",
    "role": "localized_instruction_or_meaning"
  },
  "9": {
    "sourceHash": "6c9e689ebf0f86040b138f2e5183677be324723cfb03f35bfcc843bf98529002",
    "translation": "Listen, then choose wetin you hear.",
    "role": "localized_instruction_or_meaning"
  },
  "10": {
    "sourceHash": "d10efd276aaf78c975b68c6a2f7e49501fac5d6288a3e2092eb797d362fe21d2",
    "translation": "Play am again and listen to each syllable.",
    "role": "localized_instruction_or_meaning"
  },
  "11": {
    "sourceHash": "49b9736610bfc464b2f2ab7646f296e7f481df3ac7cbc4ebe689dddc2cbe954d",
    "translation": "Compare the options one syllable after another.",
    "role": "localized_instruction_or_meaning"
  },
  "12": {
    "sourceHash": "d891f03b0939768a645e4534b060068abf15ec765b11640116bc10f6d99e3b4e",
    "translation": "Na “{ko}” ({rr}) you hear.",
    "role": "localized_instruction_or_meaning"
  },
  "13": {
    "sourceHash": "4c99f090c2d0987903657e5ff890fa39ff353acf8b0be07e67434db347664b01",
    "translation": "This one mean “{gloss}”?",
    "role": "localized_instruction_or_meaning"
  },
  "14": {
    "sourceHash": "6bf56848a275f99126ae3a8654e0ebf94b3e9be9bb4de229ef8e13b71a8ff2ab",
    "translation": "Think about the meaning of the whole word or phrase, no be only one part.",
