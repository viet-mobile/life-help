    "role": "localized_instruction_or_meaning"
  },
  "187": {
    "sourceHash": "12a0010047eaad3bbabfa146a88419b61cedb3f07134e3b6679bd73ed2cb907d",
    "translation": "Your friend talk say e like coffee, and you like am too.",
    "role": "localized_instruction_or_meaning"
  },
  "188": {
    "sourceHash": "2fa02eef51bd0fa06a6819892679ed722a4940bd60bf29131d7fb53cd202afe9",
    "translation": "Later.",
    "role": "localized_instruction_or_meaning"
  },
  "189": {
    "sourceHash": "098bf27dfcfdf9be0e638bfd3c2e08af74d558bb445f3c00372d87df23f01b80",
    "translation": "Waiter ask whether you want order now, but you want wait.",
    "role": "localized_instruction_or_meaning"
  },
  "190": {
    "sourceHash": "1438ebe71a34e577d2e8b89633280e5941d59f66b6f328bbab304278b9e8f6d2",
    "translation": "I no too sure.",
    "role": "localized_instruction_or_meaning"
  },
  "191": {
    "sourceHash": "c11fc3522d50c8d9801169160449e307dfb57394cb53bc24dc202ebcc0dcee39",
    "translation": "Person ask you something, but you no know the exact answer.",
    "role": "localized_instruction_or_meaning"
  },
  "192": {
    "sourceHash": "b0362b2a59a0582f8e703f46fb0206d06e95e52373cd141fe6366a3eb82d8139",
    "translation": "No, e no need; I dey okay.",
    "role": "localized_instruction_or_meaning"
  },
  "193": {
    "sourceHash": "97125732ab9eb5d342c5d0ae0382dff10c66b73e36bc52e2616fe45e6defcbec",
    "translation": "Shop attendant offer you bag, but you no need am.",
    "role": "localized_instruction_or_meaning"
  },
  "194": {
    "sourceHash": "09bb0c55132a19350933169fdc1ec0d65dbaed97daa301e564ee5e7a1259007f",
    "translation": "E dey; I get am.",
    "role": "localized_instruction_or_meaning"
  },
  "195": {
    "sourceHash": "48aaf50bc4440e13ff6d43d5cb651471b4ca14098df5e4021233c656f7600611",
    "translation": "The verbs for something dey and something no dey fit also mean person get am and person no get am.",
    "role": "localized_instruction_or_meaning"
  },
  "196": {
    "sourceHash": "a192f5a5f3c2a652d97c99a6483fe68640c3aed897fbd222967d157482d6bc0e",
    "translation": "E no dey; I no get am.",
    "role": "localized_instruction_or_meaning"
  },
  "197": {
    "sourceHash": "c65694b8fa713af4973d4c4ea32dfdbfaf6806c9a0bb34f7fdee53e82b68ce49",
    "translation": "Alone; only me.",
    "role": "localized_instruction_or_meaning"
  },
  "198": {
    "sourceHash": "7316b4913dce5dae40fad10c67edb4c4bca6b7a1da905d5e288d15e656a9defb",
    "translation": "I fit speak small Korean.",
    "role": "localized_instruction_or_meaning"
  },
  "199": {
    "sourceHash": "ac6b188bf6e697309dcba579b41ee00965669a5ffc51a84e2ed2ecd4a3b2f271",
    "translation": "Today no go work.",
    "role": "localized_instruction_or_meaning"
  },
  "200": {
    "sourceHash": "81ac88fd955df72d47cc5f798a7de25a0911d8b4551b27c657709d719f48eb9d",
    "translation": "Your friend invite you go out, but you busy today.",
    "role": "localized_instruction_or_meaning"
  },
  "201": {
    "sourceHash": "675d13c2dc0bf946872f682f69aedc1a1d49174b69888af1dd60be7359baa6f9",
    "translation": "No, I no dey do am.",
    "role": "localized_instruction_or_meaning"
  },
  "202": {
    "sourceHash": "d3c77d4ce767282cea940df9dec98d99243b14ee4941f9729964a2470a08b0ba",
    "translation": "Person ask whether you dey smoke or do something wey you no dey do.",
    "role": "localized_instruction_or_meaning"
  },
  "203": {
    "sourceHash": "4e6a1e833aeff8219ac8e355a3dc213f3687b03ed6b4ebc405f79158424641c5",
    "translation": "Yes, I be Korean.",
    "role": "localized_instruction_or_meaning"
  },
  "204": {
    "sourceHash": "6c4bcab67c8a3840f046c92cc0f4ad264ced5f07c86729e3629758e76fa41b29",
    "translation": "No, I no be student.",
    "role": "localized_instruction_or_meaning"
  },
  "205": {
    "sourceHash": "6d387c191a5825b3bf7b137248a40c4ba8a629320133a16eb70e9f1d5902651a",
    "translation": "No, water no dey.",
    "role": "localized_instruction_or_meaning"
  },
  "206": {
    "sourceHash": "4197009c7ef83d7f8c397b555e7ddc77e019707d82209b88b741127869855558",
    "translation": "Yes, coffee dey.",
    "role": "localized_instruction_or_meaning"
  },
  "207": {
    "sourceHash": "8bb2893065ac99735e4fe420f898a08c71bfdcf97c5aaf3460cd9a304898dc88",
    "translation": "No, I no dey go now.",
    "role": "localized_instruction_or_meaning"
  },
  "208": {
    "sourceHash": "266fc90c5335f81e2e34df80b5e3a4abdfc5b8206a59b2af43d94a5c049d8964",
    "translation": "A: You be Korean? B: No, I be Japanese.",
    "role": "localized_instruction_or_meaning"
  },
  "209": {
    "sourceHash": "4ffcd603d30f3c076b607c56447fd4d2f3901ae735a52c48e0887ed2a4a47489",
    "translation": "A: Una get coffee? B: Yes, e dey.",
    "role": "localized_instruction_or_meaning"
  },
  "210": {
    "sourceHash": "d574d9b9ada3075687acfa2731ed8d495395b55535eca540d61b0890014aa50f",
    "translation": "Abeg, chop plenty.",
    "role": "localized_instruction_or_meaning"
  },
  "211": {
    "sourceHash": "c99df889451cb4c241b35b12ee14a9c00ffe2c8a2e752bd8e3804c9e9c56a697",
    "translation": "Visitor for your house shy to chop, so you encourage the person to chop plenty.",
    "role": "localized_instruction_or_meaning"
  },
  "212": {
    "sourceHash": "1e0de1156b9220ca3f6801ff4f3fd57c29a803642287e522a47e47325637d67c",
    "translation": "For Korean table manners, elders dey start first, people dey share small side dishes, and dem dey give gifts or drinks with both hands.",
    "role": "localized_instruction_or_meaning"
  },
  "213": {
    "sourceHash": "0a140e13a74dad6060a91d519c37fa62ce4e10e474d792887ff9adf21a74e73e",
    "translation": "Enjoy your food.",
    "role": "localized_instruction_or_meaning"
  },
  "214": {
    "sourceHash": "63deb7ea3e693d8e4fbb5084bd26d715c72bba26eee197c0859447494ef0d0b6",
    "translation": "Person wey dey serve put food for your table.",
    "role": "localized_instruction_or_meaning"
  },
  "215": {
    "sourceHash": "38469334b100e1d64e84895297326a5c8a805c09db5300e75acddfa12f6842a3",
    "translation": "You don chop? (friendly greeting)",
    "role": "localized_instruction_or_meaning"
  },
  "216": {
    "sourceHash": "344f6f985cd267372ac6b9f09d9d7db2c4af4658c7d7cc59bc94dfc31468c729",
    "translation": "Your friend meet you around lunchtime and ask how you dey.",
    "role": "localized_instruction_or_meaning"
  },
  "217": {
    "sourceHash": "17b59cb4895520183a0589698f382449fc3774a24775ba7bb9ede0afb9a462be",
    "translation": "Make we raise our glasses!",
    "role": "localized_instruction_or_meaning"
  },
  "218": {
    "sourceHash": "9f5bb8a4ed8ebb843683cf0de088651fb489e3199a0211bd5324aaac171000e1",
    "translation": "You and your friends raise glasses when una dey chop for evening.",
    "role": "localized_instruction_or_meaning"
  },
  "219": {
    "sourceHash": "1a6a7d3bb88ca8d43d9c76ca89ccb61856d5925b5db10167d4e54d0d04461bad",
    "translation": "Abeg, give me small water.",
    "role": "localized_instruction_or_meaning"
  },
  "220": {
    "sourceHash": "77073d0b6824e60d613ae3393a11fb2f753c42808aed7b924c06125b08762c1b",
    "translation": "You sit down for restaurant and ask the workers.",
    "role": "localized_instruction_or_meaning"
  },
  "221": {
    "sourceHash": "4b21c1332872ae6d74d32a18a9d1891e3d46e82d24b11ca1523c929038127510",
    "translation": "Abeg, bring more side dishes.",
    "role": "localized_instruction_or_meaning"
  },
  "222": {
    "sourceHash": "6635b2c75818fdbc3347673d248647e81fe4ab5cc53c82ccf45f70255dc123dc",
    "translation": "You ask the workers to add more food for the small dishes.",
    "role": "localized_instruction_or_meaning"
  },
  "223": {
    "sourceHash": "5dad864edc999ac5a9eb0e1d649a0b774248ba9699b1a07bfc4d91a1c4c9f81f",
    "translation": "I dey remove my shoes for house.",
    "role": "localized_instruction_or_meaning"
  },
  "224": {
    "sourceHash": "d77a19551dc18e286b06ede97e44b54821738e0e244bffc7dfac4af0bda362bb",
    "translation": "I dey use both hands collect gift.",
    "role": "localized_instruction_or_meaning"
  },
  "225": {
    "sourceHash": "9d6c3dd28b23898a6c00d067a19aaf5b4b25f2f10f7bff5eafb355d57216bb3f",
    "translation": "I dey use chopsticks chop.",
    "role": "localized_instruction_or_meaning"
  },
  "226": {
    "sourceHash": "f377274d8966fdfe65ce636935d747154ae46981554b8189958ee0785fbfd565",
    "translation": "The particle (eu)ro dey show the tool wey person use do something.",
    "role": "localized_instruction_or_meaning"
  },
  "227": {
    "sourceHash": "21164c4ec9de101bb53a4b88a26903babf292d4d11e36e41803712440c9c6325",
    "translation": "I dey use spoon chop soup.",
    "role": "localized_instruction_or_meaning"
  },
  "228": {
    "sourceHash": "35672c3cfab712cc0ce6c557dbf91915817fa00f4dfdd7e4a1e9b8fc0a192b15",
    "translation": "We dey share the side dishes.",
    "role": "localized_instruction_or_meaning"
  },
  "229": {
    "sourceHash": "36be8a0d2b9bcc85206569559c5a56e8041fc6f54accf9cfb61023d49833c037",
    "translation": "Lunar New Year",
    "role": "localized_instruction_or_meaning"
  },
  "230": {
    "sourceHash": "647b7b1fb7bc68466c8961579b32dbc3b1665a331af2d2d45c0c0f7c1b37c3cf",
    "translation": "Chuseok, Korean autumn harvest festival",
    "role": "localized_instruction_or_meaning"
  },
  "231": {
    "sourceHash": "63127deaecababdab52550191b2e2089df11df9d538198754068374926f6dfd3",
    "translation": "hanbok, traditional Korean clothes",
    "role": "localized_instruction_or_meaning"
  },
  "232": {
    "sourceHash": "9014fac8184d7ba9e1dcd80b8c1e1aa2906af8a01fc1e6e9092e575eabf7b80d",
    "translation": "soup",
    "role": "localized_instruction_or_meaning"
  },
  "233": {
    "sourceHash": "c5165f66b5acaa036d4e8ef3a0b278bcfc29d250b3d1606bcc9b440dcf9890d3",
    "translation": "small dish wey dem serve beside the main food",
    "role": "localized_instruction_or_meaning"
  },
  "234": {
    "sourceHash": "473fec0ecb9339a185d9bb98a55292e66b6baaac89e6903b24c492bb9ea741ae",
    "translation": "chopsticks",
    "role": "localized_instruction_or_meaning"
  },
  "235": {
    "sourceHash": "7f480e744a79953eb916b68f540e0eeec6f9cf23edf4aa08cc1cdf5f077c0f6f",
    "translation": "spoon",
    "role": "localized_instruction_or_meaning"
  },
  "236": {
    "sourceHash": "f82468d669ec4f543880b4c8f885d521994258af2313d1cf9c6e5a2fa213abdd",
    "translation": "E don tey wey we see.",
    "role": "localized_instruction_or_meaning"
  },
  "237": {
    "sourceHash": "70245da2c890bf58ed9ac257f2107145630f73e58a85fa2c736559b1f96258de",
    "translation": "You meet friend wey you never see for long time.",
    "role": "localized_instruction_or_meaning"
  },
  "238": {
    "sourceHash": "a75d49c10401891dbfd7785767d504833068155e4279115f8b10368be14be48f",
    "translation": "Sleep well. (polite greeting to older person)",
    "role": "localized_instruction_or_meaning"
  },
  "239": {
    "sourceHash": "ee5d9f861bb9e80808d328c6df24d1a94b6c902d2cd6f8e3c06d056411bd0b0f",
    "translation": "You wish your grandma good night before e go sleep.",
    "role": "localized_instruction_or_meaning"
  },
  "240": {
    "sourceHash": "be677eb8cf24d58038c63ee0184087913cbd7ceb883a55c551a4b8fcff3d1bbc",
    "translation": "Korean get special greetings for different times, like bedtime, when person dey comot for house, and when person return.",
    "role": "localized_instruction_or_meaning"
  },
  "241": {
    "sourceHash": "95445a1210fed5edf227fe85ba4bdcb0b1bf9e1cded1f5a247eefcb89d6912d1",
    "translation": "Happy New Year.",
    "role": "localized_instruction_or_meaning"
  },
  "242": {
    "sourceHash": "33a3d12f3d549f3b91b03f256fe1a119ec3c5e2429c6838adfbc1b9d7834d11f",
    "translation": "New year don start, and you greet your neighbour.",
    "role": "localized_instruction_or_meaning"
  },
  "243": {
    "sourceHash": "125d3e7b54c0c9ff4d085e2970dbc8e5fea4bb2fdb8a92efedf665fc62fc2903",
    "translation": "I dey go out; I go come back.",
    "role": "localized_instruction_or_meaning"
  },
  "244": {
    "sourceHash": "76b33c6d2cac27acc339fac58b2f462e93fd810dda8f1e2f800ffd2b3066f531",
    "translation": "You dey leave house go school, and you tell your family.",
    "role": "localized_instruction_or_meaning"
  },
  "245": {
    "sourceHash": "9b70d08e567f5bc041dae15c88f623dc80c0ab208683a7beea7e0db971ef1363",
    "translation": "Go well and come back safely.",
    "role": "localized_instruction_or_meaning"
  },
  "246": {
    "sourceHash": "7b062d52369d5a6bdf840aac5893d7a0417f43d43e5ed1530e590b82fa2884b5",
    "translation": "Your spouse or parent dey leave house go work, and you reply from the doorway.",
    "role": "localized_instruction_or_meaning"
  },
  "247": {
    "sourceHash": "7384eb9bcd361f06c344abfcd927b690ba9b7c5eb500c13715bcf595d4d7dc3d",
    "translation": "I don come back.",
    "role": "localized_instruction_or_meaning"
  },
  "248": {
    "sourceHash": "6d0493503741508bcf2b235711f899cdb840de310ae9611f6cdbc512b73db97a",
    "translation": "You return house and call your family.",
    "role": "localized_instruction_or_meaning"
  },
  "249": {
    "sourceHash": "3fc2118d352cbb01db0d8b015d9df5926e416c4b75379601277187da80329c6b",
    "translation": "Welcome.",
    "role": "localized_instruction_or_meaning"
  }
}
