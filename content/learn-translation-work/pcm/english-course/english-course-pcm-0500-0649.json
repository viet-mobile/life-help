  "587": {
    "sourceHash": "d6ee6964ec76910bb2cb51ff2c97cf45050dfa920c404a8ca1137cba507846e7",
    "translation": "Read di passage and answer. \"Sam has a ball. The ball is green.\" Question: Which colour di ball get?",
    "role": "localized_instruction_or_meaning"
  },
  "588": {
    "sourceHash": "4131c1b289bdd825cd4ed15cf41a47f832ca90642e1602ee66a9fb31d5d9b482",
    "translation": "The ball is green. = Di ball green like grass.",
    "role": "localized_instruction_or_meaning"
  },
  "589": {
    "sourceHash": "5a1f6dad43ce0bd860a7a8925769aa4188030be04bd412da76e7802f9d6ffaec",
    "translation": "Read di sentence 'The ball is ...'.",
    "role": "localized_instruction_or_meaning"
  },
  "590": {
    "sourceHash": "27475571dafc0b108ab4033193382de03f9ee8445d0539fdb5f2048d2d305e39",
    "translation": "Read di passage and answer. \"Amy has a dog. The dog is brown.\" Question: Which colour di dog get?",
    "role": "localized_instruction_or_meaning"
  },
  "591": {
    "sourceHash": "a0e4ef20b965019a576cf2a0994728e7eec403f1cd780f6b480e5db089f143e4",
    "translation": "The dog is brown. = Di dog brown like chocolate.",
    "role": "localized_instruction_or_meaning"
  },
  "592": {
    "sourceHash": "895420db0b914d630a4028dbcc971049ff6b9709008bb2a85257558b10b15911",
    "translation": "Read di sentence 'The dog is ...'.",
    "role": "localized_instruction_or_meaning"
  },
  "593": {
    "sourceHash": "610d254851b5ecf5ff5f6f941eaf9fd852677939f54fa4dec7e27e7615b159f0",
    "translation": "Read di passage and answer. \"I like milk. I drink milk every morning.\" Question: Wetin di person dey drink?",
    "role": "localized_instruction_or_meaning"
  },
  "594": {
    "sourceHash": "0ab08aeea4207369f2dfc31c484a0f624be3839c22934ee7a71bde9fc7271203",
    "translation": "I drink milk. = I dey drink milk.",
    "role": "localized_instruction_or_meaning"
  },
  "595": {
    "sourceHash": "78b37cd6ef4dacfb17052293bfaa4228e382266a6eb3fc8a539b159091dd0508",
    "translation": "Read di sentence 'I drink ...'.",
    "role": "localized_instruction_or_meaning"
  },
  "596": {
    "sourceHash": "cf67b4ecea4ab18585f375bf3a171c51d98577268478f332cc04eabe12dfee1c",
    "translation": "Tap di words for correct order to make sentence. (Meaning: You dey happy.)",
    "role": "localized_instruction_or_meaning"
  },
  "597": {
    "sourceHash": "b26151c832bd66519816310f0775601185eac88848a66ab57cf9c3fe9f073c55",
    "translation": "I am happy. = I dey happy.",
    "role": "localized_instruction_or_meaning"
  },
  "598": {
    "sourceHash": "1a626c0c28afb3f1b0b194c311822b7bb535889e49eeb7b2997c7c8f3ecb44ba",
    "translation": "E start with 'I am'.",
    "role": "localized_instruction_or_meaning"
  },
  "599": {
    "sourceHash": "8c0a5d69c7ba7b51961a0c4ce825f1e582abc71092235fce2bdf476be973c340",
    "translation": "happy dey come last.",
    "role": "localized_instruction_or_meaning"
  },
  "600": {
    "sourceHash": "de39532cca92116eb785bf5202630cd249e193a18102659cdb724916e13a7d9f",
    "translation": "Tap di words for correct order to make sentence. (Meaning: You dey treat people well.)",
    "role": "localized_instruction_or_meaning"
  },
  "601": {
    "sourceHash": "650ffd2b1679096f1ab62272950dc1466fa66aea38502e20b6ed40a3000d11b4",
    "translation": "You are kind. = You dey treat people well.",
    "role": "localized_instruction_or_meaning"
  },
  "602": {
    "sourceHash": "3f3bd8a4e56c09a137676f4457cde9f4ab59595402e097f82ab806fb11a74935",
    "translation": "E start with 'You are'.",
    "role": "localized_instruction_or_meaning"
  },
  "603": {
    "sourceHash": "85596ddd65769a7bf973b7dedd91d87145f62c697a3b00ac1a269b6f1186320b",
    "translation": "kind mean say you dey treat other people well.",
    "role": "localized_instruction_or_meaning"
  },
  "604": {
    "sourceHash": "858310d0ed8ab1ddafcd9a628d7485ee2ab10b73e26f18c4bbe8fe882b2b28c8",
    "translation": "Choose di word wey fit di blank: I ____ a student.",
    "role": "localized_instruction_or_meaning"
  },
  "605": {
    "sourceHash": "c333118ed919812c725b7bf09174c430f012b59cef468571846287fdc92471d4",
    "translation": "I am a student. = I be student wey dey go school learn.",
    "role": "localized_instruction_or_meaning"
  },
  "606": {
    "sourceHash": "2e9083de3efa12f178d3065e079fbe71b77c4ebb0b5d590422ec05b5e61ebd47",
    "translation": "After 'I', use am.",
    "role": "localized_instruction_or_meaning"
  },
  "607": {
    "sourceHash": "e5fae53ffb75e4268b07cf0ab456a952c19023cdf975ac3b4ea8f3d7451d795c",
    "translation": "I am = wetin I be.",
    "role": "localized_instruction_or_meaning"
  },
  "608": {
    "sourceHash": "e5ac23644907af99defd2a433bc3809098b5f843157842f2942dec81bb45eb2b",
    "translation": "Choose di word wey fit di blank: You ____ my friend.",
    "role": "localized_instruction_or_meaning"
  },
  "609": {
    "sourceHash": "17fdfe84f630637ab4b36f5ea48e1a0aedbaf7f07e5be18c94320e0d50d4a554",
    "translation": "You are my friend. = You be my friend.",
    "role": "localized_instruction_or_meaning"
  },
  "610": {
    "sourceHash": "f700398e00bd81b9e0f32c1d222b3bb307d8d98cac62027a0d7f2f90894f36cd",
    "translation": "After 'You', use are.",
    "role": "localized_instruction_or_meaning"
  },
  "611": {
    "sourceHash": "595e5f73bdd719991927748747dc5806920641ff47f7675fac3ece548b1b67b9",
    "translation": "You are = wetin you be.",
    "role": "localized_instruction_or_meaning"
  },
  "612": {
    "sourceHash": "e6789f3ea6a0f1f064da519ea7dc8304caf085d262e178aacb92d3ccc09cb834",
    "translation": "Tap di words for correct order to make sentence. (Meaning: Tom na your friend.)",
    "role": "localized_instruction_or_meaning"
  },
  "613": {
    "sourceHash": "f4e3327d079a1f865cbe9abbd4e136f6055d23e1b25ae67a048123773d1cb94b",
    "translation": "Tom is my friend. = Tom na my friend.",
    "role": "localized_instruction_or_meaning"
  },
  "614": {
    "sourceHash": "0a20d73e05870c1787351ce32a35bd4ddd165b7dfb61960b5e569fabfd42afe5",
    "translation": "E start with person name.",
    "role": "localized_instruction_or_meaning"
  },
  "615": {
    "sourceHash": "ef8dbacdc580cd52eb9510b2f00455cceba93fa9fb178a6c7c79c30a22883c59",
    "translation": "After Tom, use is.",
    "role": "localized_instruction_or_meaning"
  },
  "616": {
    "sourceHash": "e17543eee5eec82d0b2638c94d6fea3beaa4c8ab689975a284d2bb4174e771f7",
    "translation": "Choose di word wey fit di blank: I ____ happy.",
    "role": "localized_instruction_or_meaning"
  },
  "617": {
    "sourceHash": "62a0c281631eec2a13fe51703d7727a7f36d96e29a16d22f39cd1fb7e93bdf79",
    "translation": "happy mean say your mind dey happy.",
    "role": "localized_instruction_or_meaning"
  },
  "618": {
    "sourceHash": "aaad99fb88191026ad98f6745edee6557f2914db98d666d636c8468c60d1ddce",
    "translation": "Tap di words for correct order to make sentence. (Meaning: You dey go school learn.)",
    "role": "localized_instruction_or_meaning"
  },
  "619": {
    "sourceHash": "4a75ba051687bcd78fd52984ec96893db5dfd3413ae99fdeda7b25b8a626f8b0",
    "translation": "a student dey come last.",
    "role": "localized_instruction_or_meaning"
  },
  "620": {
    "sourceHash": "7a0ddaf548355070bc1c8e65974645530e70b3c56e984d3e7b06c4afbd78fff4",
    "translation": "Choose di word wey fit di blank: You ____ tall.",
    "role": "localized_instruction_or_meaning"
  },
  "621": {
    "sourceHash": "a7452c9f611c37487d5e92b007d3bbced513577818c3007530a2ffa0571e3685",
    "translation": "You are tall. = Your body tall.",
    "role": "localized_instruction_or_meaning"
  },
  "622": {
    "sourceHash": "484e377bc7f0e4cdb918cc974df64f3d766030da84f6d9d3af0debc9a8588fb1",
    "translation": "tall mean say person height plenty.",
    "role": "localized_instruction_or_meaning"
  },
  "623": {
    "sourceHash": "fe612d7671af167beba2e9300a618a76f51ecaadd3351dfa8411f9492f92a25b",
    "translation": "Read di passage and answer. \"I see a big animal. It has a long nose. It is gray.\" Question: Wetin e be?",
    "role": "localized_instruction_or_meaning"
  },
  "624": {
    "sourceHash": "a374ed775106d3b568d49993283adce911dec265da99981da13bbacdc110c5b5",
    "translation": "Na big animal wey get long nose.",
    "role": "localized_instruction_or_meaning"
  },
  "625": {
    "sourceHash": "0cae3e35e3c58de0a0a9212143ce53f1ccf3cbba7c2b66ee0b5a7950c5404ea6",
    "translation": "E grey.",
    "role": "localized_instruction_or_meaning"
  },
  "626": {
    "sourceHash": "1d1ea56725d9998f9da7227b4b89ef42440b75d982526e6b096a063619232179",
    "translation": "Big grey animal wey get long nose na elephant.",
    "role": "localized_instruction_or_meaning"
  },
  "627": {
    "sourceHash": "44cab769535cc818bdabf307b61d8028761f91694aac82ed7df5509e3fb26303",
    "translation": "Read di passage and answer. \"Mina has two pets. One says \"woof\". The other lives in water.\" Question: Which pets Mina get?",
    "role": "localized_instruction_or_meaning"
  },
  "628": {
    "sourceHash": "47ff79c57f972c9ed7ef6c16f20215effee748cb9664fff1cfd016592a744477",
    "translation": "First find di animal wey dey make woof sound.",
    "role": "localized_instruction_or_meaning"
  },
  "629": {
    "sourceHash": "cdf54f86b28a1b1e6883b20a8346c56bb76698b8917ba41d16c1b48124639e74",
    "translation": "Which animal dey live inside water?",
    "role": "localized_instruction_or_meaning"
  },
  "630": {
    "sourceHash": "df0ed0e593f70749a3d45f7e01963dace8e27302f3b3bbbb18b52f2458aa8c65",
    "translation": "woof na dog sound, and animal wey dey live inside water na fish.",
    "role": "localized_instruction_or_meaning"
  },
  "631": {
    "sourceHash": "9420b0812851465f6e1b6fa304b86891717f4e7161daa6b269f44b52ee0e824b",
    "translation": "Choose di word wey fit di blank: It is dark. Mina is tired. She will ____ in her bed.",
    "role": "localized_instruction_or_meaning"
  },
  "632": {
    "sourceHash": "b7a460cd5c9baf89d3e209e80426bd5a8dd2ebdb576ba39cd2094b88d8e22662",
    "translation": "Wetin you dey do for bed at night when you don tire?",
    "role": "localized_instruction_or_meaning"
  },
  "633": {
    "sourceHash": "f0d0d2c6afd7d2f44dda6be20bf40848bfcf8a2631f933a3dd383e6172d91075",
    "translation": "Choose something wey you fit do for bed.",
    "role": "localized_instruction_or_meaning"
  },
  "634": {
    "sourceHash": "8a9f048718470e6a395d6b82caa537ec6137af276aeffda6a5529fe951a62aea",
    "translation": "Everywhere dark and Mina don tire, so Mina go sleep for bed.",
    "role": "localized_instruction_or_meaning"
  },
  "635": {
    "sourceHash": "ccf797a0832c5e9aba9d2b9a29b2413b79ce636833e36a2291b43ffa5388674d",
    "translation": "After I, use di base form of di verb.",
    "role": "localized_instruction_or_meaning"
  },
  "636": {
    "sourceHash": "987f31a366bdfad1526380288d2411453017639789aa454f804d741ed656cde5",
    "translation": "eats, am eat, eating no fit follow I for this sentence.",
    "role": "localized_instruction_or_meaning"
  },
  "637": {
    "sourceHash": "65fae0413e3f933561497151545829eca82b37e30939496ca9c32448569da0d4",
    "translation": "After I, use di base form of di verb: I eat an apple. correct.",
    "role": "localized_instruction_or_meaning"
  },
  "638": {
    "sourceHash": "dc5690138dfb30d589b5f64b4c20dec1b4917606e879500b62a9aaf576369ee0",
    "translation": "Choose di word wey fit di blank for di conversation. Ben: What do you have? Mina: I ____ a red ball.",
    "role": "localized_instruction_or_meaning"
  },
  "639": {
    "sourceHash": "4d963e926d1d935397c24c92b378cbff86430faea2120ab00df3f370e10ecf04",
    "translation": "Choose di word wey mean say something belong to person.",
    "role": "localized_instruction_or_meaning"
  },
  "640": {
    "sourceHash": "68101ed0f3208d6cebba7b7ffccdbc2f2ad0c1c21f782330906b5641934caabf",
    "translation": "When di subject na I, no use has.",
    "role": "localized_instruction_or_meaning"
  },
  "641": {
    "sourceHash": "4f45a83c110da234cc275541b0997d9bd6d3e83d978eaf8363dab0136e7e9bd0",
    "translation": "After I, use have: I have a red ball. (I get red ball.)",
    "role": "localized_instruction_or_meaning"
  },
  "642": {
    "sourceHash": "1867b507e6808f201fa040c25e0ff4b6466028f5a6e424a38e3b5dacd22302d2",
    "translation": "'I have a dog.' mean say 'I dey like dog'? True or false?",
    "role": "localized_instruction_or_meaning"
  },
  "643": {
    "sourceHash": "38ce09f112233ea89238f1d3f319ccde53937c5d8014a0a45821d1692a21070a",
    "translation": "Think about di difference between have and like.",
    "role": "localized_instruction_or_meaning"
  },
  "644": {
    "sourceHash": "b8919d8d632ec922a4cd583a97e4eba54091c2595b702c29799743b2168edc9a",
    "translation": "have mean say something belong to person.",
    "role": "localized_instruction_or_meaning"
  },
  "645": {
    "sourceHash": "7dbd2da910cb7ff70ff7d960c981427e2ba4ec7f80b81dd2ba2000ccb9356b04",
    "translation": "I have a dog. mean say I get dog as pet. To talk say you like dog, use I like dogs.",
    "role": "localized_instruction_or_meaning"
  },
  "646": {
    "sourceHash": "391adf8b20a6a4b6637415684bb0ada1900aa5de36b2a7ba7248d0d59e029faf",
    "translation": "Choose di word wey fit di blank: Mina and Tom ____ my friends.",
    "role": "localized_instruction_or_meaning"
  },
  "647": {
    "sourceHash": "f0058f3f96bf88dbe78e4f4a6dbaf8f483ddc36bde4dcdfbc598722915c5cd7e",
    "translation": "Di subject na two people. Na plural.",
    "role": "localized_instruction_or_meaning"
  },
  "648": {
    "sourceHash": "af8f9412215dcaae3788b2ad58fb441f14a074dc5666cf53d647ac41721f5717",
    "translation": "After plural subject, use are.",
    "role": "localized_instruction_or_meaning"
  },
  "649": {
    "sourceHash": "8ef03c4065f3eab61053cbd0b777ec3c04d3bc6060c4e05f3db58c2be4f4fe6d",
    "translation": "Mina and Tom na two people, so use are.",
    "role": "localized_instruction_or_meaning"
  }
}
