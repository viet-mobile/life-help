  "2130": {
    "sourceHash": "f256d909997967dfc011989a2bd41b441a82cb704146d19720e621cf4c04e33a",
    "translation": "Relative pronoun dey describe di noun before am (antecedent). Use who for people, which for things, that for both, and whose for possession.",
    "role": "localized_instruction_or_meaning"
  },
  "2131": {
    "sourceHash": "426ccba253c94b8a85286e194b38995411c81fd5d49b752b61045f6810b97429",
    "translation": "Di antecedent The girl na person.",
    "role": "localized_instruction_or_meaning"
  },
  "2132": {
    "sourceHash": "a4254c7094d86f771c60407d46716ceb4215dbb42103697ebbb0b0dc5bf91a5b",
    "translation": "Di antecedent na person and e be subject, so who.",
    "role": "localized_instruction_or_meaning"
  },
  "2133": {
    "sourceHash": "82f3b04cb9709abcbd4f5bff828020f1e83fa2a3488b3712c31485b45ec34314",
    "translation": "Choose di word wey fit di blank: This is the book ____ I bought yesterday.",
    "role": "localized_instruction_or_meaning"
  },
  "2134": {
    "sourceHash": "693edcc4861b8f8fdc567f82998cd97351539845d6236c33da093ba747aed2af",
    "translation": "Di antecedent the book na thing.",
    "role": "localized_instruction_or_meaning"
  },
  "2135": {
    "sourceHash": "3e3a02702e296b16676b2b1a7326124ca468d55ab4097f75d5f664615b6ef682",
    "translation": "Di antecedent na thing, so which (or that).",
    "role": "localized_instruction_or_meaning"
  },
  "2136": {
    "sourceHash": "6fac9d08deff37ff4a292e0418984817a0c021ee502326347d3c14304554a7b7",
    "translation": "First check whether di antecedent na person or thing.",
    "role": "localized_instruction_or_meaning"
  },
  "2137": {
    "sourceHash": "0873bb814615b35a8660b3f0c89a045c54dcef08a8313fff5f5afc5ec94aa5dc",
    "translation": "The man na person, so use who, no be which.",
    "role": "localized_instruction_or_meaning"
  },
  "2138": {
    "sourceHash": "4bb52b827fe19c80fe616b1a3426e3f19ccc35e2065971939b0afc9a6fbd4b9a",
    "translation": "Choose di words wey fit di blank for di conversation. A: Who is that woman? B: She is the teacher ____ son is in my class.",
    "role": "localized_instruction_or_meaning"
  },
  "2139": {
    "sourceHash": "f0e3b1737ee2f13764d60ca1e0bc61fe28b37a01c9fb2aad4e69ee7cca16cb17",
    "translation": "Use whose + noun to show say something belong to person.",
    "role": "localized_instruction_or_meaning"
  },
  "2140": {
    "sourceHash": "096c30cd1df48f7e812ce031e0013c56987897304aa1f6af17151a676f9d23b5",
    "translation": "Na di teacher son: possession.",
    "role": "localized_instruction_or_meaning"
  },
  "2141": {
    "sourceHash": "8efa1e9434d1c498ef6dddcb695b0eebf9da3c98fbde3be6af9857555c94552b",
    "translation": "whose son = di teacher son.",
    "role": "localized_instruction_or_meaning"
  },
  "2142": {
    "sourceHash": "fecd3a9788676ae27e4d4b9da58151d186414d0763a98b98e6a1b6f20a34261d",
    "translation": "Join di two sentences with relative pronoun and fill di blank. I have a friend. He lives in Canada. → I have a friend ____ lives in Canada.",
    "role": "localized_instruction_or_meaning"
  },
  "2143": {
    "sourceHash": "cb98dd7d097199c54ecd581f7cea7643a2770507d4c29f0d031d95f44deae416",
    "translation": "He dey refer to a friend, wey be person, and e work as subject.",
    "role": "localized_instruction_or_meaning"
  },
  "2144": {
    "sourceHash": "012c0cd1ef5a7d302d2bd64c982b6faffde17343bb23bc84962184de82a855b2",
    "translation": "Na person and na subject role, so who (or that).",
    "role": "localized_instruction_or_meaning"
  },
  "2145": {
    "sourceHash": "db5389858fac39f9bfb486c57324bb6bf5959f177f6b97801a1be183fd62a3f7",
    "translation": "Choose di word wey fit di blank: The bag ____ is on the desk is mine.",
    "role": "localized_instruction_or_meaning"
  },
  "2146": {
    "sourceHash": "99ea441a99df8f1df34ee6cbcf8016a4158fa0d369286424d17ca6141ba1ca5b",
    "translation": "the bag na thing.",
    "role": "localized_instruction_or_meaning"
  },
  "2147": {
    "sourceHash": "2a5c943409f1b5fe553261c4332038deb009a041d896af4dd167e2b03a18ff3d",
    "translation": "which correct.",
    "role": "localized_instruction_or_meaning"
  },
  "2148": {
    "sourceHash": "3a466feb0e9accb2b928dc4d2ed7c9e7fe094b264d677c583a0b5a05a95d2502",
    "translation": "the house na thing.",
    "role": "localized_instruction_or_meaning"
  },
  "2149": {
    "sourceHash": "9b415a812dbeb60818d4ed0834758293747cc8796c42d5a918f0c86c3f67f067",
    "translation": "For things, use which, no be who.",
    "role": "localized_instruction_or_meaning"
  },
  "2150": {
    "sourceHash": "18ca59b0008e092d27f9417bf845c5e9bf707d3a6e00d35fde1734b35c284160",
    "translation": "Choose di word wey fit di blank: The movie ____ we watched was fun.",
    "role": "localized_instruction_or_meaning"
  },
  "2151": {
    "sourceHash": "d8cf068021353f44a7af84a41cb25d76b70ad552696ef63c863e2b27199d2725",
    "translation": "the movie na thing.",
    "role": "localized_instruction_or_meaning"
  },
  "2152": {
    "sourceHash": "00440a5fcedd3e66547c3a407376e7fd998893b8506040e4c475b24e6491b7a7",
    "translation": "Di grammar for this sentence correct? I met a girl whose father is a pilot.",
    "role": "localized_instruction_or_meaning"
  },
  "2153": {
    "sourceHash": "0a1f745e4673d4b63cabcc417c4493313d78008165ef92e7ff0429b2b622a282",
    "translation": "E mean 'di girl papa': possession.",
    "role": "localized_instruction_or_meaning"
  },
  "2154": {
    "sourceHash": "64d180ed1f4eac40b67c7bf0849aca7ede3c416f577a80b2d13de7552a82e263",
    "translation": "whose dey show possession, so di sentence correct.",
    "role": "localized_instruction_or_meaning"
  },
  "2155": {
    "sourceHash": "4515bd7236e526267de65f1acae2e2879829dece1394170f0b12ad8ffa098fa7",
    "translation": "Choose di word wey fit di blank: He is the man ____ helped me.",
    "role": "localized_instruction_or_meaning"
  },
  "2156": {
    "sourceHash": "01fa4b21475ec4595991d765506761a8822480bc919736b8a2391f23af1c2b25",
    "translation": "the man na person.",
    "role": "localized_instruction_or_meaning"
  },
  "2157": {
    "sourceHash": "e6abeec4a425aa59a7b29793f6d25cdfaa3a4fa2ce9227796b8037ba3d0826e5",
    "translation": "who correct.",
    "role": "localized_instruction_or_meaning"
  },
  "2158": {
    "sourceHash": "0208f4a179d2643515fdc4e4f711e67df1a82e9161755f1ec96cd2bb6545e3f5",
    "translation": "Sentence dey start with 'who → do wetin'.",
    "role": "localized_instruction_or_meaning"
  },
  "2159": {
    "sourceHash": "bad7f3e84b835936147a1428b89baa5db0a26a57b50776cf0e0df80a0a6bdd87",
    "translation": "Start with di subject She.",
    "role": "localized_instruction_or_meaning"
  },
  "2160": {
    "sourceHash": "595f1a0a25ee3c91c35dbfeacb8f41241a9e756cf1b41ca39ecf870b6f4ec565",
    "translation": "She reads a book every day. (E dey read book every day.)",
    "role": "localized_instruction_or_meaning"
  },
  "2161": {
    "sourceHash": "ac7b987cbc0cdff83b1e6ab1f40967a28f39d8e84da179c448f7134789badafc",
    "translation": "Di subject na 'My mother'.",
    "role": "localized_instruction_or_meaning"
  },
  "2162": {
    "sourceHash": "5109c218165d0cdbedb819d246dfd71b2cce18c465ef09f59c9ed3463ea9e960",
    "translation": "Di adjective delicious dey come before di noun soup.",
    "role": "localized_instruction_or_meaning"
  },
  "2163": {
    "sourceHash": "9049448df713ff7278baf6c96f985fe1ccd4d7a07e869b687bd3cfb8fa07e99d",
    "translation": "My mother makes delicious soup. (Di soup wey my mama dey cook sweet well well.)",
    "role": "localized_instruction_or_meaning"
  },
  "2164": {
    "sourceHash": "7b106df2fd26b17872192816a836d1c45310e0b84470e47249fb2d333cafa1c5",
    "translation": "Start with di subject We.",
    "role": "localized_instruction_or_meaning"
  },
  "2165": {
    "sourceHash": "e389acaf76215e7ef97a0d3f6b2b20c51349d2569c6ccb5db071ae45c2345c8d",
    "translation": "Di verb dey come after We.",
    "role": "localized_instruction_or_meaning"
  },
  "2166": {
    "sourceHash": "88010dbbb3a78c1bea0bd202c7ddb50a82edd074242891587b59e3db0da5daf4",
    "translation": "We play games. (We dey play games.)",
    "role": "localized_instruction_or_meaning"
  },
  "2167": {
    "sourceHash": "7329322233f765d17dc30235ae985005e8308504b9a453b45249c546aaa7ad75",
    "translation": "Wetin be di plural of 'book'?",
    "role": "localized_instruction_or_meaning"
  },
  "2168": {
    "sourceHash": "50686778d08722e26cee7429d62a7c9322871feff89ae1d374bd84a8f93f70b2",
    "translation": "For most nouns, just add -s.",
    "role": "localized_instruction_or_meaning"
  },
  "2169": {
    "sourceHash": "f303352215c7a691b95c08f306b893d6c7bfafcf521358fc76637ebf5b40d201",
    "translation": "book + s",
    "role": "localized_instruction_or_meaning"
  },
  "2170": {
    "sourceHash": "0844e827978db3863106a991157f56650b4140a3072cef4cb053e4804d2143eb",
    "translation": "Regular plural: book → books.",
    "role": "localized_instruction_or_meaning"
  },
  "2171": {
    "sourceHash": "f6cb6defc96ecff05faab90372b67ee54f15edf288657d2c9b30456a45a9800c",
    "translation": "one box → two ____",
    "role": "localized_instruction_or_meaning"
  },
  "2172": {
    "sourceHash": "3efe0a6222341f43f5f1ff4ae1d2a26670a38faa7482689ff78ad7ffa73dc7b0",
    "translation": "box end with -x.",
    "role": "localized_instruction_or_meaning"
  },
  "2173": {
    "sourceHash": "8d7e6a41c9bc51c12ed7d4dc9cacd4a8112bb5345a610afb9dc5261b7344e18e",
    "translation": "Add -es to nouns wey end with -x.",
    "role": "localized_instruction_or_meaning"
  },
  "2174": {
    "sourceHash": "97a696ffc96c119cb7835e622f3d842feb9259e67d3a1bd9d55c01d559321b0a",
    "translation": "box → boxes.",
    "role": "localized_instruction_or_meaning"
  },
  "2175": {
    "sourceHash": "6626cef336f943f5415517e9b9bba48892d6bfb45567d598c30d29cc84fa061b",
    "translation": "Write di plural of 'child'.",
    "role": "localized_instruction_or_meaning"
  },
  "2176": {
    "sourceHash": "1cecdfbe65e590b4e11893072775a2edaab28e5740a9617ff07127bbaf639263",
    "translation": "Na irregular plural.",
    "role": "localized_instruction_or_meaning"
  },
  "2177": {
    "sourceHash": "dd78e083f8991d2f48b4a11be4aae03cdbce9e7273913bc39aa22b983528310c",
    "translation": "child + ren",
    "role": "localized_instruction_or_meaning"
  },
  "2178": {
    "sourceHash": "f9b4793c81633409af761048bff2454d8aeeccb87560d4a8f1f45908f8c91766",
    "translation": "child → children (irregular).",
    "role": "localized_instruction_or_meaning"
  },
  "2179": {
    "sourceHash": "30abc7b971006c6af8c1e13a5fe05a62b84a6dfb5a0e1cbe05c33219634caa54",
    "translation": "Wetin be di plural of 'city'?",
    "role": "localized_instruction_or_meaning"
  },
  "2180": {
    "sourceHash": "576d8dab277578bee0aa5b1d512228148b9075df0456df407cef55b84e6861d2",
    "translation": "This noun end with consonant + y.",
    "role": "localized_instruction_or_meaning"
  },
  "2181": {
    "sourceHash": "75f2e9673a0b123921f232ecc53ab9406b54a52cc59b5e83e3ea87a57a9584db",
    "translation": "Change y to i and add -es",
    "role": "localized_instruction_or_meaning"
  },
  "2182": {
    "sourceHash": "20a6119296fed724ff5b1af180695d4e9ee4d72c67eca3ada9365199d52b6a29",
    "translation": "city → cities.",
    "role": "localized_instruction_or_meaning"
  },
  "2183": {
    "sourceHash": "c40831c6123d6de6153f5787bd04c68e263de0a0f24fe1d028bf27e40f97368b",
    "translation": "He ____ to school every day.",
    "role": "localized_instruction_or_meaning"
  },
  "2184": {
    "sourceHash": "a31cb20d63ca030794214442cad51143d0e94100033d14c08b45720a2a03cfa1",
    "translation": "He na third person singular.",
    "role": "localized_instruction_or_meaning"
  },
  "2185": {
    "sourceHash": "3b31b26cbb737d0ddbbee12c5917e5b000f3745e92e0e005d5491fdbd669d0ee",
    "translation": "Add -s/-es to di ordinary verb.",
    "role": "localized_instruction_or_meaning"
  },
  "2186": {
    "sourceHash": "c093232e4f98581fd76e10938e246aa6035c7dac9392ace26aaf029ae85d917a",
    "translation": "Third person singular, present tense: go → goes.",
    "role": "localized_instruction_or_meaning"
  },
  "2187": {
    "sourceHash": "9faaabfd82cf803d36868a0a54ddd458ba4b7941bc91aeb307fbe8abaeaaf867",
    "translation": "She ____ (watch) TV at night.",
    "role": "localized_instruction_or_meaning"
  },
  "2188": {
    "sourceHash": "373212109f87fbf907df0f33103525815f70a7516edea6ab58688dcf6eb259ea",
    "translation": "watch end with -ch.",
    "role": "localized_instruction_or_meaning"
  },
  "2189": {
    "sourceHash": "95921a81a4106e0c3676958db05f441a684de237f744faec3aff16ba63c28daf",
    "translation": "Add -es to verbs wey end with -ch.",
    "role": "localized_instruction_or_meaning"
  },
  "2190": {
    "sourceHash": "a9b5355cca1702eef8e111a6ef2aa980f7a2e18718aa66a57192c40dfca85e40",
    "translation": "watch → watches (if verb end with -ch, -sh, -s, -x, -o, add -es).",
    "role": "localized_instruction_or_meaning"
  },
  "2191": {
    "sourceHash": "7b6265955977be9a0de307d2732aec0b5cfbc6f7e195fcbbe721805faed07c01",
    "translation": "My dad ____ coffee every morning.",
    "role": "localized_instruction_or_meaning"
  },
  "2192": {
    "sourceHash": "017e9024bd6efdb9fdb7c800f46824bff3a9a255c6849c013dd209b1930caca4",
    "translation": "My dad = he .",
    "role": "localized_instruction_or_meaning"
  },
  "2193": {
    "sourceHash": "ddcceeaaec5f71deece16f9c74e0e5eb0d23a3309e4a9bb55522006b55f8da39",
    "translation": "'Every morning' dey show habit for present.",
    "role": "localized_instruction_or_meaning"
  },
  "2194": {
    "sourceHash": "2c55ffa58aee0d4e4b8956622785fc3b4f83eec8707455e816b26886351439ef",
    "translation": "Habit dey use present tense, and di subject na third person singular, so drinks.",
    "role": "localized_instruction_or_meaning"
  },
  "2195": {
    "sourceHash": "e4966f7e9ee46ed6bd91b467dc8b2dab9af2b481541eecbd753e7a6e5a292c61",
    "translation": "'She study English.' na correct sentence.",
    "role": "localized_instruction_or_meaning"
  },
  "2196": {
    "sourceHash": "d2f741b5c92401e2d43d380ae4a9b9993ef1f48df9124df026df8c385bf3c2ae",
    "translation": "She na third person singular. Wetin you suppose add to di verb?",
    "role": "localized_instruction_or_meaning"
  },
  "2197": {
    "sourceHash": "60e5a659dd742be1899cc9b11ece29d3276d40ecc2fc32e250c5f0ccb6694823",
    "translation": "study end with consonant + y.",
    "role": "localized_instruction_or_meaning"
  },
  "2198": {
    "sourceHash": "c7bbe41cd96734ffa1310eec6144c31fb31dbb3909ae4d01998bc81c76d96cd3",
    "translation": "For verb wey end with consonant + y, change y to i and add -es: She studies English.",
    "role": "localized_instruction_or_meaning"
  },
  "2199": {
    "sourceHash": "9e1f033ee7c82bb7d4ed7ad673fdf90338c570ec0da82c1c37dbe2b7bf085fa8",
    "translation": "The baby ____ (cry) a lot.",
    "role": "localized_instruction_or_meaning"
  }
}
