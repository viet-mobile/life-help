  },
  "968": {
    "sourceHash": "d67c362f27642dfbba9612ff46e4dc8168312cba2339d0485bf4ef6d652fca0a",
    "translation": "She baked a cake. = E bake cake for oven.",
    "role": "localized_instruction_or_meaning"
  },
  "969": {
    "sourceHash": "0d88c153e6cba5aa2def68706acdf315ac6c7aae4e05b808f77287cc295f8cb5",
    "translation": "For past tense, add -ed.",
    "role": "localized_instruction_or_meaning"
  },
  "970": {
    "sourceHash": "084928bc346fa041c377ad34c0a74e1cde27912f93be8174f4db460391539ea3",
    "translation": "Choose di word wey fit di blank: I ____ TV every night.",
    "role": "localized_instruction_or_meaning"
  },
  "971": {
    "sourceHash": "252523e8223315b4c88ad50255cd04fe791e6a16b70de9e066924b05d3bed61c",
    "translation": "I watch TV every night. = I dey watch TV every night.",
    "role": "localized_instruction_or_meaning"
  },
  "972": {
    "sourceHash": "466746a48b86f1cae15a068eae5f4b73b8403333249b55c531f1fac88bada00b",
    "translation": "every night mean 'each night'. E dey happen again and again.",
    "role": "localized_instruction_or_meaning"
  },
  "973": {
    "sourceHash": "5e783114e7b95978857198b1a8849e50623546bfd073fa9c38c1d8aaf778157b",
    "translation": "For things wey dey happen again and again, use present tense.",
    "role": "localized_instruction_or_meaning"
  },
  "974": {
    "sourceHash": "878ba9cf7cbb1297ca8414abac95071941175b071c145782004375049312f108",
    "translation": "Write di correct word for di blank: Next week, we will ____ to Busan. (travel)",
    "role": "localized_instruction_or_meaning"
  },
  "975": {
    "sourceHash": "0e7ccb0d0a48a998d720d4f5d21fddf4c180663ae7658219b19fe90de49745ae",
    "translation": "We will go to Busan. = We go travel go Busan.",
    "role": "localized_instruction_or_meaning"
  },
  "976": {
    "sourceHash": "969122f43c30e5dfb167a0527826a95c4fa114f4bcc61fcb83c6a44b5f75b78f",
    "translation": "Di base form of di verb dey come after will.",
    "role": "localized_instruction_or_meaning"
  },
  "977": {
    "sourceHash": "a2f8724cbb204decfb0f26abe1fde99ba931c57b039794f236d654fbf5b44509",
    "translation": "Tap di words for correct order to make sentence. (Meaning: You go visit your aunt tomorrow.)",
    "role": "localized_instruction_or_meaning"
  },
  "978": {
    "sourceHash": "f109e38fe0373c597660af1aecc4c697233b40968b19d1e9fa17b0f1667765cc",
    "translation": "I will visit my aunt tomorrow. = I go visit my aunt tomorrow.",
    "role": "localized_instruction_or_meaning"
  },
  "979": {
    "sourceHash": "44de343d259dd1625d9343054ec775a305770333d11d19124a546f9341737728",
    "translation": "Di base verb visit dey come after will.",
    "role": "localized_instruction_or_meaning"
  },
  "980": {
    "sourceHash": "501026ea4ba9f9f31df96de77c33d6f9ad27daba25701225384f65d18391a5c7",
    "translation": "Choose di word wey fit di blank: Tomorrow it ____ rain.",
    "role": "localized_instruction_or_meaning"
  },
  "981": {
    "sourceHash": "80c29b7783bf218ba27b53513b623a25fa30f682b55197c191a92fd8d374dda7",
    "translation": "It will rain tomorrow. = Rain go fall tomorrow.",
    "role": "localized_instruction_or_meaning"
  },
  "982": {
    "sourceHash": "a7c59b975fc02c75de88afb3a65d80801f42c00b8857b0a37b392aef7e74b47b",
    "translation": "tomorrow dey for future.",
    "role": "localized_instruction_or_meaning"
  },
  "983": {
    "sourceHash": "fd604ab246a7c2e1ce99346b2cc534b2449fb6c8dcd8e787697751505c59078c",
    "translation": "For future tense, use will.",
    "role": "localized_instruction_or_meaning"
  },
  "984": {
    "sourceHash": "00a8d2717910e5b79c99b7c4bc3cb5a3c7f90a9b2d5e1f180cbc9da0def10d42",
    "translation": "Choose di word wey fit di blank: Tomorrow we ____ to the zoo.",
    "role": "localized_instruction_or_meaning"
  },
  "985": {
    "sourceHash": "6226e379722af440ad3b8acfd510deca6ef53da49e723f56b14dd409e61d2e1f",
    "translation": "We will go to the zoo. = We go go zoo.",
    "role": "localized_instruction_or_meaning"
  },
  "986": {
    "sourceHash": "9b4992c92781d1ea36fe006fb97e9651e08a8f68cdb645a87350fd966eb9e9ed",
    "translation": "Use will + base verb.",
    "role": "localized_instruction_or_meaning"
  },
  "987": {
    "sourceHash": "88a12d5a03f751f42cb42f8a4d7a764356dfc846e0e15ea0acf098687f5047a5",
    "translation": "Choose di word wey fit di blank: Last week he ____ his friend.",
    "role": "localized_instruction_or_meaning"
  },
  "988": {
    "sourceHash": "2f54610f6cfb457252a54b789b8224e1f19d1dd61a9df71b79b7a0e5cd9faf20",
    "translation": "He called his friend. = E call di friend for phone.",
    "role": "localized_instruction_or_meaning"
  },
  "989": {
    "sourceHash": "0bac7143592a360ffc9d144beb7377bdd13df5c2f36f1c16873228b16340e467",
    "translation": "last week na di week before this one.",
    "role": "localized_instruction_or_meaning"
  },
  "990": {
    "sourceHash": "9614c3b6cd15a0af97fbd3ce098618e73d2e7de46130862e1bef662b2e331d6f",
    "translation": "Choose di words wey fit di blanks: Last Sunday, Mina ____ to the library. Next Sunday, she ____ to the museum.",
    "role": "localized_instruction_or_meaning"
  },
  "991": {
    "sourceHash": "cdfccfc3faaa652cde25482d28b0d49204b48b7a8c5e10299f9f76d691e90b6a",
    "translation": "Last Sunday dey for past, and Next Sunday dey for future.",
    "role": "localized_instruction_or_meaning"
  },
  "992": {
    "sourceHash": "a868e0898cd428a34e4565c20d78e32a6f3c8fdbf286f89cb52c638519fa3764",
    "translation": "Di tense for each blank different.",
    "role": "localized_instruction_or_meaning"
  },
  "993": {
    "sourceHash": "5c51aa5f0a34d2eed707a8db6ce49c4b015c652f629b4b00319f9e785b082e1c",
    "translation": "Last Sunday dey for past (went), and next Sunday dey for future (will go).",
    "role": "localized_instruction_or_meaning"
  },
  "994": {
    "sourceHash": "8a2c0348313e4cee68982825751663c5b497d4fe5dd4df72e5ed9e5ac910cdbb",
    "translation": "Choose di sentence wey get different tense.",
    "role": "localized_instruction_or_meaning"
  },
  "995": {
    "sourceHash": "804395346b055af5a7b58288eb67fc59b9ac65b8c5f3dd7f5acabfd71d7b6ec1",
    "translation": "Look di verb endings (-ed).",
    "role": "localized_instruction_or_meaning"
  },
  "996": {
    "sourceHash": "5571f5e9c171936f6a922cd882f5501b176e7dabdd5bc3c963eebf3a47c8c552",
    "translation": "Three sentences dey for past tense.",
    "role": "localized_instruction_or_meaning"
  },
  "997": {
    "sourceHash": "336e8a6bd3f929c818ab5ed6e5048971d6f02c4f9691be2488c6cefcdf3326e1",
    "translation": "visited, cooked, played na past forms, but plays na present.",
    "role": "localized_instruction_or_meaning"
  },
  "998": {
    "sourceHash": "ad57bd07f00d0c801c576fab2ecbe6e30b1cc7faa5e4ee23395a6966bdee307e",
    "translation": "For negative sentence with She, use doesn't.",
    "role": "localized_instruction_or_meaning"
  },
  "999": {
    "sourceHash": "a94ab92fb4bed65dd9a024795e1d677ee40ec7b9c4b57b048f72796c4e76616a",
    "translation": "After doesn't, use di base form of di verb without -s.",
    "role": "localized_instruction_or_meaning"
  }
}
