  "820": {
    "sourceHash": "1dbb11be62f3ba3d875216796e50b9781e6250cbf3e0f249e7d7eeb1a84c7312",
    "translation": "played na di past form of play",
    "role": "localized_instruction_or_meaning"
  },
  "821": {
    "sourceHash": "663df8b3898d648ad87605b2874f0813670e0f0bd9a059f5dc63d4ac72ad08d8",
    "translation": "Think about di verb when di subject na She (third person singular).",
    "role": "localized_instruction_or_meaning"
  },
  "822": {
    "sourceHash": "173ce8e0f4abad3e1e92ba97fb79b96711c7b36ae0d76ef76b3dc7a0fa5ca58a",
    "translation": "Add -s to di verb ending. Leave tennis as e dey.",
    "role": "localized_instruction_or_meaning"
  },
  "823": {
    "sourceHash": "8120b0478438632471fa965d64d2e616f1c74b087707368466973df6d077155f",
    "translation": "After She, add -s to di verb: She plays tennis. correct.",
    "role": "localized_instruction_or_meaning"
  },
  "824": {
    "sourceHash": "aaf5147755a86a5f41919512a60c1de4834c80d5e39ac49ec3fc3559be7542aa",
    "translation": "Tap di words for correct order to make sentence. (Meaning: My younger broda dey trek go school every day.)",
    "role": "localized_instruction_or_meaning"
  },
  "825": {
    "sourceHash": "6d4bbe93fbe2c1b80301fd02136dcfe83897048356adf8cb8826a0e41bcfaa78",
    "translation": "Write di subject, then di verb, then di place and time.",
    "role": "localized_instruction_or_meaning"
  },
  "826": {
    "sourceHash": "7f17194327a2a57dd246ca4f16f9154efbf4151f0e1821667674b732b54935d6",
    "translation": "walks dey come after My brother.",
    "role": "localized_instruction_or_meaning"
  },
  "827": {
    "sourceHash": "4f5c9aa83eba5656491ad223821f29a43f2f2b094d7e6198160ddb48d215485e",
    "translation": "My brother walks to school every day. Di order na subject → verb → place → time.",
    "role": "localized_instruction_or_meaning"
  },
  "828": {
    "sourceHash": "578df5f5ba3bd93862049cdbf2e7312e830b585491e4d506cba56d9d7bc9f35a",
    "translation": "Read di passage and answer. \"Tom and Mina are friends. They play soccer together. He is fast, and she is smart.\" Question: Who smart?",
    "role": "localized_instruction_or_meaning"
  },
  "829": {
    "sourceHash": "c962bef315b29951b9e1464fcac0f162560e1b597131e3fcb12685633b792940",
    "translation": "Think about who she dey refer to.",
    "role": "localized_instruction_or_meaning"
  },
  "830": {
    "sourceHash": "57fece59ce38e77c7b08305a31ff4417c08fe38f8821668fb44abf288b2e6f41",
    "translation": "Tom na boy, and Mina na girl.",
    "role": "localized_instruction_or_meaning"
  },
  "831": {
    "sourceHash": "1ef2f69f6a184abb04c76db5bb00cae5aa4578697eae635bdeafddf53b28160b",
    "translation": "she dey refer to girl, Mina. So na Mina smart.",
    "role": "localized_instruction_or_meaning"
  },
  "832": {
    "sourceHash": "c900bee1108ae2d756ac4088a43033eda80dbf566eec5c35bd478d92e383d2f7",
    "translation": "Read di passage and answer. \"The dog is under the table. It is sleeping.\" Question: Wetin \"It\" dey refer to?",
    "role": "localized_instruction_or_meaning"
  },
  "833": {
    "sourceHash": "e62ab74f37b6491d0f848ed620cf9b9c070b4684e6b4eb6c9f338e73e7a8afe3",
    "translation": "Find wetin It dey refer to for di sentence before am.",
    "role": "localized_instruction_or_meaning"
  },
  "834": {
    "sourceHash": "29d018eb740e0720b383135403e89445ac0b568619e63722b57d9386867a8567",
    "translation": "Na people or animals dey sleep.",
    "role": "localized_instruction_or_meaning"
  },
  "835": {
    "sourceHash": "748eff5997773189f5426796f3e3f5e332ba2c810a46e80ade01d14cd1ebef61",
    "translation": "Na di dog dey sleep, so It dey refer to di dog.",
    "role": "localized_instruction_or_meaning"
  },
  "836": {
    "sourceHash": "4d3f324f85841dc002f8b28fb54f58c5db1fcf1d7d80084df5903acbf2df745d",
    "translation": "Last night show say na past tense.",
    "role": "localized_instruction_or_meaning"
  },
  "837": {
    "sourceHash": "e761c49c8da26931b427435bec6610690086a08286822721822428b4b7ff3a8a",
    "translation": "If di time expression show past, di verb too must dey for past tense.",
    "role": "localized_instruction_or_meaning"
  },
  "838": {
    "sourceHash": "708fe748a8fe74915785020ebe80a777039642310f706d661532d5d26787d346",
    "translation": "Di sentence get Last night, so use watched, no be watch.",
    "role": "localized_instruction_or_meaning"
  },
  "839": {
    "sourceHash": "606844111866e32b83b3b135c94bf9e95ef6c8f1c8fc1a8bd995888706474ac3",
    "translation": "Choose di word wey fit di blank for di conversation. A: What did you do yesterday? B: I ____ my grandmother.",
    "role": "localized_instruction_or_meaning"
  },
  "840": {
    "sourceHash": "a9caeae67cd8d4addbf65d0131644ba4f65f3b2261b663f982802206241ced58",
    "translation": "A ask wetin B do yesterday (di day before today).",
    "role": "localized_instruction_or_meaning"
  },
  "841": {
    "sourceHash": "88a655b0f86566a379f2b0315483d77d7a19ff94c72dd437c76ea3760ee00ddc",
    "translation": "Na past tense, so choose di past form of di verb.",
    "role": "localized_instruction_or_meaning"
  },
  "842": {
    "sourceHash": "86fdb606d4327b0e063fcaa00596c67e4ee486f344eb15da343fbd8e6e4e2c02",
    "translation": "E happen yesterday, so use di past form visited.",
    "role": "localized_instruction_or_meaning"
  },
  "843": {
    "sourceHash": "8314aebe81e14ff74eba030e2a0a7ef3b322726148b1751d00f950a771a2d814",
    "translation": "Read di passage and answer. \"Jin gets up at seven. He eats breakfast at seven thirty. He goes to school at eight.\" Question: Wetin Jin dey do immediately after breakfast?",
    "role": "localized_instruction_or_meaning"
  },
  "844": {
    "sourceHash": "8ffce62d1ffa0dd0bf08717216562e54794bff930fc50abae16934d3b233ee6c",
    "translation": "Arrange di activities according to time.",
    "role": "localized_instruction_or_meaning"
  },
  "845": {
    "sourceHash": "b2cba7dec9a16c4a9a6f12b312741de62ba71c3141a9b8ca13621d017b607166",
    "translation": "Di time after 7:30 na 8:00 .",
    "role": "localized_instruction_or_meaning"
  },
  "846": {
    "sourceHash": "9e5b4454b3182c0b7d180deb5f517ca560726bd34ec36efb48ac51015a0c2ab2",
    "translation": "Get up by 7 → eat breakfast by 7:30 → go school by 8.",
    "role": "localized_instruction_or_meaning"
  },
  "847": {
    "sourceHash": "c0a03e62250357416d09a8b5ec1006060a335cd980959435d3f207c68b39501e",
    "translation": "Read di passage and answer. \"Mina goes to bed at ten. She gets up at six.\" Question: How many hours Mina dey sleep?",
    "role": "localized_instruction_or_meaning"
  },
  "848": {
    "sourceHash": "02e7b2dfcf17e7b236153aa032acf0c73d0c9f7c4bc3d2017917752143ab9218",
    "translation": "Count di time from 10 for night to 6 di next morning.",
    "role": "localized_instruction_or_meaning"
  },
  "849": {
    "sourceHash": "3c06b84d822911c103e5052122191a2de3929058c81f109b0311898a6572e593",
    "translation": "From 10 reach 12 na 2 hours, and from 12 reach 6 na 6 hours.",
    "role": "localized_instruction_or_meaning"
  },
  "850": {
    "sourceHash": "fb1ad1dd805176722154b7a58a6237914a1026822809747158f3bd87d5cd165a",
    "translation": "2 hours + 6 hours = 8 hours, so di answer na eight.",
    "role": "localized_instruction_or_meaning"
  },
  "851": {
    "sourceHash": "ce8e2cf195b989676218caa76bb2adb68a8dbff3cd87ac159e20f9c15f3c1e4b",
    "translation": "Read di passage and answer. \"Mina has a new bike. She rides it to school every day. Today it is raining, so she walks.\" Question: Why Mina dey trek today?",
    "role": "localized_instruction_or_meaning"
  },
  "852": {
    "sourceHash": "597c1c85f379fae46731603ebb11e48b9df1eb5fc076c821333a96086fd9042e",
    "translation": "Di sentence before so give di reason.",
    "role": "localized_instruction_or_meaning"
  },
  "853": {
    "sourceHash": "3138f83de9d2c4cb7ca5eaae5b91a5a6a61f1ff5231530e77473769ec39f7db0",
    "translation": "Di answer dey inside Today it is raining .",
    "role": "localized_instruction_or_meaning"
  },
  "854": {
    "sourceHash": "091357df1ba45c4c3a656a47df1889031e5b5be1aac3f9b439982a44ef49318d",
    "translation": "Mina dey trek because rain dey fall. so mean 'na im make'.",
    "role": "localized_instruction_or_meaning"
  },
  "855": {
    "sourceHash": "4409ac6d1093a7a94391a2fbbff9df45b7c6918f1adf1b82cf1b68aed426e679",
    "translation": "Read di passage and answer. \"Mina has a new bike. She rides it to school every day. Today it is raining, so she walks.\" Question: Wetin be di main topic for di passage?",
    "role": "localized_instruction_or_meaning"
  },
  "856": {
    "sourceHash": "e2c35c6336221c020e1c249856fd126f600b18978868bc8f3cf0fe7b4c5b222b",
