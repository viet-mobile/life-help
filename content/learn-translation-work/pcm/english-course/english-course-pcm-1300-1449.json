    "role": "localized_instruction_or_meaning"
  },
  "1385": {
    "sourceHash": "70e5038cc8ca2e81770b10f32531a81ec049d1c0ac28d63a63ecbe369ab61a42",
    "translation": "small ≈ little (no big)",
    "role": "localized_instruction_or_meaning"
  },
  "1386": {
    "sourceHash": "a000863510b0df8bec35d38114823fbd3b740412555ce6ec695a0550858e78e9",
    "translation": "Choose di correct answer: Which word mean di opposite of 'hot'?",
    "role": "localized_instruction_or_meaning"
  },
  "1387": {
    "sourceHash": "2211dcc93c21f437b733eb68c974dac3e3f458bd3df9eeda358699ea18b8acd1",
    "translation": "cold mean say e no warm.",
    "role": "localized_instruction_or_meaning"
  },
  "1388": {
    "sourceHash": "859f261a43a32fa28625916bda6876d0721ed9f454c77a4e08af7998d2930140",
    "translation": "hot (hot well well) ↔ cold (no warm)",
    "role": "localized_instruction_or_meaning"
  },
  "1389": {
    "sourceHash": "6b800b595f2a03c4eb97ed2649aadd87cfe2311011e3190521d10ed602cbbebb",
    "translation": "Choose di best answer for di blank: This is the town ____ I was born.",
    "role": "localized_instruction_or_meaning"
  },
  "1390": {
    "sourceHash": "6065bd8e65d4225918268d9fcfe68faecab9f962718f4a9ff347f674668ca284",
    "translation": "Di relative adverbs where (place), when (time) and why (reason) dey describe di noun before dem and work as adverbs inside di clause. whether/that dey introduce noun clauses.",
    "role": "localized_instruction_or_meaning"
  },
  "1391": {
    "sourceHash": "5e14dc2f64894cf9a1c84b9428e27b0c23c82492aec00cdd34e796e544b110a0",
    "translation": "the town na place.",
    "role": "localized_instruction_or_meaning"
  },
  "1392": {
    "sourceHash": "4c6ace5c49f71b220715ccb74fb724a596ecb9fc5d5dc69d6d5fe3d9ed2c0a62",
    "translation": "E dey show place, so use where.",
    "role": "localized_instruction_or_meaning"
  },
  "1393": {
    "sourceHash": "a42d8373603fb1b28b625c2c9c3c6f528aa9a34471721b4ac3c9d9fa4cdd1a1e",
    "translation": "Choose di best answer for di blank: I don't know ____ she will come or not.",
    "role": "localized_instruction_or_meaning"
  },
  "1394": {
    "sourceHash": "04e452cd5683627396db60573ae42f46ea5d3a02ff602466c638f53bb94c6a46",
    "translation": "When e follow 'or not', e mean 'whether something go happen or no go happen'.",
    "role": "localized_instruction_or_meaning"
  },
  "1395": {
    "sourceHash": "ac85bae2c0e25f43f8fb4b5f363c375c9c6e6a768f7085f096373d65ad18f035",
    "translation": "whether ... or not.",
    "role": "localized_instruction_or_meaning"
  },
  "1396": {
    "sourceHash": "4716a66094f57cd69dfc51dc8e5ac4e4fa1c6d90fa79703cff1aa9f6c7cd0f16",
    "translation": "Choose di sentence wey grammar no correct.",
    "role": "localized_instruction_or_meaning"
  },
  "1397": {
    "sourceHash": "104a8bc5b8d81ddea8cfb394d8ce8394e047b8f89c331f2c7bcaa4d3657c4baf",
    "translation": "Incomplete clause dey follow relative pronoun. Complete clause dey follow relative adverb.",
    "role": "localized_instruction_or_meaning"
  },
  "1398": {
    "sourceHash": "f6157fd0f83ef63a4a9ac8b20b281040776258862334957bd2123f1a619451e3",
    "translation": "I live na complete clause (e no need object).",
    "role": "localized_instruction_or_meaning"
  },
  "1399": {
    "sourceHash": "694a29f2f457f78174f4e688cd463a5429d6f7384b16d03124d25e8d3a463a12",
    "translation": "Use where (or in which) instead of which.",
    "role": "localized_instruction_or_meaning"
  },
  "1400": {
    "sourceHash": "38e04b4be5e2342254f015a99b166149121f62de31811a703cd92a50491cc1e3",
    "translation": "Choose di best answer for di blank for di conversation. A: Do you know ____ he left so early? B: He had a doctor's appointment.",
    "role": "localized_instruction_or_meaning"
  },
  "1401": {
    "sourceHash": "04b90aac4acc89fb55690c7b74deb3b45b5d821a4acb68925b3371d486834f3e",
    "translation": "B answer dey give reason.",
    "role": "localized_instruction_or_meaning"
  },
  "1402": {
    "sourceHash": "f14f4583dbdc54d0967e5f55a3bbf81577d429330a3a93cb084f755af7695793",
    "translation": "Di question word / relative adverb for reason na why.",
    "role": "localized_instruction_or_meaning"
  },
  "1403": {
    "sourceHash": "7ba5ec4f5070453b7e0bbcd8ee8ff65a6168f28b5032546248e5e0d65eca2ed6",
    "translation": "why he left so early.",
    "role": "localized_instruction_or_meaning"
  },
  "1404": {
    "sourceHash": "b9c1b52fbae727288ec28a27e411884b0af0d73a93ea1c6f57893ef5d26811e9",
    "translation": "Join di two sentences with relative adverb (one word for di blank). This is the park. We played soccer in the park. → This is the park ____ we played soccer.",
    "role": "localized_instruction_or_meaning"
  },
  "1405": {
    "sourceHash": "0b6eebc9c5fc056978bf3fd52f7f23340f8fa1a6e62c261176bce1f532288bfc",
    "translation": "in the park na adverb phrase of place, so change am to relative adverb.",
    "role": "localized_instruction_or_meaning"
  },
  "1406": {
    "sourceHash": "da6d696508b15911cc36b7d3bf614d7705b52ec4997746a53e79acc03ffd0833",
    "translation": "Na place, so use where (= in which).",
    "role": "localized_instruction_or_meaning"
  },
  "1407": {
    "sourceHash": "b9632f10764d242c1af6d30c788ba4d4a5b18cb8ec5d929de2cd8764fee39de9",
    "translation": "Choose di best answer for di blank: This is the room ____ I study.",
    "role": "localized_instruction_or_meaning"
  },
  "1408": {
    "sourceHash": "83d11304334c9001132f4e8ffd84d8f102dbe48254aadc6922624a17e1dd130d",
    "translation": "the room na place.",
    "role": "localized_instruction_or_meaning"
  },
  "1409": {
    "sourceHash": "cee893f0d7065ae0a8499421e9b6be66935bc63be6e2b950ebb805a72a2bc7bd",
    "translation": "where.",
    "role": "localized_instruction_or_meaning"
  },
  "1410": {
    "sourceHash": "a5ede93d98d3bb5dd7d2326e159caba91cea7e34bef5b4bc92ca3498d732b56b",
    "translation": "Choose di best answer for di blank: The fact ____ he lied surprised everyone.",
    "role": "localized_instruction_or_meaning"
  },
  "1411": {
    "sourceHash": "067bfedc639cca806ea8d1deee9f26d2d0baeb4080e7966dcdb0afbe25cdc497",
    "translation": "that clause after noun like fact dey explain di content of di noun. Na appositive clause.",
    "role": "localized_instruction_or_meaning"
  },
  "1412": {
    "sourceHash": "410e728b7adae8a291f05ce2754bef57025f70b78f0603c669a5f0ca5ac76c24",
    "translation": "Di clause after that complete.",
    "role": "localized_instruction_or_meaning"
  },
  "1413": {
    "sourceHash": "5794d8fe41fe494f6ef9e053234f2551fc2efa8291ccc3231953a896fe595b7d",
    "translation": "The fact that he lied ...",
    "role": "localized_instruction_or_meaning"
  },
  "1414": {
    "sourceHash": "e2e5d0c079675595f33a141bc458e5c0e3b4cf824070a2c06b82c4b3ca5af35d",
    "translation": "Choose di best answer for di blank: I remember the day ____ we first met.",
    "role": "localized_instruction_or_meaning"
  },
  "1415": {
    "sourceHash": "af5809d859577feb58e401bc2d3a69ea797dc2a43d7db437fb71386224d1e87f",
    "translation": "the day na time.",
    "role": "localized_instruction_or_meaning"
  },
  "1416": {
    "sourceHash": "1f147489094620e285913c402d663eddf8f51b77d25bd87d55e8291b7fb8b00d",
    "translation": "when.",
    "role": "localized_instruction_or_meaning"
  },
  "1417": {
    "sourceHash": "a9740a7231fe25b708ea5b30c14fbf2764b991f4b83381bc3226f599509908c1",
    "translation": "Di grammar for this sentence correct? That is the reason why he was absent.",
    "role": "localized_instruction_or_meaning"
  },
  "1418": {
    "sourceHash": "df69054d2f5a87f363a47e176e11b70abc04274d9c7554f8370a1ad0c86f973f",
    "translation": "Use why after the reason.",
    "role": "localized_instruction_or_meaning"
  },
  "1419": {
    "sourceHash": "a912b71c93a674018ac1d2bf082a0a55cf17208208209fb9a07de2306f945c8c",
    "translation": "Di sentence correct.",
    "role": "localized_instruction_or_meaning"
  },
  "1420": {
    "sourceHash": "38c597a3b0275e43195b19c33dd7bef48c4250c192f73b68a8e6ef439045be32",
    "translation": "Choose di best answer for di blank: She asked ____ I wanted some tea.",
    "role": "localized_instruction_or_meaning"
  },
  "1421": {
    "sourceHash": "8ca3f53dd8909735b577bfb5ee856ed40a7c8e6e9ac45a52e6c1b02d937c0bce",
    "translation": "Use if/whether, wey mean 'whether something happen or not'.",
    "role": "localized_instruction_or_meaning"
  },
  "1422": {
    "sourceHash": "440f263303eb5ea758983d6394f39841e553298996365c3f4ea760181e585eef",
    "translation": "asked if.",
    "role": "localized_instruction_or_meaning"
  },
  "1423": {
    "sourceHash": "d4369f497ea92cf33388cde4f582462d93dd4f944c850c2c1600398315b9ad9a",
    "translation": "Choose di best answer for di blank: I was hungry. ____, I made a sandwich.",
    "role": "localized_instruction_or_meaning"
  },
  "1424": {
    "sourceHash": "ddac5ca549d326d3f69d476e99d580b84858d5721f8f8f7d62011db4f06e8c6d",
    "translation": "Choose di linking expression wey show how di sentences connect, like however (contrast), therefore (result), for example (example) and in addition (add something).",
    "role": "localized_instruction_or_meaning"
  },
  "1425": {
    "sourceHash": "e72149f0b59fbb52559c17bb84c618ddd2490fa3fdf8de0c403613f01e804cf2",
    "translation": "Hunger na di cause, and making sandwich na di result.",
    "role": "localized_instruction_or_meaning"
  },
  "1426": {
    "sourceHash": "53dccbc9a94696f17e6d92945b259e2efb8c73fe987b5447bfa11654579c13cf",
    "translation": "So na di linking word wey introduce result.",
    "role": "localized_instruction_or_meaning"
  },
  "1427": {
    "sourceHash": "d58c4b88964043151cff8fd6840d4242ca3ad165976be0386fab8356df72ad59",
    "translation": "Choose di best answer for di blank: He studied hard. ____, he failed the exam.",
    "role": "localized_instruction_or_meaning"
  },
  "1428": {
    "sourceHash": "eb0fefd7b3b5578808fc1a27e0c4801663e8efa70da96e3865f45a3fe1307d1f",
    "translation": "E study hard, but di result no be wetin e expect.",
    "role": "localized_instruction_or_meaning"
  },
  "1429": {
    "sourceHash": "70d4e9f99bf48178b7f6ee1c4bcd7c54fc9c22b32f8ed281faf19103ceee93e2",
    "translation": "However dey show contrast.",
    "role": "localized_instruction_or_meaning"
  },
  "1430": {
    "sourceHash": "75a7da35b6583c9e1d59b2146bd6a389d70a0f0fed89dff59a13f1d802199a7a",
    "translation": "Choose di best answer for di blank: Many animals sleep a lot. ____, koalas sleep up to 20 hours a day.",
    "role": "localized_instruction_or_meaning"
  },
  "1431": {
    "sourceHash": "12b68ca924a429657a49183e9cc8ed782817d039498f6450abbbd1320eaa1b8f",
    "translation": "Check whether di second sentence na specific example of di first one.",
    "role": "localized_instruction_or_meaning"
  },
  "1432": {
    "sourceHash": "3e7a72fe28297c8afc9b8b6b8fcb1deee15851f98b2102e0092762bdd68143d6",
    "translation": "Koalas na example of 'animals wey dey sleep plenty'.",
    "role": "localized_instruction_or_meaning"
  },
  "1433": {
    "sourceHash": "4de7546a4190880cecd81e71343f92c8cb6858dc44587de43903b6d999881907",
    "translation": "Choose di best answer for di blank: Online classes are convenient. ____, some students find it hard to stay focused.",
    "role": "localized_instruction_or_meaning"
  },
  "1434": {
    "sourceHash": "bfeddb7d4375b4ccb36e83cc205d60ff94dc69107340424552a6c404cd187457",
    "translation": "Disadvantage dey come after advantage.",
    "role": "localized_instruction_or_meaning"
  },
  "1435": {
    "sourceHash": "3fe2da6e0905d0cf5144b6e60e3c7916311fd58a9176feb52ebacd617a191e25",
    "translation": "However na linking word for contrast.",
    "role": "localized_instruction_or_meaning"
  },
  "1436": {
    "sourceHash": "802efed0a96eb40d358fbda53e189dde2cd0ab9b4e5147bd4609eedc36eb21bc",
    "translation": "Read di passage and answer. \"Plastic bags are cheap and light. ____ they harm sea animals. ____ many cities now ban them.\" Question: Which pair fit di blanks for correct order?",
    "role": "localized_instruction_or_meaning"
  },
  "1437": {
    "sourceHash": "ebbaae157f141a09d3c63a4f1526dc988be954e3738d97c4eb0e1849f4ca6012",
    "translation": "For each blank, check how di sentence before and after am connect (contrast or result).",
    "role": "localized_instruction_or_meaning"
  },
  "1438": {
    "sourceHash": "d844cae4063a861debb70bf746e5b766436032fd01765ae2f2a1ca5b1d738605",
    "translation": "① cheap ↔ dey cause harm (contrast) ② dey cause harm → dem ban am (result)",
    "role": "localized_instruction_or_meaning"
  },
  "1439": {
    "sourceHash": "dca1989b38b095c68fe2be96d5fd8b41835a2df2de4f34ebc6d19432c7e5e61c",
    "translation": "Choose di best answer for di blank: I'm tired. ____, I will go to bed early.",
    "role": "localized_instruction_or_meaning"
  },
  "1440": {
    "sourceHash": "ebfc5a4f4a795d7da19c02c275afa7a78538ae6b8f3175e398ae591081a0d933",
    "translation": "E mean say I go sleep early because I don tire.",
    "role": "localized_instruction_or_meaning"
  },
  "1441": {
    "sourceHash": "12984637383b7b9cafd5ff2b61cb567addb6b6a8123c85ec0000efeacebc0082",
    "translation": "So.",
    "role": "localized_instruction_or_meaning"
  },
  "1442": {
    "sourceHash": "67538ca5bb24a34ee980697e7b84ae2a02166949984218fd0c1641e8935c6d8d",
    "translation": "Choose di best answer for di blank: The shop looked cheap. ____, the quality was excellent.",
    "role": "localized_instruction_or_meaning"
  },
  "1443": {
    "sourceHash": "a855653dd471eed49b603f2ab94e689831dfc2f6ce87e13e346a2d442ca1f5c1",
    "translation": "To look cheap and to get excellent quality dey contrast.",
    "role": "localized_instruction_or_meaning"
  },
  "1444": {
    "sourceHash": "1113f7e4230150176a63ac7b2eba8c3eac1cbf1f7e76a89db6a854663801fca9",
    "translation": "However.",
    "role": "localized_instruction_or_meaning"
  },
  "1445": {
    "sourceHash": "e6402a4fc1c93572466b2a3df6b1e00550a913ce1f356949314f52e68b70cc2e",
    "translation": "Choose di best answer for di blank: It was raining. ____, we stayed inside.",
    "role": "localized_instruction_or_meaning"
  },
  "1446": {
    "sourceHash": "9567ead8846a4e50dadaf7268c27f7809534bb2d9c532f737852601c74768ce8",
    "translation": "Rain dey fall, so we stay inside.",
    "role": "localized_instruction_or_meaning"
  },
  "1447": {
    "sourceHash": "c5aa591e7687a00d3ab2edcfe5db8130c2d1c9cba3ec1f894214bf5c5ce4e71f",
    "translation": "Choose di best answer for di blank: She is smart. ____, she is very kind.",
    "role": "localized_instruction_or_meaning"
  },
  "1448": {
    "sourceHash": "ca0d01f81e0982f08f4ccfe32f5fd725535c7450279a0ec4a182fb77b6de8cee",
    "translation": "E dey add another good point.",
    "role": "localized_instruction_or_meaning"
  },
  "1449": {
    "sourceHash": "75cccb2145f2f55d4eeefe14e1cfb190e24821d0c114576d50b4b8dc9be5c5d5",
    "translation": "In addition.",
    "role": "localized_instruction_or_meaning"
  }
}
