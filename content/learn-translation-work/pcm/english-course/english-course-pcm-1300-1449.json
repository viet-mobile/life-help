{
  "1300": {
    "sourceHash": "cbaa50c76f2b0d952a63cf6881d4f2d6b9fec4197465a0c25946c014aa1c7f27",
    "translation": "Choose di word wey fit di blank: He ____ breakfast every day.",
    "role": "localized_instruction_or_meaning"
  },
  "1301": {
    "sourceHash": "0e99b0606a37838ae1d748bbe6d2cc3db655837239cb79726fc606dc73366374",
    "translation": "every day dey show habit.",
    "role": "localized_instruction_or_meaning"
  },
  "1302": {
    "sourceHash": "f2e81dfc9c35134f532fe5493c6915e2702f577863705b364675bdba212ff9d5",
    "translation": "Di subject na He, so add -s.",
    "role": "localized_instruction_or_meaning"
  },
  "1303": {
    "sourceHash": "64437024bd57a37fcd98aac82bb6e2c9ac7fb963da2331dd0229ddb91b811af5",
    "translation": "He eats breakfast every day. = E dey eat morning food every day.",
    "role": "localized_instruction_or_meaning"
  },
  "1304": {
    "sourceHash": "7071f88500583f63680adc3702e5967fd4c509ebcff9d97cf4603b674ef1ab4a",
    "translation": "Choose di word wey fit di blank: Be quiet! My father ____ .",
    "role": "localized_instruction_or_meaning"
  },
  "1305": {
    "sourceHash": "a6d56ced965bbe78254f7990440a28cf9ce6e6619c050707bf60276b3231b16e",
    "translation": "E dey happen now now.",
    "role": "localized_instruction_or_meaning"
  },
  "1306": {
    "sourceHash": "66b0552e935a640421f1034d7ddedd24752d06d9bed4cc35b19a8b484dac36a9",
    "translation": "My father is working. = My papa dey work now.",
    "role": "localized_instruction_or_meaning"
  },
  "1307": {
    "sourceHash": "7cea551df108f852a9c4125e5370884f94636994c8d0a5351af4b737add7ce40",
    "translation": "Choose di word wey fit di blank: We ____ to the museum yesterday.",
    "role": "localized_instruction_or_meaning"
  },
  "1308": {
    "sourceHash": "da2c4daed68cdc6af16548403546e640dc16701420d7ab0886830aae56af23df",
    "translation": "yesterday dey for past.",
    "role": "localized_instruction_or_meaning"
  },
  "1309": {
    "sourceHash": "0c990870a0a398c1dc0f1a95f60fa8ba1ee34267cb33ac422c92ed85d9fc381c",
    "translation": "Di past form of go na went.",
    "role": "localized_instruction_or_meaning"
  },
  "1310": {
    "sourceHash": "2e891e9bfc94f1b0bdfb4bdddbc82fbb143e98750f1295770a66d3b46b732436",
    "translation": "We went to the museum. = We go visit museum.",
    "role": "localized_instruction_or_meaning"
  },
  "1311": {
    "sourceHash": "9c155b69d2622261da27f722f06fe25e3da696ce9435706ce88322525e7cef4a",
    "translation": "last night dey show di tense.",
    "role": "localized_instruction_or_meaning"
  },
  "1312": {
    "sourceHash": "6330a13c2a372640b0436d79e65d3131400c7929d8b1250fcb3e4854cbf80613",
    "translation": "Check whether di verb form match di time expression.",
    "role": "localized_instruction_or_meaning"
  },
  "1313": {
    "sourceHash": "7e311f0d6928cf67cbdf95183833bd190b7ca957f116bc8a2d684c98fbf1be15",
    "translation": "last night dey for past, so di sentence suppose be I watched TV last night.",
    "role": "localized_instruction_or_meaning"
  },
  "1314": {
    "sourceHash": "480fa03a1ba4873c09d6c1d324431109e88ba1133447390bd71e3c31aa575695",
    "translation": "Choose di words wey fit di blanks for di conversation. A: What did you do last night? B: I ____ my homework. A: What are you doing now? B: I ____ a book.",
    "role": "localized_instruction_or_meaning"
  },
  "1315": {
    "sourceHash": "2a2bc18ee22b2aef4851e3dc0ce7d65bb6d37f7c16755b9f4fa8be51c902fff7",
    "translation": "Di first question na about last night (past). Di second na about now (present continuous).",
    "role": "localized_instruction_or_meaning"
  },
  "1316": {
    "sourceHash": "c745e060753e66df09ff955754b648f11d5cdac4bc74321c62a27d3535ae5cea",
    "translation": "With now, use am / is / are + -ing.",
    "role": "localized_instruction_or_meaning"
  },
  "1317": {
    "sourceHash": "ab701e98ecb4402b5ebbdd674fea3c59ca7ba90a57188c31db83cebdb5088770",
    "translation": "Wetin B do last night na did, and wetin B dey do now na am reading.",
    "role": "localized_instruction_or_meaning"
  },
  "1318": {
    "sourceHash": "8fcd0cf76a781a59213833140c828d01968fba4380c499311207b5d251841357",
    "translation": "Which sentence show strong duty, meaning say you must do am?",
    "role": "localized_instruction_or_meaning"
  },
  "1319": {
    "sourceHash": "7b5adcc1b5449ff8c5475a6ac84176a4a79248325e2b94b087c67ac694de2b29",
    "translation": "Use must for things wey you really have to do.",
    "role": "localized_instruction_or_meaning"
  },
  "1320": {
    "sourceHash": "756e781fb7392755e30b41edefe9607587917a0e1f51db9e4f146ad42c216601",
    "translation": "may and can dey show permission or ability.",
    "role": "localized_instruction_or_meaning"
  },
  "1321": {
    "sourceHash": "bdc582868d9120a6b437e59fe48a29886babd27dddd5968df0ff0cd23658a666",
    "translation": "must mean say you really have to do am.",
    "role": "localized_instruction_or_meaning"
  },
  "1322": {
    "sourceHash": "6a4b94562d34326a78ed7d925deffe617bd2d06fd4f1bd08baaea95a20eacdcf",
    "translation": "Choose di word wey fit di blank for di conversation. A: I have a headache. B: You ____ see a doctor.",
    "role": "localized_instruction_or_meaning"
  },
  "1323": {
    "sourceHash": "f4912d8f3ef36a849b6a9dc99f8e58b8a8d2a53caa4861278242d0900d450f9f",
    "translation": "B dey give A advice.",
    "role": "localized_instruction_or_meaning"
  },
  "1324": {
    "sourceHash": "68e46207b2148cb6ab7d43cade1cb9154463f00d698fd2f091c4a2fa5b3dc109",
    "translation": "Choose di word wey mean say e good make you do am.",
    "role": "localized_instruction_or_meaning"
  },
  "1325": {
    "sourceHash": "3ac17a8f4580da6e0cc78ee08390e77c2dabeee9feb2fc6212d697c17ba1f981",
    "translation": "To give advice, use should (e good make you do am).",
    "role": "localized_instruction_or_meaning"
  },
  "1326": {
    "sourceHash": "7f2a216afa4450c4f4dcfcfb9b2a980bbc2a62da869051b046503f8291757f79",
    "translation": "Read di passage and answer. \"It was a very tiny puppy. I could hold it in one hand.\" Question: Wetin \"tiny\" mean?",
    "role": "localized_instruction_or_meaning"
  },
  "1327": {
    "sourceHash": "6eb31a00998ba886be4481af65b1a12b3343b0d77cd79735afe787ce1b3ed402",
    "translation": "You fit hold am with one hand. Use that one reason di size.",
    "role": "localized_instruction_or_meaning"
  },
  "1328": {
    "sourceHash": "27fc528394de4cb6099788d27fe409384395f65f4f18802b7f6fcfff0cf86cd1",
    "translation": "Na word for something wey small well well.",
    "role": "localized_instruction_or_meaning"
  },
  "1329": {
    "sourceHash": "990ac30683f3af93811f4e5e97ff880fa9c1cf0b94fdfca7917916e3a0cc2d3b",
    "translation": "E small reach to hold with one hand, so tiny mean small well well.",
    "role": "localized_instruction_or_meaning"
  },
  "1330": {
    "sourceHash": "a70c33f21b8629acdde063185a794d4495b1584ccaaf0b4f66625ccd1fbe901b",
    "translation": "Choose di word wey get different meaning.",
    "role": "localized_instruction_or_meaning"
  },
  "1331": {
    "sourceHash": "9d779a2cc52fab44a4d936f51f3cccba1f3e9c2be88c4bbb0ac53dbc5c860e58",
    "translation": "Three of di words mean say person dey happy.",
    "role": "localized_instruction_or_meaning"
  },
  "1332": {
    "sourceHash": "fa41a16acb2ea3cc37e33b40e2407544737222f4cad11331a3af55fd8821e07d",
    "translation": "Think about wetin angry mean.",
    "role": "localized_instruction_or_meaning"
  },
  "1333": {
    "sourceHash": "663f8936dd64d5774212813688b885046d6235afc1281c76b3e72cd6244fc9ee",
    "translation": "happy, glad, joyful all mean say person dey happy, but angry mean say person dey vex.",
    "role": "localized_instruction_or_meaning"
  },
  "1334": {
    "sourceHash": "10252e6e28c2902d274bc4b0c7aad9e787e233277e79442a8416003055e3d23b",
    "translation": "Choose di word wey fit di blank: I wanted to go out, ____ it was raining heavily.",
    "role": "localized_instruction_or_meaning"
  },
  "1335": {
    "sourceHash": "0c9e02357bd49dafe2453c96644418a49c13829eab844f250a72590ded6d788e",
    "translation": "Check whether di two ideas contrast.",
    "role": "localized_instruction_or_meaning"
  },
  "1336": {
    "sourceHash": "52f52db486472eefea6816ba8e65b5e7f8d67e32e4add9193be1b532c5604715",
    "translation": "I want go outside, but heavy rain dey fall.",
    "role": "localized_instruction_or_meaning"
  },
  "1337": {
    "sourceHash": "1a2e140f02f777cfb37fc4251536623f1770ed2be314f5affabcfca5a689c187",
    "translation": "Di two ideas contrast, so use but, wey mean 'but even so'.",
    "role": "localized_instruction_or_meaning"
  },
  "1338": {
    "sourceHash": "12bed2a3d08b60976f05720e52d4fd7138369a907cbc565ee2d5d6e40aab7389",
    "translation": "Which one correctly join di two sentences 'It was cold. I wore a coat.'?",
    "role": "localized_instruction_or_meaning"
  },
  "1339": {
    "sourceHash": "8f18759335800232bc0197f17af13dcc687613d62366b38da4c78a8f106c1420",
    "translation": "Cold na di reason why di person wear coat.",
    "role": "localized_instruction_or_meaning"
  },
  "1340": {
    "sourceHash": "d725ec3b7373c3e5c526400d8e15a395f85ff576abc916f6ff1ee3844a8fcc0a",
    "translation": "Di word wey join cause to result na so.",
    "role": "localized_instruction_or_meaning"
  },
  "1341": {
    "sourceHash": "41167a136729686cede67f7081603a2abb0e2f6acb27081483bd0b8734a63fa0",
    "translation": "Cold dey (cause), na im make I wear coat (result). Na im make we use so.",
    "role": "localized_instruction_or_meaning"
  },
  "1342": {
    "sourceHash": "c5cd71c9ec969a74ed88e59dbb4da16e7abb2946a30721efe909cd2d3eeee568",
    "translation": "Read di passage and answer. \"Last week, Jiho joined a school cooking club. At first, he burned the eggs and the kitchen smelled bad. But he did not give up. After two weeks of practice, he made a perfect omelet for his family.\" Question: Wetin we fit learn from di story?",
    "role": "localized_instruction_or_meaning"
  },
  "1343": {
    "sourceHash": "aa06b8b79baa83d16359800d6355cbd502c5be9df21477d790081bec4d2595db",
    "translation": "Compare Jiho for di beginning and for di end.",
    "role": "localized_instruction_or_meaning"
  },
  "1344": {
    "sourceHash": "08ca3bf6068cd10649a64a284b20ede9fa8f9e016885d6f514c74305ddb59d18",
    "translation": "But he did not give up. na di key sentence.",
    "role": "localized_instruction_or_meaning"
  },
  "1345": {
    "sourceHash": "be5569fd3f451111493a6eb37b4aa7c3a5662b9efa0816717a0fbf932cab407d",
    "translation": "Jiho fail for di beginning but no give up. Jiho practise and do well. Practice dey help person improve.",
    "role": "localized_instruction_or_meaning"
  },
  "1346": {
    "sourceHash": "97736ab4786806c0dad558ae1296966d62316c907ed2461957dc742799ce9062",
    "translation": "Read di passage and answer. \"Last week, Jiho joined a school cooking club. At first, he burned the eggs and the kitchen smelled bad. But he did not give up. After two weeks of practice, he made a perfect omelet for his family.\" Question: Which word best describe Jiho?",
    "role": "localized_instruction_or_meaning"
  },
  "1347": {
    "sourceHash": "1755f1e88b1f5480b5605b1541ed2da05a159994750e4bf5b3d3719469e3d0c2",
    "translation": "Look wetin Jiho do after e fail.",
    "role": "localized_instruction_or_meaning"
  },
  "1348": {
    "sourceHash": "bc7c0af57aa7a5f743a746e78292a74a16e9bcfde48bc7a3a021f93edf1edf4f",
    "translation": "Na word for person wey no dey give up.",
    "role": "localized_instruction_or_meaning"
  },
  "1349": {
    "sourceHash": "9be0f370d808bc5f15450a0a9778fece6ffdbe34a31e69fff0d539174d420102",
    "translation": "Jiho no give up and continue to practise, so determined (person wey no dey give up) fit best.",
    "role": "localized_instruction_or_meaning"
  },
  "1350": {
    "sourceHash": "deadd12570f8b8f60eadbc0e1de62c9c76a4ac462a8581b6dae97c2d10fe82db",
