{
  "1000": {
    "sourceHash": "c1c049f493868713dd9f99fd3f8f78412e2083aba21581bae9e71ca9e6b9e8d9",
    "translation": "doesn't don already show third person singular, so use di base verb like.",
    "role": "localized_instruction_or_meaning"
  },
  "1001": {
    "sourceHash": "39bc4c8a45ac4489b619db5b3db15098cdf1bbf9c031a10034f6ec7d28acba2c",
    "translation": "Choose di word wey fit di blank for di conversation. A: ____ he play the guitar? B: Yes, he does.",
    "role": "localized_instruction_or_meaning"
  },
  "1002": {
    "sourceHash": "b75c1fba2ad5c7728accaf8342dc6c62504d4a2bd11758a945428d3e48bf9fe6",
    "translation": "Use does for B answer as clue.",
    "role": "localized_instruction_or_meaning"
  },
  "1003": {
    "sourceHash": "145c5714e21873d323f246d777d55a4c65d1abac53842c844a937ab1357601bc",
    "translation": "When di subject na he, start di question with Does.",
    "role": "localized_instruction_or_meaning"
  },
  "1004": {
    "sourceHash": "2d301824e6b20a543ae022d096675c4a737b3e1d2e2646e629f27c205abb7b8b",
    "translation": "Di answer na Yes, he does. so di question na Does he play ...?",
    "role": "localized_instruction_or_meaning"
  },
  "1005": {
    "sourceHash": "024c9996cd766c671d6e155830102d32da8756391bf791557798279dfd16fa38",
    "translation": "Choose di word wey fit di blank: The elephant is big, but the mouse is ____ .",
    "role": "localized_instruction_or_meaning"
  },
  "1006": {
    "sourceHash": "64769cef5d45ebb7528b87b9d04f6604c158f775af5df425b54e5cb4a75966b9",
    "translation": "but dey join two opposite ideas.",
    "role": "localized_instruction_or_meaning"
  },
  "1007": {
    "sourceHash": "419dfa78ae955521434976fa3e1788b010700bafc16a280eb760d98db626a7aa",
    "translation": "Think about di opposite of big.",
    "role": "localized_instruction_or_meaning"
  },
  "1008": {
    "sourceHash": "425c9ba57fbef22c7e9850986bf50dce6fb7907cc5e262b7a0d22423d555c401",
    "translation": "small, di opposite of big, dey come after but.",
    "role": "localized_instruction_or_meaning"
  },
  "1009": {
    "sourceHash": "b19366b949dd0403c7d80022882c91cc39f4b8277e0ffd9355fabfcf1fd730b2",
    "translation": "Which pair no get opposite meanings?",
    "role": "localized_instruction_or_meaning"
  },
  "1010": {
    "sourceHash": "e7568e7a4e9f2b85386921ef0ebf936ccd57eedf803139865e002585eac10924",
    "translation": "Check each pair: di two meanings really opposite?",
    "role": "localized_instruction_or_meaning"
  },
  "1011": {
    "sourceHash": "f71c5c0e7a54712900fc6143ed1777b1048ec01676b3321954723328cdd8632f",
    "translation": "Di opposite of happy na sad.",
    "role": "localized_instruction_or_meaning"
  },
  "1012": {
    "sourceHash": "cc5f7e167fbd9dce1a24119c9f0d2fb3508044de9b6e973e9510db5b8a32665e",
    "translation": "happy (dey happy) and tall (body tall) no be opposites.",
    "role": "localized_instruction_or_meaning"
  },
  "1013": {
    "sourceHash": "be668fc595376ceecb6079047f771837404e79197fda9fe06d95e51b8a5a9d97",
    "translation": "Read di passage and answer. \"The ball is in the box. The box is under the bed.\" Question: Where di ball dey?",
    "role": "localized_instruction_or_meaning"
  },
  "1014": {
    "sourceHash": "3a4166c87e62d48f61e9cea958a107bb54d7f21aaa842a3df918a02d9c87b8d8",
    "translation": "Find where di ball dey, then find where di box dey.",
    "role": "localized_instruction_or_meaning"
  },
  "1015": {
    "sourceHash": "79b7289e433ecbe52f69d715b210c172c8d18c67ec9a3a72f146868be6545a65",
    "translation": "Di ball dey inside box, and di box dey under bed.",
    "role": "localized_instruction_or_meaning"
  },
  "1016": {
    "sourceHash": "0f9e1262af97f9f870b312fef7643888cce4d2bfccb1442519719730dfe9db20",
    "translation": "Di ball dey inside box and di box dey under bed, so di ball too dey under bed.",
    "role": "localized_instruction_or_meaning"
  },
  "1017": {
    "sourceHash": "c37435a22a9f8fc0b1660912831a28e92848f762a4cbf51fa25170ec84616529",
    "translation": "Read di passage and answer. \"The book is on the desk. The pen is under the desk.\" Question: Which sentence correct according to di passage?",
    "role": "localized_instruction_or_meaning"
  },
  "1018": {
    "sourceHash": "1c1c5b4c42104e4d361aaf60c57813445be9ece5f78b2f07a8db78a795e5fd5a",
    "translation": "Know di difference between on and under.",
    "role": "localized_instruction_or_meaning"
  },
  "1019": {
    "sourceHash": "2ead88b8b40e9988681f6fd91a5dc4cd40207e090167256eb358b08466c5face",
    "translation": "Find where di pen dey inside di passage.",
    "role": "localized_instruction_or_meaning"
  },
  "1020": {
    "sourceHash": "283f4b87ae228beb2d35ad29a0364a235c1c4f0a0ac349f07be0c4958bc45d84",
    "translation": "Di passage talk say The pen is under the desk.",
    "role": "localized_instruction_or_meaning"
  },
  "1021": {
    "sourceHash": "d13eda73de842063740d8b9d95832f2d88cf0856e5f58604e620e30e8e2b7d59",
    "translation": "Read di passage and answer. \"Tom is hungry. He opens the refrigerator, but it is empty. So he goes to the store and buys bread and milk.\" Question: Why Tom go shop?",
    "role": "localized_instruction_or_meaning"
  },
  "1022": {
    "sourceHash": "175ae68b81a5c318b865f8b11b84fb7368fff79c142ef39e81850b822ee88c0c",
    "translation": "Di reason dey between but and So.",
    "role": "localized_instruction_or_meaning"
  },
  "1023": {
    "sourceHash": "ad2705359eaed653a14096e5183f8b1182514521a91c91d6dde711c23ed57ec5",
    "translation": "Check di condition of di fridge.",
    "role": "localized_instruction_or_meaning"
  },
  "1024": {
    "sourceHash": "0747184f1818e27a52ec6a747f34e32f4c0e4a9e4ee82147f1fd06e2159a2ebd",
    "translation": "Tom go shop because di fridge empty. So mean 'na im make'.",
    "role": "localized_instruction_or_meaning"
  },
  "1025": {
    "sourceHash": "3745bdf5d3436edc3d118949c348446551c4f1d65ded20e7f1c3223e063c5038",
    "translation": "Read di passage and answer. \"Tom is hungry. He opens the refrigerator, but it is empty. So he goes to the store and buys bread and milk.\" Question: Which thing happen first?",
    "role": "localized_instruction_or_meaning"
  },
  "1026": {
    "sourceHash": "e8facaa2ff5989db55016aa5791bd029804e0d5d58cec514de0d7643b8bf760c",
    "translation": "Arrange di events according to how dem happen.",
    "role": "localized_instruction_or_meaning"
  },
  "1027": {
    "sourceHash": "909cca11471269a18e44df18db6d80f863833cd657db800b5f71b693710091bb",
    "translation": "First, hunger dey catch Tom.",
    "role": "localized_instruction_or_meaning"
  },
  "1028": {
    "sourceHash": "46023c1e8c097f724e76c1e36213caf11c258c86f0779e0b0dd4c1b15ed5425d",
    "translation": "Hunger dey catch Tom, so Tom open (opens) di fridge. Di fridge empty, so Tom go shop buy bread and milk.",
    "role": "localized_instruction_or_meaning"
  },
  "1029": {
    "sourceHash": "8644f696dfd62bd6404658bd4657afb630b9b8fe8c5964c994533a119b708cbb",
    "translation": "Choose di word wey fit di blank: Tom is ____ than Ben.",
    "role": "localized_instruction_or_meaning"
  },
  "1030": {
    "sourceHash": "9ad3b500bbda7727fc9279e81a3dce70eabe01b245f90d13181cc70f09257d0d",
    "translation": "To compare two people, add -er.",
    "role": "localized_instruction_or_meaning"
  },
  "1031": {
    "sourceHash": "6c9bbffccd885d93a0293dbafdb7275c07c7a38e9419aa14d1b8a33f9a9f4c1e",
    "translation": "than mean 'if you compare am with'.",
    "role": "localized_instruction_or_meaning"
  },
  "1032": {
    "sourceHash": "8c82beefb9a2a7eceb2398f72a1bacc3fb7b899cd27c80cf02eb54285457e53d",
    "translation": "Tom is taller than Ben. = Tom tall pass Ben.",
    "role": "localized_instruction_or_meaning"
  },
  "1033": {
    "sourceHash": "3a570a579c0e3087ea052f13d7d95f408b6bb85a72d28daf30abe73c4c6389ca",
    "translation": "Choose di word wey fit di blank: This bag is ____ than that one. (E heavy pass di other one.)",
    "role": "localized_instruction_or_meaning"
  },
  "1034": {
    "sourceHash": "30c577c242c322df7e96354c44aa20622b66344000575788518563fac867a783",
    "translation": "If word end with y, change y to i and add -er.",
    "role": "localized_instruction_or_meaning"
  },
  "1035": {
    "sourceHash": "68b49d1f37dd993f290a2b51a73d6e41e42d9026634c6bf19a646585b919aae6",
    "translation": "heavy → heavier",
    "role": "localized_instruction_or_meaning"
  },
  "1036": {
    "sourceHash": "c86214d5030e2c09b7d0eca475cbc2363bc8422c50e5e0b02d8eab688a4fb797",
    "translation": "This bag is heavier. = This bag heavy pass di other one.",
    "role": "localized_instruction_or_meaning"
  },
  "1037": {
    "sourceHash": "5e4ad94198b6fa04fa3eb1677735bf02a0feb1496277c15da435b5161107d808",
    "translation": "Choose di word wey fit di blank: Mt. Everest is the ____ mountain in the world.",
    "role": "localized_instruction_or_meaning"
  },
  "1038": {
    "sourceHash": "4d92f74df59c062cbe96fb47d27ea86bd7bdf33c10e3ef2112e623082d5efcbb",
    "translation": "'the ... in the world' show di one wey get di quality pass all others.",
    "role": "localized_instruction_or_meaning"
  },
  "1039": {
    "sourceHash": "7b248d96cdfb42efaada6add4fdbad3173837e1f210d12ce9574475735269d3e",
    "translation": "Add -est.",
    "role": "localized_instruction_or_meaning"
  },
  "1040": {
    "sourceHash": "99cdd41e16dbc0c1233e59fca0f6e025927b546018134562826de888aacd9aa7",
    "translation": "the highest mountain = no mountain high pass am",
    "role": "localized_instruction_or_meaning"
  },
  "1041": {
    "sourceHash": "8c54abfed987d5a46b935cc7af68e3959304b230742c1d4bbe981be68d933c98",
    "translation": "Choose di word wey fit di blank: This book is ____ interesting than that book.",
    "role": "localized_instruction_or_meaning"
  },
  "1042": {
    "sourceHash": "3978e18888b1ca1342d23730bb7c29d879fc162aa5d153a6608e8c4048ed0980",
    "translation": "For long words, put more before di word instead of adding -er.",
    "role": "localized_instruction_or_meaning"
  },
  "1043": {
    "sourceHash": "3b06d40cfcfec30efd4c49abc7071601ad7ad3470da2daff5b200ae86b480ab0",
    "translation": "more ... than = di quality plenty pass di other one",
    "role": "localized_instruction_or_meaning"
  },
  "1044": {
    "sourceHash": "3843ba9bd648715a20aa36a9539cbf9ec93a48fcba3a8df61511f9a72095e65b",
    "translation": "more interesting than = interesting pass di other one",
    "role": "localized_instruction_or_meaning"
  },
  "1045": {
    "sourceHash": "b3481b22f3102d7bda96bacab8697edb39335f17f11be9a81639d57525af4faa",
    "translation": "Tap di words for correct order to make sentence. (Meaning: My dog big pass your cat.)",
    "role": "localized_instruction_or_meaning"
  },
  "1046": {
    "sourceHash": "7a2cf2c43d65180177787c0ba89c503d9f96afc9ff2a18087d5bce9d95bb7fa0",
    "translation": "bigger than mean 'big pass'.",
    "role": "localized_instruction_or_meaning"
  },
  "1047": {
    "sourceHash": "819c64edec74b0a6943992e656577409af7fab6346aafd511d15ee095c5ed747",
    "translation": "My dog is bigger than your cat. = My dog big pass your cat.",
    "role": "localized_instruction_or_meaning"
  },
  "1048": {
    "sourceHash": "dc827199158fdb6171682720cc1c3a304a12bcae71ac35b0b91bff2737c03879",
    "translation": "Choose di word wey fit di blank: My brother is ____ than me.",
    "role": "localized_instruction_or_meaning"
  },
  "1049": {
    "sourceHash": "19fedbda9964caef37237f07a4a0d87d7e041dfe0ad90e84af3bc640c7a2e444",
    "translation": "My brother is older than me. = My broda senior me.",
    "role": "localized_instruction_or_meaning"
  },
  "1050": {
    "sourceHash": "6fe527c9182d8b69f2d65ce76c0e6424b40bb8bf2e43897d64786e8fcf72b336",
    "translation": "Choose di word wey fit di blank: A rabbit is ____ than a turtle.",
    "role": "localized_instruction_or_meaning"
  },
  "1051": {
    "sourceHash": "ba36dc6590229dcd71bbeb937dc85b44882cbb176c5ac88f6f8490c747b20812",
    "translation": "To compare two animals, add -er.",
    "role": "localized_instruction_or_meaning"
  },
  "1052": {
    "sourceHash": "312195f87158a3721191ed318e4f19f4b04b9e3d1dc4562902a34fd0ec5b3893",
    "translation": "A rabbit is faster. = Rabbit dey move fast pass turtle.",
    "role": "localized_instruction_or_meaning"
  },
  "1053": {
    "sourceHash": "2a81151c98d6af111061c9cce5954ee48e9e14650ada6458bdb42c1be11ddab5",
    "translation": "Choose di word wey fit di blank: She is the ____ student in my class.",
    "role": "localized_instruction_or_meaning"
  },
  "1054": {
    "sourceHash": "a3be4e5c6c88be23f0e3d47285b69ced40c5ca85ab02920a5b072dd7261ec56d",
    "translation": "'the ... in my class' show di one wey get di quality pass all di others for my class.",
    "role": "localized_instruction_or_meaning"
  },
  "1055": {
    "sourceHash": "98197560ca90d0b55ce58ebda1013985e186600aebc0bda6c14dc2cdd2a00ad9",
    "translation": "the smartest student = no student smart pass am",
    "role": "localized_instruction_or_meaning"
  },
  "1056": {
    "sourceHash": "b40d0fb22944172d971ef6dde45f7605147f65a2392166ad4edbe0e7f398546c",
    "translation": "Choose di word wey fit di blank: I am ____ to visit Jeju tomorrow.",
    "role": "localized_instruction_or_meaning"
  },
  "1057": {
    "sourceHash": "d446b759271ea55a54c74ec51aaf46d5051c4d95304b379d086c31d005f66a2f",
    "translation": "be going to + base verb mean 'plan to do something'.",
    "role": "localized_instruction_or_meaning"
  },
  "1058": {
    "sourceHash": "d1f29cd80e57b67ccf49ceeed927b45da89241c193e9bd26dc8ca7967187f5b7",
    "translation": "After am, use going.",
    "role": "localized_instruction_or_meaning"
  },
  "1059": {
    "sourceHash": "b3687957490828729237fe2651e8f777900d6173f0fea261f40f08547e4e39b0",
    "translation": "I am going to visit Jeju. = I plan to visit Jeju.",
    "role": "localized_instruction_or_meaning"
  },
  "1060": {
    "sourceHash": "f13bde03374dc509325d1b9fe860e545a10448eb5d7c83743c64ee26c9f09dc3",
    "translation": "Choose di word wey fit di blank: It will ____ tomorrow.",
    "role": "localized_instruction_or_meaning"
  },
  "1061": {
    "sourceHash": "05fa0ba869797fb8ee0fb23dd7130b726bb2daef15fa677807a28b1cff463663",
    "translation": "After will, use di base form of di verb.",
    "role": "localized_instruction_or_meaning"
  },
  "1062": {
    "sourceHash": "2db0009fddd484aa71f3c72f46892a9257e62b97826f289d82b30f86d20172e4",
    "translation": "No add -s or -ed.",
    "role": "localized_instruction_or_meaning"
  },
  "1063": {
    "sourceHash": "63087c809ae3b383b92f16aac0b84dc390d3395fb7c61fc58e1071b9622a3df0",
    "translation": "It will rain tomorrow. = Rain go fall tomorrow.",
    "role": "localized_instruction_or_meaning"
  },
  "1064": {
    "sourceHash": "0fc858d55208a298778ca32eee0895f82edc23b86678c0aad156ccf65f8f242a",
    "translation": "Write di word wey fit di blank: Next Sunday, we ____ go camping. (future)",
    "role": "localized_instruction_or_meaning"
  },
  "1065": {
    "sourceHash": "06482e30108a4fbb2bc33ec4a13944c7b03154fc350dea50463dd0ccabd27f4c",
    "translation": "This word dey talk about future.",
    "role": "localized_instruction_or_meaning"
  },
  "1066": {
    "sourceHash": "f603332b4e2940fd985c6dcc24f27378631004a361de955e1d348ff3d9bf3636",
    "translation": "We will go camping. = We go go camping.",
    "role": "localized_instruction_or_meaning"
  },
  "1067": {
    "sourceHash": "341082bd90c72eaef87fef45d91299fe90809cb00e7f13b4840f3d8902781489",
    "translation": "Tap di words for correct order to make sentence. (Meaning: E plan to learn English.)",
    "role": "localized_instruction_or_meaning"
  },
  "1068": {
    "sourceHash": "7ada7769447d92c2da81701f21bf89f78b51918a2b80c1355ec2eb87e5d5fa08",
    "translation": "After is going to, use di base form of di verb.",
    "role": "localized_instruction_or_meaning"
  },
  "1069": {
    "sourceHash": "438995afa1485918863fa94b08751770beba5d70234b1707bb966e775676ffff",
    "translation": "She is going to study English. = E plan to learn English.",
    "role": "localized_instruction_or_meaning"
  },
  "1070": {
    "sourceHash": "f9247ab3bc2f9efca5970d6c4795d122002d5948e9b690415dd974fb10920bb8",
    "translation": "Choose di word wey fit di blank: What are you going to ____ tomorrow?",
    "role": "localized_instruction_or_meaning"
  },
  "1071": {
    "sourceHash": "fbef3b6862cd5db506e4b68fe9d820abfe10058a81d4813e7cf36735e1e35c22",
    "translation": "After going to, use di base form of di verb.",
    "role": "localized_instruction_or_meaning"
  },
  "1072": {
    "sourceHash": "b4017f0cbe9057c16874a4727f48f4f69ec1fff8cf4520cb6ebec3cd13ed9601",
    "translation": "do na di base form.",
    "role": "localized_instruction_or_meaning"
  },
  "1073": {
    "sourceHash": "9599c14bc754795b38a960fdda302adbca28c9268f9dae62b2e626e2dd8d504f",
    "translation": "What are you going to do? = Wetin be your plan?",
    "role": "localized_instruction_or_meaning"
  },
  "1074": {
    "sourceHash": "bbe453abade2e435589f91659611e1a2ef422595709c28d1463fade7c4e2c17c",
    "translation": "Choose di word wey fit di blank: I will ____ you tomorrow.",
    "role": "localized_instruction_or_meaning"
  },
  "1075": {
    "sourceHash": "24563903cebbd7834de8a0af5b72a4abfd9b0227e060dd27792cfcf0610ea5bc",
    "translation": "I will call you tomorrow. = I go call you for phone tomorrow.",
    "role": "localized_instruction_or_meaning"
  },
  "1076": {
    "sourceHash": "1c47a2c2deb0a6c660f7062b0ba344ba910c6bbf1e5ca52f6399eff9d3bd91e1",
    "translation": "Choose di word wey fit di blank: We are ____ to play soccer.",
    "role": "localized_instruction_or_meaning"
  },
  "1077": {
    "sourceHash": "1cb1cd9b74a32a7b5419ed6924498245a77c6d82002770e5ef75560c2d770041",
    "translation": "Di pattern na be going to + base verb.",
    "role": "localized_instruction_or_meaning"
  },
  "1078": {
    "sourceHash": "e316adb784aa53757754e2901cbf1bd4b4fb24933316ee8c95c961d775d58146",
    "translation": "After are, use going.",
    "role": "localized_instruction_or_meaning"
  },
  "1079": {
    "sourceHash": "5f7eea2355a752b961543ceab2e1b571572fb58cd65797993a5bc8acc68e8d57",
    "translation": "We are going to play soccer. = We plan to play football.",
    "role": "localized_instruction_or_meaning"
  },
  "1080": {
    "sourceHash": "6bb26c91c15a215043a6b5da3ce2bf87976f6d50d45768b59148073e76d6b577",
    "translation": "Choose di word wey fit di blank: He will ____ his homework.",
    "role": "localized_instruction_or_meaning"
  },
  "1081": {
    "sourceHash": "c9a6a3ba00dfd45f566a1fe841643d7682a8226db330ff5aac1378ac79ea282f",
    "translation": "He will do his homework. = E go do homework.",
    "role": "localized_instruction_or_meaning"
  },
  "1082": {
    "sourceHash": "dcf6549abc5234878d1982b89eb529069411e8d058c6347e3e7a109938373655",
    "translation": "Choose di word wey fit di blank: I have ____ apple.",
    "role": "localized_instruction_or_meaning"
  },
  "1083": {
    "sourceHash": "06aa85a7d556f8826c82d9d63e708faecaacd0d362ccabf07ca17ed297f2afed",
    "translation": "an apple = one apple",
    "role": "localized_instruction_or_meaning"
  },
  "1084": {
    "sourceHash": "a9fcdef82b57d649a60f61895bf1df820399bf39c1b5f13d3f50580a1f162a2b",
    "translation": "apple start with di vowel sound [ae].",
    "role": "localized_instruction_or_meaning"
  },
  "1085": {
    "sourceHash": "2c2154c759ea3a3f0e297cbeaa8dbae0a4a221a66214d7571cf107b30a089d97",
    "translation": "Use an before vowel sound.",
    "role": "localized_instruction_or_meaning"
  },
  "1086": {
    "sourceHash": "38e4d88b56eeaf6b3a0cb42cdbe3a69dc066a743c094a8b0fb9e6536ce9a533e",
    "translation": "Choose di word wey fit di blank: One box, two ____ .",
    "role": "localized_instruction_or_meaning"
  },
  "1087": {
    "sourceHash": "4446ea472dad84824f41721cf5369280cd15f0cde32de15f10be2e0b9b87e32e",
    "translation": "two boxes = 2 boxes",
    "role": "localized_instruction_or_meaning"
  },
  "1088": {
    "sourceHash": "90ef130d84dc64b8c8deeca432f12102a320aa733e8a4aff03adf0e170317b59",
    "translation": "For words wey end with x, add -es.",
    "role": "localized_instruction_or_meaning"
  },
  "1089": {
    "sourceHash": "fd7d6d8cb2750800fcfd39507c0945991461d23e36089ebe5e9157a971643fd4",
    "translation": "box → boxes",
    "role": "localized_instruction_or_meaning"
  },
  "1090": {
    "sourceHash": "c14006f84465f5e34d6ea9ddc1213321755cfa1a87764dc2ebf7ea897117e732",
    "translation": "Choose di word wey fit di blank: There ____ three books on the desk.",
    "role": "localized_instruction_or_meaning"
  },
  "1091": {
    "sourceHash": "1b98b1b1d452e6a2808fbfbb1dcddd3ded36aa8edf94e38930a142aec07119ac",
    "translation": "There are three books. = 3 books dey on di table.",
    "role": "localized_instruction_or_meaning"
  },
  "1092": {
    "sourceHash": "3ceef77c7f47daf258cc08ca6f0eed7eb541bb388b36509d532601982dffd402",
    "translation": "For plural, use There are.",
    "role": "localized_instruction_or_meaning"
  },
  "1093": {
    "sourceHash": "c0ab2880e829be83b9cf9ddf04c9ac3bfdac6a486fddd9176b82091a929662ff",
    "translation": "Choose di word wey fit di blank: I see ____ elephant.",
    "role": "localized_instruction_or_meaning"
  },
  "1094": {
    "sourceHash": "c95b01fd2a36d761ed1f177bd243e08b40fd383bd4783f3625d2ac989b9c0e18",
    "translation": "an elephant = one elephant",
    "role": "localized_instruction_or_meaning"
  },
  "1095": {
    "sourceHash": "9ad8e200ccf55c64b11add746861204e4957474539c7e907b885632a4c01f465",
    "translation": "elephant start with vowel sound.",
    "role": "localized_instruction_or_meaning"
  },
  "1096": {
    "sourceHash": "f961315c2be245392723c31c079cdcd91c71eea11a3bdce97003be8570a2ea9e",
    "translation": "Choose di word wey fit di blank: There ____ a cat under the table.",
    "role": "localized_instruction_or_meaning"
  },
  "1097": {
    "sourceHash": "adad7b08dfcc796ca09332e47815033ab5b60aea322cfc8197b07ea37b3ba8f8",
    "translation": "There is a cat. = One cat dey there.",
    "role": "localized_instruction_or_meaning"
  },
  "1098": {
    "sourceHash": "4571d746d8e90dd4e9d018fee90f42fc0b5034b25aff91169b74218eb15dd6d9",
    "translation": "a cat na only one (singular).",
    "role": "localized_instruction_or_meaning"
  },
  "1099": {
    "sourceHash": "0bb2f509225041c7959bfaa7394662754a8505d4284fecc664208ef15ec41aef",
    "translation": "For one thing, use There is.",
    "role": "localized_instruction_or_meaning"
  },
  "1100": {
    "sourceHash": "84cf0b746a24bcc16e54190de4395223fb0c903f26aa90f263f0215bdb93381f",
    "translation": "Choose di word wey fit di blank: This is ____ umbrella.",
    "role": "localized_instruction_or_meaning"
  },
  "1101": {
    "sourceHash": "a817eee4dcbb2b26080211cca193d7456441aeeec93b7b90d786f9a0956e7699",
    "translation": "umbrella start with vowel sound.",
    "role": "localized_instruction_or_meaning"
  },
  "1102": {
    "sourceHash": "91fc270d42e9b4222f29ee0258f6bcccd7c6557470b8ef5b1db57c7027ba2844",
    "translation": "an umbrella = one umbrella",
    "role": "localized_instruction_or_meaning"
  },
  "1103": {
    "sourceHash": "a8cbc40b793b053457e8faf5c73cc234d8aa7ed3eac1242952767154f614133a",
    "translation": "Choose di word wey fit di blank: There ____ two cats in the garden.",
    "role": "localized_instruction_or_meaning"
  },
  "1104": {
    "sourceHash": "d72df6b9e600b5adf63ddb5e3cfc7b2b91630684e11b564fd82edfed941abea5",
    "translation": "cats mean more than one (plural).",
    "role": "localized_instruction_or_meaning"
  },
  "1105": {
    "sourceHash": "8aa44c527a80f55c2c7a95a1463e9680e3b6008997e63e663766379cd40ea3e6",
    "translation": "There are two cats. = We fit see 2 cats.",
    "role": "localized_instruction_or_meaning"
  },
  "1106": {
    "sourceHash": "02f0c93c64fe13e0a39e81ac33e7205bd34fe9a2539a5a2383d1a0e73b264fc6",
    "translation": "Choose di word wey fit di blank: She has ____ orange.",
    "role": "localized_instruction_or_meaning"
  },
  "1107": {
    "sourceHash": "b8f3deba0514cb5999eb6e8f9554dfd4ae06d8e32409382c646c79852aa1bc7a",
    "translation": "an orange = one orange",
    "role": "localized_instruction_or_meaning"
  },
  "1108": {
    "sourceHash": "c8bfba104adfbbdbf7fc7c106be32ba71bebd9616cba3d3c42f2d2a4536850a2",
    "translation": "orange start with vowel sound.",
    "role": "localized_instruction_or_meaning"
  },
  "1109": {
    "sourceHash": "34556ffbf62e13ab42be65ecf8a32e0d4d13c9b24c18b722c754cf8c5b85e5a1",
    "translation": "Choose di word wey fit di blank: One watch, two ____ .",
    "role": "localized_instruction_or_meaning"
  },
  "1110": {
    "sourceHash": "6fe93d66d24169ae703237ea294d7bf459b11b5e851b4ea704376b10e28ab9d4",
    "translation": "For words wey end with ch, add -es.",
    "role": "localized_instruction_or_meaning"
  },
  "1111": {
    "sourceHash": "16168b38f95f315f0c281e6ec1b94247843a2064408b2b240060bef8d5518c31",
    "translation": "watch → watches",
    "role": "localized_instruction_or_meaning"
  },
  "1112": {
    "sourceHash": "1caf46a6d002760f8671c5af5727cda8b887c1c7b62fddcd7e5c5377377e40c2",
    "translation": "two watches = two watch",
    "role": "localized_instruction_or_meaning"
  },
  "1113": {
    "sourceHash": "c8dfadacf285d28bac2effae2e169880b9cb2b4585fa43209381fd5a15ab8b3a",
    "translation": "Read di passage and answer. \"Ken lives in Busan. He has two sisters. His older sister is a teacher. His younger sister is going to start school next month. On weekends, they usually go to the beach.\" Question: Where Ken dey live?",
    "role": "localized_instruction_or_meaning"
  },
  "1114": {
    "sourceHash": "855c168ef573290d1835e94d0f7e6a94dc5d209ebf4b47ded26a5fca93e5e1a6",
    "translation": "First find di words from di question inside di passage.",
    "role": "localized_instruction_or_meaning"
  },
  "1115": {
    "sourceHash": "0360a942ff80730fbcb6d1996512c2d64d655da9d4b6365867c5f67fb8c096b8",
    "translation": "Find 'lives in ...'.",
    "role": "localized_instruction_or_meaning"
  },
  "1116": {
    "sourceHash": "586464d41a54d0f429a5bb317bfa92ed830c7a82eb8e8ef96765788435b0d81c",
    "translation": "Ken lives in Busan. = Ken house dey Busan.",
    "role": "localized_instruction_or_meaning"
  },
  "1117": {
    "sourceHash": "ef62badeef11e011746f08df1c3d1abf04b97503d5645b3426f6f6d5223899d0",
    "translation": "Read di passage and answer. \"Ken lives in Busan. He has two sisters. His older sister is a teacher. His younger sister is going to start school next month. On weekends, they usually go to the beach.\" Question: How many sisters Ken get?",
    "role": "localized_instruction_or_meaning"
  },
  "1118": {
    "sourceHash": "4ad2c383461f32109c101d03a0d096bbacaced6a66f24a825595be56fbfce234",
    "translation": "Find 'has two sisters'.",
    "role": "localized_instruction_or_meaning"
  },
  "1119": {
    "sourceHash": "e358cf2c428455fb9a4fbec96232b96c65c8d04cb0966279a9d9b3591ac538b6",
    "translation": "Ken has two sisters. = Ken get 2 sisters: one senior am, one junior am.",
    "role": "localized_instruction_or_meaning"
  },
  "1120": {
    "sourceHash": "c70cc8d9055897f285842be77f0a92b3a8ceb3462b9d0d2bd77c8e62dd20154a",
    "translation": "Read di passage and answer. \"Ken lives in Busan. He has two sisters. His older sister is a teacher. His younger sister is going to start school next month. On weekends, they usually go to the beach.\" Question: Which work Ken elder sister dey do?",
    "role": "localized_instruction_or_meaning"
  },
  "1121": {
    "sourceHash": "482b408548d91ce8ddea4011734997885e25816d6d0272d9088077c3896fa2d5",
    "translation": "Find 'older sister is ...'.",
    "role": "localized_instruction_or_meaning"
  },
  "1122": {
    "sourceHash": "b2ffc99afecae06efe487198a1686261421a2f4c4f45d35f834fd65892179c67",
    "translation": "His older sister is a teacher. = Di elder sister work na teaching.",
    "role": "localized_instruction_or_meaning"
  },
  "1123": {
    "sourceHash": "20a40f0c9359038e2d2db035956b1ce0a6266d2edc63c0faf205f08f80a13d92",
    "translation": "Read di passage and answer. \"Ken lives in Busan. He has two sisters. His older sister is a teacher. His younger sister is going to start school next month. On weekends, they usually go to the beach.\" Question: When Ken younger sister go start school?",
    "role": "localized_instruction_or_meaning"
  },
  "1124": {
    "sourceHash": "cb0f037fb0718e8c4b719c153ebc09f496fdbb280e2b448e65f6da712a9b99db",
    "translation": "Find 'is going to ...'.",
    "role": "localized_instruction_or_meaning"
  },
  "1125": {
    "sourceHash": "b33a6643db7384f1909ae458f77721369bc2052734ce00c1d69c536e2dfd7992",
    "translation": "She is going to start school next month. = Di younger sister go start school next month.",
    "role": "localized_instruction_or_meaning"
  },
  "1126": {
    "sourceHash": "5005e8cc4a27f83f38e961450f89f224d0130b2b992b34e7671b63ba581a1cd2",
    "translation": "Read di passage and answer. \"Ken lives in Busan. He has two sisters. His older sister is a teacher. His younger sister is going to start school next month. On weekends, they usually go to the beach.\" Question: Where dem normally dey go for weekend?",
    "role": "localized_instruction_or_meaning"
  },
  "1127": {
    "sourceHash": "939fba7a00b032c54f289c20f4cff403c6ab616c9b0295e0b80581c213dfcfd9",
    "translation": "Find 'On weekends'.",
    "role": "localized_instruction_or_meaning"
  },
  "1128": {
    "sourceHash": "6951de3185d58205aa31111444142e3cfe6b82b4855250c8fba5878606a0bcb9",
    "translation": "On weekends, they usually go to the beach. = For Saturdays and Sundays, dem normally dey go beach.",
    "role": "localized_instruction_or_meaning"
  },
  "1129": {
    "sourceHash": "299a353049e8c51bdcb14b120a36ecff474303f442537e86c6d9413b242cb5f6",
    "translation": "Read di passage and answer. \"Ken lives in Busan. He has two sisters. His older sister is a teacher. His younger sister is going to start school next month. On weekends, they usually go to the beach.\" Question: Which city Ken dey live?",
    "role": "localized_instruction_or_meaning"
  },
  "1130": {
    "sourceHash": "ebfc15581388b41400b3e900d6c91f1ac91579e950c6b7007beafa3c83e217d1",
    "translation": "Read di passage and answer. \"Ken lives in Busan. He has two sisters. His older sister is a teacher. His younger sister is going to start school next month. On weekends, they usually go to the beach.\" Question: Who be teacher?",
    "role": "localized_instruction_or_meaning"
  },
  "1131": {
    "sourceHash": "340ea110387a60f4e7bfe3cc56990fc2aed6720f1d4caa161ba16f9f50ab1e55",
    "translation": "Find 'is a teacher'.",
    "role": "localized_instruction_or_meaning"
  },
  "1132": {
    "sourceHash": "b9074a2d7ed99d5a4480dcfd3ec244668c244133646677b81fb7b3526ffef0e5",
    "translation": "His older sister is a teacher. = Na Ken elder sister dey teach.",
    "role": "localized_instruction_or_meaning"
  },
  "1133": {
    "sourceHash": "1ca3580602b630966830d88b4c6986d243ff07772785d5e4e4b684809d41d016",
    "translation": "Read di passage and answer. \"Ken lives in Busan. He has two sisters. His older sister is a teacher. His younger sister is going to start school next month. On weekends, they usually go to the beach.\" Question: How often dem dey go beach?",
    "role": "localized_instruction_or_meaning"
  },
  "1134": {
    "sourceHash": "9989e167536675c412ef8f3519d1044b74aa296a93c6d75bf2661f3982f435e9",
    "translation": "'usually' mean 'most times'.",
    "role": "localized_instruction_or_meaning"
  },
  "1135": {
    "sourceHash": "cb26f35edf0bed28ac3711fd0e1f35590c9fa4efde55fac158da64063759cfbe",
    "translation": "On weekends = every Saturday and Sunday",
    "role": "localized_instruction_or_meaning"
  },
  "1136": {
    "sourceHash": "a5dea29f2916f2885be11347987a51d47f4543275f8544b1065e3198f48bffb3",
    "translation": "Choose di word wey fit di blank: I like carrots. → I ____ like carrots.",
    "role": "localized_instruction_or_meaning"
  },
  "1137": {
    "sourceHash": "ce756b5b16c9a4499fd4fc80016ec78bd26e586b294973a59669b5902b354b41",
    "translation": "Di subject na I, and like na ordinary verb.",
    "role": "localized_instruction_or_meaning"
  },
  "1138": {
    "sourceHash": "02a8ec643590c53f30c131dfc19125b6dbe18f74bd0cef18b486b0ae8dffd10c",
    "translation": "Use don't + base verb.",
    "role": "localized_instruction_or_meaning"
  },
  "1139": {
    "sourceHash": "ab06f71720ab9ee9c2c7d507eba862f10589ecc26c7180c56b471152e6331518",
    "translation": "I don't like carrots. = I no like carrot.",
    "role": "localized_instruction_or_meaning"
  },
  "1140": {
    "sourceHash": "d2145d99a7612d26743843753bd584d4a83168774a371e421cabb1a148727b21",
    "translation": "Choose di word wey fit di blank: You are a student. → ____ you a student?",
    "role": "localized_instruction_or_meaning"
  },
  "1141": {
    "sourceHash": "7983c235cb0cf43f5565e6ad7695e267f743305b2b183e7bffa4eb35bc9abc48",
    "translation": "For sentence wey use be verb, move di be verb go front.",
    "role": "localized_instruction_or_meaning"
  },
  "1142": {
    "sourceHash": "1a452274ae32f0d408a0ea2bee6bd39e8293fe54b5e14e86d9fd9dc5c4a746b0",
    "translation": "With you, use are.",
    "role": "localized_instruction_or_meaning"
  },
  "1143": {
    "sourceHash": "379a31a1ca0238b47d45ff4fa14a9c683ab4f254d9350f1d79225f97132a6080",
    "translation": "Are you a student? = You be student?",
    "role": "localized_instruction_or_meaning"
  },
  "1144": {
    "sourceHash": "d3ab229561f92324e28afd1859021195a8cf58bbc06b9a64cafd62f4403513ca",
    "translation": "Choose di word wey fit di blank: He played soccer. → He ____ play soccer.",
    "role": "localized_instruction_or_meaning"
  },
  "1145": {
    "sourceHash": "e4b30fc42b1e21706b2f9be064ef0e74eac0a7464c84a2f2e114962605237457",
    "translation": "played na di past form. For past negative, use didn't.",
    "role": "localized_instruction_or_meaning"
  },
  "1146": {
    "sourceHash": "66968665ea35713e24b51515c38f51dae9cfdc1511150014d1b9b2b5210cd527",
    "translation": "After didn't, use di base form of di verb.",
    "role": "localized_instruction_or_meaning"
  },
  "1147": {
    "sourceHash": "053ecf6473926729d9fe44005f88a6548f7e5778b03a6d07067b5874394ef5cd",
    "translation": "He didn't play soccer. = E no play football.",
    "role": "localized_instruction_or_meaning"
  },
  "1148": {
    "sourceHash": "6037bb76d1fde8fbbb070354be2444270d4b1b2d7b17c1df4e949b184f289274",
    "translation": "Change this sentence to negative sentence. I am happy.",
    "role": "localized_instruction_or_meaning"
  },
  "1149": {
    "sourceHash": "1790fe747190c1a9f2d1fa1b938b25eef59a5d36ce15aaf837be35b4d8c3c0e3",
    "translation": "Put not after am.",
    "role": "localized_instruction_or_meaning"
  }
}
