{
  "110": {
    "sourceHash": "9780e8e1839df67c99095dd4cc5a884073d2bea4de546fd892ce6cad448a7e65",
    "contextHash": "b96ab60dc5179e23e53eb658e6591f307d2b31dfcd2638883aef79ba6155db39",
    "translation": "I na subject wey mean di person wey dey talk. After I, use am.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "111": {
    "sourceHash": "6d983f0e8be701cb43109dd6df9a2b0bf0e66c326fe4a2aac6a9bf435a5ef797",
    "contextHash": "1ad408c359ae0e9376989c00ff0a15299fa5ab100b1e1414f086583419cd3919",
    "translation": "her dey show say something belong to di female person. Noun like hands follow am. No confuse am with she, wey be subject.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "112": {
    "sourceHash": "71215e660c431539d3e5d279a32d8c3b848c8181fa3da60dff36562cd5592f49",
    "contextHash": "191ca27dc746d8c7c6d77c729845feaec77798687b5abf060cc7a68d13afc707",
    "translation": "After word like near, use us for di group wey include me. Use we as subject.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "113": {
    "sourceHash": "86663962d5f49f7362e978168a9a7e9835f402a3bbaaa77ed0c6b347f7db9f9a",
    "contextHash": "f87d946921f1fefbb7cd6125dbb9c4ed73d49129b865f70d51c48f647e396376",
    "translation": "his dey show say something belong to di male person. Before noun like name, use his, no be he.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "114": {
    "sourceHash": "84bb7074ef5b5cf213b13ab4a373de366857e3cb4fad42a68a4dbf6a3aefb290",
    "contextHash": "2d6c286e4b132f5a2e82d4ae940aa5491be7b448e9c1ed8bc7deea0f6798cc51",
    "translation": "our dey show say something belong to us. Put our directly before noun like classroom.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "115": {
    "sourceHash": "2f969bb29d57f20601b0d6ee67be680350ce878156830036c72d32d261c338a4",
    "contextHash": "7bd91e66bce3dc81602eddbfb6ea0eb96e53ed9f231817968026984989d3300f",
    "translation": "it fit refer to one thing wey receive action. Before you for dis question, use Do and verb base form.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "116": {
    "sourceHash": "87b58645bd92ff9788c00490dbb4fa4af9543ce21d2717bb82cddfde75e6e95f",
    "contextHash": "6b2571eb90018272ca07d952489f937db48e1246ba956fcae90fde22aebdc908",
    "translation": "After verb, use her as object for di female person. Use she as subject.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "117": {
    "sourceHash": "a6b7baabd98693556391fb1907e3dd08725619fd9311c7023931f9e0b5119a76",
    "contextHash": "efccd5acec77d46b574d6d8d648261d7ea4e6a257d4823b0ad97f641ab5ebe0e",
    "translation": "Mr. Kim na one male person, so you fit replace am with he. After He, add -s to di present-tense verb.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "118": {
    "sourceHash": "e09854c261ba7c8737f6377639f8af7172ae3f2f993dad02da54fb9d6c9c54cf",
    "contextHash": "be67572aa9489a3ef4b2d432353ca166ee9ff5f5c3cf38152ec28428a2a36552",
    "translation": "Use them as object to refer to more than one thing. No use they as di object after verb.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "119": {
    "sourceHash": "3113b2a3cfb3a071fa9f27b81d59856220bd11a10aa2519b9a9aecf362098798",
    "contextHash": "f19c711e819049f885e013ccb81bbf2d386d887387e703e2dc7198d20dea4ffd",
    "translation": "your dey show say something belong to you. Put your directly before noun like pencil.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "120": {
    "sourceHash": "5c46feeef5abcb7e83373c9762b06cc9a4867b1fc62b33c099b91b88ef47cf55",
    "contextHash": "09e38ed98bc2081ad02b931889b110e10109688aae6b8b9d36647ed5ffd001d5",
    "translation": "its dey show say something belong to di animal or thing. Put am before noun.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "121": {
    "sourceHash": "8157aa6ca8c44fff6fe7216ef1b7a0979494b0d45a95de14b9aaebe265214128",
    "contextHash": "5d046526f99edec56a254b3c401151f5a829256d349d907ce6c22b513665ea4d",
    "translation": "You fit replace one thing like di sun with it. After It, add -s to di present-tense verb.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "122": {
    "sourceHash": "b66b047448386d11ed91d9f88743962250cb2a9c207d2e813a9bc421c57b628e",
    "contextHash": "e6f0bcefa0c439ff7413b2ea71273486da0259d13110cb597554a4a655dbd7bc",
    "translation": "After to, use him for di male person wey receive di action. Use he as subject.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "123": {
    "sourceHash": "0cad18d31a5e4c3ea9a69879461c54aae7ead415ba82ea896495b1001fb8a93d",
    "contextHash": "24b0ab60d8f0b42890c3a3d8b385601ea969ec1b9cfdfa46951649cc8985f1c5",
    "translation": "To talk past action like yesterday, use past tense. For regular verb, add -ed.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "124": {
    "sourceHash": "8276054d859965b926306428a3f61acc687d36e7d2c0c9340f0b6d2cfb126f4d",
    "contextHash": "50b5c89b9c38b8acc2b7a2d1163ab88d2e3c5205be3fc3b701df850242999997",
    "translation": "Use present tense for action wey dey happen regularly. If subject na she or another third-person singular subject, add -s to verb.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "125": {
    "sourceHash": "d51952d744362711f37cbfebfc9fc7b437aee33687e846a4c02874e7671fd0da",
    "contextHash": "9b717de0ab021e9a7f3604a4b94d801f02319be992d74f25be9730fe2d59bf21",
    "translation": "last Sunday na past time, so add -ed to clean and use cleaned.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "126": {
    "sourceHash": "bf008924e01468efaaf52bbd81719eedfed4d441b24dc9e188051f136f4a6d39",
    "contextHash": "f76d1f737783320e462d0dcf472407f5af2559a9abacb4af8fbf187c1fef21c8",
    "translation": "For verb wey end with sh, ch, s or x, add -es for 3rd-person singular present tense.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "127": {
    "sourceHash": "1e9bd453f86031f3fa6e8e43f2caea08c639d118a6f4284f3be5a50f18738d87",
    "contextHash": "310b990d7df25ec7aa14847b2379acb4e7523ccc4a2c6c763354519d91d832bd",
    "translation": "For verb like stop wey end with one short vowel and one consonant, repeat di last consonant before adding -ed.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "128": {
    "sourceHash": "a01d989fa33404bf77016557e531b884b37d758af2674ec6ab88f5273ab4a339",
    "contextHash": "de5d252457fb67ba89f4e639c443fd14b2c5da96244700ef3368c00864b15a23",
    "translation": "last night na past time, so for di regular verb here, add -ed.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "129": {
    "sourceHash": "3642ac6292a54a371689c85ef0c9c094cdfb7d15f4b63c50c9fa912eb6647fc4",
    "contextHash": "12ef13f7e103d61c6df5bcd930fe8518d33086b2fa3bdc6cfe3b8ee0837773d1",
    "translation": "Did already show past time for question, so use verb base form after am.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "130": {
    "sourceHash": "16d947de43011eb022cfdff659944c2876b10f62e56143438675e9365ba5a1f3",
    "contextHash": "82735006a020f1d925f047bee063c16408783eea12c3b7fc878946a04d80ac1f",
    "translation": "Use present tense for fact wey no dey change. If subject na one third-person singular subject, add -s to verb.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "131": {
    "sourceHash": "cf4eab0f66af5c51474d09718a43356e76399db35882ba74d33d279be80c95f5",
    "contextHash": "4ce2c75d74c80edb3663343f6d8f8f82235de84d27127dea913e59e39c31c76e",
    "translation": "last week na past time, so add -ed to visit.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "132": {
    "sourceHash": "1a4d27821e8a88dfcc1f63c00b27a52ec49dd3a4edbf12cf36f5db2266dc9fc7",
    "contextHash": "95915264b3bf9b105bbdc67ff61ca61d984b87c0e8cbda0e5d64e40dad40ec9a",
    "translation": "If subject na more than one person like they, no add -s to di present-tense verb.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "133": {
    "sourceHash": "daf058aa7e91960ae3d8c9ee84c22f048f32332aeea90c02ca1a7b82e341c872",
    "contextHash": "f191ab5af8c73fe814631a7a6f5c5058bb04a086056926fcf626e73333f3002b",
    "translation": "a minute ago mean say di time don pass, so add -ed to open.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "134": {
    "sourceHash": "fe932a51470d53de624f82fe4f91cbd23d0836c4b0c453fdd96a90a875125121",
    "contextHash": "497731b65ffb2af78c355e663416a5bcda7883fd2096cf5e9453802ac7eeb3a9",
    "translation": "If verb already end with e, add only -d to form past tense.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  }
}
