{
  "80": {
    "sourceHash": "4a25c55c5521775ebf18c76fcd20af1088530fc60748e5b1aa017ccaa1ade4d3",
    "contextHash": "95fef02eb060b29da2163b4cff440841d603d54bccf0e984c8258dfc1815d533",
    "translation": "To show say something belong to me, put my before noun.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "81": {
    "sourceHash": "8243bb76519e84d1c7c3743a8ee6d70e2baa5cee394de8a1e8ea2d3a27c1de1a",
    "contextHash": "2f33f1dbb5fdec78ad135efad6f4ccde30f0a069c18a3e580eee3eb2c4a4dd81",
    "translation": "After can, use di verb base form without changing am.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "82": {
    "sourceHash": "b13f12499ee6f8290cff8452e967f993c7b0eab3c61892384a9affd180e2495e",
    "contextHash": "40a6e8294b6ebd8a5328368a45c44c1736b5d4d3062f67fd90191e33b12bf15a",
    "translation": "Use She as subject when you dey refer to di female person.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "83": {
    "sourceHash": "9c09fd5a9c2f595399704e784ad0f9d44c44b6a23e11a19aa2c6f76328b5c285",
    "contextHash": "428c37bad965e99ae5705dd7d2d88c55089061a0e1032cdcf494a5a6a50d0de3",
    "translation": "If subject na He, She or one person name, na 3rd-person singular, so add -s to verb. Di order na person → action → thing.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "84": {
    "sourceHash": "240f24bf334b1fefb2f8b617df6803cfc3f0edf9da99581dd7b075a551572fc9",
    "contextHash": "fd3535ef1aff9f0f70c0c6c4139c5347702283ee0bfc8167928edbeced35d0f4",
    "translation": "Mina na one person, so add -s and use eats. Before word like apple wey start with vowel sound, use an.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "85": {
    "sourceHash": "24cf62441436ef313a593b3ffef1fcbb7a8f4571280fc3a46aadc5d5dfffe9db",
    "contextHash": "8308b6341240e91fc4c9986e3307be08402c7433b859575d96245983a7c0bc08",
    "translation": "English order na person or thing (The dog) → action (chases) → object (the ball). If subject na one, add -s or -es to verb.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "86": {
    "sourceHash": "9431273db90bf89f22351f69e24687bf069a68ce008abb7d97ca665b936e8074",
    "contextHash": "b875d1a1c619f8ffee77b5e06079170d3325584ad54e4562b9c98d230767e22b",
    "translation": "We mean more than one person, so no add -s to verb. Put verb after subject.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "87": {
    "sourceHash": "1be99369eb058e84efe11ef1fae1c3f290d3dbc98f0b8fa5c7f541767a323c77",
    "contextHash": "7cdeaefb7e0c2d51d496d45070894a45e6a5736d76fc980682f88339b6ac7be7",
    "translation": "Dad na one person, so use cooks. After person → action → thing, put di time expression.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "88": {
    "sourceHash": "21af36baceb6559e44b313647b3937004107cf4e4fc1c02006a3c829d20815c3",
    "contextHash": "7b657b1c2c70ed572d6acb657b19e3342a400e2ccb696fed6166405b4f87b7a6",
    "translation": "When subject na I, no add -s to verb. For dis simple sentence, use di one main verb; no put am drink together.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "89": {
    "sourceHash": "0f9c332e63e3e52981c438f9f1fb543ac26029362c64386f25d60786f4ed88a9",
    "contextHash": "154cc11a9baa9771faa53b904d53ec6d2e5607ca52da5dd96d4b31ffdce3641e",
    "translation": "The teacher na one person, so use writes. Put verb directly after subject.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "90": {
    "sourceHash": "e732700623eba5baae93543a449a65147fa68b64213348d0194ebcaf3cb7b914",
    "contextHash": "a8057ec2f405c3a1e83c225cf71a90f6c87b39eca66bfd482a42e0e3d5135c88",
    "translation": "Sentence wey tell wetin person be still need verb. Use is after She or My sister, and put a before di job name.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "91": {
    "sourceHash": "1d361000afe57f502686de5c309f170fe633660ee0d5b194566e496bfb21bd60",
    "contextHash": "27400ae9e8be9238720b9b5cf8e078ecc9be403977c0ca4476ff63e4327e4ada",
    "translation": "If subject na more than one person like They, use are. Di order na person → be → description.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "92": {
    "sourceHash": "c9fb7cbe75ce1c07aff8e5db535d6e7374362dafe52710f6337579075ea1db6b",
    "contextHash": "a76e3fe8ab26cfcd1d38c92725c7622075e0cfa3ec7c3f7190ac0a3cbacbddc6",
    "translation": "To make negative statement after He, use does not. After does not, use verb base form without -s.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "93": {
    "sourceHash": "eecff8a8a4b34997ab028e5d0f82487495e4e1de8de1083dbd39551735013c72",
    "contextHash": "7732d4b40aa804f4fdec3d596a03d354036b711e39a713c7eb849c36b0b4149c",
    "translation": "A cat na one animal, so add -s and use sits. Keep on the sofa together as one place expression.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "94": {
    "sourceHash": "0ea34c822265a6a1301293df8622860d5eca6c4d4988e520095c218391badb13",
    "contextHash": "afc50d6022fda44e75c1a9be901c4f736ea7640ed7064efa1b0899b2a20c52bf",
    "translation": "have dey change to has after He, She or one person name. For a new bike, a dey before di describing word new.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "95": {
    "sourceHash": "030b2b981cb35f05c23d0c25ead3d8c43c26bf06938d539edcc016e53e1af89f",
    "contextHash": "6134f77204bd78947b6b4e09705c143dbabe0a5573b594655e5cc462b29bfbdf",
    "translation": "Mom and Dad na two person, so no add -s to verb. Put in the park near di end of di sentence.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "96": {
    "sourceHash": "78280160cfdfe33af8822e5cec727039c6ea5847da137321cbf2f34c9c6c012f",
    "contextHash": "7a07b002c5f23b805dfe03cfee15ca33ac10e33eb055fea751c9a4a5dd3eaa1b",
    "translation": "After Sam, wey na one person, use lives. Keep in Busan together at di sentence end. Start person and city name with capital letter.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "97": {
    "sourceHash": "43bc172b04e0270e622382e041a1b0b19f041699daef84d2d6ec778f4ad89f32",
    "contextHash": "b7cebe4109d04c91ed810cb7b3249a2d9da97ae0b73352ca57831918d9b8df09",
    "translation": "When Birds mean more than one bird, no add -s to verb. Use a only for one.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "98": {
    "sourceHash": "aa97da61f613d058a4bfff67c9ebde80eb7c49ba97c1f4452ec4efae4a8aa479",
    "contextHash": "a7ffcbd4daddf1576266a91a96b51b84581ed4242e60f2641bf551f5754c8f00",
    "translation": "Yuna na one person, so use draws. For art class, di describing word art dey before class.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "99": {
    "sourceHash": "31ea81f3791d8dee8877756635daa326eda211cbee0b50209ae6f8e2e01e176b",
    "contextHash": "03433d0b05f627b2c022f2255290eb29edaf85ed962955a05be3f25c1549bba2",
    "translation": "Question about one person like Mina start with Does. After Does, use di base form have, no be has.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "100": {
    "sourceHash": "8a7d6b746c9b043e918fe45adbd2fe04c065ecb7f33650c51c17e949df30a1ff",
    "contextHash": "04002717cd208eecdfe5d04d625e221c7e3462b5dd0abe8eb508970a76a753ae",
    "translation": "After can, use verb base form. Even though Tom na one person, no use swims after can.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "101": {
    "sourceHash": "880a294937ce342fec7759b2383fe438556af82f4e20a83d850f7e1c44f0f242",
    "contextHash": "61f2f7d48749e660be95368fc8381bfa43fada475ad593e7520276d2c2a39604",
    "translation": "To say something dey, use There is or There are. Use is for one clock and are for more than one.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "102": {
    "sourceHash": "837c3af5b0493b6d22d6f32870ab7bd6b89727d8d9bf0897fa600c213740b101",
    "contextHash": "616f7a596c60aaabc9546b947ac9ba4f9aa5a068a01f87677f708717d77b09b8",
    "translation": "To refer to one male person without repeating name, use he. For female person use she; for thing use it.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "103": {
    "sourceHash": "87cc824d5417312ee99f4c6e9b286b78f44bd3b7778acc5bb96ad5c6a097bcf3",
    "contextHash": "10dd5b429a2b97821a236e0386350147c5b999cafd958fcce0f35ff0a2f51a1e",
    "translation": "For one animal or thing, you fit use it. After It as subject, add -s to di present-tense verb.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "104": {
    "sourceHash": "57d65bdd1a6b40388e9f2ae56cf23e822bc212949cc9eccbfb9e1da6c26e21ae",
    "contextHash": "dea7664ab744cfe6c2d9ccef33382fb1bc1db041b6dd37e9f99387798279a920",
    "translation": "To refer to more than one person, use they. No add -s to di verb after They.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "105": {
    "sourceHash": "d7fbcb47f082907775fa1d292f4a938c6cb67ee69c7c5116bb06aaa578747f06",
    "contextHash": "90fc990804f7c12e0cf18ce1de72af3650841f1810501fc57a0864d6faf59d90",
    "translation": "To refer to people wey include me, use we. No use us or me as subject for dis sentence.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "106": {
    "sourceHash": "cdfd67b9941bf70a1380776ff29781c01556e121a0f3fe8146fc40288ec2940f",
    "contextHash": "b14624388bf8c542b55ce61a70767b6feeb47b07d5e7844733d544068f4cac3c",
    "translation": "Di thing wey person dey chop, dinner, fit become it. No use he, she or they as object after di verb.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "107": {
    "sourceHash": "e0236095b8ee493cf8bbbafc29f4241effe9bdef88577aea426873222bac2fb1",
    "contextHash": "5961df3576aea6e8e39cf0a70111dfeab1b607a37b9a62c808c19bf3f99928e4",
    "translation": "After verb, use me for di person wey receive di action if na myself. Use I only as subject.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "108": {
    "sourceHash": "4a5bad0b18423235d64d84cb5414712d6216e7ad8e1366d4d15b1e620a2e8a2a",
    "contextHash": "625ae44ed2eed911be018cb69b93d0c7f1552e5e0b4d9ebecd304c607cd9908c",
    "translation": "Replace the birds, wey mean more than one bird, with they, then use are.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "109": {
    "sourceHash": "58015f1afd055868339b5808f15a4c8d1f31aad48a8a5f498fedccb60860adbd",
    "contextHash": "7762339f3875a1e56a0f5c8893a532c29c1878f4d099bc33e8e49dea35d56d69",
    "translation": "Di be verb wey go with you na are. Put a before di name of di job.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  }
}
