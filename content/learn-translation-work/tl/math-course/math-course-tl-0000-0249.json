  },
  "178": {
    "sourceHash": "312e9a2ab332fb9a565efbcf0adc90af20ad54e59cafab3e6139bd48e481ddf7",
    "translation": "Matematika sa Baitang 10"
  },
  "179": {
    "sourceHash": "050fb22542cc19b2713b7f30e5456e1aac9ef89c9c9eee1fbf2b16065e233b57",
