  },
  "184": {
    "sourceHash": "137f628591a1d8dfdd2d17fe7a57b12e345d734f4fa7b0ebbe5c16314a9cc446",
    "translation": "Mga bilang at ekonomiks, mga function at ekonomiks"
  },
  "185": {
    "sourceHash": "7ff9dfda23ed9a7f4f3e92ed983734fd7cec3bd84a9949c5d79c0204ab0361ef",
    "translation": "Pagproseso ng datos, prediksiyon at pag-optimize"
  },
  "186": {
    "sourceHash": "04fb8d99a4165986fd093bf8e5ad20085f4f99feff23c71f54099a0ab2ebc3e4",
    "translation": "Mga bilang at yunit, rasyo, lawak at pagbilang"
  },
  "187": {
    "sourceHash": "d64549f500b34aa015245cd6b265a50536a57462a6daeae0d557f9238b8146de",
    "translation": "Sining at buhay, lipunan at kapaligiran"
  },
  "188": {
    "sourceHash": "cfecedd4884a63fc99d43cd6c8dff66276d37bb4241d51f0809f00816614149c",
    "translation": "Datos at mga sample, pagtatantiya at pagsubok"
  },
  "189": {
    "sourceHash": "d1bc7c3cc36385dea18a43ff65049ad6fd75c54b16044830475946067b1048a4",
    "translation": "Mga paraan, pamamaraan at etika"
  },
  "190": {
    "sourceHash": "b83d8bd76023f9767130b148288210897b91c12cc3757d11ac46b0ed0426e75f",
    "translation": "Ituro ang bawat bagay nang paisa-isa para malaman kung ilan ang mga ito. Lampas 10, mas madaling magbilang sa mga pangkat ng 5 o 10."
  },
  "191": {
    "sourceHash": "4eb2fe9b8a1c3bda866e168cb3b0a1cd4516b3b84daca799c8bb0bddd81d50e7",
    "translation": "🍎🍎🍎🍎🍎 → May 5 mansanas."
  },
  "192": {
    "sourceHash": "22820dda6bd010b4fa5809bbbd8536045ad8c981cb25ea70fc267711e7f8694d",
    "translation": "Pinagsasama ng **pagdaragdag (+)** ang dalawang bilang. Inaalis ng **pagbabawas (-)** ang mas maliit na dami mula sa mas malaking bilang."
  },
  "193": {
    "sourceHash": "6ac8bac29a0bf131e316b1db81c310733fd51959c1d699e49041f961794ea96d",
    "translation": "$3 + 4 = 7$, $8 - 3 = 5$"
  },
  "194": {
    "sourceHash": "1b6f2263d7081c0c5db534e88899b0c8f153494a000038099e50f5267916489f",
    "translation": "Gamitin ang **>** kapag mas malaki ang unang bilang at **<** kapag mas maliit ito. Nakabukas ang tanda patungo sa mas malaking bilang."
  },
  "195": {
    "sourceHash": "2b4b7f63eebaee539679fb0c1e3e84b635e429a5913b7ba1031d7da5179697d9",
    "translation": "$8 > 5$, $4 < 7$"
  },
  "196": {
    "sourceHash": "f124245bd9d2d1ce2a6123c3b31f55690e44d2459caa5f3ebb9a9bcffebccf99",
    "translation": "May 3 gilid ang **tatsulok** at 4 gilid ang **apat-na-gilid**. Bilugan ang **bilog** at wala itong sulok."
  },
  "197": {
    "sourceHash": "103bcba7bb024d97d642911ff75d11025c80315784894be91271c2f6d2f7a869",
    "translation": "Tatsulok: 3 gilid, 3 sulok"
  },
  "198": {
    "sourceHash": "4b7254615c87c9fc6193f7d579838e68674423d7572e2167f85bec646a2f9a52",
    "translation": "Sinusukat ang haba sa **cm**. Sa orasan, ipinapakita ng maikling kamay ang 'oras' at ng mahabang kamay ang 'minuto'."
  },
  "199": {
    "sourceHash": "74d9fdea55a2b53516c593eb15f4fdde4e3b00fda30c2d441e8e52eff9460284",
    "translation": "Maikling kamay sa 4, mahabang kamay sa 12 → alas-4"
  },
  "200": {
    "sourceHash": "0b038967bb2e5b7581fee82582642ef3c89cda7a199aa03d890e74483bb2bf77",
    "translation": "Sa 2-digit na bilang, nasa **puwestong sampuhan** ang kaliwang digit at nasa **puwestong isahan** ang kanang digit. Ang 10 pangkat ng 10 ay 100."
  },
  "201": {
    "sourceHash": "b98299b3b3f6ce807e5903d0c79207345cb31c1312515b5b297b776f3eadfd19",
    "translation": "$47$ = 4 sampuhan at 7 isahan"
  },
  "202": {
    "sourceHash": "33cc0983e9328b3eaa6a5e33d9b8cc239344a4b636c97bcbffcbceb2b3bf799e",
    "translation": "Kalkulahin ang isahan, saka sampuhan. Kung higit sa 10 ang kabuuan, magdala. Kung hindi makapagbawas, muling pangkatin (humiram)."
  },
  "203": {
    "sourceHash": "acfe9765fb44b888cd54c0885e6a03ff05a09697dc959d8caa03fb58424246a6",
    "translation": "$45 + 27 = 72$, $61 - 28 = 33$"
  },
  "204": {
    "sourceHash": "17777c9dc5df7e2591ddd82f460e73a48173b44e0e08b512b4ad2a821a19ba7e",
    "translation": "Maikling maisusulat ang paulit-ulit na pagdaragdag ng parehong bilang gamit ang **pagpaparami (×)**."
  },
  "205": {
    "sourceHash": "130796c3f3eb9d13a5cc6e0ec68c166f21eca3121478a92852ad9b8daa48dfd3",
    "translation": "$3 + 3 + 3 + 3 = 3 \\times 4 = 12$"
  },
  "206": {
    "sourceHash": "449031c39f51c6992919869bbf3f239c22c26f12043c80dd42dfcd8abd75d70f",
    "translation": "**1m = 100cm**. Tuwing lalampas sa isang numero sa orasan ang mahabang kamay, lumilipas ang 5 minuto."
  },
  "207": {
    "sourceHash": "ea3e095aeca8e4576b912a5c191361a16bae8c1478288b4d9bb1be09d47f0fbf",
    "translation": "Mahabang kamay sa 6 → 30 minuto"
  },
  "208": {
    "sourceHash": "af586e146a4ad01b246faee99164c0e2943ed9c90c04f4fa5a26417ef2576a62",
    "translation": "Hanapin ang **padron** ng pagtaas o pagbaba ng mga bilang para malaman ang susunod na bilang."
  },
  "209": {
    "sourceHash": "ad201368e1980c764166f019e985b092d125903d3053453d09b0f13bf3964251",
    "translation": "$2, 4, 6, 8, \\square$ → tumataas nang 2 bawat hakbang, □ = 10"
  },
  "210": {
    "sourceHash": "24f228de93ae41ee94e585fe2c3675f28536c2e24907a8b14752cec2630fc42b",
    "translation": "Ang pagpaparami ay paulit-ulit na pagdaragdag ng parehong bilang, at ang **paghahati** ay pantay na pagbabahagi. Kung alam mo ang multiplication table, madali rin ang paghahati."
  },
  "211": {
    "sourceHash": "a5adf183686a91910db03b22a67d00c7a65a7a1a650f23f483defa699af517ef",
    "translation": "$6 \\times 7 = 42$, $42 \\div 6 = 7$"
  },
  "212": {
    "sourceHash": "e4c2e11b26df67c4bde55d1eff32b9b7a1c23bcf39a38cc9cbdd62e9cbf58d87",
    "translation": "Ipinapakita ng **praksyon** ang bahagi ng kabuuang hinati nang pantay. Ang bilang sa ibaba ang **denominator** at ang nasa itaas ang **numerator**."
  },
  "213": {
    "sourceHash": "e840fbfa9c208c0927e20e9d442e7974cc224369b609fb416184236df956ad60",
    "translation": "$\\frac{3}{8}$ : 3 bahagi mula sa 8"
  },
  "214": {
    "sourceHash": "a3f6c4ec74079d280937beffd05b385b8c72775510710f214659f8d6f8ff69cf",
    "translation": "**1km = 1000m**, **1L = 1000mL**, **1kg = 1000g**. Para maging mas maliit na yunit, i-multiply sa 1000."
  },
  "215": {
    "sourceHash": "a6fb2ae128e6aa00dea98d9c89ec14cfae080528bfeaf77cdbec080bf0851a81",
    "translation": "$3\\text{km} = 3000\\text{m}$"
  },
  "216": {
    "sourceHash": "05356fbc70899984a2a52371ceb739980befad016866a9f27a033a788715e8b1",
    "translation": "Ang **anggulong siku** ay 90°. Sa bilog, ang **diyametro** ay 2 beses ng **radius**."
  },
  "217": {
    "sourceHash": "a4580288fa71b2ea597b4503c37c2fc4002031781973b862f8d94b61c9465bfa",
    "translation": "Radius na 5cm → diyametrong 10cm"
  },
  "218": {
    "sourceHash": "faaff92ad13edbb869a2bc6efbe8382838c03ecf06518312332c30e74b1341ac",
    "translation": "Ilagay sa talahanayan ang resulta ng sarbey para madaling makita ang pinakamarami, pinakakaunti at kabuuan."
  },
  "219": {
    "sourceHash": "73ec572983cb752ed1cbedc87ae462bab145302605cfbf9f60fd131b22076f79",
    "translation": "$7 + 5 + 9 + 4 = 25$ tao"
  },
  "220": {
    "sourceHash": "aaef65d06a79df52205c618a62b18028ead51d4520433aecd3f7c1b3c4528b1b",
    "translation": "Basahin at isulat ang malalaking bilang sa pangkat ng sampung libo (10000). May halaga ang bawat digit ayon sa **halaga ng puwesto** nito."
  },
  "221": {
    "sourceHash": "50de37f7fc20ff8418ccb7579ec2992aa25056ea08e0779a0dc3faba826fa625",
    "translation": "$5 \\times 10000 + 3 \\times 1000 = 53000$"
  },
  "222": {
    "sourceHash": "90f99482b2f11c9a2e083d057971fa4d31c52786aa3e62cf7eb370f86aa996b1",
    "translation": "Hatiin ang bilang na ipinangmumultiply, i-multiply ang bawat bahagi, saka idagdag. Sa paghahati, tantiyahin ang kusyente at suriin ito."
  },
  "223": {
    "sourceHash": "daff3aa8bc8534e69e5e6a54e16cf648afeb2be4aab12605e4968c890c8ba3fd",
    "translation": "$34 \\times 12 = 408$"
  },
  "224": {
    "sourceHash": "a45f1c66fec789b06e001a43079e7eefd271ce355734fe476e91ab0d10884e7e",
    "translation": "Sa mga praksyong pareho ang denominator, idagdag o ibawas ang **mga numerator**. Sa desimal, itapat muna ang mga tuldok desimal bago magkalkula."
  },
  "225": {
    "sourceHash": "96ea1417743378757d8cef0d8602a895a100741a03259c67dc27bf28e1c92dd3",
    "translation": "$\\frac{3}{5} + \\frac{1}{5} = \\frac{4}{5}$"
  },
  "226": {
    "sourceHash": "61db665a7235febcdb1d31c0d4ae24ce1b7d9890e788122489f55ebd6a857107",
    "translation": "Ang kabuuan ng tatlong anggulo ng tatsulok ay **180°**, at ang kabuuan ng apat na anggulo ng apat-na-gilid ay **360°**."
  },
  "227": {
    "sourceHash": "a7fbc45983a4b290e6279ca33ce936105bba62932170711c0cf679909c38512e",
    "translation": "$180 - 50 - 60 = 70$"
  },
  "228": {
    "sourceHash": "7ada664d5e0c5b9d558a2b79b229526a12ebac7b7f0c0687f707915d617ea031",
    "translation": "Basahin ang datos para mahanap ang kabuuan at mga diperensiya. Ang **average** ay ang kabuuang hinati sa bilang ng mga halaga."
  },
  "229": {
    "sourceHash": "57df51c38a16e96d092b60dd4000086afa64f1b61cdb15765f3e183b34dfd2ef",
    "translation": "$60 \\div 4 = 15$"
  },
  "230": {
    "sourceHash": "c4b0473b7b80801f20266032eff4f29e436aa9e900e698a5b75fb22c2ba14dd0",
    "translation": "Kung magkaiba ang denominator, maghanap muna ng **kapwa denominator**. Pinakamadali ang paggamit ng pinakamaliit na kapwa multiple ng dalawang denominator."
  },
  "231": {
    "sourceHash": "7c038a53ad716b2605e8f160de23f97aa632a3d6c2a436f9a6f2c147258d2bf8",
    "translation": "$\\frac{1}{2} + \\frac{1}{3} = \\frac{3}{6} + \\frac{2}{6} = \\frac{5}{6}$"
  },
  "232": {
    "sourceHash": "eaf3fc33b33dd3303548b552481d17e9bcc7491574d4eefec66ea6290236365b",
    "translation": "Huwag munang pansinin ang mga tuldok desimal at mag-multiply na parang buong bilang. Ibalik ang tuldok desimal upang ang sagot ay may kabuuang dami ng desimal na puwesto ng mga bilang na minultiply."
  },
  "233": {
    "sourceHash": "96920471bca5f7894bfaf9eb6db5e7a98dbab1da896040e0024038038697be2e",
    "translation": "$0.6 \\times 4 = 2.4$"
  },
  "234": {
    "sourceHash": "327e9c04ab34066979aaa678d6b378db0e497e3569ca5bbc57bbd30c67669f67",
    "translation": "Ang **salik** ng bilang ay nakahahati rito nang walang tira. Ang **multiple** ay ang bilang na minultiply sa 1, 2, 3..."
  },
  "235": {
    "sourceHash": "36cf852a00a7f02a13d60b560d7f27193a85817a47ea0938773caebc3a163bbf",
    "translation": "Mga salik ng 12: 1, 2, 3, 4, 6, 12"
  },
  "236": {
    "sourceHash": "bae7559c2e54a8cacdad164669f6923762b355ca223ad0f4b7121af077b7b99e",
    "translation": "Parihaba: **haba × lapad**; tatsulok: **base × taas ÷ 2**; bolyum ng parihabang prisma: **haba × lapad × taas**."
  },
  "237": {
    "sourceHash": "0251841d00fd605b3c60c2eb3987c1926400833c7de08913ba2fbd68b035bd87",
    "translation": "$8 \\times 5 = 40$ cm²"
  },
  "238": {
    "sourceHash": "b8a50676bd57d6e2b532423dcd4cbe31f38caf967d907bfc299e07e812c83183",
    "translation": "Ang **rate** ay ang inihahambing na daming hinati sa batayang dami. I-multiply ang rate sa 100 para makuha ang **porsiyento (%)**."
  },
  "239": {
    "sourceHash": "9939d089afdef33bb4af1a1a7e414a106906ca3b07336c14a81614901b777f7d",
    "translation": "$3 : 5 \\to 3 \\div 5 = 0.6$"
  },
  "240": {
    "sourceHash": "3007fd8c27bf38f9a886883c7126ef27b22d66f9771abe7411575f16e852c567",
    "translation": "Para mag-multiply ng praksyon, i-multiply ang mga numerator at ang mga denominator. Para maghati sa praksyon, i-multiply sa **reciprocal** nito."
  },
  "241": {
    "sourceHash": "932b8f4db1951d7e98be375879f4973ac5252bc6f80859893758c46cb8b06fa0",
    "translation": "$\\frac{3}{4} \\times \\frac{2}{5} = \\frac{3}{10}$"
  },
  "242": {
    "sourceHash": "6c19f0ab9efa9618c26fc9057270e0bdb7b455808adcfe28b34e754c4c92c1df",
    "translation": "Sa proporsiyon, **produkto ng mga panloob na termino = produkto ng mga panlabas na termino**. Ang paghahati ng kabuuan ayon sa ibinigay na rasyo ay **proporsiyonal na paghahati**."
  },
  "243": {
    "sourceHash": "ecf5689a1cda9f73367fd248467d6b002696a9df149679d7d2e946c4f6a9ce7c",
    "translation": "$3 : 4 = 12 : \\square \\to \\square = 16$"
  },
  "244": {
    "sourceHash": "71d30d615ad2b4daa9d648312f9f47e979adc03d1dfd11d2b98730ecd4d1dc5f",
    "translation": "Ang **porsiyento (%)** ay rate kapag itinuturing na 100 ang batayang dami. I-multiply ang desimal sa 100 para makuha ang %."
  },
  "245": {
    "sourceHash": "93c46b2d019bf31e4f30fe828c73d770c22c142d2414f13fbadb322e697f3a93",
    "translation": "25% ng 80 = $80 \\times 25 \\div 100 = 20$"
  },
  "246": {
    "sourceHash": "7097328338362d122690ff5d1fbeb105a656bed813d8936e806b155baf0897ca",
    "translation": "Ang sirkumperensiya ng bilog ay **diyametro × 3.14**, at ang lawak ng bilog ay **radius × radius × 3.14**."
  },
  "247": {
    "sourceHash": "b8cacd37f923cee6812ff4d9b057228f9699f85840546dbd482b5107b59a08bc",
    "translation": "$10 \\times 3.14 = 31.4$"
  },
  "248": {
    "sourceHash": "e4d6ebef7a8084f47ba11b6512d8660538d9b04b08d500efdc05c65161e9f113",
    "translation": "Ang **mean** ay kabuuan ÷ bilang, ang **median** ang gitnang bilang, at ang **mode** ang pinakamadalas lumitaw na bilang."
  },
  "249": {
    "sourceHash": "0c3f367aeb8283ec20bd2afd65e24b476ed75481b3fa4f22355f623ff0fef471",
    "translation": "$(80 + 90 + 70 + 100) \\div 4 = 85$"
  }
}
