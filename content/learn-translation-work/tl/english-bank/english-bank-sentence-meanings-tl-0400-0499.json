  },
  "448": {
    "sourceHash": "06bc6d83848da26b6033b559bf24856dc4922e6a77770cb246ec4be27780aa5a",
    "contextHash": "bff93084c608a62d89fcdc92be1473ce6b44320f5a93675a421b99f4c18a220b",
    "translation": "Maaari po ba ninyong buksan ang bintana?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "449": {
    "sourceHash": "e6c1dfd3ef644ebfa3440b75d1af50d28f9da3dbada835456e90fd9301cff780",
    "contextHash": "ab551e3c98220379338b30c8e1fc0035f3f82b298ec52e400c3d4a2b2a6d944d",
    "translation": "Inaasahan ko nang may pananabik ang pagkikita natin.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "450": {
    "sourceHash": "139fb9462f1b79df1509ec301cf3f91ff2c03a447461941bfe3780ffb809911b",
    "contextHash": "240acfbe8300f9a07b339d4b6f791225c495454959406e6896b1e2b5587f222b",
    "translation": "Ilang tao ang nakatira sa inyong bayan?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "451": {
    "sourceHash": "c2d418a4466bfca124e899d32d70e012ad3b385782785cf9634d8ebdb92802a1",
    "contextHash": "13d7fe2991bb59caa1098b34e79521689e449143d42a2d9084042ec84636da99",
    "translation": "Mag-aaral ako sa mababang antas ng sekundarya.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "452": {
    "sourceHash": "b327db5a861f0f46d2dea4dcae14569ecf94fafb4cdd14e36e5948a6078b032d",
    "contextHash": "22888f1942276ebd9af093790c6d8f917db3f95761e008ac856c009b41d15fc8",
    "translation": "Mula sa Canada ang bago mong guro.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "453": {
    "sourceHash": "3628efa228796612d84d5d60e72f3ce3183c41618e10f09c69d8a8ec79ef5e26",
    "contextHash": "d0724d64d9f6ac70d703b847de9bc169d66da14a68743d6d0c9e67b05d2afa17",
    "translation": "Mabubuting magkakaibigan tayo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "454": {
    "sourceHash": "76eb76c10d04ed91b2ac2f17d9075d629859d86951531cf2eca2cafdfcba9db1",
    "contextHash": "e062034ad3da355c5c14274a34680cdde988e23a7422875d1a52bb0affdd6bf3",
    "translation": "Nasa aklatan ang mga bata.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "455": {
    "sourceHash": "5cdd1dba55b8d92eaaa2d7487ad87ef6ab20780dec6918012f528b8769b8f0f4",
    "contextHash": "392e90afbb158b0982b8ead89f4c94fab08992c3df303500db1ae07605fa8d47",
    "translation": "Magkaklase sina Tom at Jisu.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "456": {
    "sourceHash": "ebdfdbe5a7bcc4f6ff809a6a7eb0748d95bf90ec82370b3203cf9d445fa637c7",
    "contextHash": "72f63d0b44445e4ec8f49c8db1fbab8170b67afdd394241db96965785cb3483b",
    "translation": "Malusog ang lahat sa aking pamilya.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "457": {
    "sourceHash": "404258168150f9ba9b9bad6343858e2bd82645ad0a57b96c0107c69d47c78597",
    "contextHash": "f502d67bb5516163760e45f6b3b48d0302017d02fc8ce8c8193c8b7410f2b636",
    "translation": "Inhinyero ang tatay ko.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "458": {
    "sourceHash": "b4768174157959ce1db34cd368d57a08c6ae468a507f907cbcb07fcfbebb5a5f",
    "contextHash": "948e386792974f1df9b0f5583e8c0b615c2d97ba1e5da00d5cb51a7240b55726",
    "translation": "Masyadong maliit para sa akin ang mga sapatos na ito.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "459": {
    "sourceHash": "b553940af726ed25ad42ab57232f3a6c0f1e39ffb96344a174869211a3b8f297",
    "contextHash": "f5143cddd956b92546d86ff4b0f57b20f6c48f0173b48c08bf61f81d6d680087",
    "translation": "Hindi ko payong iyon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "460": {
    "sourceHash": "fa73f9dc1e4e3298d08c42f4f21bb2cdf3fb1d21989b89de91753f3d7d85c6c2",
    "contextHash": "a2a6ffd51d6684a76de6567f2919190e3f37705c253f235261c4b202a5c5e276",
    "translation": "Hindi ako gutom ngayon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "461": {
    "sourceHash": "1d832d5eeea74a8e3323c1ced8f5afc03e156b3515a8c7a9e13e63e7ead17da6",
    "contextHash": "c88a431296b313eb05808c97b94c984d2b35825f1b733ee42226314d2b4482c8",
    "translation": "Wala sila sa bahay ngayon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "462": {
    "sourceHash": "bf7c5327a4c1576de394bfdd5a37c66cf5702130b411bf8c978e8b1bc8284ed8",
    "contextHash": "b44f8775a25861008e85cd0173dcfc17c529759f12d67b7a5261ffe525d820f1",
    "translation": "Hindi siya nars; doktor siya.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "463": {
    "sourceHash": "1754dc8a821b71135a6e70c90b8e6c39af1f10593f2c34ae2050a7c365e8d4e3",
    "contextHash": "af846bf4215f114686af6e528aff7801d5198782def8a70a78ffd168d2e51132",
    "translation": "Malamig sa labas ngayon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "464": {
    "sourceHash": "e0df39e9deba60efe62659762a0ceac05dd8b67d86e9cc2f0c89e9a67489d07b",
    "contextHash": "fe714882b8620475b728af81feb0362701dd182afadd27fee4824d59912dc79e",
    "translation": "Handa na kami para sa pagsusulit.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "465": {
    "sourceHash": "7018f26fa188e724e02645b2d834c5e2f2229d954be9aa6d6db380612c51095e",
    "contextHash": "2e6cdbd1aa18357994768b2ed0634cf9ae5ef98eb3d10ef99029863cf29099df",
    "translation": "Bagong kasapi ka ba ng samahan?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "466": {
    "sourceHash": "1c9445d4fd0e35553c864f0de2013498a5871ac34982b248760690cb9ff9455c",
    "contextHash": "d45bbad571dc79d6f06c66569bc04d4f629b6b3cf4080105489155ab510cd7e7",
    "translation": "Nasa parke ba ang nakababata mong kapatid na babae?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "467": {
    "sourceHash": "d2401d151979dc29fef3f540a3deeb2531edb1a6e8f1a0297636d295d08a8535",
    "contextHash": "930b0773fe7c9d81762e77f325ea11d47e1303c85c2c2d066b7071dc496e2747",
    "translation": "Masyado na ba akong huli para sa palabas?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "468": {
    "sourceHash": "86b9cda1c5a5c542bc7a02a2a1638e7ad4468938ea92a071b5f916158a9a1b4f",
    "contextHash": "1468339a3fa074f77022bc39bb2263c3b9ea302920a6710541984f8046337315",
    "translation": "Nasaan ang asul kong panulat?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "469": {
    "sourceHash": "65d7bfb55e2232b019af4591923d6c79c45a53d95d31fb815cbebca651492417",
    "contextHash": "eefaa035ddc07197e6d49c37c36c4fdc5b13014bdb6ab8bc3266238cfcab4cc7",
    "translation": "Ilang taon na ang iyong mga lolo at lola?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "470": {
    "sourceHash": "fb3134381e5494c759ffda2563dcbce61e6817185e42c6d8be52c0a2de3e38a3",
    "contextHash": "f63aa0b85963e752f2f4a91e2fc4d6b87de55cb65341fd848a3abcd77a13c230",
    "translation": "Anong oras ang konsiyerto ngayong gabi?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "471": {
    "sourceHash": "d9ce149259dcb57d1f3335699059e628a8f790a3b8f2f31597cfb6dd1d9d91bc",
    "contextHash": "e0d88e5e121bb73776e40898e3cc2c932947a8115faa3fc84b64245261bfd9e7",
    "translation": "Sino ang batang babaeng iyon na nakasuot ng pulang amerikana?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "472": {
    "sourceHash": "d639971a2ca46afe5dbb75069de598c88a84c5434d87f66d7316ab19b455353e",
    "contextHash": "48550b72919053b4f1a2b66b7654b3f261c855f2b0ff55e0630575ea52bf1fe0",
    "translation": "Bakit napakasaya mo ngayon?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "473": {
    "sourceHash": "5efc86879faf210d3581a1f14c1c43c264987e750d2947eb1c4b4d0d959ca850",
    "contextHash": "b956b08792c2a06f10ea453e15b507357201bb37b92d9dc6d812d9591d2f43c8",
    "translation": "Aling bag ang sa iyo?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "474": {
    "sourceHash": "8ea5a8c550bb8a9b672c2bb4db0537a0b05e592dc236c3bc238ef5079b515dff",
    "contextHash": "3e3868d708bcc49c30ac91471555fd9086991a61a2df991dd604ca8d605166be",
    "translation": "May sakit ako kahapon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "475": {
    "sourceHash": "7f4912a34fcf4668664e8b2cd2a8695154ae9489791ca0cb95b37fac95614170",
    "contextHash": "85d257a36390539e85cf6bb7a99a0a23f92f1d2bae389311d306827a90ac45d7",
    "translation": "Pagod ang mga batang lalaki pagkatapos ng laro.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "476": {
    "sourceHash": "4d6deb197d55697b2e74e37027b117bfd1033148499c2ee6262d5130b951f0fd",
    "contextHash": "8f769bc7c77f0e6bf3222d4b096a06b33205ba9cdf6bd2552f803bd63e5187de",
    "translation": "Wala kami sa paaralan noong nakaraang Lunes.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "477": {
    "sourceHash": "d03bb53ae1e46c98706dc6cf385ba7f2033c09dc99c7d84492c24fafb31c8823",
    "contextHash": "1e27c0a64a09a488a6c56d6ea7a6767e827f6977a3d1e52608733b950a904750",
    "translation": "Kawili-wili ba ang pelikula?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "478": {
    "sourceHash": "c18f1ce5c936af9a1c86a1f2af00ddf58929517601b898751abd87a427a55ba1",
    "contextHash": "22d1aa1b133aea0a0d2b9d81237d163faacb9029074a1affa5e06ab6325bd10e",
    "translation": "Nasa estasyon ka ba noong tanghali?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "479": {
    "sourceHash": "07c6ddffb89dc9d860d64e02cbff6a648d422181268c3c4cfd467c309d38f825",
    "contextHash": "709eb47f4579f368ac4f1eb18b2d0c56c6879413e1c7e8f883456a8905fdd0be",
    "translation": "Nasaan ka kagabi?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "480": {
    "sourceHash": "315045cec85b0b2a665f636bc38c104eb202693eaf2cf5acf4993214cfeafe68",
    "contextHash": "e0e5d4818b188bc95a295ef20f1381127647c707d77938c3509a1609791c6ee9",
    "translation": "Maulan dalawang araw na ang nakalipas.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "481": {
    "sourceHash": "3d64205731291b16ff4fdb8a3511c926f3e51105566619c817295ad988c61caf",
    "contextHash": "631ff7aa3065a9c6c05da436b8bc2417c7ed3923d1ad0910d934cb31f9daa384",
    "translation": "May malaking puno rito sampung taon na ang nakalipas.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "482": {
    "sourceHash": "1a3a91e0613f22e747fc76f4bd057799acaad499a38945737ad9bbe9912606ce",
    "contextHash": "cd99acee4d8823039645d61e0a9643ec51179ce11102b6b21064cc826383daa7",
    "translation": "Maraming tao sa pagdiriwang noong nakaraang katapusan ng linggo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "483": {
    "sourceHash": "bf8de5ced78b58659a85828924985678d7fa4d65ba898e50d0cc2aebdb8f673b",
    "contextHash": "ae28eac46b3cf4289764d54d504b6812b7619fc7f8aed8462088e5542c497e10",
    "translation": "Kaarawan ko kahapon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "484": {
    "sourceHash": "c91c4c019c456dc4a81475f95d86199cb39bb0b3766ce978981faad890a12335",
    "contextHash": "cca347fa39020929b4b7a9545ce224d563b25b121e73ffb34682a4e5220cb48a",
    "translation": "May tanggapan ba ng koreo rito sa malapit?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "485": {
    "sourceHash": "6110639902e8a50643ab4d9f224606cd28bd17b6b31ed291c1f10c52ab1cd40e",
    "contextHash": "4954f33050cc7e6009393a725bbc38ac2bb460c24365e26184afe3a7962fbc83",
    "translation": "Walang kahit anong upuan sa silid.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "486": {
    "sourceHash": "a5af0001c690c00448365b2ff047fac05c69375372c988cdc571230617d64315",
    "contextHash": "f8dd459930bf9da23d66290cb1ad8081fe2a3645014fdaaeb957dab75937848b",
    "translation": "Ilang mag-aaral ang nasa klase mo?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "487": {
    "sourceHash": "08c41bdf3d064eba68167fa1fdcfd6e6bdc815b578e705e3fb9b82d4bc8d0197",
    "contextHash": "d802fdd6c2a6e45924bb3ab70bfe4c3335baf4e492e3701de8857378e753ce91",
    "translation": "Interesado sa kalawakan ang pinsan ko.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "488": {
    "sourceHash": "90256dc553106b5540fe70a9f8025c4cb443948ca7d8ff25bd0fdf0b6c7971e3",
    "contextHash": "0292a8bf6a3d5640e9e36dcf67097d771f9cc7bf7c344c3be37aa5601e089608",
    "translation": "Hindi kailanman nahuhuli sa trabaho ang tatay ko.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "489": {
    "sourceHash": "240097072a1072a4b19ff038e59c522e4b698c5b6169cde2b13ed8c4a6d38518",
    "contextHash": "4e0f85487354b4ddb9fd9915c3e6e318422c2c3060014856e79f2cb65ea9afc5",
    "translation": "Pakimanahimik sa aklatan.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "490": {
    "sourceHash": "6a4ceaf9270f04eaccac24a990e19eaec9f63352a37233c3f144edae0a26446e",
    "contextHash": "e4cb7f97e2dbb7a77a4d56a01ee3336ca8b906120e731c20a4810e8d3f0246d8",
    "translation": "Huwag kang mahuli sa klase.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "491": {
    "sourceHash": "a2fdda3f2ec1e0850baca97b18ab24a90edebf68f6e616a5c53bd7ac312ed3e2",
    "contextHash": "2119695824ab5c1fbcecdb04b3c3f3d4225fbc7e7dc1383dc0ac827b23e0e721",
    "translation": "Mas matangkad si Mina kaysa sa nakatatanda niyang kapatid na lalaki.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "492": {
    "sourceHash": "68caf559b98397a0cd1a34cad184a6f0fe531d815b4d51f89fe43e3254e7cb10",
    "contextHash": "495d85afe1e3b39ee271eef38c8f1890e6fba9266f8e7eedfa2edde86d68d4df",
    "translation": "Para sa iyo ang mga biskuwit sa ibabaw ng mesa.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "493": {
    "sourceHash": "a9da24edc1266a528ec41d143072d742017e43528d3c2261dd610ae183429e87",
    "contextHash": "cdc939a59b5c1e539efd71cdf96daa069ce3c690f929697188d04e7b58a7d029",
    "translation": "Mga susi mo ba ang mga ito?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "494": {
    "sourceHash": "5d6eb97c1e85d6909e0f689e77033a79cc4eea56162670b6f5b61a4a7dd55ce2",
    "contextHash": "9a611b973bd0730975fd60525b44435bee2d468c403d26815fa0b5f472f4f732",
    "translation": "Iyon ang salamin sa mata ng lolo ko.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "495": {
    "sourceHash": "7b41d71d817a0d67c3603ffce9b210ab0bc22ed431b3a8988a5f2678448f65cc",
    "contextHash": "b57c8f8239f59aebee50be8a1871d9a3bc9a27a6de834acbabe9a3071b3e8294",
    "translation": "Limang taong gulang ang nakababata kong kapatid na lalaki.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "496": {
    "sourceHash": "22ed99a205170b3821617e4ffec4327b1598196f83db5c0ba5615e3116b076bf",
    "contextHash": "edba3a9e9f892d6cadbdd10769a3f3831e76051c6f7d118b5931cf8a6cfc92e2",
    "translation": "Patay ang mga ilaw nang makauwi kami.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
