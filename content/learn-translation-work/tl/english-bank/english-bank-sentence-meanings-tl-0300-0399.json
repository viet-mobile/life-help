    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "308": {
    "sourceHash": "4048a00ec6840588f4efefecab615416ae1d983c56431f4e6e2eb70bb96ca7e0",
    "contextHash": "57137e8ccd8717f9502dd602f098363786967663441c36239f7298955b168a8d",
    "translation": "Handa ka na ba para sa pagsusulit?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "309": {
    "sourceHash": "23b43a5c2b0d72dfe7f221030bdab0047cbfd599476d25ada930866fab985a92",
    "contextHash": "077e85a1a68ab6f7e921f6c6c3c29015bd5641a6bc39b31b3a0f88e4fcff4420",
    "translation": "Ayaw niya ng maanghang na pagkain.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "310": {
    "sourceHash": "eac365bced8e004f5add73a624e32ef4b448ef172cdd9f38e0a258d00e5c15f6",
    "contextHash": "c572580fbada2db757a2cf956e6d66f2e268aa84101bb8ccd959e697b1216914",
    "translation": "Tumutugtog ba ng piyano ang nakatatanda mong kapatid na lalaki?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "311": {
    "sourceHash": "dc4a941e4989c63406419373c831158d68afd7c535557f2b3eae867d6ec2bf8d",
    "contextHash": "488d93513dbb0af6fe54d40ab5971dd25968790080d3b4a5edab740f0bcd2e44",
    "translation": "Hindi kami nanood ng telebisyon kagabi.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "312": {
    "sourceHash": "eaf97b52fcf57c74dadba1ac400d0b2edde248217885fc70f079f8ca0058a1f2",
    "contextHash": "45dceb4c132e4869d9223cf1924f2b83acc4be7ed68a3ae00073d96758d65b1f",
    "translation": "Natapos mo na ba ang iyong takdang-aralin?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "313": {
    "sourceHash": "c5c326d15e4155af870951eb46f7028f6c134001f19baf52191602befe434be9",
    "contextHash": "aca8a27b60a26da3a821c6233d07404a704a09881f35a207d914040920454e71",
    "translation": "Wala sila sa parke.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "314": {
    "sourceHash": "3c198a465ab4964864a6639c8ec132d607e83445136f853d8e26eb2feb2a6ec3",
    "contextHash": "17b0ddb72e66ae3c5e16476a4dba51bfc3084d3874fe7f6b43c147d6c8348f48",
    "translation": "Hindi gaanong mahusay lumangoy si Tom.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "315": {
    "sourceHash": "fde4ac380cc65a04a2760529948e3f55292c034891eb1c1dfc6a273585c37aa3",
    "contextHash": "4f35380e2ef3f96b0559302e2c572bddd207bc95067556f7b74a1dbb23b9c124",
    "translation": "Maaari mo bang buksan ang bintana?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "316": {
    "sourceHash": "332fe83d3fe9e592a4bc7daed34b690ca80f508c1b88e5523ae33d90b1547da0",
    "contextHash": "cfcd0e55518f2a107095e3f9ab5d87067c7738f0358402ce6effcd53ed2d0b3f",
    "translation": "Wala siya sa bahay kahapon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "317": {
    "sourceHash": "63b5dfa1e649a04d09a53521a884f94346e39749ba32a9691874c201b2b0777d",
    "contextHash": "1d3807c02639758e4c3e674b0107edf30c348af0605442e7df95884009e77339",
    "translation": "Nahuli ba sila sa klase?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "318": {
    "sourceHash": "90260c08011c9ee1af476a1faf981a5dcdcb9e666300f14f2d1e96b558bc42c3",
    "contextHash": "67dc72ea7d4d7d960326431718aa13228b7609fa5fbe6b4d0de2c60a0a34e943",
    "translation": "Ano ang gusto niyang matanggap sa kanyang kaarawan?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "319": {
    "sourceHash": "68b39a9768c8c7982b8d6d8f2a2cf4d7a83735d71aefada1e3ad8292322c9f99",
    "contextHash": "e1a00df14f47b700d3efcfb2246689862fe60a568b005c425de767e42717892c",
    "translation": "Saan ka pumunta kahapon?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "320": {
    "sourceHash": "93f61407dc8dec8d24bb812b7d1861d3bd006c454735daef40e08f4af267130c",
    "contextHash": "ffd2a5f3086e4baac710d410a03f9ea344a5461730d3beee2ed663859d980674",
    "translation": "Wala akong kahit anong lapis.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "321": {
    "sourceHash": "6a3b1e7cf664b965b9a197747d074e00ac52d03570e12a367e66d0b978d5ff88",
    "contextHash": "0d84ff0a6e4a588a65109583c9e1a9c888ca3448a11b0a60de69d5f119861923",
    "translation": "Walang kahit anong itlog sa pridyider.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "322": {
    "sourceHash": "a4081984691bcc84b5b8214f6d2b1503adeaab3ed2d4331ce525f8eee8d8e716",
    "contextHash": "237802b5d0904ca30f1f41f78ebdd62ebb388c3ab452befe87c3cf13559ed963",
    "translation": "Nanonood ba siya ng telebisyon ngayon?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "323": {
    "sourceHash": "9f3368eae64a1bcb981e522bb744f5d834ad79d91b32ecf13ab71d1e95a3b984",
    "contextHash": "12835c07ced1177f976e549ee1f710c50e755a86aa02078311980f18984879b3",
    "translation": "Hindi siya tumatakbo sa pasilyo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "324": {
    "sourceHash": "a38acc22d6859fdaf312596bcbbee3eec78022726823c1e5d29f1e89c1ee903b",
    "contextHash": "dd0ac6939f1822559c21dff51c52b4978f5770039d65b3d8a824fb38e0e385c8",
    "translation": "Ilang aklat ang mayroon ka?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "325": {
    "sourceHash": "1123a6818b604d59789635029309ef6b34aaad7148e542863d865c8da8e9c4a9",
    "contextHash": "20e1c7df8c4dea40633bc26e6352e9137910149bc5750bae9fb9a92cf5f56a54",
    "translation": "Kumakain ba sila ng tanghalian sa paaralan?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "326": {
    "sourceHash": "ee08eca73666be087a801797a9e5267f84f4a42bc39e259f64989f6cf4f2a1dd",
    "contextHash": "0cb6a46c606a7dc07b78da28bf6a4951c72d71cae1b1592b08707af24b27277e",
    "translation": "Hindi siya pumunta sa salu-salo dahil may sakit siya.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "327": {
    "sourceHash": "abd30aeafd1f31f75a1dbb83728e1f46966c0c40d3be4628d9ce52209216b558",
    "contextHash": "9bf72a348f0d60fe8ff9c405d9931c2dbd7c7f62e6735801eeba7ea1b1a74713",
    "translation": "Bumisita ang klase ko sa isang bukid noong nakaraang linggo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "328": {
    "sourceHash": "25abb2c4d2c3ba5fb5f7d6c72e35aafa887e3c73ce894576a28c71a2c5f00435",
    "contextHash": "4270d234f95fc805853abfb621635dbd572c11467622deff03acccb1aa33784c",
    "translation": "Magluluto si Papa ng kanin para sa amin bukas.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "329": {
    "sourceHash": "8e67058186ed5427c9348da634897c8d8fe95438afdbf40d3490a177cdda7787",
    "contextHash": "f56e68dd03549d18e418104d6044451724de757ff9cadd5e1cd2df566f12ab75",
    "translation": "Pakihugasan ang iyong mga kamay bago magtanghalian.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "330": {
    "sourceHash": "9b7b390a7f9ed886caef9669e4f07fcf0eb5f463a4e90a88d3c72e049edb6b02",
    "contextHash": "e2a00df4583a188e42de7c6ebd0fbf74994ab9b1c497a6f30304d285df90b99b",
    "translation": "Pagod sila kaya umuwi sila.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "331": {
    "sourceHash": "49b432b8c8e717c94e5eb320dd3fa6b1ba32bb99ab1bdc9318381c6e35b1f559",
    "contextHash": "4ffab44c252cf43e4faa4f1536f5cc7811f085d436538421203f02517dc3aad9",
    "translation": "Nahanap ba nina Mina at Jun ang susi?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "332": {
    "sourceHash": "8350b7f9a8ae8fdb8a04ccb98fed697ff050fc673d82c9741bf7adadbafa1ac3",
    "contextHash": "d7edccdcc1738bb6974618bce38b70de0bc553343144532029fe894bb812d076",
    "translation": "Hindi makapupunta si Ji-ho dahil may sakit siya.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "333": {
    "sourceHash": "383641487b89454fc5c00bb0deba87599f0234c918e29f3ae2d4d9454937307a",
    "contextHash": "88e808a797989d59e4be4d5853dc430e83e417dec9e187d758e9f9bd5b7eaac6",
    "translation": "Ano ang kinain mo sa almusal?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "334": {
    "sourceHash": "9cebc1b72b1a67ed28c3fcc878d1e0a8c8b48acfaea594ce11460f871225a377",
    "contextHash": "0080d7830be2cbecc019e0910a49f9592a9eca90011d5d111d6442e662f5daa7",
    "translation": "Mas matangkad si Mina kaysa sa nakababata niyang kapatid na lalaki.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "335": {
    "sourceHash": "5ce0671a492a6b87b8cef408997bea02d3e1234855e19490d986416dfb5f137c",
    "contextHash": "88fbece83f3db8a7dc695c0218ef341fb07ed346beb527e98b3f655e90a14838",
    "translation": "Pumunta kami sa zoo kahapon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "336": {
    "sourceHash": "e3a23cbd5acd7621b5a122bc3841dab953df29cb556774d24f8c7fc13287516e",
    "contextHash": "0512114a0e1dcd5b733fdbca52eaa83979cde23222c63dbb54ad4468e2092ca1",
    "translation": "Dadalawin niya ang kanyang tiyuhin ngayong katapusan ng linggo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "337": {
    "sourceHash": "95d6af9cd10306b62228757111c27e9d4f6dee996f211490c3f46840ab5c3657",
    "contextHash": "edd0de952f14163c733ff55f825a619a33b95ac2f09bda599d14bca0948e4c7a",
    "translation": "Anong oras nagbubukas ang aklatan?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "338": {
    "sourceHash": "c9e0e4a85d6d6453513f295dfe00255410e73b062b332ce9b3bdae855ced09bd",
    "contextHash": "a2d379efea4e74d1be45c94b93419eb62b2aeee703a67b262eadaf0667778a0a",
    "translation": "May ilang aklat sa ibabaw ng mesa sa pag-aaral.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "339": {
    "sourceHash": "6a48e1dc2894ccf729aa67931e761cc934846b9427337016d3f535de149e1e20",
    "contextHash": "df799de8d8c0de3afd7994b8fd82c311db7b32e9ba2ce3b0ade3ced075e14163",
    "translation": "Hindi marunong lumangoy ang nakababata kong kapatid na babae, ngunit kaya niyang tumakbo nang mabilis.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "340": {
    "sourceHash": "75c75051541fad9d8bcf1007209616cfb39c1c75ed00636b93d7c773019e5883",
    "contextHash": "70fd3dfbb3702faf666e3dffe8d73d0a1f174cd783b0c6a697bf0228ab32be67",
    "translation": "Nagbabasa ng isang aklat si Tom ngayon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "341": {
    "sourceHash": "7f136d81c1421178623bfb7235e332ca34e098f5ae368e915732ff06f8224e31",
    "contextHash": "d808389be0c9c3d327066a30f04038d8026edd89d5c7fa9bd48e447e0d862e40",
    "translation": "Naglaro kami ng soccer kahapon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "342": {
    "sourceHash": "4bccd34a8629e520998ddc1ba046c4e04cde44ed5c04d5e658b1681623df5bbc",
    "contextHash": "638d3f697904bc5eecee091b22be9a2d6d12727dd8aeb8d6c3348b944c2d701e",
    "translation": "Pumupunta siya sa aklatan tuwing Sabado.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "343": {
    "sourceHash": "30a134ea850ba927fab4503f3c3e34d4ef6c00047601028fe441fad886e43eff",
    "contextHash": "01a78e6f7cd41fb07cedca927f4f0186b6d8f812c98ad00ab6730c96a71e101b",
    "translation": "Tingnan mo! Umuulan sa labas.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "344": {
    "sourceHash": "6a1d9a62eaa1db6c509b89206a7cd56e0724586c1d44418565b3d37e1d9a2a19",
    "contextHash": "bd22f61656e6adeb427ae7e365a3a2bd282decc57e6982f4b72187d8a69c8049",
    "translation": "May sakit ang nakababata kong kapatid na lalaki noong nakaraang linggo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "345": {
    "sourceHash": "eff9be42743374b5348fbf233f1509a96164d5d25e3347402d05b08e0a914573",
    "contextHash": "ba46e990f301abc67cbd87cc485aeac32f64701f87c91e7427b5fba9edca1c8a",
    "translation": "Gagawa ako ng keyk para sa kanyang kaarawan.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "346": {
    "sourceHash": "59ca5164fa5f100d9c081a366b93a6f76dc6b45e549713c99873315f68658149",
    "contextHash": "d2d9f063ba2db11e4e198e164840c96612b195aaa60d6c4a6a25d1281589e91e",
    "translation": "Nanood ka ba ng telebisyon kagabi?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "347": {
    "sourceHash": "a0cfebcf7e47dd00556833132913e463e656e52af278e133a231adcee01af311",
    "contextHash": "d4b2edeb23c8384b48b9d5400e440662eab93ce29270b8222b7b7d7a4783f5e7",
    "translation": "Ano ang ginagawa mo ngayon?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "348": {
    "sourceHash": "7c3537c813dd6a1b47623f7da582100366059e5b0673eff22190ff1dbdbe6da8",
    "contextHash": "59605d303cb8329db66acacb9087b1705e45b444e620352c89ea216565446286",
    "translation": "Magiging maaraw ba bukas?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "349": {
    "sourceHash": "88648874e7efea57ea28c3d95eea9c7bd0b39afcfc0fb97191e56ab1376e9015",
    "contextHash": "9043e615c0b23088a28baca2fa86a33a7eaa04d0cb522664e042d5d2cfcc7d4d",
    "translation": "Hindi siya pumunta sa paaralan kahapon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "350": {
    "sourceHash": "91fdbc24a2140d0d96c9e58b4e30e3209541744a545809921b7aa6e3283a209d",
    "contextHash": "278d89347aaf1ff4fa564d8ef856c82c508f573505f720890195016bc0a5c6db",
    "translation": "Manonood sila ng pelikula ngayong Linggo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "351": {
    "sourceHash": "98a0af09bcf5d80f267c3f3f31bbed919ebc6653c638ba5c8644748bfc69c17b",
    "contextHash": "191562554faefc0510cb3ccafc36e12a36f7513d18d5c16a9f647ee0600c164d",
    "translation": "Gumigising ako tuwing umaga nang alas-siyete.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "352": {
    "sourceHash": "4e5f043d9e1d34ddc38d47ca4ada746082bfe532f25f507cb17e973c05f35b03",
    "contextHash": "14d4b3cf708c3acb7c031514cc6df11a418669cb088656e2c76c8fd0210d5f07",
    "translation": "Bumisita kami sa Isla ng Jeju noong nakaraang tag-araw.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "353": {
    "sourceHash": "fd9aa460e3e19593856578e3bdcfa12f8fd8dac81cd85271a3daa45b803d64d9",
    "contextHash": "d4b9dd1feac7a391c639123324dbbb2a56b46dbc163df6ec54308941b47516ac",
    "translation": "Hindi naglalaro si Minho ngayon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "354": {
    "sourceHash": "94e04e7defe6daae4fa8be6a767d1f647d3bdc772c06b66f37cb446464e189bf",
    "contextHash": "17cb4079163fb86d4bbb0f570432bd97d7c877e5811bb900850a635aed322ac7",
    "translation": "Tingnan ang makakapal na madilim na ulap! Mukhang uulan na.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "355": {
    "sourceHash": "e0b123815760c24e9e805d4335d3b9a4445fcdb4630909a54c2ee6adb82435ca",
    "contextHash": "e4bdab3ccba33e360ee721f6733faffce97311dde3f42ecaf8cbf799cf17fa6d",
    "translation": "Nag-aral ng Ingles nang isang oras ang nakababata kong kapatid na babae kagabi.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "356": {
    "sourceHash": "1b0a8757c07c4a5196a6acbe3323f5f3713ef967c0a3a71b519377d2eba23890",
    "contextHash": "9acb3e4966bfdc1d4a5d82b84c9f60334d27bac0beb534bcf627fa57d725b7e8",
    "translation": "Nagmamaneho ba ang tatay mo papunta sa trabaho araw-araw?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "357": {
    "sourceHash": "f4330ce7b4f6c7daa73ec8e08cb70f9447d31dbf7e318997c3498a546afd12f9",
    "contextHash": "301b1b9d2a37d353430937d4835ec6608e2dc07a9342de4e3c52c074e3635930",
    "translation": "Hindi ko malilimutan ang iyong kaarawan.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "358": {
    "sourceHash": "20f062b1f12f0a2b8ae63a3620a8e929f04d58ae3148a52633664375424c0d3f",
    "contextHash": "9c3b730ba10aa85d67963c3e2c4427710b43b0abd85251ed0499b0d9e5170695",
    "translation": "Nakatira ako sa Busan noong bata ako.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "359": {
    "sourceHash": "f16ff350d53ac67a7f46208323d2e9a98a4f7272cde1fa16f1b4560b42c43986",
    "contextHash": "a2e1e437f05d13a1c57df0ccd26fb62d666926d403ea5ab2519bf912c0d4076d",
    "translation": "Kaya niyang lumangoy nang napakabilis.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "360": {
    "sourceHash": "a9bfa0fb971336012cf345c3036bcc25fe12a4921e1163cf10874cf8fa9e8357",
    "contextHash": "eb90d29cfb9638d4f83d84fada5e8220696504980276c1d256880f30c69415c1",
    "translation": "Dapat kang magsuot ng helmet kapag nagbibisikleta.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "361": {
    "sourceHash": "05e4572925bb81764ccb419696769ffbde73f8becc0df295c910a2ad0c11cf9b",
    "contextHash": "aef481424a967e15dc38998774030faccdef4a8b974cf1afa04813f0596c6402",
    "translation": "Mas mabuting kumain ng mas maraming gulay ang mga bata.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "362": {
    "sourceHash": "c3a262600b88717a2580c488f6a7da3a250eeb8620b0f6f81e902a228e456726",
    "contextHash": "2251c70457627c68851da3fdb89587696ca50e0e53533002ae33b7dac944d5ac",
    "translation": "Maaari ko bang gamitin ang iyong lapis?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "363": {
    "sourceHash": "3b67a692c121ac6910eec7aecc596b266977a2776040648f52596cfc7c98dd7f",
    "contextHash": "342878cdfadff585fcb69de6217d0b4c8ac1322852541f0cf80dd6af20f0cba5",
    "translation": "Maaari mo ba akong tulungang ilipat ang kahong ito?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "364": {
    "sourceHash": "79c9bc7ee1d121344826095e315b23033caa2ea539bc622f3f76580f070853f7",
    "contextHash": "29b55a5604576daf5d0348263366c131ffb8f0c3fad2f2dc201cb9862b98b5d6",
    "translation": "Hindi ka dapat tumakbo sa pasilyo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "365": {
    "sourceHash": "2b108c7afdf14ee31c7ee3268668f78a05596c903cf25fe1215aff3c83406e08",
    "contextHash": "6e24b4dfb8dea41473e4529e5176a1d1ca5a40b07335e602dc4e28cb3e1b0bbe",
    "translation": "Hindi pa siya marunong magbisikleta.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "366": {
    "sourceHash": "dda5f6c65970a07a7058d5d201db1e38758eae7070896de314a897c14033e938",
    "contextHash": "9296c61292626059b7e295c56d7ee05674d31a5ef6e86332ce1ae3105fc46142",
    "translation": "Mas mabuting huwag mag-usap ang mga mag-aaral habang may pagsusulit.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "367": {
    "sourceHash": "f10d3521041b306a428ba11a33ee77ac2c4044c52b4ca3b34cf0b266137ab33a",
    "contextHash": "f335330315f56be20c5c740992ae3c4b1959a1f5a83bcfa0e0746fdc773da21a",
    "translation": "Saan ako maaaring bumili ng tiket sa tren?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "368": {
    "sourceHash": "6c98e05c9798beec09ab8cf8367fa9e3b7aa842e1676d61687c337e0c70ed68c",
    "contextHash": "fe30fa0d446e5bac66a1e7411c3229d6a63bddd7c0fa36469d57ecb1eb677b69",
    "translation": "Ano ang dapat kong dalhin sa piknik?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "369": {
    "sourceHash": "49b1fb09cb697b528c542e3de3f9050f65a36fa31bdd28c4fe29bb72dfdbda81",
    "contextHash": "2c4bb700b0efbbb91f22ff5de2a01e7790275f0a766a542429c73d07d272dc55",
    "translation": "Maaari mong iwan dito ang iyong bag.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "370": {
    "sourceHash": "e424293f24d474b7a157578eda71352a907127af4c6fba2a8681caf8e7eae3a8",
    "contextHash": "69bbb4273c9cf8fc4b9ba4c8c2e64a5339aa310e047df1c2cf21d74780ff1418",
    "translation": "Maaaring umulan ngayong hapon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "371": {
    "sourceHash": "e9dc9a5e47ac538d4557f411d0e80d639a144acffff0d2cef3c22ff1a0d9a374",
    "contextHash": "d24757e99ebc1373780cdfc26ad1e5d9f47377ff563dfe3f6ca4c993a4d3347b",
    "translation": "Nakakalipad ang mga ibon ngunit hindi ang mga isda.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "372": {
    "sourceHash": "5df94cc87a7220ec04ec7ce739f7846b1355926bac071039f519eec944b48e2a",
    "contextHash": "bb261ef23a347fbfd41d4f7859612d861d0a44207f78d7b106020b0e2b4ef209",
    "translation": "Dapat nating panatilihing malinis ang parke.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "373": {
    "sourceHash": "25895f09dc98a258f4c61953af9dda4b0426137057ecc34bba4e7e0887ddac51",
    "contextHash": "7a369098e299b254370ca16b38ef0d8e25634672e375e739ce5dd7228d0f5c05",
    "translation": "Hindi dapat hawakan ng mga bisita ang mga ipinintang larawan.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "374": {
    "sourceHash": "f0f943add3ccfcb897e1edf2e255df40948906402e7450c92fb2233f10b64b29",
    "contextHash": "e044eb3ff0918c21c79fd1bdffe9aba6a9179145fd1788d1761baccd2524b0fc",
    "translation": "Napakadilim. Wala akong makita.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "375": {
    "sourceHash": "96a65e299d507fa8b38184d13a85169e01259b162c451ffacc0060492ccae72e",
    "contextHash": "e2915e0c0175f3385e637a79becd933e2a24235d1af5bf7be8e6f44673482f0b",
    "translation": "Maaari ba akong pumasok?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "376": {
    "sourceHash": "e2dfb368bc7d3005d45b313a1dff40929be3e037dc918259beb0cacc939cec6f",
    "contextHash": "77f5b932d92088c3ac072236aac06281ad67501ababee53223a6847a6b740e0c",
    "translation": "May pagsusulit ako bukas kaya dapat akong mag-aral ngayong gabi.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "377": {
    "sourceHash": "beae6dcb3fb1fc874c9299a87dcd6c2a8378a4a3ec0d8b78b8605275bd9a5dfe",
    "contextHash": "84cb25462d0122edfa1fe5d9078813257c662f669f0bf9eef708bad7b9643525",
    "translation": "Dapat ba tayong magdala ng payong?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "378": {
    "sourceHash": "a3a75821c94189c2c722ca35f0e2772be169c553e00501bd6c28bba554298ec7",
    "contextHash": "f4a6ded401b61d1f6f10e5410bbed159bcc3adb323185084197dbc0526cde0d1",
    "translation": "Dapat kang manahimik sa aklatan.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "379": {
    "sourceHash": "74c71e6a218a6d6d9c85307880818ed8b8cdfe9f6f52120efe6cd56d502b5d0d",
    "contextHash": "7d16c38b8530f590957b65911f750e1513a219c6dfa43d32030fce5fb38ac04d",
    "translation": "Maaari tayong mananghalian sa labas dahil maganda ang panahon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "380": {
    "sourceHash": "e5f1f665cff59a7a1e38f2d4d45e2cd5075b0a115b2bf60545ce5c7853b2d290",
    "contextHash": "311079d517bd7fb40f85c524531eac956ee08029a1f5b2e7c74ea4e2d8221ece",
    "translation": "Maaari ba kitang tanungin ng isang tanong?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "381": {
    "sourceHash": "eeb1baea2fd363e101f4b7f832cd93a47fc8eac54feef64e276ad59be5e60f78",
    "contextHash": "77ef68baaf667a7aaa96ae9415bacd847b07ff9ae15c2196914d35c92e1e866c",
    "translation": "Mas mabuting hugasan mo ang iyong mga kamay bago magtanghalian.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "382": {
    "sourceHash": "2d30f7131560372ac98478df37db5138ec041a88238c027392429247ae3edc24",
    "contextHash": "65d78d95981d9fee454ea46b0774b9924e026817c4834567cbdfba10f1c24e40",
    "translation": "Bubuhatin ko ba ang iyong bag para sa iyo?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "383": {
    "sourceHash": "8d1368183f65fd00e28dde3107186545cb08034d79d2ddd0e7435d71bef90ba2",
    "contextHash": "e39489d34f1dd777c1bc4387f290cbead5403370fb32a58973ffe6e88e7a4ccf",
    "translation": "Maglaro tayo ng larong de-tablero ngayong gabi.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "384": {
    "sourceHash": "eaad75a9e1b3e5cc0b804953830050a865ff81b8bc210bb7e283ddd05a4d9e6e",
    "contextHash": "784bbb309e219dc90737ce11ac1855b642f496e63f783ac3f095602c965463aa",
    "translation": "Hindi makapupunta si Jun sa piknik ngayon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "385": {
    "sourceHash": "1d5cec391f2c8c846e243b4f1f23dd9506a535811d1e07abf32b700669ecce97",
    "contextHash": "93ce66c133bdf554da6063525db0fe0dbc41bb5e4a3eaace0c90bd3445eaf49e",
    "translation": "Maaaring bumagsak ang niyebe sa Sabado.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "386": {
    "sourceHash": "4ef4ca01db33200a56bf689ec79cf19de79450675b8067d9b41dd8b3ef45764d",
    "contextHash": "0c2e9fa62acc254e1b0f7f96c2ed9d79e9f90edc7b822188498c94365f6e6ff3",
    "translation": "Ano ang dapat dalhin ni Mina sa salu-salo?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "387": {
    "sourceHash": "996fe3ae5926b86d6742eb1d64fb6317032fd2acedfbf3d060173b89c20bd3b5",
    "contextHash": "01aaa5825d8d696efd854ce7775159e7351265b8a9404675e4163d511fa27997",
    "translation": "Pakipahiram sa akin ang iyong panulat.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "388": {
    "sourceHash": "064799450868be9a371c2bac3d1b9c3eb72d7ad5b9f8e80c42418e63e4f7791a",
    "contextHash": "60574814c3cbee9eb2f2ae99f7be999a66ef30a9a898dbbdad81595fe7cb477a",
    "translation": "Maingat siyang magmaneho.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "389": {
    "sourceHash": "088f89ac8b86a2aa551146509ab8de7ce78e0f66c917b82be71633f75a0d6441",
    "contextHash": "bd3ff2ae2c0a5d55ba1065543ff6bb5736338449ca047d4e0978bf19030b4ffb",
    "translation": "Hindi makatarungang kunin ang lahat ng biskuwit.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "390": {
    "sourceHash": "9432fc8747fb6436496cda8be59a89a1b25aa65dfc51747f06729a9aefce3615",
    "contextHash": "9ef12cf17b3cfc0aabaf57c07c280f936c1961e034c1c2f42c38d0ab78288dbf",
    "translation": "Kawili-wili ang kuwento.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "391": {
    "sourceHash": "f916f3f46be32f6b0263961e7a254b3fad83e8b75fd75b536451fe321a26d46a",
    "contextHash": "efe4bbe2afb6522305e6de6ed479bf529538c7b4793c0be2be81dc4053fe8d51",
    "translation": "Maraming tao sa pagdiriwang.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "392": {
    "sourceHash": "d50e792dee9c7e2ad11c2ba39df935d9f5f8409c270fee96416270eef39da276",
    "contextHash": "7cea2db1f2c12410082910a04723d319b9bfdad609accc7cd3698af6b9504bb1",
    "translation": "Takot ako sa mga gagamba.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "393": {
    "sourceHash": "3d16eff6314c08b2cf9212f5a5072b93454d5db111494642efa85bb75448b102",
    "contextHash": "2139caceaf6607249b6370246ac7d31020f0d4fe7ae901a058d605ad8ce42ed6",
    "translation": "Nagyoyoga ang nakababata kong kapatid na babae tuwing Sabado.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "394": {
    "sourceHash": "78b64698793be0bab4f576824fe86d589a38d53da8b2f24ab5847bba7a20b0b0",
    "contextHash": "f8aad437c06f88074dcfdf18db5d7377d1ccbd7dc67872bbb124467030c260b1",
    "translation": "Mag-ingat ka sa mainit na sabaw.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "395": {
    "sourceHash": "f6c946f1f9bc1112ac3a1c332671650f82776cb1d044a0432a39a26ee54d7325",
    "contextHash": "3173c7a725a5324c9e614b883dc1f0ef59abe8088e0adc240100f0d0c38f6216",
    "translation": "Magsasaka ang lolo ko.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
