    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "305": {
    "sourceHash": "aa783a1987338740952192a7be91b612eac9116e38aa8999d6eb0de19b410c5f",
    "contextHash": "6cc5e2a8f3def458a17e547fef6efd28c3a73c400ae44aaf55c1319fd23ccad8",
