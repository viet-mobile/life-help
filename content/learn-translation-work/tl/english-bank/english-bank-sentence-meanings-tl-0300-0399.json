    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "306": {
    "sourceHash": "be361f9663a9bbe3a9a4a0321e9e767935928ec76c62497b1f436137883ffaf8",
    "contextHash": "9f87fed435931a92af1ded5d9aa5be572141e743b1fb2fd5a95f9c9d0e54beaa",
    "translation": "Dadalhin ba ni Mina ang kanyang payong?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "307": {
    "sourceHash": "3054badbc6e3f738fe066d342796c1a0c0e099b4b3e02364e50105dc450000ab",
    "contextHash": "fec624b917cb82568d61ef6eb19ecc8e88f5daea1dfc75b0eb5630b79d14c995",
