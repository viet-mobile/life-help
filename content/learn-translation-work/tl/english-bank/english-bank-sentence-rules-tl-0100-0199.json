  "185": {
    "sourceHash": "33194b881301acc3c837a38d3f0d9e63b18cb4d0692c128f90e324e2cf7aef93",
    "contextHash": "8cd4c85358991d2604387699b70408ebc6a6c79601ba96835e863c0c785d1fda",
    "translation": "Ang tanong na may karaniwang pandiwa at maramihang simuno(your friends) ay nagsisimula sa Do at gumagamit ng batayang anyo ng pandiwa.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "186": {
    "sourceHash": "cebd80187fd8ff2940c2ae31a73fe634684feed7521272be1ae22703b212e1de",
    "contextHash": "d557442f033f97867d11b31ea98c19a1f2c114ec660cb38167a312c8cf2187ee",
    "translation": "Nasa Does na ang -s ng 3rd person singular kaya gamitin ang batayang anyo ng kasunod na pandiwa.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "187": {
    "sourceHash": "bdcaa028951181297320f90661a094756c51be58d33bb63b83a06e853ce417c0",
    "contextHash": "4636f9cefab5c881968a2504223b9ccc04a974f5155552c74c95b617dfcf2966",
    "translation": "Ang pagtanggi sa karaniwang pandiwa ay don't + batayang anyo ng pandiwa.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "188": {
    "sourceHash": "5bf32a341c7c161c953cf70d1fc0a3ac73b3e67d414f4520fb0096f66ddfd86d",
    "contextHash": "312a8535253512eddbeafd57e0f2dc41b14588374c56c3c13806e3f59e29b81b",
    "translation": "Kung 3rd person singular(my sister) ang simuno, gamitin ang doesn't + batayang anyo ng pandiwa upang magsaad ng pagtanggi.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "189": {
    "sourceHash": "429a6ba3a2e51507b60bbeafdb5225b831e0483bcd6f0a4021e20eb4ece5c6a0",
    "contextHash": "872bedb316f031010ad508a6b6c4ffd9f26cd932bf09875f5f60c7cccb3be8b1",
    "translation": "Sa tanong tungkol sa nakaraan na may Did, gamitin ang batayang anyo ng pandiwa. Nakasaad na sa Did ang nakaraan.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "190": {
    "sourceHash": "f3b3361b1278e613da63aa76403db324f42c160e90ed1e89ce135ded08d7f1f9",
    "contextHash": "b092d116e738b2c5272db18082706f0b6bdf0024ef2aee625363e0d54dfd73fd",
    "translation": "Gamitin ang batayang anyo ng pandiwa pagkatapos ng didn't. Ang didn't ang nagsasaad ng nakaraan.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "191": {
    "sourceHash": "b122145ee2f2bb966252a158ef660b24bd91cb4a586b9d8c4a13dd970a2f0d50",
    "contextHash": "cc568ff0e4e37c9823a641646df507cfaea3980870223a12813da60febb2f067",
    "translation": "Ang pinaikling will not ay won't, na sinusundan ng batayang anyo ng pandiwa. Huwag isulat ang willn't.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "192": {
    "sourceHash": "4470d55d99c5ae22f4d3328838f6ed0ec7d7cc69aa8570826b62377ff9aae2dd",
    "contextHash": "115468074128448e962a68c7eb57e695ed4e029a686745f42c62044263b825ca",
    "translation": "Ang ayos ng tanong na may will ay Will + simuno + batayang anyo ng pandiwa.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "193": {
    "sourceHash": "6784d4090ae8d58fbd86c7d9830a025aa771114fd8f154f842421ac4b3c27944",
    "contextHash": "f68ccda90d75b124e1cdbc157928e57b94264290ee674a5b3615a305a136fb25",
    "translation": "Sa tanong na may be, ilagay ang anyo ng be(Is/Are) sa pinakaunahan. Gamitin ang Is para sa this.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "194": {
    "sourceHash": "1feb3583c69a0f1854330796106231a6e38488b93e199139a1a385bcf6fac6ca",
    "contextHash": "1b5b237577265fe7978fd6cce728bfe0fb35df77629a9d922d0288498274fce8",
    "translation": "Sa tanong ng pangungusap na may be, ilipat sa unahan ang anyo ng be, at gamitin ang Are para sa they.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "195": {
    "sourceHash": "921a004755fbb39f0f12760c9bb35a2e403a51fc42f382d8f33e892cd416aeda",
    "contextHash": "70eaa10ace749fb9f30d0236fe913902ed1c05f29179ea11e88575a6b660b45b",
    "translation": "Ang ayos ng tanong na may salitang pananong ay salitang pananong + do/does + simuno + batayang anyo ng pandiwa.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "196": {
    "sourceHash": "66860c4529a4837aad7ab3e54b83b7357f32b0a3429c9a0ddea1957bf423369d",
    "contextHash": "7a9fd001809404e4681a3634cbac7842e7381eb733bd9088a9a086b3d610362c",
    "translation": "Kung kasunod ng What time ang does, batayang anyo ang pandiwa. Nakasaad na sa does ang -s.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "197": {
    "sourceHash": "2c85909b9255283dc714d90af6d25e23897f2c275f91b94dbe41065b4cd600f0",
    "contextHash": "21c93eb35bfdc2f41440fc71e72c0ee98124398f66de94e183776d5ce029aafd",
    "translation": "Magtanong sa ayos na How many + maramihang pangngalan + do + simuno + batayang anyo ng pandiwa.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "198": {
    "sourceHash": "53d7791a92a9961d4a40f23e282aa44d338d228b27ecccc6f8d146ee805f14a8",
    "contextHash": "6a995d164f32a57ae94776f2aa854a7f4213457fc0ed53a5b27450f450d0a8e0",
    "translation": "Gamitin ang batayang anyo ng pandiwa sa tanong na may did.",
    "role": "localized_grammar_explanation",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "199": {
    "sourceHash": "ada10417595aa2754b778302df7f4d253031a670ff0340cfd59cf6a0d496c92b",
    "contextHash": "99954e7e84e3ff36a4b2c003547fd970843ff29c2c19c54539e050f0dc9accdf",
    "translation": "Gamitin ang batayang anyo ng pandiwa pagkatapos ng don't. Hindi maaaring gamitin ang has.",
