{
  "100": {
    "sourceHash": "fb939f72c934338ff6e280b549f10722a8e0d68c753fd7a4913df5a8d071dda8",
    "contextHash": "04002717cd208eecdfe5d04d625e221c7e3462b5dd0abe8eb508970a76a753ae",
    "translation": "Kayang lumangoy nang mabilis ni Tom.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "101": {
    "sourceHash": "6de9d73b3200f71781f7427470d0161c5ef6c4ef8db8c3b1f02d21f647185caa",
    "contextHash": "61f2f7d48749e660be95368fc8381bfa43fada475ad593e7520276d2c2a39604",
    "translation": "May isang orasan sa dingding.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "102": {
    "sourceHash": "24ae9ecd71aa472a070ac508683755eb2fba234f26de5dccade548038c3e3211",
    "contextHash": "616f7a596c60aaabc9546b947ac9ba4f9aa5a068a01f87677f708717d77b09b8",
    "translation": "Matangkad ang kapatid kong lalaki at naglalaro siya ng basketball.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "103": {
    "sourceHash": "da0310aa4ab3ed1aa9fe23ca07bf1d7bc28ae927078e1ba0431ce5312df08d31",
    "contextHash": "10dd5b429a2b97821a236e0386350147c5b999cafd958fcce0f35ff0a2f51a1e",
    "translation": "Maliit ang pusa. Natutulog ito buong araw.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "104": {
    "sourceHash": "0a33138262b14dd515370856f8cce9ba3c2d6542c6f2b71a73046b89d0685461",
    "contextHash": "dea7664ab744cfe6c2d9ccef33382fb1bc1db041b6dd37e9f99387798279a920",
    "translation": "Mabait ang mga magulang ko. Tinutulungan nila ako.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "105": {
    "sourceHash": "ce16d9d181cd519faeeb32aca91f9d1b109e08deea4d126e826f366bd34f01e6",
    "contextHash": "90fc990804f7c12e0cf18ce1de72af3650841f1810501fc57a0864d6faf59d90",
    "translation": "Magkaibigan kami ni Jisu. Magkasama kaming nag-aaral.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "106": {
    "sourceHash": "c6208ee49a7e72d9287e872c3cc6d86f9559881ad81c693f83bea33061d903b6",
    "contextHash": "b14624388bf8c542b55ce61a70767b6feeb47b07d5e7844733d544068f4cac3c",
    "translation": "Nagluluto si Papa ng hapunan at kinakain namin ito nang alas-6.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "107": {
    "sourceHash": "25cb1b607c8b9386aea5790814218cb94a0d52906af8bb5655ae48d20737784c",
    "contextHash": "5961df3576aea6e8e39cf0a70111dfeab1b607a37b9a62c808c19bf3f99928e4",
    "translation": "Pakitawagan ako pagkatapos ng klase.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "108": {
    "sourceHash": "1c8ee3149dcb7cd42209216cbb3a897f039d1693802bb57ec0731f59d0d7941c",
    "contextHash": "625ae44ed2eed911be018cb69b93d0c7f1552e5e0b4d9ebecd304c607cd9908c",
    "translation": "Tingnan mo ang mga ibon. Asul ang mga ito.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "109": {
    "sourceHash": "dd89ca8128727d2a4b509167ef8d3f8beeb3abf30dfb1d79b651a620a9fc3179",
    "contextHash": "7762339f3875a1e56a0f5c8893a532c29c1878f4d099bc33e8e49dea35d56d69",
    "translation": "Mag-aaral ka ba?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "110": {
    "sourceHash": "5dd64ce12012a1a837301ef0f42b5b9053d9e99da4958b79cb891e1693c7be13",
    "contextHash": "b96ab60dc5179e23e53eb658e6591f307d2b31dfcd2638883aef79ba6155db39",
    "translation": "Sampung taong gulang ako.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "111": {
    "sourceHash": "21adce822550eee2ea591702487a05599df360334599d99c652dd5fc2d769618",
    "contextHash": "1ad408c359ae0e9376989c00ff0a15299fa5ab100b1e1414f086583419cd3919",
    "translation": "Hinuhugasan niya ang kanyang mga kamay bago magtanghalian.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "112": {
    "sourceHash": "71f7a96f117f01b7409f512243f1dd7758d3d96a2a96da421724a6d07443c07d",
    "contextHash": "191ca27dc746d8c7c6d77c729845feaec77798687b5abf060cc7a68d13afc707",
    "translation": "Nakatira ang lola ko malapit sa amin.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "113": {
    "sourceHash": "38d7d72544385f231fc4d18c241ba4708a6cfd22974b822b1dbff537aa91cd6c",
    "contextHash": "f87d946921f1fefbb7cd6125dbb9c4ed73d49129b865f70d51c48f647e396376",
    "translation": "Ben ang pangalan niya.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "114": {
    "sourceHash": "15bcd75b203bf92c53cd36085818868478df77d4d1f55e64b805b58b2fffa3b4",
    "contextHash": "2d6c286e4b132f5a2e82d4ae940aa5491be7b448e9c1ed8bc7deea0f6798cc51",
    "translation": "Nililinis namin ang aming silid-aralan tuwing Biyernes.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "115": {
    "sourceHash": "a143233758c2ea4ea8784ca05d74d0128d21108fff1c2fff5d85037c36920d09",
    "contextHash": "7bd91e66bce3dc81602eddbfb6ea0eb96e53ed9f231817968026984989d3300f",
    "translation": "Gusto mo ba ito?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "116": {
    "sourceHash": "d7e284876bccc7da1a2a5779f2df0f39707ae65cea9f5b27d653084c73a70054",
    "contextHash": "6b2571eb90018272ca07d952489f937db48e1246ba956fcae90fde22aebdc908",
    "translation": "Tiya ko siya at mahal ko siya.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "117": {
    "sourceHash": "7cefc8aa2c3fe311afdb70eb0feea70f8dc1c889f8c890181bab172046d66b2f",
    "contextHash": "efccd5acec77d46b574d6d8d648261d7ea4e6a257d4823b0ad97f641ab5ebe0e",
    "translation": "Guro namin si Ginoong Kim. Nagtuturo siya ng Ingles.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "118": {
    "sourceHash": "1e255f0e572e6f9cc76bbc50009a67d59dcdc7ed16cf643174b6359158fd5b8e",
    "contextHash": "be67572aa9489a3ef4b2d432353ca166ee9ff5f5c3cf38152ec28428a2a36552",
    "translation": "Matamis ang mga biskuwit. Gusto ko ang mga ito.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "119": {
    "sourceHash": "b5bea23d93ea1b839d858f259d307e0c72d8f84954a4fcb4dce651932d4f7fb9",
    "contextHash": "f19c711e819049f885e013ccb81bbf2d386d887387e703e2dc7198d20dea4ffd",
    "translation": "Lapis mo ba ito?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "120": {
    "sourceHash": "d9a3ea9531d9644910b5d8b2dfefc53f1bef0fcc5f71f29b1744ec7bb847a898",
    "contextHash": "09e38ed98bc2081ad02b931889b110e10109688aae6b8b9d36647ed5ffd001d5",
    "translation": "May aso si Tom. Max ang pangalan ng aso.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "121": {
    "sourceHash": "07fa10f2047ce7de9449ef67dc4ee10c5f1d9965d1658a3b5441eefad3b79679",
    "contextHash": "5d046526f99edec56a254b3c401151f5a829256d349d907ce6c22b513665ea4d",
    "translation": "Mainit ang araw. Sinisikatan tayo nito.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "122": {
    "sourceHash": "b953474a92a90d4998aaf43349af00c40e6e37773662bdca68269e373e88b1d5",
    "contextHash": "e6f0bcefa0c439ff7413b2ea71273486da0259d13110cb597554a4a655dbd7bc",
    "translation": "Pakibigay sa kanya ang lapis.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "123": {
    "sourceHash": "de1a19958936e887143a0cf72240654d4ee6410cbf6d6c3282a79a6e72db1211",
    "contextHash": "24b0ab60d8f0b42890c3a3d8b385601ea969ec1b9cfdfa46951649cc8985f1c5",
    "translation": "Naglakad ako papunta sa paaralan kahapon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "124": {
    "sourceHash": "9b328475c80eecc4f40feb15e02093ab1062fe7be08e1230ece5b066b65e837b",
    "contextHash": "50b5c89b9c38b8acc2b7a2d1163ab88d2e3c5205be3fc3b701df850242999997",
    "translation": "Tumutugtog siya ng piyano pagkatapos ng klase.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "125": {
    "sourceHash": "5e2a3508076ea7ef562d80fdadb8b96d854465349b5f65379854def4271cf325",
    "contextHash": "9b717de0ab021e9a7f3604a4b94d801f02319be992d74f25be9730fe2d59bf21",
    "translation": "Nilinis namin ang aming silid noong nakaraang Linggo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "126": {
    "sourceHash": "468d970f28226c329cc7b5de7f9a6f805b3cb8fdadc2cc91299ae7f02971bf9d",
    "contextHash": "f76d1f737783320e462d0dcf472407f5af2559a9abacb4af8fbf187c1fef21c8",
    "translation": "Nagsisipilyo si Tom ng kanyang ngipin pagkatapos ng hapunan.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "127": {
    "sourceHash": "077a948b6782fe03ceb1491a064a0d1da22795ec921c0c6500270daa2357d63d",
    "contextHash": "310b990d7df25ec7aa14847b2379acb4e7523ccc4a2c6c763354519d91d832bd",
    "translation": "Huminto ang bus sa harap ng aming bahay kahapon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "128": {
    "sourceHash": "65f74bbf954f8fa62cd051832516c82a9e92dfbd364ea95bef34012a5bee2241",
    "contextHash": "de5d252457fb67ba89f4e639c443fd14b2c5da96244700ef3368c00864b15a23",
    "translation": "Nagluto ng hapunan ang nanay ko kagabi.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "129": {
    "sourceHash": "c44df0ae40c7c9ddb8255a907f989eb278d99e572dcd61bbc1b0d229c4038a17",
    "contextHash": "12ef13f7e103d61c6df5bcd930fe8518d33086b2fa3bdc6cfe3b8ee0837773d1",
    "translation": "Naglaro ka ba ng soccer kahapon?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "130": {
    "sourceHash": "7e82c0f2f97f0200f435a3e16c624153feda8d39ab3b7dd6156ae0d3e2cc27e0",
    "contextHash": "ae20fcb9e2b2f605639fdbb376cf733fb39cb58d95e60ffbed2c1d757b0f1c01",
    "translation": "Sumisikat ang araw sa silangan.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "131": {
    "sourceHash": "e572a3a2653b7522bb8f04a77d4a863d6f2eb79bff281fdf2de25637ce12ac69",
    "contextHash": "4ce2c75d74c80edb3663343f6d8f8f82235de84d27127dea913e59e39c31c76e",
    "translation": "Dinalaw ng nakatatanda kong kapatid na lalaki ang aming lola noong nakaraang linggo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "132": {
    "sourceHash": "73b2abc4757ec46486ffa822a7a5af9403a6bbd5cf9fcbf30b16c95a90b0f622",
    "contextHash": "95915264b3bf9b105bbdc67ff61ca61d984b87c0e8cbda0e5d64e40dad40ec9a",
    "translation": "Tinutulungan nila ang kanilang mga magulang tuwing katapusan ng linggo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "133": {
    "sourceHash": "379c2ffb87ee1e5263eddebd7f809ab7eb3666ea0bf4efdb77e6d1a5acb0658a",
    "contextHash": "f191ab5af8c73fe814631a7a6f5c5058bb04a086056926fcf626e73333f3002b",
    "translation": "Binuksan ko ang bintana 1 minuto ang nakalipas.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "134": {
    "sourceHash": "ededa12b2f450d11af518c059d3e580647924a397de8917faf7667d2f3c4cf75",
    "contextHash": "497731b65ffb2af78c355e663416a5bcda7883fd2096cf5e9453802ac7eeb3a9",
    "translation": "Sumayaw ang mga bata sa salu-salo kagabi.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "135": {
    "sourceHash": "b8c5fb74dae2cc0e36b0b97894cc973dab0e60bdba9bab04708a42d6ca60856e",
    "contextHash": "b012a05891b845136aac8a46fc9113ce0ba6a186dd5a4bdca0b484de5ef1aedf",
    "translation": "Nag-aaral ng Ingles ang aming guro kasama namin.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "136": {
    "sourceHash": "f4fed2235a279a1090c77de7627e36e234ac869a1f87a1aee80599a101b4f179",
    "contextHash": "1c344a63313f749351a090ec74c6dc8024abfeb140e43d099c60f3c4bf09384d",
    "translation": "Nag-aral ako para sa pagsusulit kagabi.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "137": {
    "sourceHash": "8b8c5093aa80a209f71f779a5244d4b3439c0ad1d160ab1f1284f6d83736af64",
    "contextHash": "651c7da7a025b2a06978bbacb756a75e0b85e7315fa9401908670f3e1cb0776d",
    "translation": "Nanonood siya ng mga kartun tuwing Sabado ng umaga.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "138": {
    "sourceHash": "8b1a80afba26d482ed04de86374a4a15b16a365bf6ab716d7d5328932a61faae",
    "contextHash": "03c367e3befcd068bb8b82dbeaf6fd445bcbe8abc81940af99f6f6fd775d20d4",
    "translation": "Pumunta kami sa zoo noong nakaraang Sabado.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "139": {
    "sourceHash": "ba8c56a124bf07ec95ed7971048c065b4d0f99b68df4258a817831207fbbf8d3",
    "contextHash": "b57a452ee5aacf77bc851fc82f86198af3e901380f8ede0760ffb4d33ba88a6e",
    "translation": "Kumain si Papa ng pansit sa tanghalian kahapon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "140": {
    "sourceHash": "895b7dd8bf7e190ca902e7f4ff7f3f3b0e1dd0b43cc83ca91f6c627f8f1e3bd7",
    "contextHash": "d8f013cd3b80692814cc4b24325181f3b0eefbbfa79c94faf0339b906b47b16b",
    "translation": "Hindi niya ako tinawagan kahapon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "141": {
    "sourceHash": "03e6bced112ab07a6d1cc630996fb5c3d885e6002742a3f6393d62ffafe3a366",
    "contextHash": "f320d769360c1303453490acbe7f3ce468b031cea924b789fbbcaa89e10007fd",
    "translation": "Nakatira ba sila malapit sa parke?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "142": {
    "sourceHash": "604bc28a8b75aa802944dcc08529a315a44e89001a56819711755d6baf87a72f",
    "contextHash": "90911868c04c887321588e5309995cb1f3e9393b0f0988c6e628ebfb0142e50c",
    "translation": "Nagtrabaho ang lolo ko sa isang bukid noong unang panahon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "143": {
    "sourceHash": "0c121f1f6b9aaacf4ff20ea39d47f36a9102d9dd1fc8b8a3ad24bc6e0420b217",
    "contextHash": "61309f222fef5ec1d66b7b0207f7bf6147f77ad8d3aba12fdedb2b03dfdf63fd",
    "translation": "Gusto ba ng nakababata mong kapatid na lalaki ang isda?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "144": {
    "sourceHash": "8a8b783c7fed9b4ad8484b6334b8d4b02be9367d6f0e67f944d727408cd1e4f7",
    "contextHash": "aceb1bd09e098a9166ca8a3e4a57bf0cc92fa3f7b652a5580d5ff692a73b7fe0",
    "translation": "Natutulog siya nang alas-10.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "145": {
    "sourceHash": "7b1aad385455a625a0a79c82838ae710af1fd48886283e851586f30ea95a3b6e",
    "contextHash": "91db231f3474bf27c84dbd41a8fe3f2c0de748005dd06c9ac9b033fba2c5b036",
    "translation": "Gumigising ang nakatatanda kong kapatid na babae nang alas-6:30.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "146": {
    "sourceHash": "d39c83bfb637f43b013127d299c767b60f9e432d2c2645672ec52880dff39455",
    "contextHash": "9cd567d34d1a7dab2f9b59895aa55c29b90375e57c32b5f4304d46c5049833c8",
    "translation": "Kumakain kami ng tanghalian nang alas-12.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "147": {
    "sourceHash": "9cd067c1b32f2baf12b4cf48463dc23b2a4947ca870033fd3f080c33b9f15cbe",
    "contextHash": "40745e67f7e7dc643c51cd09c1c8c2f7afbc02e270db1bea6babf47810b73f7d",
    "translation": "Ginagawa niya ang kanyang takdang-aralin pagkatapos ng hapunan.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "148": {
