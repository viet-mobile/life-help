{
  "500": {
    "sourceHash": "5f0010456a72fdb9bf48fdebedcf32425c5b611e63afeda08ac9e11f4400a4da",
    "contextHash": "dd23dc51f58dc131e2a9a7f7ecb26ea241a35b64b144849452d2406828d35d6a",
    "translation": "Nanonood ng balita ang nanay ko tuwing gabi.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "501": {
    "sourceHash": "4acb2cec6a053aed9eddcdefd716a5ad2fe1eaccd51cd3f9b21b39095b5ac872",
    "contextHash": "d1b9cd52f0a7de52d01b238a0d7bb2b18eb9ca20cbb51caf7e2c2a38bd19518a",
    "translation": "Nagtuturo ng agham ang aming guro tuwing Martes.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "502": {
    "sourceHash": "528ce3d0d37c21d476ad028f333bd664c6720b846cac0cdcca5d84dc21b42a43",
    "contextHash": "0ea5c1caa32f924d662909f2bd31800f1c4aa53cda1c220f8f7711e2d5038102",
    "translation": "May pulang bola ang aking tuta.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "503": {
    "sourceHash": "00bdb218856bbf9beb4d74567830923745a8020fbe55bcf297a839899c64cb7e",
    "contextHash": "aba0b95f4ffb9b5b95fc1e7e4e1521234269b56bda5a1ae50f7bfc700e6f4256",
    "translation": "Ginagawa ni Jisu ang kanyang takdang-aralin bago maghapunan.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "504": {
    "sourceHash": "2153704a1086920cb3f8d80cd5e0fe6932035e762e70b60f82f4e9853dce493c",
    "contextHash": "a170e96dbba7f7c8ecbe534d80f1d1400e2783748773c4ad6e27c83dba57c9a1",
    "translation": "Ayaw ni Tom ng maanghang na pagkain.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "505": {
    "sourceHash": "7d814660da85bb17b73aad781112d4377171014ef5544b188200408f8d44a069",
    "contextHash": "49123a1637edfde8fd1602abedd9d9567bfb4e30ab4bb5fe2c6d39c7ffb2f632",
    "translation": "Hindi nag-aalmusal ang mga magulang ko kapag araw ng pasok.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "506": {
    "sourceHash": "3b25b98c863c7493e66812cf17c37499e491f24fa6feed161909b7bd06907cf1",
    "contextHash": "4a05c7309e5208ccfd92041ca5340580f83b3b92a608ef2212f6f563f99ee2c7",
    "translation": "Tumutugtog ba ng piyano ang nakababata mong kapatid na babae?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "507": {
    "sourceHash": "26fe7183114f1c68a21585ef3968a2b6bc146e60b89bc6d263800877e80bfbf6",
    "contextHash": "7c39efa7cb3ea9e5625c12069cf14ef33cad45deb23778d523fbb6dd2125957c",
    "translation": "Naglalakad ka ba papunta sa paaralan?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "508": {
    "sourceHash": "dcb53fd67bf5fc09801eb2200e808e2481ea3dcd50c3760f6a2538111bc074aa",
    "contextHash": "a49b0b9e628874a405d712c76996690257d0dfb0237c6368104a0725c0f06a09",
    "translation": "Anong oras umaalis ang bus?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "509": {
    "sourceHash": "5de41db6b2717a46354ae9fed251643a13cf3b0f043e78fba24e1d90cab86814",
    "contextHash": "dc878b983ce8e3c6d1650a418ec4070761439fe93469b45b0cb68c678a27e8ea",
    "translation": "Saan nakatira ang iyong mga pinsan?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "510": {
    "sourceHash": "7659c0a0566d0564c5651c0c1638bd821e82e06f18c97902cf53cef816a96cea",
    "contextHash": "099dcba9718dc111d5987dbba67c1981c6e2a4f14abd530181f460feaac1ac41",
    "translation": "Hindi siya kailanman kumakain ng karne.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "511": {
    "sourceHash": "ddfd691a95dd6aa06c4eddc6f36bdadc162bc6a160957016802d458ef8a330c8",
    "contextHash": "b1c13b67627290715f761175f0396199df5e88e6a5919be72ed4b37fe2f4e22c",
    "translation": "Lagi akong nagsisipilyo ng aking ngipin pagkatapos magtanghalian.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "512": {
    "sourceHash": "57987da5fc0b2599679e267ef27b315859a76a910ea4ee60fb73701b95df209d",
    "contextHash": "6262f6301f411707fb01c283fd9e0aa00b31835cd1093b788ce391a10f5d5021",
    "translation": "Madalas siyang pumunta sa aklatan kapag Sabado.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "513": {
    "sourceHash": "b5ae1eb0d8192ae4087b3bf9fee5a96676b38231ee7528052903149ad4a2c924",
    "contextHash": "9881da2ffcf52c75530bde02e1d8b006b3f1c5aaa55488d7849947952b7224cf",
    "translation": "Karaniwang sumasakay ng bus papunta sa trabaho ang tiyuhin ko.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "514": {
    "sourceHash": "cd180d1940dcecafaa27bfdcac4e657dbccf1fb07bdd5f87ce437725d132c8cb",
    "contextHash": "8b4d5f52c118c86507a3db56107002a3ba3cecce097bc37cd59766106fcde80f",
    "translation": "Kumukulo ang tubig sa 100 digri Celsius.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "515": {
    "sourceHash": "340deb45f82dbf0e83a685547e3d627baa091c03cf1a3e5c677d8e74c3269cc9",
    "contextHash": "15aa0c9004bc8daa95f7539dbc51f7ed55e9c093123fd75221c42c6eca688961",
    "translation": "Gusto ng bawat mag-aaral sa klase ko ang musika.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "516": {
    "sourceHash": "f5e6c17e320a5745a2af301aa791212f87528486abf8cf3ed6622dcaddb31dab",
    "contextHash": "33f92d2d972e26259efc3a00dc40ee274946c9176a65063d22d50d0a35b0865e",
    "translation": "Walang umiinom ng kape sa aking pamilya.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "517": {
    "sourceHash": "ab88313ac62dbb32087665605c1da210f4dc38b42ac7769a7924671dbf16bcdf",
    "contextHash": "ee866d068459419764a02273b98aad2f45e6c5f0adf7506ecd659e9c83959e23",
    "translation": "Magkasamang naglalakad sina Tom at Mina papunta sa paaralan.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "518": {
    "sourceHash": "f6f5fe315802cb88826c13df15a924bd78e66af395dcc11c5ff4c184dacb3a75",
    "contextHash": "983904c45e318badcb29e3bbb4742f38f5a6bf10aa8dc7a5a07bc8e8ae05874c",
    "translation": "Wala siyang kahit anong alagang hayop.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "519": {
    "sourceHash": "cbce0a79549914d60bf727563de6dfc4232fad9dab7a41b4e0da9bf16eef6541",
    "contextHash": "78490daa46e28f67d347dab7f3d938235b2eadcb2e18a61ffeaff4d72a8d43f8",
    "translation": "Mayroon ba siyang bisikleta?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "520": {
    "sourceHash": "7d90e3f9fa6c7f49bda61e26c28229136f4fcba1b9d3c7885b4e537253abbca2",
    "contextHash": "a10fd74a7f3fb46ea7fc2fcfb4595dc6e9f793081721e63954b618049a62761f",
    "translation": "Nagbubukas ang tindahan nang alas-9 at nagsasara nang alas-6.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "521": {
    "sourceHash": "d43293bcf5d2b5ac0489551915d22e55f29948eb031f618e450cd1171732b304",
    "contextHash": "553301304f17b8760961dd13140be48def3e88f5bc8c0fbdec9163fb06686d23",
    "translation": "Nanghuhuli ng mga daga ang pusa sa gabi.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "522": {
    "sourceHash": "16e7eeaab15228ab791422afdfa573fa526b4954d9751f6ce32bc31096b96766",
    "contextHash": "07219f73176eda75a6ad0553b389e0b7a797183871061d9f456df424d6a6e1cc",
    "translation": "Nag-aayos ng mga bisikleta ang tatay ko sa kanyang maliit na tindahan.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "523": {
    "sourceHash": "537c247049f4963b08f07719ef80b95da857dc53949fa06721ff3e3cd75ebe9d",
    "contextHash": "c6277c8083250865d8c21f6bc5031955adb5ab548acee9585554044b8c9d5c1a",
    "translation": "Naghahalo ng pintura ang tiya ko para sa kanyang klase sa sining.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "524": {
    "sourceHash": "45fb1279b91bfb8e9f4982c360b9af3f4e62b17223926e5ef002ad8ee7945d57",
    "contextHash": "bf56fa19eb3d803341c393873c1a37b8cdc8d2a858ba4f297337277144272921",
    "translation": "Nangungulila siya sa kanyang lola.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "525": {
    "sourceHash": "d2f0b233745d5dc4c15f82036246cf70016d87e5045ae22fe6931761e9049093",
    "contextHash": "543d858d41deed3c95635611200d95927a1db6c760b18c8557506adb11b2395b",
    "translation": "Bumibili siya ng prutas sa palengke tuwing Linggo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "526": {
    "sourceHash": "e80657d05b164611e2d52f7a893c069d0dfe09db529061a42b3265ef239d9e13",
    "contextHash": "0b95f93fa2fac792c3811e2f00d7161f05e08bcdb7532de1d140ff8533c9f818",
    "translation": "Nasisiya ang pinsan ko sa paglalakad sa kabundukan.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "527": {
    "sourceHash": "a3092f562e9eb97ebff4e0a57d505383f4c851227bc9772bdfe7c44d5d0a0334",
    "contextHash": "c4d91c122d3a99ec5dcfb2042531dd3c03ca2a2f72a88e79b09cced9ae250283",
    "translation": "Dumarating ang tren nang alas-7.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "528": {
    "sourceHash": "14b4781bb9dd4a7d5e93f1c0d188e4bbfcf930c7c45426a0e239ac02153f16fa",
    "contextHash": "14d068f1686b050b3993de065dd71daee2863363801079e2baf078f19019c6b5",
    "translation": "Binubuhat ni Sumin ang bag ng kanyang nakababatang kapatid na lalaki.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "529": {
    "sourceHash": "da8d9d2ceb323f166b84ea07d05267b75b632d25dd5fd39339be0e58768fb241",
    "contextHash": "376e56f033c16cbd613050c030c7cf34c29ce90381ed155b07d3d0529e965e3e",
    "translation": "Nangingisda ang lolo ko sa ilog tuwing katapusan ng linggo.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "530": {
    "sourceHash": "e81fd952260880d13a8966659a0c44c5f6b1a803d66de7addc4cdc6c2a77b3a6",
    "contextHash": "ca9aad19528971dd548b6bd629953c698aa6cc41a39d1663cdd00f2a2699c4d4",
    "translation": "Marami ang ulan sa ika-7 buwan ng taon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "531": {
    "sourceHash": "f8f8bf94f08837264ac45cc2452fc2cdaff8a559f249690f3b268bafff0a8992",
    "contextHash": "54de5521d09e20964b16d423fac693adc3f47ba2a050871812231304a1f87ae5",
    "translation": "Gaano kadalas hinuhugasan ni Papa ang sasakyan?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "532": {
    "sourceHash": "0598a95b81704965726f57e2258027a1157ddc1fd0a923b6e522f2be8b3edfc6",
    "contextHash": "fee4dc57a51d91497fb21701dac22952f344695aaa44910bc3fea3f1eeeb4606",
    "translation": "Sino ang naglilinis ng silid-aralan pagkatapos ng klase?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "533": {
    "sourceHash": "4d6cfae0bc8da91f6cdf64019127f613aca45e282a05e1f636ab1973af21a882",
    "contextHash": "593ed3a891061d0ca076801b84ea42907c3e8d71e9146715f3bd5013a3925de3",
    "translation": "Hindi ako nanonood ng telebisyon kapag araw ng pasok.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "534": {
    "sourceHash": "971f837b47d5842e1f03bf8bea10891572e3a054cc325482ffaa3c0cf26da824",
    "contextHash": "a69bda2b4ca57df7a4a55ca3947f3fed5e7455907b9f07bf3e9853981769ddc7",
    "translation": "Hindi nagbubukas ang aklatan tuwing Lunes.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "535": {
    "sourceHash": "98a22c11719b337d10bac9c15b3f4554330e784e9196e782cb5c5174fc1decc3",
    "contextHash": "f42c56b42c20bed203097a476cd1ae2281909f253bb5ae7078102510ebbe51f1",
    "translation": "Kailangan ng mga bata ang maraming tulog.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "536": {
    "sourceHash": "5f95727c4fb5ba2eabd30a1b7ccb927f283942ff12a14f46df52228d8f3e3caf",
    "contextHash": "6c0167009219773161c41f7f35cf4f435186f1d71bb98d5103ab936539e949e0",
    "translation": "Natutulog ang koala nang humigit-kumulang dalawampung oras bawat araw.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "537": {
    "sourceHash": "2ac7d8592a799397fdcfe505a4c003929b2fdec5ad5586eeea30873c61396a8e",
    "contextHash": "7c672a9c8e36043d673f014eb9eccc17c497d0522ab82f8ad10f76097c4d8823",
    "translation": "Bumabati siya sa lahat.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "538": {
    "sourceHash": "f8af5a7d64e27cc88dfa6ecf9afdb9db5e4ac415f696ff8e43ad133ce29a47fd",
    "contextHash": "4b313412dab774bf109eb39b64a43ab7eb583f0c0fc751fe164eef90041e975c",
    "translation": "Sa mismong katabing bahay nakatira ang kaibigan ng nakababata kong kapatid na babae.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "539": {
    "sourceHash": "98e5d91e2fc2773d9d262f0332a86c7f9b58ae623995cd51ac26d98432c1921c",
    "contextHash": "cd725fb3fe441c79faa6908bb8128252fa75b3896798026de36a255a52d112af",
    "translation": "Nagbibisikleta ba si Minho papunta sa paaralan gamit ang kanyang bisikleta?",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "540": {
    "sourceHash": "93655b288ad66b6384d58d3221a6b30074b34c711aeddddd13f17756f6fbbe6f",
    "contextHash": "ecd6f6cab022c9d7650591b036b38c72dc3fe5e289d2f03193af92d5a3a684c3",
    "translation": "Naglalaro ang mga bata sa parke.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "541": {
    "sourceHash": "1d83337eebdc64459a19207578753f7370cbb84ec8d079e5eafdbfcdd24b0e01",
    "contextHash": "bb05f73cb3a4ee9070b25158d2647492ca7c599d45ec36a7b08dbf0b6601ec67",
    "translation": "May tatlong kahon sa ibabaw ng mesa.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "542": {
    "sourceHash": "e435aff4e978c700ebd63871f23c42a3ba1183b8244bdced5d0ec7c829367f7a",
    "contextHash": "df862f0542a03234f00e396a42c98a8eb6e16bade164cd3047fe6bd32fd0abeb",
    "translation": "Bumili ng limang kamatis ang nanay ko.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "543": {
    "sourceHash": "5f67b711bf877b25f1236b3c00edb5276d6079b825554903b52eea0f2895ff60",
    "contextHash": "d08ee505417a4eef497b80f8cd49fe1b4b2e17513c034548980ca7fde221fb20",
    "translation": "Kumuha kami ng maraming larawan sa paglalakbay.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "544": {
    "sourceHash": "7370e3a431f5c8633297b8cf5dd85670822f19991dae8d86539359fe2efd2d34",
    "contextHash": "470774ea4f59a08751638d1461054e658055444578757cae4e51190c933b5182",
    "translation": "May dalawa nang ngipin ang sanggol ngayon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "545": {
    "sourceHash": "e5f1092538c002eabcb42106b9ec9840cee69a5d5d534119c7639f7cdb76e5e2",
    "contextHash": "8aeaa8951213221c44e36828db05ac3f8d7fa097bf6973d2a8d22883dd8cb710",
    "translation": "Naghihintay ang dalawang babae sa hintuan ng bus.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "546": {
    "sourceHash": "b30345b455b9c153730a97f81b91bc8bd411f151b85ed48ee26670911ce8c6fe",
    "contextHash": "d7fa4a2e0195f851f94d461547182c44a7543f152a74d5fd8cf54b23947ab51d",
    "translation": "Kumakain ng damo ang mga tupang iyon.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "547": {
    "sourceHash": "9806a0780e12ea05b08d6cd48bdc72a0839e072b80a0b36cae6ef7cb9248b2ab",
    "contextHash": "e1a025ea0b5279a5d2e9f08418a0bb04fca6b17a6c2d433aa6d8202ec14788a0",
    "translation": "Nakahuli kami ng limang isda sa lawa.",
    "role": "localized_sentence_meaning",
    "status": "AUTHOR_DRAFT_NOT_INDEPENDENTLY_REVIEWED"
  },
  "548": {
