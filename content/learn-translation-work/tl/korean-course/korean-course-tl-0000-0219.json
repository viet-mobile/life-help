  },
  "118": {
    "sourceHash": "3b64ba0b2bd006a456ed300823ab69b16061fb5ec8c80a17374a5a87d30d61dc",
    "translation": "Hardin ng pagsasalita",
    "role": "localized_instruction_or_meaning"
  },
  "119": {
    "sourceHash": "82d016cb4128e769b71d561dbf622c478e703d61a3da39d7e0dfa8145daa83d9",
    "translation": "Pagdugtungin ang masalimuot na ideya at isalaysay ang sinabi ng iba",
    "role": "localized_instruction_or_meaning"
  },
  "120": {
    "sourceHash": "275b738c7d8bd362874fdeb4e2f0711ac8edd6675dd34f1bf43b3d250b5979a1",
    "translation": "Hakbang 8 ng kursong Koreano · Magalang, balintiyak at anyong sanhi",
