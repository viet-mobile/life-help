  "lessons": {
    "korean-k1-l1": {
      "title": "תנועות בסיסיות",
      "concept": "האנגול הוא האלפבית הקוריאני. כל הברה היא בלוק. תנועה לבדה נכתבת עם **ㅇ** לפניה, שאינה נהגית בתחילת ההברה: 아 הוא פשוט “a”.",
      "example": "아 · 어 · 오 · 우 · 으 · 이 (a · eo · o · u · eu · i)"
    },
    "korean-k1-l2": {
      "title": "עיצורים בסיסיים",
      "concept": "שימו עיצור לפני תנועה כדי ליצור בלוק הברה: **ㄱ + ㅏ = 가** (ga). קראו את הבלוק משמאל לימין.",
      "example": "가 · 나 · 다 · 마 · 바 · 사 · 하 (ga · na · da · ma · ba · sa · ha)"
    },
    "korean-k1-l3": {
      "title": "מילים ראשונות",
      "concept": "חברו בלוקים של הברות כדי ליצור מילים. קראו כל בלוק, ואז אמרו אותם יחד.",
      "example": "우유 (uyu) = חלב / 나무 (namu) = עץ"
    },
    "korean-k2-l1": {
      "title": "שלום ותודה",
      "concept": "ברכות מנומסות מסתיימות ב־**-요** או ב־**-니다**. 안녕하세요 מתאים בכל שעה ביום.",
      "example": "안녕하세요. (annyeonghaseyo.) = שלום. / 감사합니다. (gamsahamnida.) = תודה."
    },
    "korean-k2-l2": {
      "title": "כן, לא ובסדר",
      "concept": "תשובות קצרות ומנומסות שאפשר להשתמש בהן כל יום. בקוריאנית מוסיפים **요** בסוף כדי להיות מנומסים.",
      "example": "네. (ne.) = כן. / 아니요. (aniyo.) = לא."
    },
    "korean-k2-l3": {
      "title": "נעים להכיר",
      "concept": "כשפוגשים מישהו חדש, אומרים 만나서 반갑습니다. יש שתי דרכים להיפרד: אחת למי שהולך, ואחת למי שנשאר.",
      "example": "만나서 반갑습니다. (mannaseo bangapseumnida.) = נעים להכיר."
    },
    "korean-k3-l1": {
      "title": "אני תלמיד",
      "concept": "**저는** פירושו “אני” (בנימוס). שימו **이에요** אחרי עיצור ו־**예요** אחרי תנועה כדי לומר “אני …”.",
      "example": "저는 학생이에요. (jeoneun haksaengieyo.) = אני תלמיד."
    },
    "korean-k3-l2": {
      "title": "המשפחה שלי",
      "concept": "בקוריאנית משתמשים הרבה במילים של משפחה, גם לאנשים שאינם בני משפחה.",
      "example": "가족 (gajok) = משפחה / 어머니 (eomeoni) = אמא"
    },
    "korean-k3-l3": {
      "title": "ספירה",
      "concept": "בקוריאנית יש שתי שיטות מספרים: קוריאנית מקורית (하나, 둘, 셋 …) לספירת דברים, וסינו־קוריאנית (일, 이, 삼 …) לכסף, לתאריכים ולדקות.",
      "example": "하나 · 둘 · 셋 (hana · dul · set)"
    },
    "korean-k4-l1": {
      "title": "פעלים יומיומיים",
      "concept": "פעלים מנומסים בזמן הווה מסתיימים ב־**-아요 / -어요 / -해요**. אותה צורה משמשת ל“אני”, ל“אתה” ול“הם”.",
      "example": "먹어요. (meogeoyo.) = (אני) אוכל. / 마셔요. (masyeoyo.) = (אני) שותה."
    },
    "korean-k4-l2": {
      "title": "ללכת למקומות",
      "concept": "שימו **에** אחרי מקום כדי לומר לאן הולכים או באים: 학교에 가요. הפועל בא בסוף.",
      "example": "학교에 가요. (hakgyoe gayo.) = אני הולך לבית הספר."
    },
    "korean-k4-l3": {
      "title": "לאכול, לשתות, לקרוא",
      "concept": "המושא של פועל מקבל **을** אחרי עיצור ו־**를** אחרי תנועה: 밥을 먹어요, 커피를 마셔요.",
      "example": "밥을 먹어요. (babeul meogeoyo.) = אני אוכל ארוחה."
    },
    "korean-k5-l1": {
      "title": "אתמול, היום, מחר",
      "concept": "מילות זמן באות בדרך כלל קרוב לתחילת המשפט.",
      "example": "어제 · 오늘 · 내일 (eoje · oneul · naeil)"
    },
    "korean-k5-l2": {
      "title": "מה עשיתי",
      "concept": "זמן עבר: **-았어요 / -었어요 / -했어요**. יש פעלים שמתקצרים: 가다 → 갔어요, 보다 → 봤어요.",
      "example": "먹었어요. (meogeosseoyo.) = אכלתי."
    },
    "korean-k5-l3": {
      "title": "מה אעשה",
      "concept": "השתמשו ב־**-(으)ㄹ 거예요** לתוכניות: 가다 → 갈 거예요, 먹다 → 먹을 거예요.",
      "example": "내일 갈 거예요. (naeil gal geoyeyo.) = אני אלך מחר."
    },
    "korean-k6-l1": {
      "title": "בחנות",
      "concept": "שאלו על המחיר עם 얼마예요? ובקשו משהו עם **… 주세요** (… בבקשה).",
      "example": "얼마예요? (eolmayeyo?) = כמה זה עולה?"
    },
    "korean-k6-l2": {
      "title": "איפה זה?",
      "concept": "שאלו **… 어디예요?** (איפה …?). הקשיבו ל־오른쪽 (ימינה), 왼쪽 (שמאלה) ו־직진 (ישר).",
      "example": "화장실이 어디예요? (hwajangsiri eodiyeyo?) = איפה השירותים?"
    },
    "korean-k6-l3": {
      "title": "אני רוצה …",
      "concept": "הוסיפו **-고 싶어요** לגזע הפועל כדי לומר מה אתם רוצים לעשות: 가다 → 가고 싶어요.",
      "example": "가고 싶어요. (gago sipeoyo.) = אני רוצה ללכת."
    }
  },
