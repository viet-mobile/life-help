  "lessons": {
    "korean-k1-l1": {
      "title": "Основні голосні",
      "concept": "Хангиль — це корейська абетка. Кожен склад — це блок. Голосну без приголосної пишуть із **ㅇ** попереду; на початку вона не читається: 아 — це просто «а».",
      "example": "아 · 어 · 오 · 우 · 으 · 이 (a · eo · o · u · eu · i)"
    },
    "korean-k1-l2": {
      "title": "Основні приголосні",
      "concept": "Постав приголосну перед голосною, щоб утворити складовий блок: **ㄱ + ㅏ = 가** (ga). Читай блок зліва направо.",
      "example": "가 · 나 · 다 · 마 · 바 · 사 · 하 (ga · na · da · ma · ba · sa · ha)"
    },
    "korean-k1-l3": {
      "title": "Перші слова",
      "concept": "Поєднуй складові блоки в слова. Прочитай кожен блок, а потім скажи їх разом.",
      "example": "우유 (uyu) = молоко / 나무 (namu) = дерево"
    },
    "korean-k2-l1": {
      "title": "Привіт і дякую",
      "concept": "Ввічливі привітання закінчуються на **-요** або **-니다**. 안녕하세요 можна казати в будь-який час доби.",
      "example": "안녕하세요. (annyeonghaseyo.) = Добрий день. / 감사합니다. (gamsahamnida.) = Дякую."
    },
    "korean-k2-l2": {
      "title": "Так, ні й гаразд",
      "concept": "Короткі ввічливі відповіді на кожен день. Щоб звучати ввічливо, корейці додають **요** в кінці.",
      "example": "네. (ne.) = Так. / 아니요. (aniyo.) = Ні."
    },
    "korean-k2-l3": {
      "title": "Приємно познайомитися",
      "concept": "Коли знайомишся з кимось, скажи 만나서 반갑습니다. Попрощатися можна двома способами: один — для того, хто йде, інший — для того, хто залишається.",
      "example": "만나서 반갑습니다. (mannaseo bangapseumnida.) = Приємно познайомитися."
    },
    "korean-k3-l1": {
      "title": "Я студент",
      "concept": "**저는** означає «я» (ввічливо). Щоб сказати «я — …», став **이에요** після приголосної та **예요** після голосної.",
      "example": "저는 학생이에요. (jeoneun haksaengieyo.) = Я студент."
    },
    "korean-k3-l2": {
      "title": "Моя родина",
      "concept": "Слова про родину в корейській вживають дуже часто — навіть щодо людей, які не є родичами.",
      "example": "가족 (gajok) = родина / 어머니 (eomeoni) = мама"
    },
    "korean-k3-l3": {
      "title": "Рахуємо",
      "concept": "У корейській дві системи чисел: власне корейська (하나, 둘, 셋 …) — для лічби предметів, і китайсько-корейська (일, 이, 삼 …) — для грошей, дат і хвилин.",
      "example": "하나 · 둘 · 셋 (hana · dul · set)"
    },
    "korean-k4-l1": {
      "title": "Повсякденні дієслова",
      "concept": "Ввічливі дієслова теперішнього часу закінчуються на **-아요 / -어요 / -해요**. Та сама форма вживається для «я», «ти» і «вони».",
      "example": "먹어요. (meogeoyo.) = (Я) їм. / 마셔요. (masyeoyo.) = (Я) п’ю."
    },
    "korean-k4-l2": {
      "title": "Ідемо в різні місця",
      "concept": "Постав **에** після назви місця, щоб сказати, куди йдеш або звідки приходиш: 학교에 가요. Дієслово стоїть у кінці.",
      "example": "학교에 가요. (hakgyoe gayo.) = Я йду до школи."
    },
    "korean-k4-l3": {
      "title": "Їмо, п’ємо, читаємо",
      "concept": "Додаток дієслова отримує **을** після приголосної та **를** після голосної: 밥을 먹어요, 커피를 마셔요.",
      "example": "밥을 먹어요. (babeul meogeoyo.) = Я їм їжу."
    },
    "korean-k5-l1": {
      "title": "Учора, сьогодні, завтра",
      "concept": "Слова про час зазвичай стоять на початку речення.",
      "example": "어제 · 오늘 · 내일 (eoje · oneul · naeil)"
    },
    "korean-k5-l2": {
      "title": "Що я зробив",
      "concept": "Минулий час: **-았어요 / -었어요 / -했어요**. Деякі дієслова скорочуються: 가다 → 갔어요, 보다 → 봤어요.",
      "example": "먹었어요. (meogeosseoyo.) = Я поїв."
    },
    "korean-k5-l3": {
      "title": "Що я робитиму",
      "concept": "Для планів використовуй **-(으)ㄹ 거예요**: 가다 → 갈 거예요, 먹다 → 먹을 거예요.",
      "example": "내일 갈 거예요. (naeil gal geoyeyo.) = Я піду завтра."
    },
    "korean-k6-l1": {
      "title": "У магазині",
      "concept": "Запитай ціну за допомогою 얼마예요?, а щоб попросити щось, скажи **… 주세요** (… будь ласка).",
      "example": "얼마예요? (eolmayeyo?) = Скільки це коштує?"
    },
    "korean-k6-l2": {
      "title": "Де це?",
      "concept": "Запитуй **… 어디예요?** (Де …?). Прислухайся до слів 오른쪽 (праворуч), 왼쪽 (ліворуч) і 직진 (прямо).",
      "example": "화장실이 어디예요? (hwajangsiri eodiyeyo?) = Де туалет?"
    },
    "korean-k6-l3": {
      "title": "Я хочу …",
      "concept": "Додай **-고 싶어요** до основи дієслова, щоб сказати, що хочеш зробити: 가다 → 가고 싶어요.",
      "example": "가고 싶어요. (gago sipeoyo.) = Я хочу піти."
    }
  },
