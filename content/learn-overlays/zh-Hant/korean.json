  "lessons": {
    "korean-k1-l1": {
      "title": "基本母音",
      "concept": "韓文是韓語的字母。每個音節是一個方塊。母音單獨書寫時要在前面加 **ㅇ**，它在開頭時不發音：아 就讀作「a」。",
      "example": "아 · 어 · 오 · 우 · 으 · 이 (a · eo · o · u · eu · i)"
    },
    "korean-k1-l2": {
      "title": "基本子音",
      "concept": "把子音放在母音前面，就組成一個音節塊：**ㄱ + ㅏ = 가**（ga）。從左往右讀這個方塊。",
      "example": "가 · 나 · 다 · 마 · 바 · 사 · 하 (ga · na · da · ma · ba · sa · ha)"
    },
    "korean-k1-l3": {
      "title": "第一批單字",
      "concept": "把音節塊連起來就成了單字。先讀每個方塊，再連起來讀。",
      "example": "우유 (uyu) = 牛奶 / 나무 (namu) = 樹"
    },
    "korean-k2-l1": {
      "title": "你好和謝謝",
      "concept": "禮貌的問候語以 **-요** 或 **-니다** 結尾。안녕하세요 一天中任何時候都可以用。",
      "example": "안녕하세요. (annyeonghaseyo.) = 你好。 / 감사합니다. (gamsahamnida.) = 謝謝。"
    },
    "korean-k2-l2": {
      "title": "是、不是和沒關係",
      "concept": "每天都能用的簡短禮貌回答。韓語在句末加上 **요** 表示禮貌。",
      "example": "네. (ne.) = 是。 / 아니요. (aniyo.) = 不是。"
    },
    "korean-k2-l3": {
      "title": "很高興認識你",
      "concept": "第一次見到某人時，說 만나서 반갑습니다。說再見有兩種方式：一種對離開的人說，一種對留下的人說。",
      "example": "만나서 반갑습니다. (mannaseo bangapseumnida.) = 很高興認識你。"
    },
    "korean-k3-l1": {
      "title": "我是學生",
      "concept": "**저는** 的意思是「我」（禮貌）。子音後面加 **이에요**，母音後面加 **예요**，表示「我是……」。",
      "example": "저는 학생이에요. (jeoneun haksaengieyo.) = 我是學生。"
    },
    "korean-k3-l2": {
      "title": "我的家人",
      "concept": "韓語中家庭稱謂用得很多，甚至用來稱呼不是家人的人。",
      "example": "가족 (gajok) = 家人 / 어머니 (eomeoni) = 媽媽"
    },
    "korean-k3-l3": {
      "title": "數數",
      "concept": "韓語有兩套數字：固有詞數字（하나, 둘, 셋 …）用來數東西，漢字詞數字（일, 이, 삼 …）用於錢、日期和分鐘。",
      "example": "하나 · 둘 · 셋 (hana · dul · set)"
    },
    "korean-k4-l1": {
      "title": "日常動詞",
      "concept": "禮貌的現在式動詞以 **-아요 / -어요 / -해요** 結尾。「我」「你」「他們」都用同一個形式。",
      "example": "먹어요. (meogeoyo.) = （我）吃。 / 마셔요. (masyeoyo.) = （我）喝。"
    },
    "korean-k4-l2": {
      "title": "去各個地方",
      "concept": "在地點後面加 **에**，表示去哪裡或來哪裡：학교에 가요。動詞放在最後。",
      "example": "학교에 가요. (hakgyoe gayo.) = 我去學校。"
    },
    "korean-k4-l3": {
      "title": "吃、喝、讀",
      "concept": "動詞的受詞在子音後加 **을**，在母音後加 **를**：밥을 먹어요, 커피를 마셔요。",
      "example": "밥을 먹어요. (babeul meogeoyo.) = 我吃飯。"
    },
    "korean-k5-l1": {
      "title": "昨天、今天、明天",
      "concept": "時間詞通常放在句子的開頭附近。",
      "example": "어제 · 오늘 · 내일 (eoje · oneul · naeil)"
    },
    "korean-k5-l2": {
      "title": "我做過的事",
      "concept": "過去式：**-았어요 / -었어요 / -했어요**。有些動詞會縮略：가다 → 갔어요, 보다 → 봤어요。",
      "example": "먹었어요. (meogeosseoyo.) = 我吃了。"
    },
    "korean-k5-l3": {
      "title": "我要做的事",
      "concept": "用 **-(으)ㄹ 거예요** 表示計畫：가다 → 갈 거예요, 먹다 → 먹을 거예요。",
      "example": "내일 갈 거예요. (naeil gal geoyeyo.) = 我明天要去。"
    },
    "korean-k6-l1": {
      "title": "在商店",
      "concept": "用 얼마예요? 問價格，用 **… 주세요**（請給我……）要東西。",
      "example": "얼마예요? (eolmayeyo?) = 多少錢？"
    },
    "korean-k6-l2": {
      "title": "在哪裡？",
      "concept": "問 **… 어디예요?**（……在哪裡？）。注意聽 오른쪽（右邊）、왼쪽（左邊）和 직진（直走）。",
      "example": "화장실이 어디예요? (hwajangsiri eodiyeyo?) = 洗手間在哪裡？"
    },
    "korean-k6-l3": {
      "title": "我想……",
      "concept": "在動詞詞幹後加 **-고 싶어요**，表示你想做什麼：가다 → 가고 싶어요。",
      "example": "가고 싶어요. (gago sipeoyo.) = 我想去。"
    }
  },
