  "lessons": {
    "korean-k1-l1": {
      "title": "الحروف المتحركة الأساسية",
      "concept": "الهانغول هو الأبجدية الكورية. كل مقطع صوتي عبارة عن كتلة. يُكتب الحرف المتحرك وحده مع **ㅇ** قبله، وهو صامت في البداية: 아 تُقرأ «a» فقط.",
      "example": "아 · 어 · 오 · 우 · 으 · 이 (a · eo · o · u · eu · i)"
    },
    "korean-k1-l2": {
      "title": "الحروف الساكنة الأساسية",
      "concept": "ضع حرفًا ساكنًا قبل الحرف المتحرك لتكوين كتلة مقطعية: **ㄱ + ㅏ = 가** (ga). اقرأ الكتلة من اليسار إلى اليمين.",
      "example": "가 · 나 · 다 · 마 · 바 · 사 · 하 (ga · na · da · ma · ba · sa · ha)"
    },
    "korean-k1-l3": {
      "title": "الكلمات الأولى",
      "concept": "اربط الكتل المقطعية لتكوين كلمات. اقرأ كل كتلة، ثم انطقها معًا.",
      "example": "우유 (uyu) = حليب / 나무 (namu) = شجرة"
    },
    "korean-k2-l1": {
      "title": "مرحبًا وشكرًا",
      "concept": "تنتهي التحيات المهذبة بـ **-요** أو **-니다**. يمكن قول 안녕하세요 في أي وقت من اليوم.",
      "example": "안녕하세요. (annyeonghaseyo.) = مرحبًا. / 감사합니다. (gamsahamnida.) = شكرًا."
    },
    "korean-k2-l2": {
      "title": "نعم ولا وحسنًا",
      "concept": "إجابات قصيرة مهذبة يمكنك استخدامها كل يوم. تضيف الكورية **요** في النهاية للتأدب.",
      "example": "네. (ne.) = نعم. / 아니요. (aniyo.) = لا."
    },
    "korean-k2-l3": {
      "title": "تشرفت بمعرفتك",
      "concept": "عندما تلتقي بشخص جديد، قل 만나서 반갑습니다. هناك طريقتان لقول وداعًا: واحدة للشخص المغادر، وأخرى للشخص الباقي.",
      "example": "만나서 반갑습니다. (mannaseo bangapseumnida.) = تشرفت بمعرفتك."
    },
    "korean-k3-l1": {
      "title": "أنا طالب",
      "concept": "**저는** تعني «أنا» (بأدب). ضع **이에요** بعد الحرف الساكن و**예요** بعد الحرف المتحرك لتقول «أنا …».",
      "example": "저는 학생이에요. (jeoneun haksaengieyo.) = أنا طالب."
    },
    "korean-k3-l2": {
      "title": "عائلتي",
      "concept": "تُستخدم كلمات العائلة كثيرًا في الكورية، حتى مع أشخاص ليسوا من العائلة.",
      "example": "가족 (gajok) = عائلة / 어머니 (eomeoni) = أم"
    },
    "korean-k3-l3": {
      "title": "العدّ",
      "concept": "للكورية نظامان للأرقام: الكوري الأصلي (하나, 둘, 셋 …) لعدّ الأشياء، والصيني الكوري (일, 이, 삼 …) للنقود والتواريخ والدقائق.",
      "example": "하나 · 둘 · 셋 (hana · dul · set)"
    },
    "korean-k4-l1": {
      "title": "أفعال يومية",
      "concept": "تنتهي أفعال المضارع المهذبة بـ **-아요 / -어요 / -해요**. وتُستخدم الصيغة نفسها لـ«أنا» و«أنت» و«هم».",
      "example": "먹어요. (meogeoyo.) = (أنا) آكل. / 마셔요. (masyeoyo.) = (أنا) أشرب."
    },
    "korean-k4-l2": {
      "title": "الذهاب إلى الأماكن",
      "concept": "ضع **에** بعد المكان لتقول إلى أين تذهب أو تأتي: 학교에 가요. يأتي الفعل في الآخر.",
      "example": "학교에 가요. (hakgyoe gayo.) = أذهب إلى المدرسة."
    },
    "korean-k4-l3": {
      "title": "الأكل والشرب والقراءة",
      "concept": "يأخذ مفعول الفعل **을** بعد الحرف الساكن و**를** بعد الحرف المتحرك: 밥을 먹어요, 커피를 마셔요.",
      "example": "밥을 먹어요. (babeul meogeoyo.) = آكل وجبة."
    },
    "korean-k5-l1": {
      "title": "أمس، اليوم، غدًا",
      "concept": "تأتي كلمات الزمن عادةً قرب بداية الجملة.",
      "example": "어제 · 오늘 · 내일 (eoje · oneul · naeil)"
    },
    "korean-k5-l2": {
      "title": "ما فعلته",
      "concept": "الزمن الماضي: **-았어요 / -었어요 / -했어요**. بعض الأفعال تُختصر: 가다 → 갔어요, 보다 → 봤어요.",
      "example": "먹었어요. (meogeosseoyo.) = أكلت."
    },
    "korean-k5-l3": {
      "title": "ما سأفعله",
      "concept": "استخدم **-(으)ㄹ 거예요** للخطط: 가다 → 갈 거예요, 먹다 → 먹을 거예요.",
      "example": "내일 갈 거예요. (naeil gal geoyeyo.) = سأذهب غدًا."
    },
    "korean-k6-l1": {
      "title": "في المتجر",
      "concept": "اسأل عن السعر بـ 얼마예요? واطلب شيئًا بـ **… 주세요** (… من فضلك).",
      "example": "얼마예요? (eolmayeyo?) = بكم هذا؟"
    },
    "korean-k6-l2": {
      "title": "أين هو؟",
      "concept": "اسأل **… 어디예요?** (أين …؟). انتبه إلى 오른쪽 (يمين) و왼쪽 (يسار) و직진 (إلى الأمام مباشرة).",
      "example": "화장실이 어디예요? (hwajangsiri eodiyeyo?) = أين الحمّام؟"
    },
    "korean-k6-l3": {
      "title": "أريد أن …",
      "concept": "أضف **-고 싶어요** إلى جذر الفعل لتقول ما تريد أن تفعله: 가다 → 가고 싶어요.",
      "example": "가고 싶어요. (gago sipeoyo.) = أريد أن أذهب."
    }
  },
