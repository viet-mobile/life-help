  "k.k3.sounds": {
   "notes": {
    "linkC": "A final consonant moves over to the next syllable when that syllable begins with a silent consonant letter, so it sounds linked.",
    "doubleC": "Of two final consonants, only one is pronounced before a consonant, but before a vowel the second one links to the next syllable.",
    "neutral": "At the end of a word or before a consonant, a final consonant is pronounced as only one of a few basic sounds.",
    "hDrop": "The h sound is silent after a vowel or n, m, l, ng; the neighbouring sounds then link smoothly.",
    "nasal": "A p, t or k sound becomes m, n or ng when a nasal consonant follows.",
    "lateral": "The sound n next to l is pronounced l.",
    "rToN": "An l sound after a stop or ng is pronounced n, and a stop before it may also turn nasal.",
    "wolLink": "A final l sound links to the next vowel-initial syllable, so the syllable boundary does not match the spelling."
   },
