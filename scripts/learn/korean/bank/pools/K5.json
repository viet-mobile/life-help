  "k.k5.plans": {
   "notes": {
    "planA": "The future/plan ending attaches to the verb stem: a linking vowel is added after a consonant stem, and none after a vowel stem.",
    "planB": "Stems ending in the consonant that sounds like 'l' drop it before this ending.",
    "planC": "The negative word goes before the verb, and the plan ending stays at the end."
