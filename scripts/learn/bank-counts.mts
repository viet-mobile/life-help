/* Honest question counts per subject, from the files the runtime really serves.   npx tsx scripts/learn/bank-counts.mts [--write]
 * Columns: ids | exact-unique (prompt+options+answer) | normalised-unique (digits masked, punctuation/case/option order ignored) |
 * independent learning items | served to a learner of locale L. Copies that only change a number, an id or the option order are NOT
 * independent: the 12,000 target is judged on the bank, apart from the regular course questions. */
import fs from "node:fs";
import { loadIndex } from "../../lib/learn/content/repository";
import type { Question, Site } from "../../lib/learn/types";

const mask = (s: string) => s.toLowerCase().replace(/\d+(?:[.,]\d+)*/g, "#").replace(/[^\p{L}\p{N}#]+/gu, " ").trim();
const optText = (q: Question) => (q.options ?? []).map((o) => mask(o.text ?? "")).sort().join("|");
const ansText = (q: Question) => q.answer.kind === "choice" ? mask((q.options ?? []).find((o) => o.id === (q.answer as { id: string }).id)?.text ?? "") : q.answer.kind === "order" ? (q.answer.ids as string[]).map((i) => mask((q.options ?? []).find((o) => o.id === i)?.text ?? "")).join(" ") : q.answer.kind === "numeric" ? "num" : JSON.stringify(q.answer);
const exact = (q: Question) => `${q.prompt}|${(q.options ?? []).map((o) => o.text).sort().join("|")}|${JSON.stringify(q.answer)}`;
const normalised = (q: Question) => `${mask(q.prompt)}|${optText(q)}|${ansText(q)}`;
const uniq = (qs: Question[], f: (q: Question) => string) => new Set(qs.map(f)).size;
// independent learning item: math = one structure (family of the set); english = the authored item (id middle part); korean = the bank item (id middle part)
const itemKey = (site: Site, q: Question) => site === "math" ? (q.family ?? q.id) : q.id.split("-").slice(site === "korean" ? 2 : 1, site === "korean" ? -1 : -1).join("-");

type Row = { subject: string; scope: string; ids: number; exactUnique: number; normalisedUnique: number; independentItems: number };
const rows: Row[] = [];
const served: Record<string, Record<string, number>> = {};
const BANK = (site: Site) => (q: Question) => site === "math" ? q.tags?.includes("bank") === true : site === "english" ? q.id.startsWith("eb-") : q.id.startsWith("kb-");
const LOCALES = ["ko", "en", "vi", "ja", "zh-Hans", "th", "am"] as const;
for (const site of ["math", "english", "korean"] as const) {
  const { bundle } = await loadIndex(site);
  const bank = bundle.questions.filter(BANK(site));
  const course = bundle.questions.filter((q) => !BANK(site)(q));
  const hsOnly = site === "math" ? bank.filter((q) => q.id.startsWith("b-hs-")) : [];
  const mathOld = site === "math" ? bank.filter((q) => !q.id.startsWith("b-hs-")) : [];
  const add = (scope: string, qs: Question[]) => rows.push({ subject: site, scope, ids: qs.length, exactUnique: uniq(qs, exact), normalisedUnique: uniq(qs, normalised), independentItems: new Set(qs.map((q) => itemKey(site, q))).size });
  add("course (regular lessons/diagnostic, PUBLISHED)", course);
  if (site === "math") { add("bank: original (b-*)", mathOld); add("bank: high-school tranche (b-hs-*)", hsOnly); }
  add(`bank: ${site === "math" ? "all" : "practice bank"}`, bank);
  served[site] = {};
  for (const L of LOCALES) { const b = (await loadIndex(site, { locale: L })).bundle; served[site][L] = b.questions.filter(BANK(site)).length; }
}
const md = ["| subject | scope | ids | exact-unique | normalised-unique | independent items |", "|---|---|---:|---:|---:|---:|", ...rows.map((r) => `| ${r.subject} | ${r.scope} | ${r.ids} | ${r.exactUnique} | ${r.normalisedUnique} | ${r.independentItems} |`), "", "Bank questions served per learner language (0 = the bank is withheld for that language):", "", "| subject | " + LOCALES.join(" | ") + " |", "|---|" + LOCALES.map(() => "---:").join("|") + "|", ...Object.entries(served).map(([s, v]) => `| ${s} | ${LOCALES.map((l) => v[l]).join(" | ")} |`)].join("\n");
console.log(md);
if (process.argv.includes("--write")) fs.writeFileSync("docs/release/bank-counts-generated.md", `# Question counts (generated by scripts/learn/bank-counts.mts)\n\n${md}\n`);
