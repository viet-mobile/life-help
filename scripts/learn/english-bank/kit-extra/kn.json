  "q:eb-f1232ce3-q3": "ಸಬ್‌ವೇ ನಕ್ಷೆ ನಿಲ್ದಾಣಗಳ ನಡುವೆ ಸಮಾನ ಅಂತರವನ್ನು ಏಕೆ ತೋರಿಸುತ್ತದೆ?",
  "q:eb-f1a379cf-q3": "ಪರಿಪೂರ್ಣತಾವಾದಿಗಳು ಸಾಮಾನ್ಯವಾಗಿ ಏನು ಮಾಡುತ್ತಾರೆ?",
  "q:eb-f219e2c5-q3": "'than those on ordinary land' ಎಂಬಲ್ಲಿ 'those' ಯಾವುದನ್ನು ಸೂಚಿಸುತ್ತದೆ?",
  "q:eb-f219e2c5-q4": "ರೈತರ ಆಯ್ಕೆಯ ಬಗ್ಗೆ ಲೇಖಕನ ಮನೋಭಾವವನ್ನು ಯಾವುದು ವಿವರಿಸುತ್ತದೆ?",
  "q:eb-f465448c-q1": "ಲೇಖಕ ಯಾವಾಗ ಚಿತ್ರ ಬಿಡಿಸುತ್ತಾನೆ?",
  "q:eb-f465448c-q3": "ಚಿತ್ರಕಲೆ ಶಿಕ್ಷಕರು ಏನು ಯೋಚಿಸುತ್ತಾರೆ?",
  "q:eb-f465448c-q4": "ಲೇಖಕ ಮುಂದೆ ಏನು ಚಿತ್ರ ಬಿಡಿಸುತ್ತಾನೆ?",
  "q:eb-f5596fd9-q3": "ಪಠ್ಯದ ಪ್ರಕಾರ, ತಾನಾಗಿ ಆರಿಸಿಕೊಂಡ ಏಕಾಂತ ಏನನ್ನು ತರುತ್ತದೆ?",
  "q:eb-f6d8c54f-q2": "ಹುಡುಗಿ ಮೊದಲು ನಿಂತಾಗ ಅವಳಿಗೆ ಹೇಗೆ ಅನಿಸಿತು?",
  "q:eb-f88efd8f-q1": "A ಯಾವುದಕ್ಕೆ ಹೆದರುತ್ತಾನೆ?",
  "q:eb-f9a4f6ec-q1": "ಮೊದಲ ಪಂದ್ಯದಲ್ಲಿ ಏನು ತಪ್ಪಾಯಿತು?",
  "q:eb-f9a4f6ec-q3": "ಸಡಿಲವಾದ ತಂತಿಯನ್ನು ಏಕೆ ಗಮನಿಸಿರಲಿಲ್ಲ?",
  "q:eb-f9a4f6ec-q4": "ಪಂದ್ಯದ ತಕ್ಷಣ ನಂತರ ಲೇಖಕನ ತಂಡಕ್ಕೆ ಹೇಗೆ ಅನಿಸಿತು?",
  "q:eb-fb23fddd-q2": "ಪಠ್ಯದ ಪ್ರಕಾರ, ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಯಾರಿಗೆ ತಿಳಿದಿರಬಹುದು?",
  "q:eb-fb23fddd-q4": "ಅಪರಿಚಿತರು ಸಂದೇಶ ಕಳುಹಿಸಿದರೆ ನೀವು ಏನು ಮಾಡಬೇಕು?",
  "q:eb-fc5455fc-m": "/m/ ಧ್ವನಿಯಿಂದ ಯಾವ ಪದ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ?",
  "q:eb-fc813d5b-q2": "ವ್ಯಾಯಾಮ ಶಾಲೆಯನ್ನು ಯಾರು ಅಲಂಕರಿಸುತ್ತಾರೆ?",
  "q:eb-fdb1067f-q2": "ಕಾರ್ಡ್ ಹೊಂದಿರುವವರು ಎಷ್ಟು ಪುಸ್ತಕಗಳನ್ನು ಎರವಲು ಪಡೆಯಬಹುದು?",
  "q:eb-fdb1067f-q4": "ಗ್ರಂಥಾಲಯ ಕಾರ್ಡ್‌ಗೆ ಯಾರು ಸಹಿ ಹಾಕಬೇಕು?",
  "q:eb-ff5b1737-q3": "ಡೈನೋಸಾರ್ ಮೂಳೆಗಳನ್ನು ನೋಡಿದ ತಕ್ಷಣ ಕುಟುಂಬ ಏನು ಮಾಡಿತು?",
