{
  "name": "life-help",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs --target=staging",
    "build:staging": "node scripts/build.mjs --target=staging",
    "build:production": "node scripts/build.mjs --target=production",
    "build:next": "node scripts/build.mjs --target=staging --next-only",
    "start": "node scripts/dev.mjs --start",
    "lint": "next lint",
    "preview": "node scripts/preview.mjs",
    "deploy": "node scripts/refuse-ambiguous-deploy.mjs",
    "deploy:staging": "node scripts/build.mjs --target=staging && node scripts/verify-build.mjs --target=staging && wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production": "node scripts/build.mjs --target=production && node scripts/verify-build.mjs --target=production && wrangler deploy --name life-help",
    "test": "node scripts/run-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:learn": "vitest run",
    "test:e2e": "playwright test",
    "lint:learn": "eslint app/study app/api/learn lib/learn lib/env.ts components/learn tests utils/supabase/admin.ts",
    "check:learn": "npm run typecheck && npm run lint:learn && npm run test:learn",
    "seed:learn:generate": "node scripts/learn/generate-seed.mjs",
    "bank:generate": "node scripts/learn/bank/generate.mjs",
    "bank:calibrate": "node scripts/learn/bank/calibrate.mjs",
    "check:learn:secrets": "node scripts/learn/check-no-secrets.mjs",
    "test:learn:bundle": "node scripts/test_learning_bundle_secrets.mjs",
    "bank:validate-data": "node scripts/learn/bank/core/validate-calibration-data.mjs",
    "bank:audit": "node scripts/learn/bank/core/audit.mjs",
    "bank:probe": "node scripts/learn/bank/core/probe-family.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "katex": "^0.18.9",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "opencc-js": "^1.4.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.142.0"
  }
}
