{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "life-help",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Staging Worker: a separate Worker served on its own *.workers.dev URL, deployed only with
  // `--env staging`. It has no routes/custom domains and is unrelated to the production
  // `*.life.help/* -> life-help` route. Nothing here changes the default (production) deploy.
  "env": {
    "staging": {
      "name": "life-help-staging",
      "main": ".open-next/worker.js",
      "compatibility_date": "2024-09-23",
      "compatibility_flags": ["nodejs_compat"],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "vars": {
        "APP_ENV": "staging",
        // Non-secret: pins this Worker to the staging Supabase project (fail-closed guard in lib/env.ts).
        "EXPECTED_SUPABASE_REF": "wreebowcbiymodswajwe"
      }
    }
  }
}
