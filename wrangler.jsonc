{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "life-help",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/favicon.ico", "/learn-content/*"]
  },
  "kv_namespaces": [{ "binding": "JIU_MAIL_STATE", "id": "a9762c3d3317416ea30b09fe1ad7640d" }],
  "send_email": [{ "name": "JIU_EMAIL", "destination_address": "jiubag850@gmail.com" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
