{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "minify": true,
  "name": "life-help",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/favicon.ico", "/learn-content/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "kv_namespaces": [{ "binding": "JIU_MAIL_STATE", "id": "a9762c3d3317416ea30b09fe1ad7640d" }],
  "send_email": [{ "name": "JIU_EMAIL", "destination_address": "jiubag850@gmail.com" }],
  "ratelimits": [{ "name": "LEARN_RATE", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  "upload_source_maps": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
