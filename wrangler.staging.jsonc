// STAGING-ONLY Worker config for the learning-only production port (used to stage-validate the exact artifact; never used for production).
// Same artifact as production (`opennextjs-cloudflare build`, no environment baked in). Differences are runtime bindings only:
//   APP_ENV=staging lets the learning sites be reached by path (/study/<site>); the learning platform reads its own LEARN_SUPABASE_* names.
//   Worker secrets (never here): LEARN_SUPABASE_PUBLISHABLE_KEY, LEARN_SUPABASE_SECRET_KEY (reported installed on life-help-staging - verify with
//   `wrangler secret list --config wrangler.staging.jsonc`), and for the integrated tree SERVICE_CORE_SUPABASE_SECRET_KEY, LIFE_HELP_SYS_ADMIN_ID,
//   LIFE_HELP_SYS_ADMIN_PASSWORD, LIFE_HELP_SYS_SESSION_SECRET. Names and classification: scripts/staging/contract.cjs (WORKER_BINDINGS).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "life-help-staging",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/favicon.ico", "/learn-content/*"]
  },
  "vars": {
    "APP_ENV": "staging",
    "LEARN_SUPABASE_URL": "https://wreebowcbiymodswajwe.supabase.co",
    "EXPECTED_LEARN_SUPABASE_REF": "wreebowcbiymodswajwe",
    "SERVICE_CORE_SUPABASE_URL": "https://wreebowcbiymodswajwe.supabase.co",
    "EXPECTED_SERVICE_CORE_SUPABASE_REF": "wreebowcbiymodswajwe"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
