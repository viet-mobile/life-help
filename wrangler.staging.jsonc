// STAGING-ONLY Worker config, used by `npm run deploy:staging`.
// Same as wrangler.jsonc plus the staging cron entry (workers/scheduled.mjs) and its trigger.
// Production (`deploy:production`) uses wrangler.jsonc, which has no cron trigger.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "workers/scheduled.mjs",
  "name": "life-help-staging",
  "compatibility_date": "2024-09-23",
  // At this compatibility date nodejs_compat alone does not copy bindings / secrets into process.env; the server code
  // (learning platform, lib/supabase/serviceRole.ts) reads Supabase credentials from process.env.
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/favicon.ico"]
  },
  // Every 6 hours at minute 17: retry for interrupted post-SETTLED conversation cleanup.
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  // STAGING ONLY (never in wrangler.jsonc): Solana DEVNET test rail + private request-media bucket.
  // Public values only. Worker SECRETS (never here): LIFE_HELP_SOLANA_DEVNET_SIGNER_SECRET (devnet signer)
  // and LIFE_HELP_SOLANA_DEVNET_RPC_URL (any standard devnet JSON-RPC provider; may carry an API key).
  // The recipient below is the signer's public address (the staging holding account). The FX rate is
  // an explicit TEST rate for devnet test USDC, not a market rate.
  "vars": {
    // Learning sites (/study, math|english-staging hosts): APP_ENV selects staging behavior (lib/env.ts). The learning platform has
    // its OWN Supabase contract and never reads the generic SUPABASE_* names:
    //   vars (public, here):  LEARN_SUPABASE_URL, EXPECTED_LEARN_SUPABASE_REF (accounts fail closed unless the URL's project ref equals it)
    //   Worker secrets (NOT here, set with `wrangler secret put ... --config wrangler.staging.jsonc`):
    //     LEARN_SUPABASE_PUBLISHABLE_KEY  (public by design, but kept a secret binding: plain vars set in the dashboard are removed by a deploy)
    //     LEARN_SUPABASE_SECRET_KEY       (trusted server key)
    //   Until BOTH secrets exist, learning accounts stay off and guests are unaffected.
    "APP_ENV": "staging",
    "LEARN_SUPABASE_URL": "https://wreebowcbiymodswajwe.supabase.co",
    "EXPECTED_LEARN_SUPABASE_REF": "wreebowcbiymodswajwe",
    "LIFE_HELP_PAYMENT_MODE": "STAGING_DEVNET_TEST",
    "LIFE_HELP_SOLANA_DEVNET_RECIPIENT": "D89fnNdAMFSnd4Jc8NvHcAkGQfvhWFkhY84K5qALQE4",
    "LIFE_HELP_TEST_FX_RATES": "KRW=1400",
    "LIFE_HELP_MEDIA_BUCKET": "life-help-staging-request-media"
  }
}
