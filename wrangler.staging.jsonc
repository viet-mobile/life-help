// STAGING-ONLY Worker config, used by `npm run deploy:staging`.
// Same as wrangler.jsonc plus the staging cron entry (workers/scheduled.mjs) and its trigger.
// Production (`deploy:production`) uses wrangler.jsonc, which has no cron trigger.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "workers/scheduled.mjs",
  "name": "life-help-staging",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Every 6 hours at minute 17: retry for interrupted post-SETTLED conversation cleanup.
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  // STAGING ONLY (never in wrangler.jsonc): Solana DEVNET test rail + private request-media bucket.
  // Public values only. Worker SECRETS (never here): LIFE_HELP_SOLANA_DEVNET_SIGNER_SECRET (devnet signer)
  // and LIFE_HELP_SOLANA_DEVNET_RPC_URL (any standard devnet JSON-RPC provider; may carry an API key).
  // The recipient below is the signer's public address (the staging holding account). The FX rate is
  // an explicit TEST rate for devnet test USDC, not a market rate.
  "vars": {
    "LIFE_HELP_PAYMENT_MODE": "STAGING_DEVNET_TEST",
    "LIFE_HELP_SOLANA_DEVNET_RECIPIENT": "D89fnNdAMFSnd4Jc8NvHcAkGQfvhWFkhY84K5qALQE4",
    "LIFE_HELP_TEST_FX_RATES": "KRW=1400",
    "LIFE_HELP_MEDIA_BUCKET": "life-help-staging-request-media"
  }
}
