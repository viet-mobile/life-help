    "selfAssess": [
     "\ub0b4\uac00 \ub4e0 \uc218\uc5d0\uc11c p\ub294 \ucc38\uc774\uace0 r\ub294 \uac70\uc9d3\uc774\ub77c\ub294 \uac83\uc774 \ubd84\uba85\ud788 \ubcf4\uc774\ub098\uc694?",
     "'\ud655\uc815\ud560 \uc218 \uc5c6\ub2e4'\uc640 '\uac70\uc9d3\uc774\ub2e4'\ub97c \uad6c\ubcc4\ud574\uc11c \uc37c\ub098\uc694?",
     "\ub0b4\uac00 \ub9d0\ud55c \ucd94\uac00 \uc815\ubcf4\uac00 \uc788\uc73c\uba74 \uc815\ub9d0 'p\uc774\uba74 r\uc774\ub2e4'\uac00 \ucc38\uc774 \ub418\ub294\uc9c0 \ud55c \uac00\uc9c0 \uc608\ub85c \ud655\uc778\ud574 \ubcf4\uc558\ub098\uc694?",
     "s1\uc5d0\uc11c \ucc98\uc74c \uace0\ub978 \uac83\uc774 \ubc14\ub00c\uc5c8\ub2e4\uba74 \ubb34\uc5c7 \ub54c\ubb38\uc5d0 \ubc14\ub00c\uc5c8\ub294\uc9c0, \uadf8\ub300\ub85c\ub77c\uba74 \uc5b4\ub5a4 \uadfc\uac70\ub85c \uadf8\ub300\ub85c\uc778\uc9c0 \uc37c\ub098\uc694?"
    ],
    "modelAnswers": [
     {
      "text": "\uc9c0\ud638\uc758 \ub9d0\uc740 \ud655\uc815\ud560 \uc218 \uc5c6\uc5b4. 4\ub294 4\uc758 \ubc30\uc218\ub77c\uc11c p\ub294 \ucc38\uc778\ub370 6\uc758 \ubc30\uc218\uac00 \uc544\ub2c8\ub77c\uc11c r\ub294 \uac70\uc9d3\uc774\uc57c. \uadf8\ub798\ub3c4 (\uac00), (\ub098)\ub294 \uadf8\ub300\ub85c \ucc38\uc774\ub2c8\uae4c q \uc548\uc5d0 \uc788\ub2e4\ub294 \uac83\ub9cc\uc73c\ub85c\ub294 \ubd80\uc871\ud574. P\uac00 R \uc548\uc5d0 \ub4e4\uc5b4 \uc788\ub2e4\ub294 \uc815\ubcf4\ucc98\ub7fc p\uc640 r\uc744 \uc9c1\uc811 \uc774\uc5b4 \uc8fc\ub294 \uac83\uc774 \ub354 \ud544\uc694\ud574.",
      "note": "\ucc98\uc74c 'p\uc774\uba74 r\uc774\ub2e4'\ub97c \uace0\ub974\uc9c0 \uc54a\uc558\ub2e4\uba74 \ud310\ub2e8\uc774 \uadf8\ub300\ub85c\uc778 \uacbd\uc6b0\ub85c, \uc608\ub85c \ud655\uc778\ud574 \ud655\uc2e0\uc774 \ucee4\uc84c\ub2e4\uace0 \uc4f0\uba74 \ub41c\ub2e4."
     },
     {
      "text": "\ucc38\uc778\uc9c0 \uc54c \uc218 \uc5c6\uc5b4. 16\uc740 4\uc758 \ubc30\uc218\uc9c0\ub9cc 6\uc758 \ubc30\uc218\ub294 \uc544\ub2c8\ub77c\uc11c \ubc18\ub840\uac00 \ub3fc. \uadf8\ub7f0\ub370 'q\uc774\uba74 r\uc774\ub2e4'\uae4c\uc9c0 \uc54c\uac8c \ub418\uba74 P\uac00 Q \uc548\uc5d0, Q\uac00 R \uc548\uc5d0 \uc788\uc73c\ub2c8 P\ub3c4 R \uc548\uc5d0 \uc788\uc5b4\uc11c p\uc774\uba74 r\uc774 \ucc38\uc774 \ub3fc. \ucc98\uc74c\uc5d4 \ucc38\uc77c \uac83 \uac19\uc558\ub294\ub370 \ubc18\ub840\ub97c \ucc3e\uace0 \uc0dd\uac01\uc744 \ubc14\uafe8\uc5b4.",
      "note": "\uc0c8 \uc815\ubcf4\ub97c \ud558\ub098 \uc81c\uc2dc\ud558\uace0 \uadf8\uac83\uc774 \ucda9\ubd84\ud55c \uc774\uc720\uae4c\uc9c0 \ub9d0\ud55c \ub2f5. R=Q\uc778 \uacbd\uc6b0\ub294 (\ub098)\uc640 \ud569\uccd0 'q\uc774\uba74 r'\uc774 \ub418\ubbc0\ub85c \uac19\uc740 \ub2f5\uc758 \ub2e4\ub978 \ud45c\ud604\uc774\ub2e4."
     }
