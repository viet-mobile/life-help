  "title": "\uac19\uc740 \uacf3\uc73c\ub85c \uc774\uc5b4\uc9c0\ub294 \ub450 \uc870\uac74, \uc11c\ub85c\ub294 \uc5b4\ub5a4 \uc0ac\uc774\uc77c\uae4c",
  "uiLang": "ko",
  "format": "choose-needed-info",
  "generative": true,
  "goal": "'p\uc774\uba74 q'\uc640 'r\uc774\uba74 q'\uac00 \ucc38\uc774\ub77c\ub294 \uc815\ubcf4\ub9cc\uc73c\ub85c \ud655\uc815\ub418\ub294 \ubb38\uc7a5\uacfc \ud655\uc815\ub418\uc9c0 \uc54a\ub294 \ubb38\uc7a5\uc744 \uc9c4\ub9ac\uc9d1\ud569\uc758 \ud3ec\ud568 \uad00\uacc4\ub85c \uac00\ub824\ub0b4\uace0, \ud655\uc815\ub418\uc9c0 \uc54a\ub294 \ubb38\uc7a5\uc740 \ubc18\ub840\ub85c \ubcf4\uc774\uba70, \ud655\uc815\ud558\ub824\uba74 \ubb34\uc5c7\uc744 \ub354 \uc54c\uc544\uc57c \ud558\ub294\uc9c0 \ub9d0\ud55c\ub2e4.",
  "thinking": [
   "\uc8fc\uc5b4\uc9c4 \uc815\ubcf4\ub85c \ud655\uc815\ub418\ub294 \uac83\uacfc '\uc54c \uc218 \uc5c6\ub294' \uac83\uc744 \uad6c\ubcc4\ud558\uae30",
   "\uc870\uac74\uc744 \uc9c4\ub9ac\uc9d1\ud569\uc758 \ud3ec\ud568 \uad00\uacc4\ub85c \ubc14\uafb8\uc5b4 \ud310\ub2e8\ud558\uae30",
   "\ubc18\ub840\ub97c \uc9c1\uc811 \ub9cc\ub4e4\uc5b4 '\ud56d\uc0c1 \ucc38\uc740 \uc544\ub2d8'\uc744 \ubcf4\uc774\uae30",
   "\uacb0\ub860\uc744 \ud655\uc815\ud558\ub294 \ub370 \ubd80\uc871\ud55c \uc815\ubcf4\uac00 \ubb34\uc5c7\uc778\uc9c0 \ub9d0\ud558\uae30"
  ],
  "differsFromPlain": "\ub2e8\uc21c \uc5f0\uc2b5\uc740 \ub450 \uc870\uac74 p, q\uac00 \uc8fc\uc5b4\uc9c0\uba74 \ud544\uc694\uc870\uac74\u00b7\ucda9\ubd84\uc870\uac74\uc744 \ud310\ubcc4\ud558\uac8c \ud55c\ub2e4. \uc5ec\uae30\uc11c\ub294 \uc870\uac74\uc774 \uc14b(p, q, r)\uc774\uace0 p\uc640 r \uc0ac\uc774\uc758 \uad00\uacc4\ub294 \uc8fc\uc5b4\uc9c0\uc9c0 \uc54a\uc544\uc11c, \uc5b4\ub5a4 \ubb38\uc7a5\uc774 \ud655\uc815\ub418\ub294\uc9c0\ubd80\ud130 \ud559\uc0dd\uc774 \uac00\ub824\ub0b4\uc57c \ud55c\ub2e4. \ub610 '\uc54c \uc218 \uc5c6\ub2e4'\ub294 \ud310\ub2e8\uc774 \ub9de\ub294 \uc774\uc720\ub97c \uad6c\uccb4\uc801\uc778 \uc218\uc758 \ubc18\ub840\ub85c \ub4b7\ubc1b\uce68\ud558\uace0, \ubb34\uc5c7\uc744 \ub354 \uc54c\uba74 \ud655\uc815\ub418\ub294\uc9c0\uae4c\uc9c0 \ub9d0\ud55c\ub2e4.",
  "prerequisites": [
   "\uba85\uc81c 'p\uc774\uba74 q'\uac00 \ucc38\uc77c \ub54c \uc9c4\ub9ac\uc9d1\ud569 P\uac00 Q\uc758 \ubd80\ubd84\uc9d1\ud569\uc774\ub77c\ub294 \uac83, \uadf8\ub9ac\uace0 \ub300\uc6b0\uac00 \uc6d0\ub798 \uba85\uc81c\uc640 \uac19\uc740 \ucc38\u00b7\uac70\uc9d3\uc744 \uac16\ub294\ub2e4\ub294 \uac83 (\uacf5\ud1b5\uc218\ud559 '\uc9d1\ud569\uacfc \uba85\uc81c' \uc55e\ubd80\ubd84\uc744 \ubc30\uc6b4 \ub4a4\ub77c\uace0 \uac00\uc815; H2\ub294 \uc774 \uc0dd\uc0b0 \ubc30\uc815\uc758 \ub09c\uc774\ub3c4 \uad6c\ubd84\uc77c \ubfd0 \ud559\ub144 \uc9c0\uc815\uc774 \uc544\ub2c8\ub2e4)",
   "\ud569\uc9d1\ud569\u00b7\uad50\uc9d1\ud569\uacfc \uc5ec\uc9d1\ud569\uc758 \ub73b, \ubc30\uc218\uc640 \uc57d\uc218"
  ],
  "minutes": 14,
  "curriculum": null,
  "material": "\uc804\uccb4\uc9d1\ud569 U\uc5d0\uc11c \uc138 \uc870\uac74 p, q, r\ub97c \uc0dd\uac01\ud574\uc694. \uac01\uac01\uc758 \uc9c4\ub9ac\uc9d1\ud569\uc744 P, Q, R\ub77c\uace0 \ud574\uc694. \uc544\ub294 \uac83\uc740 \ub2e4\uc74c \ub450 \uac00\uc9c0\ubfd0\uc774\uc5d0\uc694.\n(\uac00) \uba85\uc81c 'p\uc774\uba74 q\uc774\ub2e4'\ub294 \ucc38\uc774\ub2e4. (P\ub294 Q\uc758 \ubd80\ubd84\uc9d1\ud569\uc774\ub2e4.)\n(\ub098) \uba85\uc81c 'r\uc774\uba74 q\uc774\ub2e4'\ub294 \ucc38\uc774\ub2e4. (R\ub294 Q\uc758 \ubd80\ubd84\uc9d1\ud569\uc774\ub2e4.)\nP\uc640 R \uc0ac\uc774\uc758 \uad00\uacc4\ub294 \uc544\ubb34\uac83\ub3c4 \uc54c\ub824\uc9c0\uc9c0 \uc54a\uc558\uc5b4\uc694. \uadf8\ub9bc \uc5c6\uc774 \ub9d0\ub85c\ub9cc \uc774\ud574\ud574\ub3c4 \ub418\ub3c4\ub85d, 'P\ub294 Q \uc548\uc5d0 \ub4e4\uc5b4 \uc788\uace0 R\ub3c4 Q \uc548\uc5d0 \ub4e4\uc5b4 \uc788\ub2e4'\uace0 \uadf8\ub824 \ubcf4\uba74 \ub3fc\uc694.",
