  "hardCases": [
   "P\uac00 \uacf5\uc9d1\ud569\uc774\uac70\ub098 P\uc640 R\uac00 \uac19\uc740 \uacbd\uc6b0\uc5d0\ub294 'p\uc774\uba74 r\uc774\ub2e4'\uac00 \uc2e4\uc81c\ub85c \ucc38\uc774\ub2e4. \uadf8\ub798\uc11c '\ud655\uc815\ub418\uc9c0 \uc54a\ub294\ub2e4'\ub294 '\uac70\uc9d3\uc774\ub2e4'\uac00 \uc544\ub2c8\ub77c '\uc774 \uc815\ubcf4\ub9cc\uc73c\ub85c\ub294 \ucc38\uc774\ub77c\uace0 \ub2e8\uc815\ud560 \uc218 \uc5c6\ub2e4'\ub294 \ub73b\uc774\ub2e4. \ud559\uc0dd\uc774 \uc774 \ub458\uc744 \uc11e\uc5b4 \uc4f0\uba74 \uc0ac\ub78c\uc774 \uc9da\uc5b4 \uc8fc\uc5b4\uc57c \ud55c\ub2e4.",
