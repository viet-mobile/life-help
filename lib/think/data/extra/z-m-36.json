  "topic": "\ub450 \uc870\uac74\uc774 \uac19\uc740 \uc870\uac74\uc73c\ub85c \uc774\uc5b4\uc9c8 \ub54c \uc54c \uc218 \uc788\ub294 \uac83\uacfc \uc54c \uc218 \uc5c6\ub294 \uac83 (\uc9c4\ub9ac\uc9d1\ud569\uc758 \ud3ec\ud568 \uad00\uacc4)",
  "level": 3,
