  "topic": "\ud568\uc218\uc758 \ub73b\uacfc \uc77c\ub300\uc77c\ud568\uc218: \uac12\uc758 \ud569 \uc870\uac74\uacfc \uacf5\uc5ed\uc758 \ud06c\uae30",
  "level": 3,
  "levelLabel": "\uace0\ub4f1",
  "title": "\uc11c\ub85c \ub2e4\ub978 \uac12\uc778\ub370 \ud569\uc774 \uac19\uc744 \uc218 \uc788\uc744\uae4c?",
  "uiLang": "ko",
  "format": "build-many-verify",
  "generative": true,
  "goal": "\uc77c\ub300\uc77c\ud568\uc218\uc758 \ub73b(\uc11c\ub85c \ub2e4\ub978 \uc6d0\uc18c\ub294 \uc11c\ub85c \ub2e4\ub978 \uac12\uc5d0 \ub300\uc751)\uc774 \uac12\ub4e4\uc758 \ud569\uc5d0 \ub300\ud574\uc11c\ub294 \uc544\ubb34\uac83\ub3c4 \ub9d0\ud558\uc9c0 \uc54a\ub294\ub2e4\ub294 \uc810\uc744 \ubc18\ub840\ub85c \ud655\uc778\ud558\uace0, \uac19\uc740 \uc870\uac74\uc758 \ud568\uc218\uac00 \uc874\uc7ac\ud558\ub294\uc9c0\uac00 \uacf5\uc5ed\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d0\uc744 \uc124\uba85\ud55c\ub2e4.",
  "thinking": [
   "\uc8fc\uc7a5\uc744 \uac12\uc758 \ud45c\ub85c \uc62e\uaca8 \uc2dc\ud5d8\ud558\uae30",
   "\uc870\uac74\uc744 \ub9cc\uc871\ud558\ub294 \uc11c\ub85c \ub2e4\ub978 \uc608(\ubc18\ub840) \ub9cc\ub4e4\uae30",
   "\uacf5\uc5ed\uc744 \ubc14\uafe8\uc744 \ub54c \uc874\uc7ac \uc5ec\ubd80\ub97c \uc870\uac74\ubd80\ub85c \ud310\ub2e8\ud558\uae30"
  ],
  "differsFromPlain": "\ub2e8\uc21c \uc5f0\uc2b5\uc740 \uc815\uc758\uc5ed\u00b7\uacf5\uc5ed\uc774 \uc8fc\uc5b4\uc9c4 \ud568\uc218\uc5d0\uc11c \uc77c\ub300\uc77c\ud568\uc218\uc758 \uac1c\uc218\ub098 \uc2dd\uc758 \uac12\uc744 \uad6c\ud55c\ub2e4. \uc5ec\uae30\uc11c\ub294 '\uc77c\ub300\uc77c\uc774\uba74 \ud569\uc774 \ub2e4\ub974\ub2e4'\ub294 \uadf8\ub7f4\ub4ef\ud55c \uc8fc\uc7a5\uc744 \uc9c1\uc811 \uc2dc\ud5d8\ud558\uace0, \uc870\uac74\uc744 \ub9cc\uc871\ud558\ub294 \ud568\uc218\ub97c \uc5ec\ub7ec \uac1c \ub9cc\ub4e4\uace0, \uacf5\uc5ed\uc774 \ubc14\ub00c\uba74 \uc874\uc7ac \uc5ec\ubd80\uac00 \uc5b4\ub5bb\uac8c \ub2ec\ub77c\uc9c0\ub294\uc9c0 \ud310\ub2e8\ud55c\ub2e4.",
  "prerequisites": [
   "\ud568\uc218, \uc815\uc758\uc5ed\u00b7\uacf5\uc5ed\u00b7\uce58\uc5ed\uc758 \ub73b\uacfc \uc77c\ub300\uc77c\ud568\uc218\uc758 \ub73b(\uace0\ub4f1 \uacf5\ud1b5\uc218\ud559\uc758 \ud568\uc218 \ub2e8\uc6d0 \uc55e\ubd80\ubd84)",
   "\uc9d1\ud569\uc758 \uc6d0\uc18c\uc758 \uac1c\uc218 \uc138\uae30",
   "(\ud559\uad50 \uc21c\uc11c \uac00\uc815: \uc774 \uacfc\uc81c\uc758 H2\ub294 \uc81c\uc791 \ubc30\uc815\uc758 \ub09c\uc774\ub3c4 \ud45c\uc2dc\uc77c \ubfd0\uc774\uba70, \uc704 \uc120\uc218\ud559\uc2b5\uc744 \uc774\ubbf8 \ubc30\uc6e0\ub2e4\uace0 \uac00\uc815\ud55c\ub2e4)"
  ],
  "minutes": 14,
  "curriculum": null,
  "material": "\uc815\uc758\uc5ed X={1, 2, 3, 4}\uc5d0\uc11c \uacf5\uc5ed Y={1, 2, 3, 4, 5, 6, 7}\ub85c \uac00\ub294 \ud568\uc218 f\ub97c \uac12\uc758 \ud45c\ub85c \uc0dd\uac01\ud574\uc694. \ud45c\uc5d0\ub294 f(1), f(2), f(3), f(4)\ub9cc \uc801\ud600 \uc788\uc5b4\uc694(\uc2dd\uc740 \uc5c6\uc5b4\uc694). \uc870\uac74 (\uac00): f\ub294 \uc77c\ub300\uc77c\ud568\uc218, \uc989 X\uc758 \uc11c\ub85c \ub2e4\ub978 \uc6d0\uc18c\ub294 \uc11c\ub85c \ub2e4\ub978 \uac12\uc5d0 \ub300\uc751\ud574\uc694. \uc870\uac74 (\ub098): f(1)+f(4)=f(2)+f(3). \ubbfc\uc544\uac00 \ub9d0\ud588\uc5b4\uc694. \"\uc77c\ub300\uc77c\ud568\uc218\uba74 \ub124 \uac12\uc774 \ubaa8\ub450 \ub2e4\ub974\uc796\uc544. \uadf8\ub7ec\uba74 (\ub098)\ucc98\ub7fc \ub450 \uc30d\uc758 \ud569\uc774 \uac19\uc744 \uc218\ub294 \uc5c6\uc5b4.\"",
  "steps": [
   {
    "id": "s1",
    "kind": "choose",
    "prompt": "\ubbfc\uc544\uc758 \ub9d0\uc5d0 \ub300\ud55c \uccab \ud310\ub2e8\uc744 \uace0\ub974\uc138\uc694. (\uc544\uc9c1 \uacc4\uc0b0\ud558\uc9c0 \uc54a\uc544\ub3c4 \ub3fc\uc694.)",
    "options": [
     {
      "id": "a",
      "text": "\ub9de\ub2e4. \ub124 \uac12\uc774 \ubaa8\ub450 \ub2e4\ub974\uba74 \ub450 \uc30d\uc758 \ud569\ub3c4 \uc11c\ub85c \ub2e4\ub974\uac8c \ub41c\ub2e4",
      "reveals": "'\uac12\uc774 \uc11c\ub85c \ub2e4\ub974\ub2e4'\uc640 '\ud569\uc774 \uc11c\ub85c \ub2e4\ub974\ub2e4'\ub97c \uac19\uc740 \ub9d0\ub85c \ubcf4\uace0 \uc788\uc5b4\uc694. \uc11c\ub85c \ub2e4\ub978 \ub450 \uc218 \uc30d\uc744 \uc9c1\uc811 \uace8\ub77c \ud569\uc744 \ube44\uad50\ud574 \ubcf4\uc138\uc694."
     },
     {
      "id": "b",
      "text": "\ub9de\ub2e4. \uc77c\ub300\uc77c\ud568\uc218\ub294 x\uac00 \ucee4\uc9c8\uc218\ub85d \uac12\ub3c4 \ucee4\uc9c0\ubbc0\ub85c \ud569\uc774 \uac19\uc744 \uc218 \uc5c6\ub2e4",
      "reveals": "\uc77c\ub300\uc77c\ud568\uc218\uc640 \uc99d\uac00\ud558\ub294 \ud568\uc218\ub97c \uac19\uac8c \ubcf4\uace0 \uc788\uc5b4\uc694. \uac12\uc774 \uc904\uc5b4\ub4dc\ub294 \uc77c\ub300\uc77c\ud568\uc218\ub3c4 \uc788\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
     },
     {
      "id": "c",
      "text": "\ud2c0\ub9ac\ub2e4. \uac12\uc774 \ubaa8\ub450 \ub2ec\ub77c\ub3c4 \uc11c\ub85c \ub2e4\ub978 \ub450 \uc30d\uc758 \ud569\uc774 \uac19\uc544\uc9c8 \uc218 \uc788\ub2e4",
      "reveals": "\uc8fc\uc7a5\uc744 '\ud56d\uc0c1'\uc73c\ub85c \uc77d\uace0 \uc608\uac00 \uc788\ub294\uc9c0\ub97c \uc758\uc2ec\ud588\uc5b4\uc694. \uc774\uc81c \uc815\ub9d0 \uadf8\ub7f0 \uc608\uac00 \ub9cc\ub4e4\uc5b4\uc9c0\ub294\uc9c0 \uc2dc\ud5d8\ud574 \ubcfc \ucc28\ub840\uc608\uc694."
     },
     {
      "id": "d",
      "text": "\ud310\ub2e8\ud560 \uc218 \uc5c6\ub2e4. f\uc758 \uc2dd\uc774 \uc8fc\uc5b4\uc9c0\uc9c0 \uc54a\uc558\uae30 \ub54c\ubb38\uc774\ub2e4",
      "reveals": "\ud568\uc218\ub97c \uc2dd\uc73c\ub85c\ub9cc \uc0dd\uac01\ud558\uace0 \uc788\uc5b4\uc694. \uc5ec\uae30\uc11c\ub294 \ub124 \uac12\uc758 \ud45c\ub9cc\uc73c\ub85c\ub3c4 \uc870\uac74\uc744 \uc2dc\ud5d8\ud560 \uc218 \uc788\uc5b4\uc694."
