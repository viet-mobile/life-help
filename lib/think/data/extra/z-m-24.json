  "topic": "\ubc29\uc815\uc2dd\uc758 \uc591\ubcc0\uc744 \uac19\uc740 \uc2dd\uc73c\ub85c \ub098\ub20c \ub54c \uc0ac\ub77c\uc9c0\ub294 \ud574",
