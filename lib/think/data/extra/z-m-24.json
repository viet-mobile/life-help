    "id": "s1",
    "kind": "pickLine",
    "prompt": "\uc9c0\uc544\uc758 \ud480\uc774\uc774\ub2e4. \ud574\ub97c \uc798\ubabb \uad6c\ud558\uac8c \ub9cc\ub4e0 \uc904, \ub610\ub294 \uadf8 \uc798\ubabb\uc774 \uadf8\ub300\ub85c \ub4dc\ub7ec\ub09c \uc904\uc744 \uace0\ub974\uc138\uc694.",
