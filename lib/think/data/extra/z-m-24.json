  "uiLang": "ko",
  "format": "find-error-fix",
  "generative": true,
  "goal": "\ud480\uc774\uc758 \uc5b4\ub290 \uc904\uc5d0\uc11c \ud574\uac00 \uc0ac\ub77c\uc84c\ub294\uc9c0 \ucc3e\uace0, \uadf8\ub7f0 \uc77c\uc774 \uc0dd\uae30\ub294 \ubc29\uc815\uc2dd\uc758 \uc870\uac74\uc744 \uc77c\ubc18\ud654\ud558\uba70, \ud574\ub97c \uc783\ub294 \ubc29\uc815\uc2dd\uc744 \uc2a4\uc2a4\ub85c \ub9cc\ub4e4\uc5b4 \uc774\uc720\ub97c \uc124\uba85\ud55c\ub2e4.",
  "thinking": [
