  "hardCases": [
   "'x = 0 \uc740 \ud574\uac00 \uc544\ub2c8\ub2e4'\ub77c\uace0 \ubbff\ub294 \ud559\uc0dd: 0\uc744 \ub300\uc785\ud558\ub294 \ud655\uc778\uc744 \uc9c1\uc811 \ud558\uac8c \ud55c\ub2e4. \ub300\uc785\ud558\uc9c0 \uc54a\uace0 \ub290\ub08c\uc73c\ub85c \ub9d0\ud558\uba74 \uc774\uc720 \uce78\uc774 \ubd80\uc871\ud558\ub2e4.",
   "\ubc94\uc704\ub97c \ubcf5\uc18c\uc218\uae4c\uc9c0 \ub113\ud788\uba74 x\u00b2 + 3 \uc73c\ub85c \ub098\ub204\ub294 \uc120\ud0dd\uc9c0 c\uc5d0\uc11c\ub3c4 \ud5c8\uadfc \u00b1\u221a3 i \ub97c \uc783\ub294\ub2e4. \uc774 \uacfc\uc81c\ub294 \uc2e4\uc218 \ubc94\uc704\ub85c \ubabb \ubc15\uc558\uc73c\ubbc0\ub85c \uc815\ub2f5\uc740 c\uc774\uc9c0\ub9cc, \ubc94\uc704\ub97c \ubc14\uafb8\uba74 \ub2ec\ub77c\uc9c4\ub2e4\ub294 \ud559\uc0dd\uc758 \uc9c0\uc801\uc740 \ud0c0\ub2f9\ud558\ub2e4."
