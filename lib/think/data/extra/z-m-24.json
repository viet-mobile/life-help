  "cell": "math|H2|equations",
  "topic": "\uc0bc\ucc28\ubc29\uc815\uc2dd x\u00b3 = 1 \uc758 \ud574\uc758 \uac1c\uc218\uc640 \uc218\uc758 \ubc94\uc704",
  "level": 3,
  "levelLabel": "\uace0\ub4f1",
  "title": "\ubc94\uc704\uac00 \uc5c6\ub294 \ubb38\uc81c\uc758 \ud574\ub294 \uba87 \uac1c\uc77c\uae4c",
  "uiLang": "ko",
  "format": "reveal-and-revise",
  "generative": true,
  "goal": "\ud480\uc774\uac00 \uc5b4\ub5a4 \uc218\uc758 \ubc94\uc704\ub97c \uc804\uc81c\ud558\ub294\uc9c0 \ub530\uc9c0\uace0, \uc0c8 \uc815\ubcf4\uac00 \ub4e4\uc5b4\uc62c \ub54c\ub9c8\ub2e4 \ud574\uc758 \uac1c\uc218\uc5d0 \ub300\ud55c \ud310\ub2e8\uc744 \uc720\uc9c0\u00b7\uc218\uc815\ud558\uba70, \ubc94\uc704\uc5d0 \ub530\ub978 \uc870\uac74\ubd80 \ub2f5\uacfc \uc9c1\uc811 \ucc3e\uc740 \ud574\ub85c \ud655\uc778\ud55c\ub2e4.",
  "thinking": [
   "\ub17c\uc99d\uc774 \uc131\ub9bd\ud558\ub294 \ubc94\uc704(\uc870\uac74) \ubc1d\ud788\uae30",
   "\uc0c8 \uc815\ubcf4\ub85c \ud310\ub2e8 \uc218\uc815\u00b7\uc720\uc9c0\ud558\uae30",
   "\ubc94\uc704\uc5d0 \ub530\ub978 \uc870\uac74\ubd80 \ub2f5 \uc4f0\uae30",
   "\uc5ec\ub7ec \ud574\ub97c \uc9c1\uc811 \ucc3e\uc544 \uac80\uc99d\ud558\uae30"
  ],
  "differsFromPlain": "\ub2e8\uc21c \uc5f0\uc2b5\uc740 x\u00b3 = 1 \uc744 \uc778\uc218\ubd84\ud574\ud574 \ud574\ub97c \uad6c\ud558\ub294 \uac83\uc73c\ub85c \ub05d\ub09c\ub2e4. \uc5ec\uae30\uc11c\ub294 '\ud574\ub294 \ud558\ub098'\ub77c\ub294 \ub17c\uc99d\uc774 \uc5b4\ub5a4 \ubc94\uc704\uc5d0\uc11c \uc633\uc740\uc9c0\ubd80\ud130 \ub530\uc9c0\uace0, \uc815\ubcf4\uac00 \ub298 \ub54c\ub9c8\ub2e4 \ud310\ub2e8\uc744 \uace0\uce58\uac70\ub098 \uc9c0\ud0a4\uba70, \ubcf5\uc18c\uc218 \ud574\ub97c \uc9c1\uc811 \ucc3e\uc544 \ud655\uc778\ud55c\ub2e4.",
  "prerequisites": [
   "\uc774 \ubc30\uce58\uc758 H2\ub294 \ub09c\uc774\ub3c4\u00b7\uc9c0\uc6d0 \uc218\uc900 \uad6c\ubd84\uc774\uba70 \ud559\uad50\uc5d0\uc11c \ubc30\uc6b0\ub294 \ud559\ub144\uc744 \ub73b\ud558\uc9c0 \uc54a\ub294\ub2e4. \ud559\uad50 \uc21c\uc11c \uac00\uc815: \uacf5\ud1b5\uc218\ud559\uc5d0\uc11c \ubcf5\uc18c\uc218\uc758 \ub73b(\ud5c8\uc218\ub2e8\uc704 i, i\u00b2 = \u22121)\uacfc \uacf1\uc148, \uc774\ucc28\ubc29\uc815\uc2dd\uc758 \ud310\ubcc4\uc2dd, \uc0bc\ucc28\uc2dd\uc758 \uc778\uc218\ubd84\ud574\ub97c \uc774\ubbf8 \ubc30\uc6e0\ub2e4.",
   "\ub450 \ubcf5\uc18c\uc218\uac00 \uac19\uc744 \uc870\uac74: \uc2e4\uc218 \ubd80\ubd84\ub07c\ub9ac, \ud5c8\uc218 \ubd80\ubd84\ub07c\ub9ac \uac19\ub2e4."
  ],
  "minutes": 16,
  "curriculum": null,
  "material": "\ubc29\uc815\uc2dd x\u00b3 = 1 \uc758 \ud574\ub97c \uad6c\ud558\ub294 \ubb38\uc81c\uac00 \uc788\ub2e4. \ubb38\uc81c\uc5d0\ub294 x\uc758 \ubc94\uc704\uac00 \uc801\ud600 \uc788\uc9c0 \uc54a\ub2e4. \ubbfc\uc218\ub294 \ud06c\uae30\ub97c \ube44\uad50\ud558\ub294 \ud480\uc774\ub97c \uc37c\uace0, \ud480\uc774\ub97c \ubcf8 \uc11c\uc724\uc774\ub294 '\ubc94\uc704\ubd80\ud130 \uc815\ud574\uc57c \ud558\uc9c0 \uc54a\uc744\uae4c?'\ub77c\uace0 \ubb3c\uc5c8\ub2e4. \uc790\ub8cc\uac00 \ud558\ub098\uc529 \uacf5\uac1c\ub418\ub2c8, \uadf8\ub54c\ub9c8\ub2e4 \uc790\uc2e0\uc758 \ud310\ub2e8\uc744 \uc815\ud574 \ubcf4\uc790. (x\u00b3 \uc740 '\uc5d1\uc2a4 \uc138\uc81c\uacf1'\uc73c\ub85c \uc77d\ub294\ub2e4.)",
  "steps": [
   {
    "id": "s1",
    "kind": "reveal",
    "prompt": "\uc790\ub8cc\uac00 \ud558\ub098\uc529 \uacf5\uac1c\ub3fc\uc694. \uadf8\ub54c\ub9c8\ub2e4 \ud310\ub2e8\uc744 \uace0\ub974\uace0, \uc0c8 \uc815\ubcf4\uac00 \ud310\ub2e8\uc744 \ubc14\uafb8\ub294\uc9c0 \uc720\uc9c0\ud558\ub294\uc9c0 \uc0b4\ud3b4\ubcf4\uc138\uc694.",
    "stages": [
     {
      "info": "\ubc29\uc815\uc2dd x\u00b3 = 1 \uc744 \ud478\ub294 \ubb38\uc81c\uc774\ub2e4. \ubb38\uc81c\uc5d0\ub294 x\uc758 \ubc94\uc704\uac00 \uc801\ud600 \uc788\uc9c0 \uc54a\ub2e4. \ubbfc\uc218\uc758 \ud480\uc774: 'x = 1 \uc740 \ud574\uc774\ub2e4. x > 1 \uc774\uba74 x\u00b3 > 1 \uc774\uace0 x < 1 \uc774\uba74 x\u00b3 < 1 \uc774\ubbc0\ub85c, \ud574\ub294 x = 1 \ud558\ub098\ubfd0\uc774\ub2e4.' ('>'\ub294 '\ubcf4\ub2e4 \ud06c\ub2e4', '<'\ub294 '\ubcf4\ub2e4 \uc791\ub2e4'\ub85c \uc77d\ub294\ub2e4.)",
      "ask": "\ubbfc\uc218\uc758 \ud480\uc774\ub97c \uc5b4\ub5bb\uac8c \ud310\ub2e8\ud558\uaca0\uc2b5\ub2c8\uae4c?",
      "options": [
       {
        "id": "a",
        "text": "\uc218\ub294 \ubaa8\ub450 \ud06c\uae30\ub97c \ube44\uad50\ud560 \uc218 \uc788\uc73c\ub2c8 \ubbfc\uc218\uc758 \ud480\uc774\ub294 \uc633\uace0, \ud574\ub294 1 \ud558\ub098\ubfd0\uc774\ub2e4",
        "reveals": "\ubaa8\ub4e0 \uc218\uac00 \ud06c\uace0 \uc791\uc74c\uc73c\ub85c \uc904 \uc138\uc6cc\uc9c0\ub294\uc9c0\ub294 \ub530\uc838 \ubcf4\uc9c0 \uc54a\uc558\uc5b4\uc694. \uc5b4\ub5a4 \uc218\uc5d0\uc11c \ud06c\uae30 \ube44\uad50\uac00 \uac00\ub2a5\ud55c\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
       },
       {
        "id": "b",
        "text": "x\uac00 \uc2e4\uc218\uc77c \ub54c\ub294 \ud480\uc774\uac00 \uc633\ub2e4. \ub2e4\ub9cc \ubc94\uc704\uac00 \uc5c6\uc73c\ub2c8 \ub354 \ud655\uc778\uc774 \ud544\uc694\ud558\ub2e4",
        "reveals": "\ud480\uc774\uac00 \uc5b4\ub5a4 \uc218\ub97c \uc804\uc81c\ud558\ub294\uc9c0 \uc77d\uace0, \ubc94\uc704\uac00 \ube60\uc9c4 \uc810\uae4c\uc9c0 \ud310\ub2e8\uc5d0 \ub123\uc5c8\uc5b4\uc694."
       },
       {
        "id": "c",
        "text": "\uc0bc\ucc28\ubc29\uc815\uc2dd\uc740 \ud574\uac00 \ubc18\ub4dc\uc2dc \uc138 \uac1c\uc774\ubbc0\ub85c \ud574\uac00 \ud558\ub098\ub77c\ub294 \ud480\uc774\ub294 \ud2c0\ub838\ub2e4",
        "reveals": "\ucc28\uc218\ub9cc \ubcf4\uace0 \ud574\uc758 \uac1c\uc218\ub97c \ub2e8\uc815\ud588\uc5b4\uc694. \uc11c\ub85c \ub2e4\ub978 \ud574\uac00 \uba87 \uac1c\uc778\uc9c0\ub294 \uc2dd\uacfc \ubc94\uc704\ub97c \ubcf4\uace0 \ud655\uc778\ud574\uc57c \ud574\uc694."
       },
       {
        "id": "d",
        "text": "x = 1 \ud558\ub098\ub9cc \ub123\uc5b4 \ubcf8 \uac83\uc774\ub77c\uc11c \uc774 \ud480\uc774\ub85c\ub294 \uc544\ubb34\uac83\ub3c4 \uc54c \uc218 \uc5c6\ub2e4",
        "reveals": "\ud480\uc774\uc5d0\ub294 1\ubcf4\ub2e4 \ud070 \uacbd\uc6b0\uc640 \uc791\uc740 \uacbd\uc6b0\ub97c \ub530\uc9c4 \ubd80\ubd84\ub3c4 \uc788\uc5b4\uc694. \uadf8 \ubd80\ubd84\uc774 \ubb34\uc5c7\uc744 \ubcf4\uc7a5\ud558\ub294\uc9c0 \uc77d\uc5b4 \ubcf4\uc138\uc694."
       }
      ],
      "reasonable": [
       "b"
      ],
      "after": "x\uac00 \uc2e4\uc218\ub77c\uba74 \ubbfc\uc218\uc758 \ub17c\uc99d\uc740 \uc633\uc544\uc694(1\ubcf4\ub2e4 \ud06c\uba74 x\u00b3 > 1, \uc791\uc73c\uba74 x\u00b3 < 1). \ud558\uc9c0\ub9cc \ubc94\uc704\uac00 \uc801\ud600 \uc788\uc9c0 \uc54a\uc544\uc11c, \uc2e4\uc218\ub9cc \uc0dd\uac01\ud574\ub3c4 \ucda9\ubd84\ud55c\uc9c0\ub294 \uc544\uc9c1 \uc54c \uc218 \uc5c6\uc5b4\uc694."
     },
     {
      "info": "\uc0c8\ub85c\uc6b4 \uc815\ubcf4 \ub450 \uac00\uc9c0\uac00 \ub098\uc654\ub2e4. (1) x\u00b3 \u2212 1 = (x \u2212 1)(x\u00b2 + x + 1) \uc774\uace0, \uc774\ucc28\ubc29\uc815\uc2dd x\u00b2 + x + 1 = 0 \uc758 \ud310\ubcc4\uc2dd\uc740 1 \u2212 4 = \u22123 \uc774\ub2e4. (2) \uc774 \ubb38\uc81c\uc9d1\uc758 \uc55e\ubd80\ubd84 \uc124\uba85\uc5d0\ub294 '\uc774 \ub2e8\uc6d0\uc5d0\uc11c\ub294 \ubcf5\uc18c\uc218 \ubc94\uc704\uc5d0\uc11c \ubc29\uc815\uc2dd\uc744 \ud47c\ub2e4'\uace0 \uc801\ud600 \uc788\uc9c0\ub9cc, \uc774 \ubb38\uc81c \uc790\uccb4\uc5d0\ub294 \uc5ec\uc804\ud788 \ubc94\uc704\uac00 \uc5c6\ub2e4.",
      "ask": "\uc774\uc81c '\uc11c\ub85c \ub2e4\ub978 \ud574\uac00 \uba87 \uac1c\uc778\uac00'\uc5d0 \uc5b4\ub5bb\uac8c \ub2f5\ud558\uaca0\uc2b5\ub2c8\uae4c?",
      "options": [
       {
        "id": "a",
        "text": "\ubc94\uc704\uac00 \ubb38\uc81c\uc5d0 \uc5c6\uc73c\ub2c8 \uc2e4\uc218\ub9cc \uc0dd\uac01\ud558\uace0, \ud574\ub294 1 \ud558\ub098\ub77c\uace0\ub9cc \ub2f5\ud55c\ub2e4",
        "reveals": "\uc2e4\uc218 \ubc94\uc704\uc758 \ub2f5\uc73c\ub85c\ub294 \ub9de\uc9c0\ub9cc, \ud310\ubcc4\uc2dd \uacc4\uc0b0\uacfc \ub2e8\uc6d0 \uc124\uba85\uc774\ub77c\ub294 \uc0c8 \uc815\ubcf4\ub97c \ud310\ub2e8\uc5d0 \uc4f0\uc9c0 \uc54a\uc558\uc5b4\uc694."
       },
