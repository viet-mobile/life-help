     "\uadf8\ub7ec\ubbc0\ub85c x\uc640 y\uac00 \ubaa8\ub450 \uc0ac\ub77c\uc838 x = 0, y = 0\uc774 \ud574\uc774\ub2e4.",
     "\ub530\ub77c\uc11c \uc774 \uc5f0\ub9bd\ubc29\uc815\uc2dd\uc758 \ud574\ub294 (0, 0) \ud55c \uc30d\uc774\ub2e4."
