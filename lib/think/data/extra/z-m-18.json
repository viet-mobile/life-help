  "cautions": {
   "language": "'\ud574'\uac00 '\ud480\uc774'\uac00 \uc544\ub2c8\ub77c '\uc2dd\uc744 \ub9cc\uc871\ud558\ub294 (x, y) \uc30d'\uc774\ub77c\ub294 \ub73b\uc784\uc744 material\uc5d0\uc11c \ubc1d\ud614\ub2e4. '\ubb34\uc218\ud788'\ub294 '\uc140 \uc218 \uc5c6\uc774 \ub9ce\uc774'\ub85c \ud480\uc5b4 \uc4f8 \uc218 \uc788\ub2e4.",
   "culture": "\ud2b9\uc815 \ubb38\ud654\uc5d0 \uae30\ub300\uc9c0 \uc54a\ub294 \uc21c\uc218 \uc218\uc2dd \uc0c1\ud669\uc774\ub2e4. \uc774\ub984 '\uc18c\uc601'\uc740 \uc784\uc758\uc758 \uc774\ub984\uc774\uba70 \uc131\ubcc4 \uc5ed\ud560\uacfc \uad00\uacc4\uc5c6\ub2e4.",
