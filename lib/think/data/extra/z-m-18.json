     "\ud574\uac00 \uc5c6\uc5c8\ub358 \uc9dd, \ud574\uac00 \ubb34\uc218\ud788 \ub9ce\uc558\ub358 \uc9dd, \ud574\uac00 \ud55c \uc30d\uc774\uc5c8\ub358 \uc9dd\uc744 \ub098\ub204\uc5b4 \uac01\uac01 \uc5b4\ub5a4 \uc810\uc774 \ub2ec\ub790\ub294\uc9c0 \uc801\uc5b4 \ubcf4\uc138\uc694."
    ]
