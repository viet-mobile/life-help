  "topic": "\uc5f0\ub9bd\uc77c\ucc28\ubc29\uc815\uc2dd\uc758 \ud574\uac00 \uc5c6\uac70\ub098 \ubb34\uc218\ud788 \ub9ce\uc740 \uacbd\uc6b0",
  "level": 2,
  "levelLabel": "\uc911\ub4f1",
  "title": "\uc2dd\uc774 \ub450 \uac1c\uba74 \ud574\ub294 \ud56d\uc0c1 \ud55c \uc30d\uc77c\uae4c?",
  "uiLang": "ko",
  "format": "build-many-verify",
  "generative": true,
  "goal": "\ubbf8\uc9c0\uc218\uac00 2\uac1c\uc778 \uc77c\ucc28\ubc29\uc815\uc2dd \ub450 \uac1c\ub97c \ubb36\uc5c8\uc744 \ub54c \ud574\uac00 \ud55c \uc30d, \uc5c6\uc74c, \ubb34\uc218\ud788 \ub9ce\uc74c\uc758 \uc138 \uac00\uc9c0\ub85c \ub098\ub268\uc744 \ud480\uc774 \uc810\uac80\u00b7\uc815\ubcf4 \ud310\ub2e8\u00b7\uc9c1\uc811 \ub9cc\ub4e0 \uc608\ub85c \ud655\uc778\ud558\uace0, \uc5b4\ub5a4 \uc870\uac74\uc5d0\uc11c \uc5b4\ub290 \uacbd\uc6b0\uac00 \ub418\ub294\uc9c0 \uc124\uba85\ud55c\ub2e4.",
  "thinking": [
   "\ud480\uc774\uc5d0\uc11c \uacb0\ub860\uc774 \uadfc\uac70 \uc5c6\uc774 \ub098\uc628 \uc904 \ucc3e\uc544 \uace0\uce58\uae30",
   "\ud574\uc758 \uac1c\uc218\ub97c \uc815\ud558\ub824\uba74 \uc5b4\ub5a4 \uc815\ubcf4\uac00 \ub354 \ud544\uc694\ud55c\uc9c0 \ud310\ub2e8\ud558\uae30",
   "\uc870\uac74\uc744 \ub9cc\uc871\ud558\ub294 \uc2dd\uc744 \uc5ec\ub7ec \uac1c \uc9c1\uc811 \ub9cc\ub4e4\uc5b4 \ud655\uc778\ud558\uae30",
   "'\ud56d\uc0c1'\uc774\ub77c\ub294 \uc8fc\uc7a5\uc758 \uc131\ub9bd \uc870\uac74 \uc815\ub9ac\ud558\uae30"
  ],
  "differsFromPlain": "\ub2e8\uc21c \uc5f0\uc2b5\uc740 \uacc4\uc218\uac00 \ub9de\ub294 \uc5f0\ub9bd\ubc29\uc815\uc2dd\uc744 \uc8fc\uace0 \ud574 (x, y)\ub97c \uad6c\ud558\uac8c \ud55c\ub2e4. \uc5ec\uae30\uc11c\ub294 \uc2dd \ub450 \uac1c\uac00 \uc788\uc73c\uba74 \ud574\uac00 \ubc18\ub4dc\uc2dc \ud55c \uc30d\uc774\ub77c\ub294 \ubbff\uc74c\uc744 \uc2dc\ud5d8\ud558\uace0, \ud480\ub2e4\uac00 \ubaa8\uc21c\uc774 \ub098\uc654\uc744 \ub54c \uacb0\ub860\uc744 \uc5b4\ub5bb\uac8c \uc77d\uc5b4\uc57c \ud558\ub294\uc9c0 \uc810\uac80\ud558\uba70, \ud574\uac00 \uc5c6\ub294 \uc2dd\uc744 \ud559\uc0dd\uc774 \uc9c1\uc811 \uc124\uacc4\ud55c\ub2e4.",
  "prerequisites": [
   "\ubbf8\uc9c0\uc218\uac00 2\uac1c\uc778 \uc77c\ucc28\ubc29\uc815\uc2dd\uc758 \ud574\uac00 (x, y) \uc30d\uc784\uc744 \uc544\ub294 \uac83",
   "\uc5f0\ub9bd\ubc29\uc815\uc2dd\uc758 \ud574\uc758 \ub73b(\ub450 \uc2dd\uc744 \ub3d9\uc2dc\uc5d0 \ub9cc\uc871\ud558\ub294 \uc30d)",
   "\uc77c\ucc28\ubc29\uc815\uc2dd ax+by=c\ub97c \uc88c\ud45c\ud3c9\uba74\uc758 \uc9c1\uc120\uc73c\ub85c \ubcf4\ub294 \uacbd\ud5d8(\uc9112 \uc218\uc900, \ud574\uc758 \uac1c\uc218\uc640\uc758 \uad00\uacc4\ub294 \ubab0\ub77c\ub3c4 \ub428)"
  ],
  "minutes": 15,
  "curriculum": null,
  "material": "\uc18c\uc601\uc774\uac00 \ub9d0\ud588\uc5b4\uc694. \"\ubbf8\uc9c0\uc218\uac00 x, y \ub450 \uac1c\uc778 \uc77c\ucc28\ubc29\uc815\uc2dd\uc774 \ub450 \uac1c \uc788\uc73c\uba74, \ub450 \uc2dd\uc744 \ub3d9\uc2dc\uc5d0 \ub9cc\uc871\ud558\ub294 (x, y)\ub294 \uc5b8\uc81c\ub098 \ub531 \ud55c \uc30d\uc774\uc57c.\" \uc5ec\uae30\uc11c x, y\ub294 \uc5b4\ub5a4 \uc218\uc5ec\ub3c4 \ub418\uace0, \uc2dd\uc740 \ubaa8\ub450 \uacc4\uc218\uac00 \uc815\uc218\uc778 \uc77c\ucc28\ubc29\uc815\uc2dd\uc774\uc5d0\uc694. \uc18c\uc601\uc774\ub294 \uc544\ub798 \uc5f0\ub9bd\ubc29\uc815\uc2dd\uc73c\ub85c \uc790\uae30 \uc0dd\uac01\uc744 \ud655\uc778\ud574 \ubcf4\ub824 \ud574\uc694. \uc77d\ub294 \ubc95: '\uc5d1\uc2a4 \ub354\ud558\uae30 \uc774\uc640\uc774\ub294 \uc721', '\uc774\uc5d1\uc2a4 \ub354\ud558\uae30 \uc0ac\uc640\uc774\ub294 \uc2ed'.\n  \u3260 x + 2y = 6\n  \u3261 2x + 4y = 10",
  "steps": [
   {
    "id": "s1",
    "kind": "pickLine",
    "prompt": "\uc18c\uc601\uc774\uac00 \u3260, \u3261\uc744 \ud480\uc5b4 \uc4f4 \uc544\ub798 \ud480\uc774\uc5d0\uc11c, \uacb0\ub860\uc744 \uc774\ub04c\uc5b4 \ub0b4\ub294 \ub370 \uadfc\uac70\uac00 \ubd80\uc871\ud55c \uc904\uc744 \ud558\ub098 \uace0\ub974\uc138\uc694. \ucc98\uc74c \uc0dd\uac01(\uc18c\uc601\uc758 \ub9d0)\uc740 \uc77c\ub2e8 \uc811\uc5b4 \ub450\uace0 \uc904\ub9c8\ub2e4 \uc2dd\uc774 \uc2e4\uc81c\ub85c \uc131\ub9bd\ud558\ub294\uc9c0 \ub530\uc838 \ubcf4\uc138\uc694.",
    "lines": [
     "\u3260 x + 2y = 6\uc758 \uc591\ubcc0\uc5d0 2\ub97c \uacf1\ud558\uba74 2x + 4y = 12\uc774\ub2e4.",
