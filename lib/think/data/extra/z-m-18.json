    "selfAssess": [
     "\ud574\uac00 \uc5c6\ub294 \uacbd\uc6b0\uc640 \ubb34\uc218\ud788 \ub9ce\uc740 \uacbd\uc6b0\uac00 \uac01\uac01 \uc2dd\uc758 \uc5b4\ub5a4 \ubaa8\uc591\uc5d0\uc11c \uc0dd\uae30\ub294\uc9c0 \uad6c\ubd84\ud574\uc11c \uc37c\ub098\uc694?",
     "\ud55c \uc30d\ub9cc \ub098\uc624\ub294 \uacbd\uc6b0\uac00 \uc5b8\uc81c\uc778\uc9c0\ub3c4 \uc37c\ub098\uc694?",
     "\ub0b4\uac00 s3\uc5d0\uc11c \ub9cc\ub4e0 \uc2dd\uc774\ub098 \u3260, \u3261 \uac19\uc740 \uc22b\uc790 \uc608\ub97c \uadfc\uac70\ub85c \ub4e4\uc5c8\ub098\uc694?"
    ],
    "modelAnswers": [
     {
      "text": "\uc18c\uc601\uc774 \ub9d0\uc740 \ud56d\uc0c1 \ub9de\uc9c0\ub294 \uc54a\uc544. \ub450 \uc2dd\uc5d0\uc11c x, y\uc758 \uacc4\uc218\uc758 \ube44\uac00 \ub2e4\ub974\uba74 \ud574\uac00 \ud55c \uc30d\uc774\uc57c. \uacc4\uc218\uc758 \ube44\ub294 \uac19\uc740\ub370 \uc624\ub978\ucabd \uc0c1\uc218\uc758 \ube44\uac00 \ub2e4\ub974\uba74 \ud574\uac00 \uc5c6\uc5b4. \uc0c1\uc218\uc758 \ube44\uae4c\uc9c0 \uac19\uc73c\uba74 \uac19\uc740 \uc2dd\uc774\ub77c\uc11c \ud574\uac00 \ubb34\uc218\ud788 \ub9ce\uc544. \uc608\ub97c \ub4e4\uc5b4 x+2y=6\uacfc 2x+4y=10\uc740 \ud574\uac00 \uc5c6\uc5b4."
     },
     {
      "text": "\ub450 \uc9c1\uc120\uc73c\ub85c \uc0dd\uac01\ud558\uba74 \ub3fc. \uae30\uc6b8\uae30\uac00 \ub2e4\ub974\uba74 \ud55c \uc810\uc5d0\uc11c \ub9cc\ub098\uc11c \ud574\uac00 \ud55c \uc30d\uc774\uc57c. \uae30\uc6b8\uae30\uac00 \uac19\uace0 \uc9c0\ub098\ub294 \uacf3\uc774 \ub2e4\ub974\uba74 \ud3c9\ud589\ud574\uc11c \ub9cc\ub098\uc9c0 \uc54a\uc73c\ub2c8 \ud574\uac00 \uc5c6\uc5b4. \uc644\uc804\ud788 \uacb9\uce58\uba74 \ud574\uac00 \ubb34\uc218\ud788 \ub9ce\uc544. \uadf8\ub7ec\ub2c8\uae4c \uc2dd\uc774 \ub450 \uac1c\ub77c\uace0 \ud574\uc11c \uc5b8\uc81c\ub098 \ud55c \uc30d\uc740 \uc544\ub2c8\uc57c.",
      "note": "\uadf8\ub798\ud504 \uad00\uc810\uc758 \ub2f5. \uacc4\uc218\u00b7\uc0c1\uc218 \ud45c\ud604 \ub300\uc2e0 \uae30\uc6b8\uae30\u00b7'\uc9c0\ub098\ub294 \uacf3'\uc73c\ub85c \uac19\uc740 \ub0b4\uc6a9\uc744 \ub9d0\ud588\ub2e4."
     }
    ],
    "badAnswers": [
     {
      "text": "\uc18c\uc601\uc774 \ub9d0\uc774 \ub9de\uc544. \uc2dd\uc774 \ub450 \uac1c\ub2c8\uae4c \uc5b8\uc81c\ub098 \ud574\uac00 \ub531 \ud55c \uc30d\uc774\uc57c.",
      "why": "\ucc98\uc74c \ubbff\uc74c\uc744 \uadf8\ub300\ub85c \ubc1b\uc544\ub4e4\uc600\uace0 \ubc18\ub840(\ud574\uac00 \uc5c6\uac70\ub098 \ubb34\uc218\ud788 \ub9ce\uc740 \uacbd\uc6b0)\uac00 \uc5c6\ub2e4."
     },
     {
      "text": "\uacbd\uc6b0\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc694. \uc22b\uc790\uc5d0 \ub530\ub77c \ud574\uac00 \uc5ec\ub7ec \uac00\uc9c0\ub85c \ub098\uc62c \uc218 \uc788\uc5b4\uc694.",
      "why": "\uc5b4\ub5a4 \uacbd\uc6b0\uc5d0 \uc5b4\ub5bb\uac8c \ub2ec\ub77c\uc9c0\ub294\uc9c0(\ud574\uac00 \uc5c6\uc74c\u00b7\ubb34\uc218\ud788 \ub9ce\uc74c, \uc2dd\uc758 \ubaa8\uc591)\uac00 \uc5c6\ub2e4."
     },
     {
      "text": "\ud574\uac00 \uc5c6\uc744 \uc218\ub3c4 \uc788\uc5b4\uc694. \uadf8\ub798\uc11c \uc18c\uc601\uc774 \ub9d0\uc740 \ud2c0\ub838\uc5b4\uc694. \uc798 \ubaa8\ub974\uaca0\uc9c0\ub9cc \uc22b\uc790\uac00 \ub2e4\ub974\ub2c8\uae4c\uc694.",
      "why": "\ud574\uac00 \uc5c6\ub294 \uacbd\uc6b0\ub9cc \ub9d0\ud588\uace0 \ubb34\uc218\ud788 \ub9ce\uc740 \uacbd\uc6b0\uc640 \uc2dd\uc758 \ubaa8\uc591\uacfc\uc758 \uc5f0\uacb0\uc774 \uc5c6\ub2e4."
     }
