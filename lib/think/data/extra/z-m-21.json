  "subject": "math",
  "grade": "H2",
  "cell": "math|H2|polynomial",
  "topic": "\uc0ac\ucc28\uc2dd\uc744 \uc774\ucc28\uc2dd \ub458\uc758 \uacf1\uc73c\ub85c \ub098\ud0c0\ub0b4\uae30: \uac00\ub2a5\ud55c \uacbd\uc6b0\ub97c \ube60\uc9d0\uc5c6\uc774 \uc0b4\ud53c\uae30",
  "level": 3,
  "levelLabel": "\uace0\ub4f1",
  "title": "\u2018\ud558\ub098\ubfd0\u2019\uc774\ub77c\ub294 \uacb0\ub860, \uc815\ub9d0 \ud558\ub098\ubfd0\uc77c\uae4c?",
  "uiLang": "ko",
  "format": "build-many-verify",
  "generative": true,
  "goal": "\uac00\ub2a5\ud55c \uacbd\uc6b0\ub97c \uc77c\ubd80\ub9cc \uc0b4\ud53c\uace0 \ub0b4\ub9b0 \u2018\ud558\ub098\ubfd0\u2019\uc774\ub77c\ub294 \uacb0\ub860\uc744 \uc810\uac80\ud558\uace0, \uac19\uc740 \uc0ac\ucc28\uc2dd\uc758 \uc11c\ub85c \ub2e4\ub978 \uc774\ucc28\uc2dd \uacf1 \ud45c\ud604\uc744 \uc9c1\uc811 \ub9cc\ub4e4\uc5b4 \ud655\uc778\ud558\uba70, \uc870\uac74\uc744 \ub113\ud600\ub3c4 \uac00\uc9d3\uc218\uac00 \uc815\ud574\uc9c0\ub294 \uc774\uc720\ub97c \uc124\uba85\ud55c\ub2e4.",
  "thinking": [
   "\ud480\uc774\uc5d0\uc11c \uacbd\uc6b0\ub97c \ube60\ub728\ub9b0 \uc904 \ucc3e\uae30",
   "\uacb0\ub860\uc744 \uae68\ub294 \uc11c\ub85c \ub2e4\ub978 \uc608\ub97c \uc9c1\uc811 \ub9cc\ub4e4\uae30",
   "\uc870\uac74(\uc815\uc218\u2192\uc2e4\uc218)\uc744 \ubc14\uafc0 \ub54c \uacb0\ub860\uc774 \uc5b4\ub5bb\uac8c \ub2ec\ub77c\uc9c0\ub294\uc9c0 \ud310\ub2e8\ud558\uae30"
  ],
  "differsFromPlain": "\ub2e8\uc21c \uc5f0\uc2b5\uc740 \uc8fc\uc5b4\uc9c4 \uc0ac\ucc28\uc2dd\uc744 \ud55c \uac00\uc9c0 \ubc29\ubc95\uc73c\ub85c \uc778\uc218\ubd84\ud574\ud574 \ub2f5 \ud558\ub098\ub97c \uc4f4\ub2e4. \uc5ec\uae30\uc11c\ub294 \u2018\ud558\ub098\ubfd0\u2019\uc774\ub77c\ub294 \uacb0\ub860\uc758 \uadfc\uac70\uac00 \ucda9\ubd84\ud55c\uc9c0 \ub530\uc9c0\uace0, \uc11c\ub85c \ub2e4\ub978 \ubd84\ud574\ub97c \ud559\uc0dd\uc774 \uc9c1\uc811 \ub9cc\ub4e4\uc5b4 \uc804\uac1c\ub85c \ud655\uc778\ud558\uba70, \uc815\uc218 \uc870\uac74\uc744 \uc2e4\uc218\ub85c \ub113\ud788\uba74 \ub2ec\ub77c\uc9c0\ub294\uc9c0 \ud310\ub2e8\ud55c\ub2e4.",
  "prerequisites": [
   "\ub450 \uc774\ucc28\uc2dd\uc758 \uacf1\uc744 \uc804\uac1c\ud558\uace0 \uac19\uc740 \ucc28\uc218\uc758 \ud56d\ub07c\ub9ac \uc815\ub9ac\ud558\uae30(\uc9113~\uace01 \uacf5\ud1b5\uc218\ud559 \ub2e4\ud56d\uc2dd \uc218\uc900)",
   "\ub450 \ub2e4\ud56d\uc2dd\uc774 x\uc5d0 \ub300\ud55c \uac19\uc740 \uc2dd\uc774\ub77c\ub294 \ub73b(\ud56d\ub4f1\uc2dd) \u2014 \uc774 \ud65c\ub3d9\uc758 \ud559\ub144 \ubc30\uc815\uc740 \uc81c\uc791 \ubc30\uce58 \uc548\uc758 \ub09c\uc774\ub3c4 \uad6c\ubd84\uc77c \ubfd0 \uad50\uc721\uacfc\uc815\uc0c1 \ud559\ub144 \uc9c0\uc815\uc774 \uc544\ub2c8\ub2e4",
   "(x\u22121), (x+1)\ucc98\ub7fc \uc77c\ucc28\uc2dd\ub07c\ub9ac\uc758 \uacf1\uc744 \uc804\uac1c\ud558\ub294 \uacbd\ud5d8"
  ],
  "minutes": 16,
  "curriculum": null,
  "material": "\uc9c0\ud638\ub294 x\u2074\u22125x\u00b2+4\ub97c (x\u00b2+ax+b)(x\u00b2+cx+d)\uc758 \uaf34\ub85c \uc4f0\ub294 \ubc29\ubc95\uc744 \ucc3e\uc558\ub2e4. \uc5ec\uae30\uc11c x\u00b2\uc758 \uacc4\uc218\ub294 \ub450 \uc774\ucc28\uc2dd \ubaa8\ub450 1\uc774\uace0, a, b, c, d\ub294 \uc815\uc218\uc774\uba70, \ub450 \uc774\ucc28\uc2dd\uc758 \uc21c\uc11c\ub97c \ubc14\uafbc \uac83(\uc608: a,b\uc640 c,d\ub97c \uc11c\ub85c \ubc14\uafbc \uac83)\uc740 \uac19\uc740 \ubd84\ud574\ub85c \uc13c\ub2e4. \uc9c0\ud638\ub294 \ud480\uc774\ub97c \ub9c8\uce58\uace0 \"\uc774\ub7f0 \ubd84\ud574\ub294 \ud558\ub098\ubfd0\uc774\uc57c\"\ub77c\uace0 \ub9d0\ud588\ub2e4. \uc544\ub798\ub294 \uc9c0\ud638\uc758 \ud480\uc774\ub2e4. (\uc77d\ub294 \ubc95: x\u2074\uc740 \u2018\uc5d1\uc2a4\uc758 \ub124\uc81c\uacf1\u2019, x\u00b2\uc740 \u2018\uc5d1\uc2a4 \uc81c\uacf1\u2019, ac\ub294 \u2018a \uacf1\ud558\uae30 c\u2019\uc774\ub2e4.)",
  "steps": [
   {
    "id": "s1",
    "kind": "pickLine",
    "prompt": "\uc9c0\ud638\uc758 \u2018\ud558\ub098\ubfd0\u2019\uc774\ub77c\ub294 \uacb0\ub860\uc744 \uadf8\ub300\ub85c \ubbff\uae30 \uc5b4\ub835\uac8c \ub9cc\ub4dc\ub294 \uc904\uc740 \uc5b4\ub290 \uc904\uc77c\uae4c\uc694? \ud55c \uc904\uc744 \uace8\ub77c \ubcf4\uc138\uc694.",
    "lines": [
     "(x\u00b2+ax+b)(x\u00b2+cx+d)\ub97c \uc804\uac1c\ud574\uc11c x\u2074\u22125x\u00b2+4\uc640 \uac19\uc740 \uc2dd\uc774 \ub418\ub3c4\ub85d \uac01 \ucc28\uc218\uc758 \uacc4\uc218\ub97c \ub9de\ucd98\ub2e4.",
     "x\u00b3\uc758 \uacc4\uc218\uc5d0\uc11c a+c=0\uc774\ubbc0\ub85c c=\u2212a\uc774\uace0, x\uc758 \uacc4\uc218\uc5d0\uc11c ad+bc=a(d\u2212b)=0\uc774\ubbc0\ub85c a=0 \ub610\ub294 b=d\uc774\ub2e4.",
     "\uc0c1\uc218\ud56d\uc5d0\uc11c bd=4\uc774\ub2e4.",
     "b, d\ub294 \uc815\uc218\uc774\uace0 \uacf1\uc774 4\uc774\ubbc0\ub85c (b, d)\ub294 (1, 4), (4, 1), (2, 2) \uc911 \ud558\ub098\uc774\ub2e4.",
     "\uc774 \uc911 x\u00b2\uc758 \uacc4\uc218 b+d\u2212a\u00b2=\u22125\ub97c \ub9cc\uc871\ud558\ub294 \uac83\uc740 b=d=2, a=3(\ub610\ub294 a=\u22123)\ubfd0\uc774\ub2e4.",
     "\uadf8\ub7ec\ubbc0\ub85c \uc774\ub7f0 \ubd84\ud574\ub294 (x\u00b2+3x+2)(x\u00b2\u22123x+2) \ud558\ub098\ubfd0\uc774\ub2e4."
    ],
    "wrong": [
     3,
