    ]
   },
   {
    "id": "s3",
    "kind": "choose",
    "prompt": "\uc774\ubc88\uc5d0\ub294 \uc0ac\ud0d5 6\uac1c\uac00 \ubaa8\ub450 \uc11c\ub85c \ub2e4\ub978 \ub9db\uc774\uace0, \ud55c \uc0ac\ub78c\uc774 \ud558\ub098\ub3c4 \ubabb \ubc1b\uc544\ub3c4 \ub41c\ub2e4\uace0 \ud574 \ubd10\uc694. \uac19\uc740 \uc885\ub958\uc758 \uc0ac\ud0d5\uc744 \ube48\uc190 \ud5c8\uc6a9\uc73c\ub85c \ub098\ub20c \ub54c(28\uac00\uc9c0)\uc640 \ube44\uad50\ud558\uba74 \ubc29\ubc95\uc758 \uc218\ub294 \uc5b4\ub5bb\uac8c \ub420\uae4c\uc694?",
    "options": [
     {
      "id": "a",
      "text": "\uc904\uc5b4\ub4e0\ub2e4. \uad6c\ubcc4\ud574\uc57c \ud558\ub2c8 \uc870\uac74\uc774 \ub354 \uae4c\ub2e4\ub86d\uae30 \ub54c\ubb38\uc774\ub2e4",
      "reveals": "\uad6c\ubcc4\ud55c\ub2e4\uace0 \ud574\uc11c \uac00\ub2a5\ud55c \ubd84\ubc30\uac00 \uc5c6\uc5b4\uc9c0\uc9c0\ub294 \uc54a\uc544\uc694. \uac19\uc740 \uac1c\uc218 \ubd84\ubc30\uac00 \uba87 \uac00\uc9c0\ub85c \uac08\ub77c\uc9c0\ub294\uc9c0 \uc0b4\ud3b4\ubcf4\uc138\uc694."
     },
     {
      "id": "b",
      "text": "28\uac00\uc9c0\ub85c \uac19\ub2e4. \uc0ac\ud0d5\uc758 \uac1c\uc218\uc640 \uc0ac\ub78c \uc218\uac00 \uadf8\ub300\ub85c\uc774\uae30 \ub54c\ubb38\uc774\ub2e4",
      "reveals": "\uac1c\uc218\uc640 \uc0ac\ub78c \uc218\uac00 \uac19\uc544\ub3c4, \uac19\uc740 (4,1,1) \ubd84\ubc30\uc5d0\uc11c \ub204\uac00 \uc5b4\ub5a4 \uc0ac\ud0d5\uc744 \ubc1b\ub294\uc9c0\uac00 \ub2ec\ub77c\uc9c0\uba74 \ub2e4\ub978 \ubc29\ubc95\uc774\uc5d0\uc694."
     },
     {
      "id": "c",
      "text": "\ub298\uc5b4\ub09c\ub2e4. \ud55c \ubd84\ubc30\uac00 \uc5ec\ub7ec \ubc29\ubc95\uc73c\ub85c \uac08\ub77c\uc9c0\uae30 \ub54c\ubb38\uc774\ub2e4",
      "reveals": "\uad6c\ubcc4\uc774 \uc0dd\uae30\uba74 \ud55c \ubd84\ubc30\uac00 \uc5ec\ub7ec \ubc29\ubc95\uc73c\ub85c \ucabc\uac1c\uc9c4\ub2e4\ub294 \uc810\uc744 \uc9da\uc5c8\uc5b4\uc694."
     },
     {
      "id": "d",
      "text": "\uc5b4\ub5bb\uac8c \ub418\ub294\uc9c0 \uad6c\ud574 \ubcf4\uc9c0 \uc54a\uace0\ub294 \uc54c \uc218 \uc5c6\ub2e4",
      "reveals": "\uc804\ubd80 \uacc4\uc0b0\ud558\uc9c0 \uc54a\uc544\ub3c4 \ud55c \ubd84\ubc30\uac00 \uba87 \uac00\uc9c0\ub85c \uac08\ub77c\uc9c0\ub294\uc9c0 \ud558\ub098\ub9cc \ubcf4\uba74 \ud06c\uae30\ub97c \ube44\uad50\ud560 \uc218 \uc788\uc5b4\uc694."
     }
    ],
    "correct": [
     "c"
    ],
    "explain": "\uc0ac\ud0d5\uc774 \uc11c\ub85c \ub2e4\ub974\uba74 \uc0ac\ud0d5\ub9c8\ub2e4 \uc138 \uc0ac\ub78c \uc911 \ud55c \uba85\uc744 \uace0\ub974\ub294 \uac83\uc774\ubbc0\ub85c 3\uc758 6\uc81c\uacf1, \uc989 729\uac00\uc9c0\uc608\uc694. \uac19\uc740 \uc885\ub958\uc77c \ub54c\uc758 28\uac00\uc9c0\ubcf4\ub2e4 \ud6e8\uc52c \ub9ce\uc544\uc694. 28\uac00\uc9c0 \uac01\uac01\uc774 \uc5ec\ub7ec \ubc29\ubc95\uc73c\ub85c \uac08\ub77c\uc9c0\uae30 \ub54c\ubb38\uc774\uc5d0\uc694. \uc608\ub97c \ub4e4\uc5b4 (4,1,1) \ud558\ub098\ub9cc \ud574\ub3c4 \uc5b4\ub5a4 \uc0ac\ud0d5 4\uac1c\ub97c \uac11\uc774 \ubc1b\ub294\uc9c0\uc5d0 \ub530\ub77c \uc5ec\ub7ec \uac00\uc9c0\ub85c \ub098\ub258\uc5b4\uc694.",
    "hints": [
