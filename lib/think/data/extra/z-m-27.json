  "cell": "math|H2|counting",
  "topic": "\uc0ac\ud0d5\uc744 \ub098\ub204\uc5b4 \uc8fc\ub294 \ubc29\ubc95\uc758 \uc218: \uc0ac\ud0d5\uc758 \uad6c\ubcc4 \uc5ec\ubd80\uc640 \ube48\uc190 \ud5c8\uc6a9 \uc870\uac74",
  "level": 3,
  "levelLabel": "\uace0\ub4f1",
  "title": "\uc0ac\ud0d5 6\uac1c\ub97c \ub098\ub204\uc5b4 \uc8fc\ub294 \ubc29\ubc95\uc740 \uba87 \uac00\uc9c0\uc77c\uae4c?",
  "uiLang": "ko",
  "format": "choose-needed-info",
  "generative": true,
  "goal": "'\ub098\ub204\uc5b4 \uc8fc\ub294 \ubc29\ubc95\uc758 \uc218'\ub77c\ub294 \ubb38\uc7a5\ub9cc\uc73c\ub85c\ub294 \ub2f5\uc774 \ud558\ub098\ub85c \uc815\ud574\uc9c0\uc9c0 \uc54a\uc74c\uc744 \uc54c\uace0, \ub2f5\uc744 \uc815\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc870\uac74(\uc0ac\ud0d5\uc758 \uad6c\ubcc4 \uc5ec\ubd80, \ube48\uc190 \ud5c8\uc6a9 \uc5ec\ubd80)\uc744 \uc2a4\uc2a4\ub85c \ubc1d\ud600 \ubb38\uc81c\ub97c \ub2e4\uc2dc \uc4f4\ub2e4.",
  "thinking": [
   "\ub2f5\uc744 \uad6c\ud558\uae30 \uc804\uc5d0 \uc815\ubcf4\uac00 \ucda9\ubd84\ud55c\uc9c0 \ud310\ub2e8\ud558\uae30",
   "\uc870\uac74\uc744 \ubc14\uafb8\uba74 \uacbd\uc6b0\uc758 \uc218\uac00 \uc5b4\ub5bb\uac8c \ub2ec\ub77c\uc9c0\ub294\uc9c0 \uc608\uce21\ud558\uae30",
   "\uc870\uac74\uc774 \uc815\ud574\uc9c4 \uacbd\uc6b0\ub97c \uc9c1\uc811 \ub9cc\ub4e4\uc5b4 \ubcf4\uba70 \ud655\uc778\ud558\uae30",
   "\ubaa8\ud638\ud55c \ubb38\uc81c\ub97c \ud55c \uac00\uc9c0 \ub2f5\uc774 \ub098\uc624\ub3c4\ub85d \uace0\uccd0 \uc4f0\uae30"
  ],
  "differsFromPlain": "\ub2e8\uc21c \uc5f0\uc2b5\uc740 '\uac19\uc740 \uc0ac\ud0d5 6\uac1c\ub97c 3\uba85\uc5d0\uac8c \ub098\ub204\uc5b4 \uc8fc\ub294 \ubc29\ubc95\uc740 \uba87 \uac00\uc9c0\uc778\uac00'\ucc98\ub7fc \uc870\uac74\uc774 \ub2e4 \uc8fc\uc5b4\uc9c4 \ubb38\uc81c\uc758 \ub2f5\uc744 \uad6c\ud55c\ub2e4. \uc5ec\uae30\uc11c\ub294 \uc22b\uc790\ub97c \uad6c\ud558\uae30 \uc804\uc5d0 \ubb34\uc5c7\uc774 \uc815\ud574\uc838 \uc788\uc9c0 \uc54a\uc740\uc9c0\ub97c \ucc3e\uace0, \uc870\uac74\uc5d0 \ub530\ub77c \uac00\ub2a5\ud55c \uacbd\uc6b0\ub97c \uc9c1\uc811 \ub9cc\ub4e4\uc5b4 \ubcf4\uba70, \ubb38\uc81c\ub97c \uc2a4\uc2a4\ub85c \uace0\uccd0 \uc4f4\ub2e4.",
  "prerequisites": [
   "\uacbd\uc6b0\ub97c \uc21c\uc11c\uc30d\uc73c\ub85c \ub098\ud0c0\ub0b4\uc5b4 \ube60\uc9d0\uc5c6\uc774 \ub098\uc5f4\ud558\uae30",
   "\uacf1\uc758 \ubc95\uce59\uacfc \ud569\uc758 \ubc95\uce59(\uace0\ub4f1 \uacf5\ud1b5\uc218\ud559 \uacbd\uc6b0\uc758 \uc218 \ub2e8\uc6d0 \uc55e\ubd80\ubd84 \uc218\uc900)",
   "\ud559\uad50\uae09 \ubc30\uc815\uc758 H2\ub294 \uc774 \uc81c\uc791 \uacc4\ud68d\uc758 \ub09c\uc774\ub3c4 \uad6c\ubd84\uc77c \ubfd0\uc774\uba70, \ud559\uad50 \ud559\ub144 \ubc30\uc815\uc774 \uc544\ub2c8\ub2e4. \uacbd\uc6b0\uc758 \uc218 \ub2e8\uc6d0\uc758 \uae30\ubcf8 \uac1c\ub150\uc744 \ubc30\uc6b4 \ub4a4\ub77c\uace0 \uac00\uc815\ud55c\ub2e4."
  ],
  "minutes": 14,
  "curriculum": null,
  "material": "\uc0ac\ud0d5 6\uac1c\ub97c \uac11, \uc744, \ubcd1 \uc138 \uc0ac\ub78c\uc5d0\uac8c \ubaa8\ub450 \ub098\ub204\uc5b4 \uc8fc\ub824 \ud55c\ub2e4. \uac11, \uc744, \ubcd1\uc740 \uc774\ub984\uc774 \uc815\ud574\uc838 \uc788\uc5b4 \uc11c\ub85c \ub2e4\ub978 \uc0ac\ub78c\uc774\ub2e4. \uc0ac\ud0d5\uc744 \ub098\ub204\uc5b4 \uc8fc\ub294 \ubc29\ubc95\uc740 '\ub204\uac00 \ubb34\uc5c7\uc744 \ubc1b\uc558\ub294\uac00'\ub77c\ub294 \uacb0\uacfc\ub85c \uc13c\ub2e4. \uacb0\uacfc\uac00 \uac19\uc73c\uba74 \uac19\uc740 \ubc29\ubc95\uc774\uace0, \uc0ac\ud0d5\uc744 \uc8fc\ub294 \uc21c\uc11c\ub294 \uc138\uc9c0 \uc54a\ub294\ub2e4. \ubb38\uc81c\ub294 \ud55c \ubb38\uc7a5\ubfd0\uc774\ub2e4. \"\uc0ac\ud0d5 6\uac1c\ub97c \uc138 \uc0ac\ub78c\uc5d0\uac8c \ub098\ub204\uc5b4 \uc8fc\ub294 \ubc29\ubc95\uc740 \uba87 \uac00\uc9c0\uc77c\uae4c?\"",
  "steps": [
   {
    "id": "s1",
    "kind": "choose",
    "multi": true,
    "prompt": "\uc774 \ud55c \ubb38\uc7a5\ub9cc\uc73c\ub85c \ub2f5\uc774 \ud558\ub098\ub85c \uc815\ud574\uc9c0\ub824\uba74 \uaf2d \ub354 \uc54c\uc544\uc57c \ud558\ub294 \uac83\uc740 \ubb34\uc5c7\uc77c\uae4c\uc694? \ubaa8\ub450 \uace0\ub974\uc138\uc694.",
    "options": [
     {
      "id": "a",
      "text": "\uac11, \uc744, \ubcd1 \uc138 \uc0ac\ub78c\uc758 \ub098\uc774",
      "reveals": "\ub098\uc774\ub294 \uba87 \uac00\uc9c0\ub85c \ub098\ub204\ub290\ub0d0\uc640 \uad00\uacc4\uac00 \uc5c6\uc5b4\uc694. \uc5b4\ub5a4 \uc815\ubcf4\uac00 \uc138\ub294 \ubc29\ubc95\uc744 \ubc14\uafb8\ub294\uc9c0 \ub530\uc838 \ubcf4\uc138\uc694."
     },
     {
      "id": "b",
      "text": "\uc0ac\ud0d5 6\uac1c\uac00 \uc11c\ub85c \uad6c\ubcc4\ub418\ub294\uc9c0 \uc5ec\ubd80",
      "reveals": "\uc0ac\ud0d5\uc774 \uad6c\ubcc4\ub418\ub294\uc9c0\uc5d0 \ub530\ub77c \uac19\uc740 \uac1c\uc218 \ubd84\ubc30\ub3c4 \uc11c\ub85c \ub2e4\ub978 \ubc29\ubc95\uc73c\ub85c \uc138\uc5b4\uc9c8 \uc218 \uc788\ub2e4\ub294 \uc810\uc744 \ubd24\uc5b4\uc694."
     },
     {
      "id": "c",
      "text": "\uc0ac\ud0d5\uc744 \ud55c \uac1c\uc529 \ucc28\ub840\ub85c \uc8fc\ub294\uc9c0, \ud55c\uaebc\ubc88\uc5d0 \uc8fc\ub294\uc9c0",
      "reveals": "\uc774 \ubb38\uc81c\ub294 \uc8fc\ub294 \uc21c\uc11c\ub97c \uc138\uc9c0 \uc54a\uace0 \uacb0\uacfc\ub9cc \uc138\uae30\ub85c \uc815\ud574 \ub450\uc5c8\uc5b4\uc694. \uc774\ubbf8 \uc815\ud574\uc9c4 \uc870\uac74\uc774\uc5d0\uc694."
     },
     {
      "id": "d",
      "text": "\uc138 \uc0ac\ub78c \uc911 \ub204\uad70\uac00 \uc0ac\ud0d5\uc744 \ud558\ub098\ub3c4 \ubabb \ubc1b\uc544\ub3c4 \ub418\ub294\uc9c0",
      "reveals": "\ubc1b\ub294 \uac1c\uc218\uac00 0\uc778 \uacbd\uc6b0\ub97c \ub123\ub290\ub0d0\uc5d0 \ub530\ub77c \uac00\ub2a5\ud55c \uacbd\uc6b0\uc758 \ubaa9\ub85d \uc790\uccb4\uac00 \ub2ec\ub77c\uc9c4\ub2e4\ub294 \uc810\uc744 \ubd24\uc5b4\uc694."
     },
     {
      "id": "e",
      "text": "\uac11, \uc744, \ubcd1\uc774 \uc11c\ub85c \ub2e4\ub978 \uc0ac\ub78c\uc778\uc9c0",
      "reveals": "\uc774\ub984\uc774 \uc815\ud574\uc838 \uc788\ub2e4\uace0 \uc774\ubbf8 \uc801\ud600 \uc788\uc5b4\uc694. \uc8fc\uc5b4\uc9c4 \uc815\ubcf4\uc640 \ubaa8\uc790\ub780 \uc815\ubcf4\ub97c \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
     }
    ],
    "correct": [
     "b",
     "d"
    ],
    "explain": "\ubaa8\uc790\ub780 \uc815\ubcf4\ub294 \ub450 \uac00\uc9c0\uc608\uc694. \uc0ac\ud0d5\uc744 \uad6c\ubcc4\ud558\ub294\uc9c0\uc5d0 \ub530\ub77c (\uac11 4\uac1c, \uc744 1\uac1c, \ubcd1 1\uac1c)\ucc98\ub7fc \uac1c\uc218\uac00 \uac19\uc544\ub3c4 \uc5b4\ub5a4 \uc0ac\ud0d5\uc744 \ubc1b\uc558\ub294\uc9c0\uac00 \ub2e4\ub974\uba74 \ub2e4\ub978 \ubc29\ubc95\uc774 \ub3fc\uc694. \ub610 \ube48\uc190\uc744 \ud5c8\uc6a9\ud558\ub290\ub0d0\uc5d0 \ub530\ub77c \uac00\ub2a5\ud55c \uacbd\uc6b0\uac00 \ub2ec\ub77c\uc838\uc694. \uc0ac\ub78c\uc774 \uad6c\ubcc4\ub41c\ub2e4\ub294 \uac83\uacfc \uc8fc\ub294 \uc21c\uc11c\ub97c \uc138\uc9c0 \uc54a\ub294\ub2e4\ub294 \uac83\uc740 \uc774\ubbf8 \uc8fc\uc5b4\uc84c\uc5b4\uc694.",
    "hints": [
     "\ubb38\uc81c \uc9c0\ubb38\uc5d0 \uc774\ubbf8 \uc801\ud78c \uc870\uac74\uacfc \uc801\ud788\uc9c0 \uc54a\uc740 \uc870\uac74\uc744 \uc904\uc744 \uadf8\uc5b4 \uac00\ub974\ub4ef \ub098\ub204\uc5b4 \ubcf4\uc138\uc694.",
     "\uac19\uc740 \uacb0\uacfc\uac00 \ub418\ub3c4\ub85d (\uac11, \uc744, \ubcd1)\uc758 \uac1c\uc218\ub97c \ud558\ub098 \uc815\ud574 \ub193\uace0, \uc5b4\ub5a4 \uc870\uac74\uc744 \ubc14\uafb8\uba74 \uadf8 \uacb0\uacfc\uac00 \ub2ec\ub77c\uc9c0\uac70\ub098 \ubd88\uac00\ub2a5\ud574\uc9c0\ub294\uc9c0 \ub530\uc838 \ubcf4\uc138\uc694."
    ]
   },
   {
