  "format": "reveal-and-revise",
  "generative": true,
  "goal": "\ud589\ub82c\uc758 \uac70\ub4ed\uc81c\uacf1\uc5d0\uc11c \uc801\uc740 \uc218\uc758 \uac12\uc5d0 \ub9de\ub294 \uaddc\uce59\uc774 \uc5ec\ub7ff\uc77c \uc218 \uc788\uc74c\uc744 \uc54c\uace0, \ud6c4\ubcf4 \uaddc\uce59\uc744 \uac78\ub7ec \ub0b4\uba70 \ud310\ub2e8\uc744 \uace0\uccd0 \uac00\uace0, \uc774\uc720(\uad6c\uc870)\ub97c \ucc3e\uc740 \ub4a4\uc5d0\uc57c \uc77c\ubc18\uc2dd\uc744 \ud655\uc2e0\ud560 \uc218 \uc788\uc74c\uc744 \uc124\uba85\ud55c\ub2e4.",
  "thinking": [
   "\uc801\uc740 \uc790\ub8cc\ub85c \uaddc\uce59\uc744 \uc77c\ubc18\ud654\ud560 \ub54c \uac00\ub2a5\ud55c \ub2e4\ub978 \uaddc\uce59\uc744 \ud568\uaed8 \ub530\uc838 \ubcf4\uae30",
