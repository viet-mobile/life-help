  "differsFromPlain": "\ub2e8\uc21c \uc5f0\uc2b5\uc740 \uc8fc\uc5b4\uc9c4 \ud589\ub82c\uc758 \uac70\ub4ed\uc81c\uacf1 A\u00b2\uc774\ub098 A\u00b3\uc744 \uacc4\uc0b0\ud558\ub294 \uac83\uc774\ub2e4. \uc5ec\uae30\uc11c\ub294 \uacc4\uc0b0\ud55c \uba87 \uac1c\uc758 \uac12\ub9cc\uc73c\ub85c B^n\uc744 \ub2e8\uc815\ud574\ub3c4 \ub418\ub294\uc9c0, \ub2e4\ub978 \uaddc\uce59\uc774 \ub0a8\uc544 \uc788\ub294\uc9c0\ub97c \ub530\uc9c0\uace0, \uc774\uc720\uac00 \uc0dd\uacbc\uc744 \ub54c \ud655\uc2e0\uc774 \uc5b4\ub5bb\uac8c \ub2ec\ub77c\uc9c0\ub294\uc9c0\ub97c \ub2e4\ub8ec\ub2e4.",
  "prerequisites": [
   "2\u00d72 \ud589\ub82c\uc758 \uacf1\uc148(\uacf1\uc758 \ud55c \uc131\ubd84 = \uc55e \ud589\ub82c\uc758 \ud55c \ud589\uacfc \ub4a4 \ud589\ub82c\uc758 \ud55c \uc5f4\uc758 \uc131\ubd84\ub07c\ub9ac \uacf1\ud574 \ub354\ud55c \uac12)\uacfc \uac70\ub4ed\uc81c\uacf1 A^n = A\ub97c n\ubc88 \uacf1\ud55c \uac83",
