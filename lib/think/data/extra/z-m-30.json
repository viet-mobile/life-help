   "\ud480\uc774\uc5d0\uc11c \ucc98\uc74c \uc5b4\uae0b\ub098\ub294 \uc904\uc744 \ucc3e\uc544 \uc6d0\uc778 \uc124\uba85\ud558\uae30",
   "\ubb38\uc790(p, n)\ub97c \uc0ac\uc6a9\ud55c \uc77c\ubc18\uc2dd\uc744 \ub9cc\ub4e4\uace0 \uc774\uc720 \uc4f0\uae30"
