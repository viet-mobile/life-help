     "\uc11c\ub85c \ub2e4\ub978 \ub113\uc774\uac00 \ub098\uc624\ub294\uc9c0 \uacf1\ud574\uc11c \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    ]
   },
   {
    "id": "s3",
    "kind": "write",
    "prompt": "\uc9c0\uc544\uc5d0\uac8c \uc5b4\ub5bb\uac8c \ub9d0\ud574 \uc904\ub798\uc694? \ubc18\ub840\ub97c \ub4e4\uc5b4 \uc124\uba85\ud558\uace0, \ub458\ub808\uac00 \uac19\uc744 \ub54c \ub113\uc774\uac00 \uac00\uc7a5 \ud070 \ubaa8\uc591\uc740 \uc5b4\ub5a4 \uacbd\uc6b0\uc77c\uc9c0 \uc9d0\uc791\ud574 \uc368 \ubcf4\uc138\uc694.",
    "placeholder": "\uc608: ...",
