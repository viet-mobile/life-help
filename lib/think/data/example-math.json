  "title": "'\ub458\ub808\uac00 \uac19\uc73c\uba74 \ub113\uc774\ub3c4 \uac19\ub2e4'\ub294 \uc8fc\uc7a5 \uac80\uc99d\ud558\uae30",
  "uiLang": "ko",
  "format": "make-your-own",
  "generative": true,
  "goal": "\ub458\ub808\uc640 \ub113\uc774\uc758 \uad00\uacc4\uc5d0 \ub300\ud55c \uc77c\ubc18\ud654\uac00 \uc131\ub9bd\ud558\uc9c0 \uc54a\uc74c\uc744 \ubc18\ub840\ub85c \ubcf4\uc774\uace0, \uc5b4\ub5a4 \uc870\uac74\uc5d0\uc11c \ube44\uad50\uac00 \uac00\ub2a5\ud55c\uc9c0 \ub9d0\ud55c\ub2e4.",
  "thinking": [
   "\uc8fc\uc7a5\uc758 \ucc38/\uac70\uc9d3\uc744 \ud310\ub2e8\ud558\uae30",
   "\ubc18\ub840\ub97c \uc9c1\uc811 \ub9cc\ub4e4\uae30",
   "\uc131\ub9bd \uc870\uac74 \ubc1c\uacac\ud558\uae30"
  ],
  "differsFromPlain": "\ub2e8\uc21c \uc5f0\uc2b5\uc740 \uc9c1\uc0ac\uac01\ud615\uc758 \ub458\ub808\ub098 \ub113\uc774\ub97c \uacf5\uc2dd\uc5d0 \ub300\uc785\ud574 \uad6c\ud55c\ub2e4. \uc5ec\uae30\uc11c\ub294 \uacf5\uc2dd\uc744 \uacc4\uc0b0\ud558\ub294 \ub300\uc2e0 '\uc8fc\uc7a5\uc774 \ud56d\uc0c1 \uc131\ub9bd\ud558\ub294\uac00'\ub97c \uc2a4\uc2a4\ub85c \uc2dc\ud5d8\ud558\uace0, \ud559\uc0dd\uc774 \ubc18\ub840\ub97c \ub9cc\ub4e0\ub2e4.",
  "prerequisites": [
   "\uc9c1\uc0ac\uac01\ud615\uc758 \ub458\ub808\uc640 \ub113\uc774 \uacc4\uc0b0(\ucd08\ub4f1 4\ud559\ub144 \uc218\uc900)"
  ],
  "minutes": 8,
  "curriculum": null,
  "material": "\uce5c\uad6c \uc9c0\uc544\uac00 \ub9d0\ud588\uc5b4\uc694. \"\uc6b8\ud0c0\ub9ac \uae38\uc774(\ub458\ub808)\uac00 \uac19\uc740 \uc9c1\uc0ac\uac01\ud615 \ud143\ubc2d\uc740 \ub113\uc774\ub3c4 \ud56d\uc0c1 \uac19\uc544!\"",
  "steps": [
   {
    "id": "s1",
    "kind": "choose",
    "scaffold": true,
    "prompt": "\uc9c0\uc544\uc758 \ub9d0\uc744 \ud655\uc778\ud558\ub824\uba74 \uac00\uc7a5 \uba3c\uc800 \ubb34\uc5c7\uc744 \ud574 \ubcf4\uba74 \uc88b\uc744\uae4c\uc694?",
    "options": [
     {
      "id": "a",
      "text": "\ub458\ub808\uac00 \uac19\uc740 \uc9c1\uc0ac\uac01\ud615\uc744 \uc5ec\ub7ec \uac1c \uadf8\ub824\uc11c \ub113\uc774\ub97c \uad6c\ud574 \ubcf8\ub2e4"
     },
     {
      "id": "b",
      "text": "\uc9c0\uc544\uac00 \ud2c0\ub838\ub2e4\uace0 \ub9d0\ud55c\ub2e4",
      "reveals": "\uacb0\ub860\ubd80\ud130 \ub9d0\ud558\uba74 \uadfc\uac70 \uc5c6\uc774 \ub2e8\uc815\ud558\ub294 \uac70\uc608\uc694. \uba3c\uc800 \uc608\ub97c \ub9cc\ub4e4\uc5b4 \uc2dc\ud5d8\ud574\uc57c \ud574\uc694."
     },
     {
      "id": "c",
      "text": "\uc9c1\uc0ac\uac01\ud615\uc758 \ub113\uc774 \uacf5\uc2dd\uc744 \ub2e4\uc2dc \uc678\uc6b4\ub2e4",
      "reveals": "\uacf5\uc2dd\uc744 \uc544\ub294 \uac83\uacfc \uc8fc\uc7a5\uc774 \ud56d\uc0c1 \uc131\ub9bd\ud558\ub294\uc9c0 \uc2dc\ud5d8\ud558\ub294 \uac83\uc740 \ub2ec\ub77c\uc694."
     }
    ],
    "correct": [
     "a"
    ],
    "explain": "\uc8fc\uc7a5\uc774 '\ud56d\uc0c1'\uc774\ub77c\uba74, \uc870\uac74\uc744 \ub9cc\uc871\ud558\ub294 \uc608\ub97c \uc9c1\uc811 \ub9cc\ub4e4\uc5b4 \uc2dc\ud5d8\ud558\ub294 \uac83\uc774 \uac00\uc7a5 \uc9c1\uc811\uc801\uc778 \ud655\uc778 \ubc29\ubc95\uc774\uc5d0\uc694.",
    "hints": [
     "'\ud56d\uc0c1'\uc774\ub77c\ub294 \ub9d0\uc740 \uc608 \ud558\ub098\ub85c\ub3c4 \uae68\uc9c8 \uc218 \uc788\uc5b4\uc694.",
     "\ub458\ub808\uac00 \uac19\uc740 \uc9c1\uc0ac\uac01\ud615\uc744 \ub450 \uac1c\ub9cc \ub9cc\ub4e4\uc5b4 \ubcf4\uc138\uc694."
    ]
   },
   {
    "id": "s2",
    "kind": "build",
    "prompt": "\ub458\ub808\uac00 20\uc778 \uc9c1\uc0ac\uac01\ud615 \ub450 \uac1c\ub97c, \ub113\uc774\uac00 \uc11c\ub85c \ub2e4\ub974\uac8c \ub9cc\ub4e4\uc5b4 \ubcf4\uc138\uc694. (\uac00\ub85c a, \uc138\ub85c b)",
