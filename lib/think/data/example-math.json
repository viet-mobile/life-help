   "culture": "\ud143\ubc2d\u00b7\uc6b8\ud0c0\ub9ac\ub294 \ubcf4\ud3b8\uc801\uc778 \uc0c1\ud669\uc774\ub77c \ubb38\ud654 \uc758\uc874\uc774 \uc801\ub2e4.",
   "accessibility": "\uadf8\ub9bc \uc5c6\uc774 \uc22b\uc790\ub9cc\uc73c\ub85c \ud480 \uc218 \uc788\uac8c \ud588\ub2e4. \uc0c9\uc5d0 \uc758\uc874\ud558\uc9c0 \uc54a\ub294\ub2e4."
