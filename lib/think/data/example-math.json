    "selfAssess": [
     "\ub0b4\uac00 \ub4e0 \uc608\uc5d0\uc11c \ub458\ub808\uac00 \uac19\uace0 \ub113\uc774\uac00 \ub2e4\ub974\ub2e4\ub294 \uac83\uc774 \ubd84\uba85\ud55c\uac00\uc694?",
     "'\ud56d\uc0c1'\uc744 \uae68\ub824\uba74 \uc608 \ud558\ub098\ub85c \ucda9\ubd84\ud558\ub2e4\ub294 \uc810\uc744 \uc54c\uace0 \uc37c\ub098\uc694?",
     "\uac00\uc7a5 \ud070 \ub113\uc774\uc5d0 \ub300\ud55c \ub0b4 \uc9d0\uc791\uc744 \uc22b\uc790\ub85c \uc2dc\ud5d8\ud574 \ubd24\ub098\uc694?"
    ],
    "modelAnswers": [
     {
      "text": "\uc544\ub2c8\uc57c. \ub458\ub808\uac00 20\uc774\uc5b4\ub3c4 5\u00d75\ub294 \ub113\uc774 25\uc778\ub370 9\u00d71\uc740 \ub113\uc774 9\uc57c. \ub458\ub808\uac00 \uac19\uc544\ub3c4 \ub113\uc774\uac00 \ub2e4\ub97c \uc218 \uc788\uc5b4. \uc815\uc0ac\uac01\ud615\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d \ub113\uc774\uac00 \ucee4\uc9c0\ub294 \uac83 \uac19\uc544."
     },
     {
      "text": "\ud56d\uc0c1 \uac19\uc9c0\ub294 \uc54a\uc544. \ub458\ub808 20\uc5d0\uc11c \uac00\ub85c 6, \uc138\ub85c 4\uba74 \ub113\uc774 24\uc778\ub370 \uac00\ub85c 8, \uc138\ub85c 2\uba74 \ub113\uc774 16\uc774\uc57c.",
      "note": "\ud070 \ub113\uc774\uc5d0 \ub300\ud55c \uc9d0\uc791\uc740 \uc0dd\ub7b5\ud588\uc9c0\ub9cc \ubc18\ub840\ub294 \ucda9\ubd84\ud558\ub2e4."
     }
    ],
    "badAnswers": [
     {
      "text": "\uc9c0\uc544\uac00 \ud2c0\ub838\uc5b4.",
