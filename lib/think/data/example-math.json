     },
     {
      "text": "\ub9de\uc544. \ub458\ub808\uac00 \uac19\uc73c\uba74 \ub113\uc774\ub3c4 \uac19\uc544.",
      "why": "\uc8fc\uc7a5\uc744 \uadf8\ub300\ub85c \ubc1b\uc544\ub4e4\uc600\ub2e4."
     }
    ],
    "humanReview": "'\uc815\uc0ac\uac01\ud615\uc77c \ub54c \ub113\uc774\uac00 \uac00\uc7a5 \ud06c\ub2e4'\ub294 \uc9d0\uc791\uc774 \uc22b\uc790 \uc608\uc5d0 \uae30\ub300\ub294\uc9c0, \ub9c9\uc5f0\ud55c \uac10\uc778\uc9c0\ub294 \uc0ac\ub78c\uc774 \uc77d\uc5b4\uc57c \ud310\ub2e8\ud560 \uc218 \uc788\ub2e4.",
    "hints": [
     "\uc704\uc5d0\uc11c \ub9cc\ub4e0 \ub450 \uc9c1\uc0ac\uac01\ud615\uc758 \uc22b\uc790\ub97c \uadf8\ub300\ub85c \uc368\ub3c4 \ub3fc\uc694.",
