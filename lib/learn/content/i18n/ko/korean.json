  "lessons": {
    "korean-k1-l1": {
      "title": "기본 모음",
      "concept": "한글은 한국어의 글자예요. 한 음절은 한 덩어리로 써요. 모음만 쓸 때는 앞에 **ㅇ**을 붙이는데, 첫소리의 ㅇ은 소리가 나지 않아요. 그래서 아는 그냥 “a” 소리예요.",
      "example": "아 · 어 · 오 · 우 · 으 · 이 (a · eo · o · u · eu · i)"
    },
    "korean-k1-l2": {
      "title": "기본 자음",
      "concept": "모음 앞에 자음을 놓으면 음절 덩어리가 돼요: **ㄱ + ㅏ = 가** (ga). 덩어리는 왼쪽에서 오른쪽으로 읽어요.",
      "example": "가 · 나 · 다 · 마 · 바 · 사 · 하 (ga · na · da · ma · ba · sa · ha)"
    },
    "korean-k1-l3": {
      "title": "첫 단어",
      "concept": "음절 덩어리를 이어서 단어를 만들어요. 한 덩어리씩 읽은 다음 이어서 말해 봐요.",
      "example": "우유 (uyu) = 소에서 얻는 하얀 마실 것 / 나무 (namu) = 줄기와 가지, 잎이 있는 큰 식물"
    },
    "korean-k2-l1": {
      "title": "안녕하세요와 고맙습니다",
      "concept": "공손한 인사는 **-요**나 **-니다**로 끝나요. 안녕하세요는 아침, 낮, 저녁 언제나 쓸 수 있어요.",
      "example": "안녕하세요. (annyeonghaseyo.) = 만났을 때 하는 공손한 인사 / 감사합니다. (gamsahamnida.) = 고마운 마음을 전하는 말"
    },
    "korean-k2-l2": {
      "title": "네, 아니요, 괜찮아요",
      "concept": "매일 쓸 수 있는 짧고 공손한 대답이에요. 한국어는 끝에 **요**를 붙여 공손하게 말해요.",
      "example": "네. (ne.) = 긍정하는 공손한 대답 / 아니요. (aniyo.) = 부정하는 공손한 대답"
    },
    "korean-k2-l3": {
      "title": "만나서 반가워요",
      "concept": "처음 만난 사람에게는 만나서 반갑습니다라고 해요. 헤어질 때 인사는 두 가지예요. 떠나는 사람에게 하는 인사와 남아 있는 사람에게 하는 인사가 달라요.",
      "example": "만나서 반갑습니다. (mannaseo bangapseumnida.) = 처음 만나서 기쁘다는 인사"
    },
    "korean-k3-l1": {
      "title": "저는 학생이에요",
      "concept": "**저는**은 “나는”을 공손하게 말하는 표현이에요. “나는 …이다”라고 할 때 받침 있는 말 뒤에는 **이에요**, 받침 없는 말 뒤에는 **예요**를 붙여요.",
      "example": "저는 학생이에요. (jeoneun haksaengieyo.) = 나는 학교에서 배우는 사람이다."
    },
    "korean-k3-l2": {
      "title": "우리 가족",
      "concept": "한국어에서는 가족을 부르는 말을 아주 많이 써요. 가족이 아닌 사람에게도 써요.",
      "example": "가족 (gajok) = 부모, 형제처럼 함께 사는 사람들 / 어머니 (eomeoni) = 나를 낳아 준 여자 부모"
    },
    "korean-k3-l3": {
      "title": "숫자 세기",
      "concept": "한국어에는 숫자 체계가 두 가지 있어요. 물건을 셀 때는 고유어 숫자(하나, 둘, 셋 …)를, 돈, 날짜, 분을 말할 때는 한자어 숫자(일, 이, 삼 …)를 써요.",
      "example": "하나 · 둘 · 셋 (hana · dul · set)"
    },
    "korean-k4-l1": {
      "title": "자주 쓰는 동사",
      "concept": "공손한 현재형 동사는 **-아요 / -어요 / -해요**로 끝나요. “나”, “너”, “그들” 모두 같은 형태를 써요.",
      "example": "먹어요. (meogeoyo.) = (내가) 음식을 입에 넣어 삼킨다. / 마셔요. (masyeoyo.) = (내가) 물 같은 것을 삼킨다."
    },
    "korean-k4-l2": {
      "title": "장소에 가기",
      "concept": "가거나 오는 곳을 말할 때는 장소 뒤에 **에**를 붙여요: 학교에 가요. 동사는 맨 끝에 와요.",
      "example": "학교에 가요. (hakgyoe gayo.) = 나는 학교로 간다."
    },
    "korean-k4-l3": {
      "title": "먹기, 마시기, 읽기",
      "concept": "동사의 목적어에는 받침 있는 말 뒤에 **을**, 받침 없는 말 뒤에 **를**을 붙여요: 밥을 먹어요, 커피를 마셔요.",
      "example": "밥을 먹어요. (babeul meogeoyo.) = 나는 끼니를 먹는다."
    },
    "korean-k5-l1": {
      "title": "어제, 오늘, 내일",
      "concept": "시간을 나타내는 말은 보통 문장 앞부분에 와요.",
      "example": "어제 · 오늘 · 내일 (eoje · oneul · naeil)"
    },
    "korean-k5-l2": {
      "title": "내가 한 일",
      "concept": "과거형: **-았어요 / -었어요 / -했어요**. 줄어드는 동사도 있어요: 가다 → 갔어요, 보다 → 봤어요.",
      "example": "먹었어요. (meogeosseoyo.) = 나는 먹었다."
    },
    "korean-k5-l3": {
      "title": "내가 할 일",
      "concept": "계획을 말할 때는 **-(으)ㄹ 거예요**를 써요: 가다 → 갈 거예요, 먹다 → 먹을 거예요.",
      "example": "내일 갈 거예요. (naeil gal geoyeyo.) = 나는 다음 날 갈 것이다."
    },
    "korean-k6-l1": {
      "title": "가게에서",
      "concept": "값을 물을 때는 얼마예요?라고 하고, 무엇을 달라고 할 때는 **… 주세요**라고 해요.",
      "example": "얼마예요? (eolmayeyo?) = 값이 얼마인지 묻는 말"
    },
    "korean-k6-l2": {
      "title": "어디예요?",
      "concept": "**… 어디예요?**라고 물어보세요. 대답에서 오른쪽, 왼쪽, 직진을 잘 들어 보세요.",
      "example": "화장실이 어디예요? (hwajangsiri eodiyeyo?) = 화장실 위치를 묻는 말"
    },
    "korean-k6-l3": {
      "title": "… 하고 싶어요",
      "concept": "하고 싶은 일을 말할 때는 동사 어간에 **-고 싶어요**를 붙여요: 가다 → 가고 싶어요.",
      "example": "가고 싶어요. (gago sipeoyo.) = 가기를 바란다는 말"
    }
  },
