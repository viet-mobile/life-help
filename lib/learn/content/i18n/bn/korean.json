  "lessons": {
    "korean-k1-l1": {
      "title": "মৌলিক স্বরবর্ণ",
      "concept": "হাঙ্গুল হলো কোরিয়ান বর্ণমালা। প্রতিটি অক্ষর (সিলেবল) একটি ব্লক। একা স্বরবর্ণ লেখার সময় সামনে **ㅇ** বসে, যা শুরুতে উচ্চারিত হয় না: 아 শুধু “আ”।",
      "example": "아 · 어 · 오 · 우 · 으 · 이 (a · eo · o · u · eu · i)"
    },
    "korean-k1-l2": {
      "title": "মৌলিক ব্যঞ্জনবর্ণ",
      "concept": "স্বরবর্ণের সামনে একটি ব্যঞ্জনবর্ণ বসিয়ে সিলেবল ব্লক বানাও: **ㄱ + ㅏ = 가** (ga)। ব্লকটি বাঁ থেকে ডানে পড়ো।",
      "example": "가 · 나 · 다 · 마 · 바 · 사 · 하 (ga · na · da · ma · ba · sa · ha)"
    },
    "korean-k1-l3": {
      "title": "প্রথম শব্দ",
      "concept": "সিলেবল ব্লক জুড়ে শব্দ বানাও। প্রতিটি ব্লক পড়ো, তারপর একসাথে বলো।",
      "example": "우유 (uyu) = দুধ / 나무 (namu) = গাছ"
    },
    "korean-k2-l1": {
      "title": "হ্যালো আর ধন্যবাদ",
      "concept": "ভদ্র শুভেচ্ছা **-요** বা **-니다** দিয়ে শেষ হয়। 안녕하세요 দিনের যেকোনো সময় বলা যায়।",
      "example": "안녕하세요. (annyeonghaseyo.) = হ্যালো। / 감사합니다. (gamsahamnida.) = ধন্যবাদ।"
    },
    "korean-k2-l2": {
      "title": "হ্যাঁ, না আর ঠিক আছে",
      "concept": "প্রতিদিন ব্যবহার করার মতো ছোট ভদ্র উত্তর। ভদ্রতার জন্য কোরিয়ানে শেষে **요** যোগ করা হয়।",
      "example": "네. (ne.) = হ্যাঁ। / 아니요. (aniyo.) = না।"
    },
    "korean-k2-l3": {
      "title": "পরিচিত হয়ে খুশি হলাম",
      "concept": "নতুন কারও সাথে দেখা হলে বলো 만나서 반갑습니다। বিদায় বলার দুটি উপায় আছে: একটি যে চলে যাচ্ছে তার জন্য, আরেকটি যে থেকে যাচ্ছে তার জন্য।",
      "example": "만나서 반갑습니다. (mannaseo bangapseumnida.) = আপনার সাথে পরিচিত হয়ে খুশি হলাম।"
    },
    "korean-k3-l1": {
      "title": "আমি একজন ছাত্র",
      "concept": "**저는** মানে “আমি” (ভদ্র)। “আমি …” বলতে ব্যঞ্জনবর্ণের পরে **이에요** আর স্বরবর্ণের পরে **예요** বসাও।",
      "example": "저는 학생이에요. (jeoneun haksaengieyo.) = আমি একজন ছাত্র।"
    },
    "korean-k3-l2": {
      "title": "আমার পরিবার",
      "concept": "কোরিয়ানে পারিবারিক শব্দ অনেক ব্যবহার হয়, এমনকি যারা পরিবারের সদস্য নয় তাদের জন্যও।",
      "example": "가족 (gajok) = পরিবার / 어머니 (eomeoni) = মা"
    },
    "korean-k3-l3": {
      "title": "গণনা",
      "concept": "কোরিয়ানে দুটি সংখ্যা পদ্ধতি আছে: জিনিস গোনার জন্য খাঁটি কোরিয়ান সংখ্যা (하나, 둘, 셋 …), আর টাকা, তারিখ ও মিনিটের জন্য সিনো-কোরিয়ান সংখ্যা (일, 이, 삼 …)।",
      "example": "하나 · 둘 · 셋 (hana · dul · set)"
    },
    "korean-k4-l1": {
      "title": "প্রতিদিনের ক্রিয়া",
      "concept": "বর্তমান কালের ভদ্র ক্রিয়া **-아요 / -어요 / -해요** দিয়ে শেষ হয়। “আমি”, “তুমি” আর “তারা” সবার জন্য একই রূপ।",
      "example": "먹어요. (meogeoyo.) = (আমি) খাই। / 마셔요. (masyeoyo.) = (আমি) পান করি।"
    },
    "korean-k4-l2": {
      "title": "কোথাও যাওয়া",
      "concept": "কোথায় যাও বা আসো বলতে জায়গার পরে **에** বসাও: 학교에 가요। ক্রিয়া সবার শেষে আসে।",
      "example": "학교에 가요. (hakgyoe gayo.) = আমি স্কুলে যাই।"
    },
    "korean-k4-l3": {
      "title": "খাওয়া, পান করা, পড়া",
      "concept": "ক্রিয়ার কর্মের পরে ব্যঞ্জনবর্ণ হলে **을** আর স্বরবর্ণ হলে **를** বসে: 밥을 먹어요, 커피를 마셔요।",
      "example": "밥을 먹어요. (babeul meogeoyo.) = আমি ভাত খাই।"
    },
    "korean-k5-l1": {
      "title": "গতকাল, আজ, আগামীকাল",
      "concept": "সময়ের শব্দ সাধারণত বাক্যের শুরুর দিকে আসে।",
      "example": "어제 · 오늘 · 내일 (eoje · oneul · naeil)"
    },
    "korean-k5-l2": {
      "title": "আমি যা করেছি",
      "concept": "অতীত কাল: **-았어요 / -었어요 / -했어요**। কিছু ক্রিয়া ছোট হয়ে যায়: 가다 → 갔어요, 보다 → 봤어요।",
      "example": "먹었어요. (meogeosseoyo.) = আমি খেয়েছি।"
    },
    "korean-k5-l3": {
      "title": "আমি যা করব",
      "concept": "পরিকল্পনার জন্য **-(으)ㄹ 거예요** ব্যবহার করো: 가다 → 갈 거예요, 먹다 → 먹을 거예요।",
      "example": "내일 갈 거예요. (naeil gal geoyeyo.) = আমি আগামীকাল যাব।"
    },
    "korean-k6-l1": {
      "title": "দোকানে",
      "concept": "দাম জিজ্ঞেস করো 얼마예요? দিয়ে, আর কিছু চাইতে বলো **… 주세요** (… দিন)।",
      "example": "얼마예요? (eolmayeyo?) = এটার দাম কত?"
    },
    "korean-k6-l2": {
      "title": "এটা কোথায়?",
      "concept": "জিজ্ঞেস করো **… 어디예요?** (… কোথায়?)। 오른쪽 (ডান), 왼쪽 (বাঁ) আর 직진 (সোজা) শুনতে খেয়াল রাখো।",
      "example": "화장실이 어디예요? (hwajangsiri eodiyeyo?) = টয়লেট কোথায়?"
    },
    "korean-k6-l3": {
      "title": "আমি … চাই",
      "concept": "কী করতে চাও বলতে ক্রিয়ামূলের সাথে **-고 싶어요** যোগ করো: 가다 → 가고 싶어요।",
      "example": "가고 싶어요. (gago sipeoyo.) = আমি যেতে চাই।"
    }
  },
