  "lessons": {
    "korean-k1-l1": {
      "title": "मूलभूत स्वर",
      "concept": "हांगुल ही कोरियन लिपी आहे. प्रत्येक अक्षर एक ठोकळा असतो. एकटा स्वर लिहिताना पुढे **ㅇ** लिहितात, जो सुरुवातीला उच्चारला जात नाही: 아 म्हणजे फक्त “अ”.",
      "example": "아 · 어 · 오 · 우 · 으 · 이 (a · eo · o · u · eu · i)"
    },
    "korean-k1-l2": {
      "title": "मूलभूत व्यंजने",
      "concept": "अक्षर-ठोकळा बनवण्यासाठी स्वराच्या आधी व्यंजन ठेवा: **ㄱ + ㅏ = 가** (ga). ठोकळा डावीकडून उजवीकडे वाचा.",
      "example": "가 · 나 · 다 · 마 · 바 · 사 · 하 (ga · na · da · ma · ba · sa · ha)"
    },
    "korean-k1-l3": {
      "title": "पहिले शब्द",
      "concept": "अक्षर-ठोकळे जोडून शब्द बनवा. प्रत्येक ठोकळा वाचा, मग ते एकत्र म्हणा.",
      "example": "우유 (uyu) = दूध / 나무 (namu) = झाड"
    },
    "korean-k2-l1": {
      "title": "नमस्कार आणि धन्यवाद",
      "concept": "सभ्य अभिवादनाच्या शेवटी **-요** किंवा **-니다** येते. 안녕하세요 दिवसाच्या कोणत्याही वेळी चालते.",
      "example": "안녕하세요. (annyeonghaseyo.) = नमस्कार. / 감사합니다. (gamsahamnida.) = धन्यवाद."
    },
    "korean-k2-l2": {
      "title": "हो, नाही आणि ठीक आहे",
      "concept": "रोज वापरता येणारी छोटी सभ्य उत्तरे. सभ्यपणासाठी कोरियनमध्ये शेवटी **요** जोडतात.",
      "example": "네. (ne.) = हो. / 아니요. (aniyo.) = नाही."
    },
    "korean-k2-l3": {
      "title": "भेटून आनंद झाला",
      "concept": "नवीन व्यक्तीला भेटल्यावर 만나서 반갑습니다 म्हणा. निरोप घेण्याचे दोन प्रकार आहेत: एक जाणाऱ्या व्यक्तीसाठी, एक थांबणाऱ्या व्यक्तीसाठी.",
      "example": "만나서 반갑습니다. (mannaseo bangapseumnida.) = भेटून आनंद झाला."
    },
    "korean-k3-l1": {
      "title": "मी विद्यार्थी आहे",
      "concept": "**저는** म्हणजे “मी” (सभ्य). “मी … आहे” म्हणण्यासाठी व्यंजनानंतर **이에요** आणि स्वरानंतर **예요** लावा.",
      "example": "저는 학생이에요. (jeoneun haksaengieyo.) = मी विद्यार्थी आहे."
    },
    "korean-k3-l2": {
      "title": "माझे कुटुंब",
      "concept": "कोरियनमध्ये कुटुंबातील नात्यांचे शब्द खूप वापरले जातात, कुटुंबाबाहेरील लोकांसाठीसुद्धा.",
      "example": "가족 (gajok) = कुटुंब / 어머니 (eomeoni) = आई"
    },
    "korean-k3-l3": {
      "title": "मोजणी",
      "concept": "कोरियनमध्ये दोन संख्या पद्धती आहेत: वस्तू मोजण्यासाठी मूळ कोरियन (하나, 둘, 셋 …), आणि पैसे, तारखा व मिनिटांसाठी चिनी-कोरियन (일, 이, 삼 …).",
      "example": "하나 · 둘 · 셋 (hana · dul · set)"
    },
    "korean-k4-l1": {
      "title": "रोजची क्रियापदे",
      "concept": "सभ्य वर्तमानकाळातील क्रियापदांच्या शेवटी **-아요 / -어요 / -해요** येते. “मी”, “तुम्ही” आणि “ते” या सर्वांसाठी हेच रूप वापरतात.",
      "example": "먹어요. (meogeoyo.) = (मी) खातो. / 마셔요. (masyeoyo.) = (मी) पितो."
    },
    "korean-k4-l2": {
      "title": "ठिकाणी जाणे",
      "concept": "तुम्ही कुठे जाता किंवा कुठून येता हे सांगण्यासाठी ठिकाणानंतर **에** लावा: 학교에 가요. क्रियापद शेवटी येते.",
      "example": "학교에 가요. (hakgyoe gayo.) = मी शाळेत जातो."
    },
    "korean-k4-l3": {
      "title": "खाणे, पिणे, वाचणे",
      "concept": "क्रियापदाच्या कर्माला व्यंजनानंतर **을** आणि स्वरानंतर **를** लागते: 밥을 먹어요, 커피를 마셔요.",
      "example": "밥을 먹어요. (babeul meogeoyo.) = मी जेवण करतो."
    },
    "korean-k5-l1": {
      "title": "काल, आज, उद्या",
      "concept": "वेळेचे शब्द सहसा वाक्याच्या सुरुवातीजवळ येतात.",
      "example": "어제 · 오늘 · 내일 (eoje · oneul · naeil)"
    },
    "korean-k5-l2": {
      "title": "मी काय केले",
      "concept": "भूतकाळ: **-았어요 / -었어요 / -했어요**. काही क्रियापदे लहान होतात: 가다 → 갔어요, 보다 → 봤어요.",
      "example": "먹었어요. (meogeosseoyo.) = मी खाल्ले."
    },
    "korean-k5-l3": {
      "title": "मी काय करणार",
      "concept": "योजनांसाठी **-(으)ㄹ 거예요** वापरा: 가다 → 갈 거예요, 먹다 → 먹을 거예요.",
      "example": "내일 갈 거예요. (naeil gal geoyeyo.) = मी उद्या जाईन."
    },
    "korean-k6-l1": {
      "title": "दुकानात",
      "concept": "किंमत विचारण्यासाठी 얼마예요? आणि काही मागण्यासाठी **… 주세요** (… द्या) म्हणा.",
      "example": "얼마예요? (eolmayeyo?) = याची किंमत किती आहे?"
    },
    "korean-k6-l2": {
      "title": "ते कुठे आहे?",
      "concept": "**… 어디예요?** (… कुठे आहे?) असे विचारा. 오른쪽 (उजवीकडे), 왼쪽 (डावीकडे) आणि 직진 (सरळ) हे शब्द ऐका.",
      "example": "화장실이 어디예요? (hwajangsiri eodiyeyo?) = शौचालय कुठे आहे?"
    },
    "korean-k6-l3": {
      "title": "मला … करायचे आहे",
      "concept": "तुम्हाला काय करायचे आहे ते सांगण्यासाठी क्रियापदाच्या मुळाला **-고 싶어요** जोडा: 가다 → 가고 싶어요.",
      "example": "가고 싶어요. (gago sipeoyo.) = मला जायचे आहे."
    }
  },
