  "lessons": {
    "korean-k1-l1": {
      "title": "基本元音",
      "concept": "韩文是韩语的字母。每个音节是一个方块。元音单独书写时要在前面加 **ㅇ**，它在开头时不发音：아 就读作“a”。",
      "example": "아 · 어 · 오 · 우 · 으 · 이 (a · eo · o · u · eu · i)"
    },
    "korean-k1-l2": {
      "title": "基本辅音",
      "concept": "把辅音放在元音前面，就组成一个音节块：**ㄱ + ㅏ = 가**（ga）。从左往右读这个方块。",
      "example": "가 · 나 · 다 · 마 · 바 · 사 · 하 (ga · na · da · ma · ba · sa · ha)"
    },
    "korean-k1-l3": {
      "title": "第一批单词",
      "concept": "把音节块连起来就成了单词。先读每个方块，再连起来读。",
      "example": "우유 (uyu) = 牛奶 / 나무 (namu) = 树"
    },
    "korean-k2-l1": {
      "title": "你好和谢谢",
      "concept": "礼貌的问候语以 **-요** 或 **-니다** 结尾。안녕하세요 一天中任何时候都可以用。",
      "example": "안녕하세요. (annyeonghaseyo.) = 你好。 / 감사합니다. (gamsahamnida.) = 谢谢。"
    },
    "korean-k2-l2": {
      "title": "是、不是和没关系",
      "concept": "每天都能用的简短礼貌回答。韩语在句末加上 **요** 表示礼貌。",
      "example": "네. (ne.) = 是。 / 아니요. (aniyo.) = 不是。"
    },
    "korean-k2-l3": {
      "title": "很高兴认识你",
      "concept": "第一次见到某人时，说 만나서 반갑습니다。说再见有两种方式：一种对离开的人说，一种对留下的人说。",
      "example": "만나서 반갑습니다. (mannaseo bangapseumnida.) = 很高兴认识你。"
    },
    "korean-k3-l1": {
      "title": "我是学生",
      "concept": "**저는** 的意思是“我”（礼貌）。辅音后面加 **이에요**，元音后面加 **예요**，表示“我是……”。",
      "example": "저는 학생이에요. (jeoneun haksaengieyo.) = 我是学生。"
    },
    "korean-k3-l2": {
      "title": "我的家人",
      "concept": "韩语中家庭称谓用得很多，甚至用来称呼不是家人的人。",
      "example": "가족 (gajok) = 家人 / 어머니 (eomeoni) = 妈妈"
    },
    "korean-k3-l3": {
      "title": "数数",
      "concept": "韩语有两套数字：固有词数字（하나, 둘, 셋 …）用来数东西，汉字词数字（일, 이, 삼 …）用于钱、日期和分钟。",
      "example": "하나 · 둘 · 셋 (hana · dul · set)"
    },
    "korean-k4-l1": {
      "title": "日常动词",
      "concept": "礼貌的现在时动词以 **-아요 / -어요 / -해요** 结尾。“我”“你”“他们”都用同一个形式。",
      "example": "먹어요. (meogeoyo.) = （我）吃。 / 마셔요. (masyeoyo.) = （我）喝。"
    },
    "korean-k4-l2": {
      "title": "去各个地方",
      "concept": "在地点后面加 **에**，表示去哪里或来哪里：학교에 가요。动词放在最后。",
      "example": "학교에 가요. (hakgyoe gayo.) = 我去学校。"
    },
    "korean-k4-l3": {
      "title": "吃、喝、读",
      "concept": "动词的宾语在辅音后加 **을**，在元音后加 **를**：밥을 먹어요, 커피를 마셔요。",
      "example": "밥을 먹어요. (babeul meogeoyo.) = 我吃饭。"
    },
    "korean-k5-l1": {
      "title": "昨天、今天、明天",
      "concept": "时间词通常放在句子的开头附近。",
      "example": "어제 · 오늘 · 내일 (eoje · oneul · naeil)"
    },
    "korean-k5-l2": {
      "title": "我做过的事",
      "concept": "过去时：**-았어요 / -었어요 / -했어요**。有些动词会缩略：가다 → 갔어요, 보다 → 봤어요。",
      "example": "먹었어요. (meogeosseoyo.) = 我吃了。"
    },
    "korean-k5-l3": {
      "title": "我要做的事",
      "concept": "用 **-(으)ㄹ 거예요** 表示计划：가다 → 갈 거예요, 먹다 → 먹을 거예요。",
      "example": "내일 갈 거예요. (naeil gal geoyeyo.) = 我明天要去。"
    },
    "korean-k6-l1": {
      "title": "在商店",
      "concept": "用 얼마예요? 问价格，用 **… 주세요**（请给我……）要东西。",
      "example": "얼마예요? (eolmayeyo?) = 多少钱？"
    },
    "korean-k6-l2": {
      "title": "在哪里？",
      "concept": "问 **… 어디예요?**（……在哪里？）。注意听 오른쪽（右边）、왼쪽（左边）和 직진（直走）。",
      "example": "화장실이 어디예요? (hwajangsiri eodiyeyo?) = 洗手间在哪里？"
    },
    "korean-k6-l3": {
      "title": "我想……",
      "concept": "在动词词干后加 **-고 싶어요**，表示你想做什么：가다 → 가고 싶어요。",
      "example": "가고 싶어요. (gago sipeoyo.) = 我想去。"
    }
  },
