  "lessons": {
    "korean-k1-l1": {
      "title": "الحروف المتحركة الأساسية",
      "concept": "الهانغول هو الأبجدية الكورية. كل مقطع عبارة عن بلوك. الحرف المتحرك لوحده بيتكتب وقدامه **ㅇ**، ودي مابتتنطقش في الأول: 아 يعني «آ» بس.",
      "example": "아 · 어 · 오 · 우 · 으 · 이 (a · eo · o · u · eu · i)"
    },
    "korean-k1-l2": {
      "title": "الحروف الساكنة الأساسية",
      "concept": "حط حرف ساكن قدام حرف متحرك عشان تعمل بلوك مقطع: **ㄱ + ㅏ = 가** (ga). اقرا البلوك من الشمال لليمين.",
      "example": "가 · 나 · 다 · 마 · 바 · 사 · 하 (ga · na · da · ma · ba · sa · ha)"
    },
    "korean-k1-l3": {
      "title": "أول الكلمات",
      "concept": "وصّل بلوكات المقاطع عشان تعمل كلمات. اقرا كل بلوك، وبعدين قولهم مع بعض.",
      "example": "우유 (uyu) = لبن / 나무 (namu) = شجرة"
    },
    "korean-k2-l1": {
      "title": "أهلاً وشكراً",
      "concept": "التحيات المؤدبة بتخلص بـ **-요** أو **-니다**. 안녕하세요 تنفع في أي وقت في اليوم.",
      "example": "안녕하세요. (annyeonghaseyo.) = أهلاً. / 감사합니다. (gamsahamnida.) = شكراً."
    },
    "korean-k2-l2": {
      "title": "أيوه ولا وماشي",
      "concept": "ردود قصيرة ومؤدبة تقدر تستعملها كل يوم. الكوري بيزوّد **요** في الآخر عشان يبقى مؤدب.",
      "example": "네. (ne.) = أيوه. / 아니요. (aniyo.) = لا."
    },
    "korean-k2-l3": {
      "title": "فرصة سعيدة",
      "concept": "لما تقابل حد جديد، قول 만나서 반갑습니다. فيه طريقتين تقول بيهم مع السلامة: واحدة للي ماشي، وواحدة للي قاعد.",
      "example": "만나서 반갑습니다. (mannaseo bangapseumnida.) = فرصة سعيدة."
    },
    "korean-k3-l1": {
      "title": "أنا طالب",
      "concept": "**저는** معناها «أنا» (بأدب). حط **이에요** بعد الحرف الساكن و**예요** بعد الحرف المتحرك عشان تقول «أنا …».",
      "example": "저는 학생이에요. (jeoneun haksaengieyo.) = أنا طالب."
    },
    "korean-k3-l2": {
      "title": "عيلتي",
      "concept": "كلمات العيلة بتتقال كتير في الكوري، حتى لناس مش من العيلة.",
      "example": "가족 (gajok) = عيلة / 어머니 (eomeoni) = أم"
    },
    "korean-k3-l3": {
      "title": "العدّ",
      "concept": "الكوري فيه نظامين أرقام: الكوري الأصلي (하나, 둘, 셋 …) لعدّ الحاجات، والصيني الكوري (일, 이, 삼 …) للفلوس والتواريخ والدقايق.",
      "example": "하나 · 둘 · 셋 (hana · dul · set)"
    },
    "korean-k4-l1": {
      "title": "أفعال كل يوم",
      "concept": "الأفعال المؤدبة في المضارع بتخلص بـ **-아요 / -어요 / -해요**. نفس الصيغة بتنفع لـ «أنا» و«إنت» و«هم».",
      "example": "먹어요. (meogeoyo.) = (أنا) باكل. / 마셔요. (masyeoyo.) = (أنا) باشرب."
    },
    "korean-k4-l2": {
      "title": "الروحة لأماكن",
      "concept": "حط **에** بعد المكان عشان تقول رايح فين أو جاي منين: 학교에 가요. الفعل بييجي في الآخر.",
      "example": "학교에 가요. (hakgyoe gayo.) = أنا رايح المدرسة."
    },
    "korean-k4-l3": {
      "title": "الأكل والشرب والقراية",
      "concept": "المفعول به بياخد **을** بعد الحرف الساكن و**를** بعد الحرف المتحرك: 밥을 먹어요, 커피를 마셔요.",
      "example": "밥을 먹어요. (babeul meogeoyo.) = باكل."
    },
    "korean-k5-l1": {
      "title": "امبارح، النهارده، بكره",
      "concept": "كلمات الوقت عادةً بتيجي في أول الجملة.",
      "example": "어제 · 오늘 · 내일 (eoje · oneul · naeil)"
    },
    "korean-k5-l2": {
      "title": "اللي عملته",
      "concept": "الماضي: **-았어요 / -었어요 / -했어요**. فيه أفعال بتتختصر: 가다 → 갔어요, 보다 → 봤어요.",
      "example": "먹었어요. (meogeosseoyo.) = أكلت."
    },
    "korean-k5-l3": {
      "title": "اللي هعمله",
      "concept": "استعمل **-(으)ㄹ 거예요** للخطط: 가다 → 갈 거예요, 먹다 → 먹을 거예요.",
      "example": "내일 갈 거예요. (naeil gal geoyeyo.) = هروح بكره."
    },
    "korean-k6-l1": {
      "title": "في المحل",
      "concept": "اسأل عن السعر بـ 얼마예요? واطلب حاجة بـ **… 주세요** (… لو سمحت).",
      "example": "얼마예요? (eolmayeyo?) = بكام؟"
    },
    "korean-k6-l2": {
      "title": "فين؟",
      "concept": "اسأل **… 어디예요?** (… فين؟). خلي بالك من 오른쪽 (يمين) و왼쪽 (شمال) و직진 (على طول).",
      "example": "화장실이 어디예요? (hwajangsiri eodiyeyo?) = الحمام فين؟"
    },
    "korean-k6-l3": {
      "title": "أنا عايز …",
      "concept": "زوّد **-고 싶어요** على جذر الفعل عشان تقول عايز تعمل إيه: 가다 → 가고 싶어요.",
      "example": "가고 싶어요. (gago sipeoyo.) = عايز أروح."
    }
  },
