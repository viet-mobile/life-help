  "lessons": {
    "korean-k1-l1": {
      "title": "Temel ünlüler",
      "concept": "Hangıl, Kore alfabesidir. Her hece bir bloktur. Tek başına bir ünlü, önüne **ㅇ** konarak yazılır; bu harf başta okunmaz: 아 sadece “a” diye okunur.",
      "example": "아 · 어 · 오 · 우 · 으 · 이 (a · eo · o · u · eu · i)"
    },
    "korean-k1-l2": {
      "title": "Temel ünsüzler",
      "concept": "Hece bloğu yapmak için ünlünün önüne bir ünsüz koy: **ㄱ + ㅏ = 가** (ga). Bloğu soldan sağa oku.",
      "example": "가 · 나 · 다 · 마 · 바 · 사 · 하 (ga · na · da · ma · ba · sa · ha)"
    },
    "korean-k1-l3": {
      "title": "İlk kelimeler",
      "concept": "Hece bloklarını birleştirerek kelime yap. Her bloğu oku, sonra hepsini birlikte söyle.",
      "example": "우유 (uyu) = süt / 나무 (namu) = ağaç"
    },
    "korean-k2-l1": {
      "title": "Merhaba ve teşekkürler",
      "concept": "Kibar selamlar **-요** ya da **-니다** ile biter. 안녕하세요 günün her saatinde kullanılır.",
      "example": "안녕하세요. (annyeonghaseyo.) = Merhaba. / 감사합니다. (gamsahamnida.) = Teşekkür ederim."
    },
    "korean-k2-l2": {
      "title": "Evet, hayır ve tamam",
      "concept": "Her gün kullanabileceğin kısa ve kibar cevaplar. Korecede kibar olmak için sona **요** eklenir.",
      "example": "네. (ne.) = Evet. / 아니요. (aniyo.) = Hayır."
    },
    "korean-k2-l3": {
      "title": "Tanıştığıma memnun oldum",
      "concept": "Yeni biriyle tanışınca 만나서 반갑습니다 de. Hoşça kal demenin iki yolu var: biri giden kişiye, biri kalan kişiye.",
      "example": "만나서 반갑습니다. (mannaseo bangapseumnida.) = Tanıştığıma memnun oldum."
    },
    "korean-k3-l1": {
      "title": "Ben öğrenciyim",
      "concept": "**저는** “ben” demektir (kibar). “Ben …’im” demek için ünsüzden sonra **이에요**, ünlüden sonra **예요** kullan.",
      "example": "저는 학생이에요. (jeoneun haksaengieyo.) = Ben öğrenciyim."
    },
    "korean-k3-l2": {
      "title": "Ailem",
      "concept": "Korecede aile kelimeleri çok kullanılır, aileden olmayan kişiler için bile.",
      "example": "가족 (gajok) = aile / 어머니 (eomeoni) = anne"
    },
    "korean-k3-l3": {
      "title": "Saymak",
      "concept": "Korecede iki sayı sistemi var: nesneleri saymak için öz Korece (하나, 둘, 셋 …), para, tarih ve dakika için Çin kökenli Korece (일, 이, 삼 …).",
      "example": "하나 · 둘 · 셋 (hana · dul · set)"
    },
    "korean-k4-l1": {
      "title": "Gündelik fiiller",
      "concept": "Kibar şimdiki zaman fiilleri **-아요 / -어요 / -해요** ile biter. Aynı biçim “ben”, “sen” ve “onlar” için kullanılır.",
      "example": "먹어요. (meogeoyo.) = Yerim. / 마셔요. (masyeoyo.) = İçerim."
    },
    "korean-k4-l2": {
      "title": "Bir yere gitmek",
      "concept": "Nereye gittiğini ya da nereden geldiğini söylemek için yerin arkasına **에** koy: 학교에 가요. Fiil en sona gelir.",
      "example": "학교에 가요. (hakgyoe gayo.) = Okula giderim."
    },
    "korean-k4-l3": {
      "title": "Yemek, içmek, okumak",
      "concept": "Fiilin nesnesi ünsüzden sonra **을**, ünlüden sonra **를** alır: 밥을 먹어요, 커피를 마셔요.",
      "example": "밥을 먹어요. (babeul meogeoyo.) = Yemek yerim."
    },
    "korean-k5-l1": {
      "title": "Dün, bugün, yarın",
      "concept": "Zaman kelimeleri genellikle cümlenin başına yakın gelir.",
      "example": "어제 · 오늘 · 내일 (eoje · oneul · naeil)"
    },
    "korean-k5-l2": {
      "title": "Ne yaptım",
      "concept": "Geçmiş zaman: **-았어요 / -었어요 / -했어요**. Bazı fiiller kısalır: 가다 → 갔어요, 보다 → 봤어요.",
      "example": "먹었어요. (meogeosseoyo.) = Yedim."
    },
    "korean-k5-l3": {
      "title": "Ne yapacağım",
      "concept": "Planlar için **-(으)ㄹ 거예요** kullan: 가다 → 갈 거예요, 먹다 → 먹을 거예요.",
      "example": "내일 갈 거예요. (naeil gal geoyeyo.) = Yarın gideceğim."
    },
    "korean-k6-l1": {
      "title": "Dükkânda",
      "concept": "Fiyatı 얼마예요? ile sor, bir şey istemek için **… 주세요** (… lütfen) de.",
      "example": "얼마예요? (eolmayeyo?) = Ne kadar?"
    },
    "korean-k6-l2": {
      "title": "Nerede?",
      "concept": "**… 어디예요?** (… nerede?) diye sor. 오른쪽 (sağ), 왼쪽 (sol) ve 직진 (düz) kelimelerine kulak ver.",
      "example": "화장실이 어디예요? (hwajangsiri eodiyeyo?) = Tuvalet nerede?"
    },
    "korean-k6-l3": {
      "title": "… istiyorum",
      "concept": "Ne yapmak istediğini söylemek için fiil köküne **-고 싶어요** ekle: 가다 → 가고 싶어요.",
      "example": "가고 싶어요. (gago sipeoyo.) = Gitmek istiyorum."
    }
  },
