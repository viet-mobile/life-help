en/home/themen/einreise/faq.html"},{"text":"Letter of invitation written in German, French or Italian with host's and visitor's full details, length of stay, date and signature","sourceUrl":"https://www.sem.admin.ch/dam/sem/en/data/einreise/merkblatt_einreise/mb-einladungsschreiben.pdf.download.pdf/mb-einladungsschreiben.pdf"},{"text":"Declaration of sponsorship by a guarantor (Swiss citizen, permit holder or legal entity) covering up to CHF 30,000, if the representation requires it","sourceUrl":"https://www.sem.admin.ch/dam/sem/en/data/einreise/merkblatt_einreise/mb-verpflicht-erklaerung.pdf.download.pdf/mb-verpflicht-erklaerung.pdf"},{"text":"Travel document valid 3 months after departure and issued within the last 10 years","sourceUrl":"https://www.sem.admin.ch/dam/sem/en/data/einreise/merkblatt_einreise/mb-einreise-ch.pdf.download.pdf/mb-einreise-ch.pdf"},{"text":"Proof of health insurance and documents supporting the purpose of the visit","sourceUrl":"https://www.sem.admin.ch/dam/sem/en/data/einreise/merkblatt_einreise/mb-einreise-ch.pdf.download.pdf/mb-einreise-ch.pdf"},{"text":"Photograph","sourceUrl":"https://www.sem.admin.ch/sem/en/home/themen/einreise/faq.html"},{"text":"Travel medical insurance covering EUR 30,000","sourceUrl":"https://www.sem.admin.ch/sem/en/home/themen/einreise/faq.html"}]},"other":{"visaTypes":["Settlement permits (C)","Permit Ci","Permit G"],"links":[{"kind":"info","url":"https://www.sem.admin.ch/sem/en/home/themen/aufenthalt.html","title":"Residence","langs":["en","de","fr","it"],"verifiedAt":"2026-10-21"},{"kind":"info","url":"https://www.sem.admin.ch/sem/en/home/themen/aufenthalt/nicht_eu_efta.html","title":"Residence permits for non-EU/EFTA nationals","langs":["en","de","fr","it"],"verifiedAt":"2026-10-21"},{"kind":"info","url":"https://www.sem.admin.ch/sem/en/home/themen/aufenthalt/biometr_auslaenderausweis.html","title":"Biometric residence permits for foreign nationals","langs":["en","de","fr","it"],"verifiedAt":"2026-10-21"},{"kind":"info","url":"https://www.schweiz-vereinigtestaaten.eda.admin.ch/en/do-i-need-a-national-visa","title":"Do I need a national visa?","langs":["en"],"verifiedAt":"2026-10-21"}],"docs":[{"text":"A permit is required for work or for stays longer than three months; issued by the cantonal migration offices","sourceUrl":"https://www.sem.admin.ch/sem/en/home/themen/aufenthalt.html"},{"text":"Visa-exempt nationals staying over 90 days must register with the cantonal authority within 14 days of arrival","sourceUrl":"https://www.schweiz-vereinigtestaaten.eda.admin.ch/en/do-i-need-a-national-visa"}]}},"entryRules":[{"nationalities":["AT","BE","BG","HR","CY","CZ","DK","EE","FI","FR","DE","GR","HU","IS","IE","IT","LV","LI","LT","LU","MT","MC","NL","NO","PL","PT","RO","SK","SI","ES","SE"],"status":"visa_free","days":null,"note":"EU/EFTA, Schengen and associated states: no visa for short or long stays; valid passport or identity card","sourceUrl":"https://www.sem.admin.ch/sem/en/home/publiservice/weisungen-kreisschreiben/visa/liste1_staatsangehoerigkeit.html"},{"nationalities":["AD","AU","BN","JP","MY","NZ","SM","SG","VA","GB"],"status":"visa_free","days":90,"note":"No visa for stays up to 90 days in any 180-day period and none for longer stays; a residence permit from the cantonal migration office is still required for stays over 90 days. GB: British Citizen passports","sourceUrl":"https://www.sem.admin.ch/sem/en/home/publiservice/weisungen-kreisschreiben/visa/liste1_staatsangehoerigkeit.html"},{"nationalities":["AG","AR","BS","BB","BR","CA","CL","CO","CR","DM","SV","GD","GT","HN","IL","KI","MH","MU","MX","FM","NI","PW","PA","PY","PE","KN","LC","VC","SB","WS","SC","KR","TL","TO","TT","TV","AE","US","UY","VE"],"status":"visa_free","days":90,"note":"No visa for stays up to 90 days in any 180-day period; visa required for stays over 90 days and for gainful occupation in listed sectors or exceeding 8 days per calendar year (V1)","sourceUrl":"https://www.sem.admin.ch/sem/en/home/publiservice/weisungen-kreisschreiben/visa/liste1_staatsangehoerigkeit.html"},{"nationalities":["AL","BA","GE","MD","ME","MK","RS","UA"],"status":"visa_free","days":90,"note":"Exemption only for holders of biometric passports; visa required for any gainful occupation and for stays over 90 days. Kosovo (no ISO code) has the same rule","sourceUrl":"https://www.sem.admin.ch/sem/en/home/publiservice/weisungen-kreisschreiben/visa/liste1_staatsangehoerigkeit.html"},{"nationalities":["HK","MO","TW"],"status":"visa_free","days":90,"note":"HK: HKSAR passport only; MO: MSAR passport only; TW: passport must include an identity card number. Visa required for stays over 90 days","sourceUrl":"https://www.sem.admin.ch/sem/en/home/publiservice/weisungen-kreisschreiben/visa/liste1_staatsangehoerigkeit.html"},{"nationalities":["AF","DZ","AO","AM","AZ","BH","BD","BY","BZ","BJ","BT","BO","BW","BF","BI","KH","CM","CV","CF","TD","CN","KM","CG","CD","CI","CU","DJ","DO","EC","EG","GQ","ER","SZ","ET","FJ","GA","GM","GH","GN","GW","GY","HT","IN","ID","IR","IQ","JM","JO","KZ","KE","KW","KG","LA","LB","LS","LR","LY","MG","MW","MV","ML","MR","MN","MA","MZ","MM","NA","NR","NP","NE","NG","KP","OM","PK","PS","PG","PH","QA","RU","RW","ST","SA","SN","SL","SO","ZA","LK","SD","SS","SR","SY","TJ","TZ","TH","TG","TN","TR","TM","UG","UZ","VU","VN","YE","ZM","ZW"],"status":"visa_required","days":null,"note":"Ordinary passport holders need a visa for stays up to 90 days and for longer stays; holders of a valid Schengen residence permit or type D visa are exempt","sourceUrl":"https://www.sem.admin.ch/sem/en/home/publiservice/weisungen-kreisschreiben/visa/liste1_staatsangehoerigkeit.html"}],"entryRulesSource":"https://www.sem.admin.ch/sem/en/home/publiservice/weisungen-kreisschreiben/visa/liste1_staatsangehoerigkeit.html"}
