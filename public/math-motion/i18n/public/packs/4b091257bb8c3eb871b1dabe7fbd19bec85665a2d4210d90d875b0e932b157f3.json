{
  "locale": "te",
  "status": "ai-translated-unreviewed",
  "sourceCatalogSHA256": "068ebb2a7378d1953a57038344d31624bc2c362e89d5625d3a5cc5066992e07f",
  "values": {
    "t-88f51c35f6abbb04": "0తో సహా ఒక్కొక్కటిగా లెక్కించడం",
    "t-40e15999ca86e3ed": "వస్తువుల సంఖ్యకు, వాటి కదలికకు ఉన్న సంబంధాన్ని గమనించండి.",
    "t-5c67e8578836de39": "గణితం",
    "t-c483d2e83e3c6c2c": "పది చొప్పున 100 వరకు లెక్కించడం",
    "t-61268a8bf69a94bc": "స్థాన విలువతో అదే పరిమాణాన్ని తిరిగి సమూహాలుగా చేయండి.",
    "t-624e73f3c497b542": "ఒకట్లు, పదులు, వందలు, వేలు",
    "t-59232a8ca029c131": "సంఖ్యలను క్రమపరచడం, పోల్చడం",
    "t-cb6732cf0398f974": "సంఖ్యారేఖపై స్థానం, దిశ, హద్దుల అర్థాలను పోల్చండి.",
    "t-57b6f15b4f43ed7f": "సంఖ్యలను విడదీయడం, కలపడం",
    "t-ae00c7f024c62e4f": "కూడికతో కలపడం",
    "t-d18b279af014d3d1": "తీసివేతతో తొలగించడం",
    "t-5468d87b3794655b": "ఒకట్లను ఒక పదిగా మార్చడం",
    "t-57b582cd1268322a": "10 ఒకట్లు = 1 పది",
    "t-aac93eddd44d5ea3": "ఒక పదిని ఒకట్లుగా మార్చడం",
    "t-82c4b038b33ae549": "కూడిక, తీసివేత విలోమ క్రియలు",
    "t-4a5c8fe6c8c0b348": "మూడు సంఖ్యలను సులభంగా కూడడం",
    "t-1ccfa54b58a811f5": "తెలియని సంఖ్యను కనుగొనడం",
    "t-675768cf83cb5ebd": "రెండు వైపులా ఒకే మార్పు చేస్తే సమానత్వం నిలుస్తుంది.",
    "t-62fe583b2d62d91b": "రెండు వైపులా −3",
    "t-66fb47410686e310": "రెండు వైపులా ఒకే క్రియ",
    "t-2d8039569ad289c5": "సమాన సమూహాలుగా గుణకారం",
    "t-d3a951a2c0be8ad7": "వస్తువులను సమూహాలుగా చేయండి లేదా పంచండి; ప్రతి సమూహాన్ని మొత్తంతో పోల్చండి.",
    "t-f08906cfdce533ae": "వరుస అమరికలు, గుణకార వాస్తవాలు",
    "t-3972bc6e3ec0f774": "పునరావృత నమూనాలు",
    "t-963fda52101495b1": "ఏది పునరావృతమవుతుందో లేదా స్థిర పరిమాణంతో మారుతుందో కనుగొనండి.",
    "t-ce56f93e6b33bc9f": "నియమాన్ని ఎంచుకుని నమూనాను కొనసాగించండి",
    "t-a770806f03465613": "దీర్ఘఘనాలు, స్థూపాలు, గోళాలు",
    "t-cb742755d61dd692": "ఘనాకారాల్లో ముఖాలు, అంచులు, అడ్డుకోతలు, ఘనపరిమాణాన్ని గమనించండి.",
    "t-aedcca2a7e6244ad": "6 ముఖాలు · 2 వృత్తాలు · 1 వక్ర ఉపరితలం",
    "t-f6491bf48f1634a3": "ప్రమాణ ఘనాల స్థానాలు",
    "t-a6b8d33b36e1ef92": "ఎడమ · కుడి · పైన",
    "t-2a3483d2df91813d": "త్రిభుజాలు, చతుర్భుజాలు, వృత్తాలు",
    "t-68b511fedada6ef9": "భుజాలు, కోణాలు, కర్ణాల మధ్య సంబంధాలను పరిశీలించండి.",
    "t-c2c9333a52ce097b": "3 భుజాలు · 4 భుజాలు · వృత్తం",
    "t-30e484429f51793f": "భుజాలు, శీర్షాల ప్రకారం వర్గీకరించడం",
    "t-dfc071f3fe5f68db": "త్రిభుజం: 3; చతుర్భుజం: 4",
    "t-3199810ce815b58d": "చివరలను సమం చేసి పొడవులను పోల్చడం",
    "t-c281af6c3b33264f": "పొడవు, సామర్థ్యం, ద్రవ్యరాశిని పోల్చడానికి ప్రమాణాన్ని ఎంచుకోండి.",
    "t-f7c98ec9b702b4a6": "సామర్థ్యం, ద్రవ్యరాశి, వైశాల్యాన్ని పోల్చడం",
    "t-6876139fd3aa7b97": "ఒకే రకమైన పరిమాణాలను పోల్చండి",
    "t-d8ce65deefb26221": "గంటల ముల్లు, నిమిషాల ముల్లు",
    "t-3a87ee1ace9f9191": "గడియారంలోని రెండు ముళ్లు కలిసి సమయాన్ని ఎలా చూపుతాయో గమనించండి.",
    "t-81522fd6c9dc9589": "60 నిమిషాలు ఒక గంట",
    "t-4709ae2950b096a8": "రోజులు, వారాలు",
    "t-e8287be1ee253a7c": "కాల ప్రమాణాల మధ్య సంబంధాలను పరిశీలించండి.",
    "t-15afdd2f2548ac82": "24 గంటలు = 1 రోజు; 7 రోజులు = 1 వారం",
    "t-0e5041ec1091e833": "స్కేలుతో పొడవును కొలవడం",
    "t-c546b34b2a5ee42e": "మీటర్లు, సెంటీమీటర్లు",
    "t-c16f7436d8bfdc72": "వేర్వేరు ప్రమాణాల్లో తెలిపినా పరిమాణాన్ని మార్చకండి.",
    "t-4f172a32d18a2251": "అంచనా పొడవు, కొలిచిన పొడవు",
    "t-b3493f6c7d9a0697": "అంచనా వేయి → కొలువు → పోల్చు",
    "t-f370ac671d0da224": "పొడవులను కూడడం, తీసివేయడం",
    "t-4156bb20be2fb116": "ఎంచుకున్న నియమం ప్రకారం వర్గీకరించడం",
    "t-4d94ecfc0573ae63": "ఒకే నియమంతో వస్తువులను వర్గీకరించిన ఫలితాలను పోల్చండి.",
    "t-0daad5f1a4e0c57c": "నీలాకుపచ్చ: 4; బంగారు రంగు: 3",
    "t-54e6b65879a484e5": "వర్గీకరించిన దత్తాంశాన్ని పట్టికలో పెట్టడం",
    "t-160c4ac65e2792b2": "దత్తాంశ విలువలను, స్థానాలను అడ్డు వరుసలు, నిలువు వరుసల్లో అమర్చండి.",
    "t-201c265f2a6dd41a": "ఒక దత్తాంశ అంశానికి ఒక గుర్తు",
    "t-e0add09ecf0f0e78": "అక్షాలు, ప్రమాణాలు, మొత్తాలను తనిఖీ చేసి దత్తాంశ మార్పులను చదవండి.",
    "t-c764ad5b84df2f76": "పది వేలు, అంతకంటే పెద్ద సంఖ్యల్లో స్థాన విలువ",
    "t-5f1de083e83090a9": "అత్యధిక స్థానం నుంచి పెద్ద సంఖ్యలను పోల్చడం",
    "t-c5f954154932c6d2": "మూడు అంకెల సంఖ్యలను కూడడం",
    "t-f6dcd5a7c6358056": "మూడు అంకెల సంఖ్యలను తీసివేయడం",
    "t-f6db586ea591438a": "గుణకారాన్ని వైశాల్యాలుగా విడదీయడం",
    "t-90b8323721188093": "పొడవు, వైశాల్య సంబంధాలను తెలుసుకోవడానికి ఆకారాలను విడదీయండి లేదా తిరిగి అమర్చండి.",
    "t-2c6d4378ce50dedf": "రెండు అంకెల సంఖ్యలను గుణించడం",
    "t-0d1c4557accded2a": "సమానంగా పంచడంగా భాగహారం",
    "t-9922e0b817a15ee3": "గుణకారం, భాగహారం మధ్య సంబంధం",
    "t-11b008f7e3a1d8b6": "భాగఫలాలు, శేషాలు",
    "t-2cc1a4c4c3a0b0de": "రెండు అంకెల సంఖ్యతో భాగించడం",
    "t-a85ebc51d99a0b25": "జవాబు పరిమాణాన్ని తనిఖీ చేయడానికి అంచనా వేయడం",
    "t-162a49a27bb5abd1": "భిన్నాలు: మొత్తాన్ని సమాన భాగాలుగా విభజించడం",
    "t-f422c72d424e1650": "మొత్తాన్ని స్థిరంగా ఉంచి సమాన పరిమాణ భాగాలను పోల్చండి.",
    "t-054ab20202a1daa7": "క్రమ భిన్నాలు, అపక్రమ భిన్నాలు, మిశ్రమ సంఖ్యలు",
    "t-23c2ab8af1b4b3b1": "ఏకాంక భిన్నాలను పోల్చడం",
    "t-ec9d38d4e09d9d58": "సమాన హారాల భిన్నాలను పోల్చడం",
    "t-5704b828de4bf14c": "పదవ వంతులు, దశాంశాలు",
    "t-8d42aa24dc2d7a61": "దశాంశ స్థాన విలువ",
    "t-15a6e102ec809ca5": "దశాంశాలను పోల్చడం",
    "t-e934f9a4da1cff9e": "సమాన హారాల భిన్నాలను కూడడం",
    "t-3e35e16dee647baf": "సమాన హారాల భిన్నాలను తీసివేయడం",
    "t-d4607ba487541632": "దశాంశాలను కూడడం, తీసివేయడం",
    "t-fa6f5a3d076d04e4": "దశాంశ స్థానాలను సరిచేయండి",
    "t-dee04b63c30ae87f": "మారే నమూనాను సమాసంతో చూపడం",
    "t-04e27296e34722d1": "లెక్కల అమరికల్లో నమూనాలు",
    "t-7b4589b06464f111": "సమానం గుర్తు రెండు వైపులా ఒకే విలువ ఉందని తెలుపుతుంది",
    "t-8f075df464800ee2": "సరళరేఖలు, కిరణాలు, రేఖాఖండాలు",
    "t-bf970f17b8959f3e": "బిందువులు, రేఖలు, తలాల స్థానాలను, నిర్మాణ నియమాలను గమనించండి.",
    "t-eb9c8caac70040e7": "సరళరేఖ · కిరణం · రేఖాఖండం",
    "t-38a9c1e721584da2": "సరళరేఖ",
    "t-c04bc270f965db4d": "కిరణం",
    "t-03e71c6d7dc6bd4e": "రేఖాఖండం",
    "t-3bd0a866c4766344": "అల్ప, లంబ, అధిక కోణాలు",
    "t-15358205dd429762": "దిశల మధ్య కోణాలను, స్థిర కోణాల సంబంధాలను పరిశీలించండి.",
    "t-3e81b3b2049af4cb": "లంబ రేఖలు, సమాంతర రేఖలు",
    "t-890b6d8ddc6979a7": "సమాంతరం: ఖండించవు; లంబం: 90°",
    "t-5087b82cb885187d": "ఆకారాన్ని స్థానాంతరం చేయడం",
    "t-45c8c592599bb21b": "రూపాంతరానికి ముందు, తరువాత స్థానం, పొడవు, కోణాలను పోల్చండి.",
    "t-e8a6eb7765f5f3bc": "స్థానాంతరం: అదే ఆకారం, అదే పరిమాణం",
    "t-8ff3a97a9338a6c9": "ఆకారాన్ని ప్రతిబింబించడం",
    "t-e67ae035f1d8b6e7": "ఒక రేఖకు సంబంధించి ప్రతిబింబం",
    "t-f8a846ac368115c8": "ఆకారాన్ని భ్రమణం చేయడం",
    "t-51708830c68582ce": "భ్రమణం: 90°",
    "t-bf206946147fb87f": "స్థానం, దిశతో కదలికను వివరించడం",
    "t-dded0183d111fc62": "నిరూపకాలు లేదా గడులతో స్థానాలను, షరతులను చూపండి.",
    "t-e7ec28ac50748143": "కుడికి 3, పైకి 2",
    "t-914f7067ff1c3401": "వృత్త కేంద్రం, వ్యాసార్థం, వ్యాసం",
    "t-e78ced948049c5f9": "కేంద్రాలు, వ్యాసార్థాలు, చాపాలు, జ్యాల సంబంధాలను పరిశీలించండి.",
    "t-3682af318a9cc53d": "కంపాసుతో వృత్తాన్ని గీయడం",
    "t-6d6184dc5fa62de9": "స్థిర వ్యాసార్థం",
    "t-a0fe2740da7c238e": "సమద్విబాహు, సమబాహు త్రిభుజాలు",
    "t-39eb08e68991b1e5": "సమాన భుజాలు → సమాన భూమి కోణాలు",
    "t-45d3e5c087f5e48f": "సమబాహు త్రిభుజంలోని మూడు కోణాలు",
    "t-0777b41fcf69980b": "కోణాల ప్రకారం త్రిభుజాలను వర్గీకరించడం",
    "t-fa49a865147da2c6": "అల్ప · లంబ · అధిక",
    "t-eb9fb7a0619ad843": "చతుర్భుజాల ధర్మాలు",
    "t-ea5107b52c1de6bd": "దీర్ఘచతురస్రం · చతురస్రం · సమాంతర చతుర్భుజం · సమచతుర్భుజం · విషమ చతుర్భుజం",
    "t-81f59b0dc30f640d": "బహుభుజాలు, క్రమ బహుభుజాలు",
    "t-167a005e9dc684a3": "సమాన భుజాలు, సమాన కోణాలు రెండూ",
    "t-971cd25391c8a5e6": "ఖాళీలు లేకుండా పరచడం",
    "t-3c8e9aa0e69a47da": "ఖాళీలు లేవు · ఒకదానిపై మరొకటి లేవు",
    "t-8c3b0e0a88669b42": "నిమిషాలు, సెకన్లు",
    "t-785503ce32f2d6fa": "కాల వ్యవధులను కూడడం",
    "t-d45b1daa23b010d5": "మిల్లీమీటర్లు, సెంటీమీటర్లు",
    "t-be96e81f2f21607b": "కిలోమీటర్లు, మీటర్లు",
    "t-6f379f140a4a8e83": "లీటర్లు, మిల్లీలీటర్లు",
    "t-0189f028732341d4": "సామర్థ్యాలను కూడడం",
    "t-8d45e745f7ea3d22": "కిలోగ్రాములు, గ్రాములు",
    "t-8b4803574b3ef7cd": "టన్నులు, కిలోగ్రాములు",
    "t-6e1bc372287dba8a": "ద్రవ్యరాశులను కూడడం",
    "t-1d46c6b63e604e6d": "కోణమానితో కోణాలను కొలవడం",
    "t-fcc14b9d992cece5": "త్రిభుజ అంతర కోణాల మొత్తం",
    "t-88d3ac8e46d93178": "చతుర్భుజ అంతర కోణాల మొత్తం",
    "t-eb639465cf5e82fd": "చిత్రలేఖలను చదవడం",
    "t-39a44608fbc0dc79": "కమ్మీ రేఖాచిత్రంలోని ఎత్తులు",
    "t-15f8761e17cebd69": "రేఖా చిత్రంలోని మార్పులు",
    "t-8285b7740d620ff0": "ప్రశ్నకు తగిన రేఖాచిత్రాన్ని ఎంచుకోవడం",
    "t-1b31e5eecbc42b2d": "ఈ పరిచయం ఒక పరిశోధన నిర్మాణాన్ని చూపుతుంది. దీన్ని చూడటం మాత్రమే పరిశోధన చేసినట్లు లేదా పాఠ్య ప్రమాణాన్ని సాధించినట్లు నిరూపించదు.",
    "t-35c4720b8066a753": "ప్రశ్న → దత్తాంశం → రేఖాచిత్రం → వివరణ",
    "t-1c5cb9921cbececa": "ప్రశ్న",
    "t-d2a3e8c8137f0a8a": "సేకరించు",
    "t-217acdbed6242ff0": "విశ్లేషించు",
    "t-b492ea747630a88f": "వివరించు",
    "t-38208ab550a6e09f": "గణిత క్రియల క్రమం",
    "t-531ea2bbb04d24dd": "ఒకే విలువ ఉన్న సమాసాల నిర్మాణాన్ని, గణన దశలను పోల్చండి.",
    "t-f6b47792281a7dd7": "కనీసం, గరిష్ఠంగా, కంటే ఎక్కువ, కంటే తక్కువ",
    "t-858c6ad576158e80": "సవరింపు హద్దులు, అంచనాలు",
    "t-916549ac3fcccc2d": "పైకి, కిందికి సవరించడం",
    "t-08e7a51392edb8b2": "3.2: కింది పూర్ణాంకం 3, పై పూర్ణాంకం 4",
    "t-5212bef4f90ce4f9": "కారణాంకాలు, గరిష్ఠ సామాన్య కారణాంకం",
    "t-f4bb6b28d2193aa3": "సామాన్య కారణాంకాలు లేదా సామాన్య గుణిజాలను కనుగొనండి.",
    "t-1f1be50314fcd1a8": "గుణిజాలు, కనిష్ఠ సామాన్య గుణిజం",
    "t-0d6b0a2b56baa770": "సమాన భిన్నాలు",
    "t-264880e7cdcff6c0": "భిన్నాలను సంక్షిప్తం చేయడం, సామాన్య హారాలను కనుగొనడం",
    "t-85b671d2664738f7": "వేర్వేరు హారాల భిన్నాలను పోల్చడం",
    "t-f8cf9562a8aca339": "వేర్వేరు హారాల భిన్నాలను కూడడం",
    "t-3fefea193682ed51": "వేర్వేరు హారాల భిన్నాలను తీసివేయడం",
    "t-60ae6223eb4ea100": "అతివ్యాప్త వైశాల్యాలతో భిన్నాలను గుణించడం",
    "t-a063cceeb609e18f": "పూర్ణ సంఖ్యల భాగహారం, భిన్నాలు",
    "t-dbbd34176c2fe6b1": "భిన్నంతో భాగించడం: ఎన్ని సరిపోతాయి?",
    "t-835bb98f1a204aa3": "భిన్నాలు, దశాంశాలను అనుసంధానించడం",
    "t-e3aaba9d6000efb3": "దశాంశాలను గుణించడం",
    "t-95600f1de72d7c63": "భాగఫలాన్ని దశాంశంగా చూపడం",
    "t-c88e3c55e2153606": "దశాంశాలను భాగించడం",
    "t-26d30c963b36f04a": "సంకేతాలతో రెండు పరిమాణాల సంబంధాలు",
    "t-853784f547a3f2a8": "ఇన్‌పుట్, రూపాంతరం, అవుట్‌పుట్ క్రమాన్ని, అనురూపతను అనుసరించండి.",
    "t-a59d4d048944439b": "రెండు పరిమాణాల నిష్పత్తి",
    "t-c5e6d54fd71cb965": "రెండు పరిమాణాలను ఒకే గుణకంతో మార్చినప్పుడు ఏది మారదో పరిశీలించండి.",
    "t-9b2bbd2791a34478": "నిష్పత్తులు, దశాంశాలు, శాతాలు",
    "t-eab04b52fbb79e03": "అనుపాతాల ధర్మాలు",
    "t-2a07562763e0be78": "ఇచ్చిన నిష్పత్తిలో పరిమాణాన్ని విభజించడం",
    "t-7f607197829d0955": "సర్వసమత్వం: సరిగ్గా సరిపోయే ఆకారాలు",
    "t-2873a6caa06700ed": "ఒకే ఆకారం, ఒకే పరిమాణం రెండూ",
    "t-69bbce95f6d0c63c": "ప్రతిబింబ సౌష్ఠవం",
    "t-c8289a42382138eb": "అద్ద సౌష్ఠవం",
    "t-c634a0af245ae8bf": "బిందు సౌష్ఠవం",
    "t-751b6c29d485ba07": "180° భ్రమణం",
    "t-94bbbabcbccc7c72": "దీర్ఘఘన ముఖాలు, అంచులు, శీర్షాలు",
    "t-b92f436550a68906": "6 ముఖాలు · 12 అంచులు · 8 శీర్షాలు",
    "t-25453d393787cf05": "దీర్ఘఘన వల",
    "t-5f46f5ad74d42247": "వలలో ప్రతి ముఖాన్ని ఘనంపై దాని స్థానంతో అనుసంధానించండి.",
    "t-bf5f1147e0265a5f": "6 చతురస్రాలు → 1 ఘనం",
    "t-9e511926bd11f347": "పట్టకాలు, పిరమిడ్లు",
    "t-6db7ac17b1665002": "పట్టకం · పిరమిడ్",
    "t-5e76e828cd6959d5": "త్రిభుజాకార పట్టక వల",
    "t-ceafc934151d7665": "2 త్రిభుజాలు + 3 దీర్ఘచతురస్రాలు",
    "t-91feffdbc113a60b": "స్థూపాలు, శంకువులు, గోళాలు",
    "t-d15162227fc69c5c": "స్థూపం · శంకువు · గోళం",
    "t-16dfb54bd9446070": "స్థూప వల",
    "t-cded66bc5ea19cd1": "2 వృత్తాలు + 1 దీర్ఘచతురస్రం",
    "t-1ee4064971e9afae": "ప్రమాణ ఘనాలను లెక్కించడం",
    "t-5b3d9c979c0d8147": "పై నుంచి, ముందు నుంచి, పక్క నుంచి దృశ్యాలు",
    "t-75788894503ab43b": "ఒక ఘనాన్ని వేర్వేరు దిశల నుంచి చూపి పోల్చండి.",
    "t-b03967224037a35f": "పని ప్రదేశ గణితం",
    "t-9fe81b20d14c52de": "సాంకేతిక చిత్రంలో మూడు దృశ్యాలు",
    "t-96eff7919782e87a": "పై · ముందు · పక్క",
    "t-28720365c5e7476a": "పై",
    "t-2d8d693177ac4489": "ముందు",
    "t-ea7bf4bb723041e7": "పక్క",
    "t-de9c81fa3dcc9068": "చుట్టుకొలత: హద్దు వెంట కూడడం",
    "t-8466e3ab01636c3e": "వైశాల్య ప్రమాణాల సంబంధాలు",
    "t-c542b9fdfea85de6": "దీర్ఘచతురస్ర వైశాల్యం",
    "t-f3a84e2573317fee": "సమాంతర చతుర్భుజ వైశాల్యం",
    "t-6305c4c96501b5d8": "త్రిభుజ వైశాల్యం",
    "t-52b56112a2969c64": "విషమ చతుర్భుజ వైశాల్యం",
    "t-862374c7eb71f029": "సమచతుర్భుజ వైశాల్యం",
    "t-2b50917a89d99d90": "వృత్త పరిధికి వ్యాసానికి నిష్పత్తి",
    "t-3bc645a1faef41f9": "వృత్త వైశాల్యం, వ్యాసార్థం",
    "t-e1a0d44043f67b54": "దీర్ఘఘన ఉపరితల వైశాల్యం",
    "t-f6f93bcff0721150": "ఘనపరిమాణ ప్రమాణాల సంబంధాలు",
    "t-985626a07cee9b7d": "దీర్ఘఘన ఘనపరిమాణం",
    "t-0ae36f5d44bf3d52": "సగటు: సమానంగా పంచడం",
    "t-0598d6122ebfdd73": "దత్తాంశ కేంద్రాన్ని, వ్యాప్తిని వేరు చేయండి.",
    "t-c1c40acbed9de079": "2, 4, 6 → సగటు 4",
    "t-6b499d5923e34b49": "విభజిత కమ్మీ చిత్రంలోని నిష్పత్తులు",
    "t-80d251b60bfd0700": "వృత్త చిత్రంలోని నిష్పత్తులు",
    "t-4153439d0058b1a9": "దత్తాంశ సేకరణ నుంచి వివరణ వరకు",
    "t-19e68f1557caa757": "ప్రశ్న → సేకరించు → చిత్రించు → వివరించు",
    "t-9c40a51b0b7e5ea3": "జరిగే అవకాశాలను పోల్చడం",
    "t-22fc39ac83e9c2a3": "అవకాశాలను పోల్చడానికి శాంపిల్ ఆవరణాన్ని, ఘటనలను గుర్తించండి.",
    "t-81cef9182f7f8192": "అవకాశాన్ని సంఖ్యగా చూపడం",
    "t-3111b8ae2f71a3c9": "P(నీలాకుపచ్చ) = 3 / 4",
    "t-fa308ebfcdfd3a5b": "అవకాశాన్ని అంచనా వేయడానికి దత్తాంశాన్ని వాడడం",
    "t-d6826a597764f42f": "గమనించినది 7 / 10 ≠ తదుపరి ఫలితం ఖాయం",
    "t-3501aa9cf1d4905d": "ప్రధాన కారణాంక విభజన: ప్రధాన సంఖ్యల వరకు శాఖలుగా విడదీయడం",
    "t-44c0447fb6f3e29c": "ఎంపికలోని అన్ని శాఖలను మానకుండా లెక్కించండి.",
    "t-8a1e4528f9432749": "ప్రధాన సంఖ్యలతో గరిష్ఠ సామాన్య కారణాంకం కనుగొనడం",
    "t-2c2027a7d70b74f7": "ప్రధాన సంఖ్యలతో కనిష్ఠ సామాన్య గుణిజం కనుగొనడం",
    "t-75fd7ead921e9e48": "ధన సంఖ్యలు, ఋణ సంఖ్యలు, సున్నా",
    "t-91b10edcce44438a": "పూర్ణాంకాలు, పరిమేయ సంఖ్యలు",
    "t-96f45f9f4ee1b018": "మూలకాలు, అంతర్భావం, ఛేదనలను వేరు చేయండి.",
    "t-c1d2ef13845eb291": "పూర్ణాంకాలు ⊂ పరిమేయ సంఖ్యలు",
    "t-f1dd6683235e1aa7": "పూర్ణాంకాలు",
    "t-4556b4421d94b09b": "పరిమేయ సంఖ్యలు",
    "t-8ac9c56ef75f08df": "ఋణ సంఖ్యలను పోల్చడం",
    "t-d1911b604731f033": "ఋణ సంఖ్యకు ధన సంఖ్యను కూడడం",
    "t-ff4a6586a7461043": "ఋణ సంఖ్యను తీసివేసే దిశ",
    "t-d3e100350248c853": "ఋణ సంఖ్యలను గుణించే నియమాలు",
    "t-3f85401a65226892": "పరిమేయ సంఖ్యలను భాగించడం, విలోమాలను వాడడం",
    "t-cf0562cb2df0d4e1": "ఆవర్తన దశాంశాలు, పరిమేయ సంఖ్యలు",
    "t-90fa33589fd0fc97": "వర్గమూలాలు: వైశాల్యం నుంచి భుజం పొడవుకు",
    "t-95b9515ddfa5e6dd": "సంఖ్యారేఖపై అపరిమేయ సంఖ్యలు",
    "t-d39399ded8d21f21": "వాస్తవ సంఖ్యల పరిమాణం, స్థానం",
    "t-53228b65d2a1a6ea": "సజాతి కరణులతో గణన",
    "t-a6ff645d933896bf": "అక్షరాలతో పరిమాణాలను చూపడం",
    "t-bb73ab9f1a95b25a": "సజాతి పదాలను కలపడం",
    "t-d1c5879ac6a19a38": "సమీకరణానికి రెండు వైపులా ఒకే సంఖ్యను కూడడం",
    "t-c94c22cdbe9c4d20": "రేఖీయ సమీకరణాన్ని సాధించడం",
    "t-561184e6e94bf218": "−2, తరువాత ÷2",
    "t-ac0cdfe77c028a17": "క్రమ యుగ్మాలు, నిరూపకాలు",
    "t-f717965d4d3508a4": "(3, 2): ముందు x, తరువాత y",
    "t-96279dcc61da4671": "రేఖాచిత్రంలో పెరుగుదల, తగ్గుదల చదవడం",
    "t-3741b3ecc75ce2a5": "పైకి → కిందికి → పైకి",
    "t-a5429e222c4c0d56": "అనులోమానుపాత రేఖాచిత్రాలు",
    "t-ca87750cd1e2ac86": "రేఖాచిత్రంలోని బిందువులను సమీకరణం తెలిపే సంబంధంతో పోల్చండి.",
    "t-7079524541b19818": "విలోమానుపాత రేఖాచిత్రాలు",
    "t-72925698c8f69769": "ఘాతాంక నియమాలు: పునరావృత గుణకారాన్ని కలపడం",
    "t-5790d614b0e54844": "బహుపదులను కూడడం, తీసివేయడం",
    "t-4aa43ac9e92b880b": "విభాజక నియమం, ఏకపదుల గుణకారం",
    "t-1db5a5081163b34a": "బహుపదిని ఏకపదితో భాగించడం",
    "t-75ccf88f6a2b177f": "అసమీకరణాలు, ఋణ సంఖ్యతో గుణకారం",
    "t-f1fb1b0a1a6b9190": "రేఖీయ అసమీకరణ సాధనలు",
    "t-daac0dd30403173d": "యుగపత్ సమీకరణాల్లో లోపన పద్ధతి",
    "t-dfb78f21cb030ada": "ప్రతి ఇన్‌పుట్‌కు ఒక అవుట్‌పుట్",
    "t-473ff7491987d0b1": "రేఖీయ ప్రమేయ రేఖాచిత్రం",
    "t-d8ac69c08900ca40": "వాలు, అంతఃఖండం",
    "t-71660718d17fdb97": "రేఖీయ సమీకరణాలు, సరళరేఖలు",
    "t-96fadfe22462d384": "ఖండన బిందువులు, యుగపత్ రేఖీయ సమీకరణాలు",
    "t-c0fea3ccc3f69018": "గుణకార సర్వసమీకరణాలకు వైశాల్య నమూనాలు",
    "t-f82b5fbbd4920756": "కారణాంక విభజన: వైశాల్య భుజాలను కనుగొనడం",
    "t-0c97ad21dce29838": "వర్గ సమీకరణంలోని రెండు మూలాలు",
    "t-692163110303c117": "సామాన్య గణితం 1, 2",
    "t-80242088ce5081f5": "ప్రాథమిక గణితం 1, 2",
    "t-af9fe3c875671ec3": "సమీకరణ సాధనలు, రేఖాచిత్ర ఖండనలు",
    "t-179fb3ea9db627dc": "వర్గ ప్రమేయ పరావలయం",
    "t-980de97f88cc1fd5": "వర్గ ప్రమేయ శీర్షం, కనిష్ఠం",
    "t-409d1e17c9f93ce3": "వర్గ ప్రమేయ గరిష్ఠ, కనిష్ఠ విలువలు",
    "t-2808b2249a0116c8": "బిందువులు, రేఖలు, తలాల స్థానాలు",
    "t-36c882706edd70a6": "బిందువు → రేఖ → తలం",
    "t-251fecd592e56e6c": "బిందువు",
    "t-fad900280ce54a04": "తలం",
    "t-685c68d4b736a35f": "సమాంతర రేఖల్లో అనురూప, ఏకాంతర కోణాలు",
    "t-6a343fde38d3a521": "అనురూప కోణాలు: 60° = 60°",
    "t-3361705b5ee706ed": "మూడు భుజాలతో త్రిభుజాన్ని నిర్మించడం",
    "t-d21583aae4e70973": "3, 4, 5 → సర్వసమత్వం వరకు ఒకే త్రిభుజం",
    "t-f3ab1fbbcc3f6ead": "త్రిభుజ సర్వసమత్వ నియమాలు",
    "t-b7c85825780e0e33": "బహుభుజ అంతర కోణాల మొత్తం",
    "t-3f837d7a307d46ff": "వృత్త విభాగ చాపం పొడవు, వైశాల్యం",
    "t-ff5f124c7b1c17a5": "బహుముఖాలు, భ్రమణ ఘనాలు",
    "t-09ebc842614b9fb6": "దీర్ఘచతురస్రం → స్థూపం",
    "t-299bcf54c044b1b5": "భ్రమణం చేయి",
    "t-369e0e1738d302ca": "స్థూప ఉపరితల వైశాల్యం",
    "t-093d2e9d628f1fe8": "శంకు ఘనపరిమాణం",
    "t-2b869a53d2ff73ec": "సమద్విబాహు త్రిభుజ భూమి కోణాలు",
    "t-13d108abf062f87d": "పరివృత్త కేంద్రం: శీర్షాలకు సమాన దూరాలు",
    "t-213f88a1b23cb3c3": "అంతర్వృత్త కేంద్రం: మూడు భుజాలకు సమాన దూరాలు",
    "t-66c676d1297111e6": "ప్రతి భుజానికి దూరం = r",
    "t-71c8c45ee54d7c9c": "సమాంతర చతుర్భుజ కర్ణాలు",
    "t-ea59d9a0fd23a466": "కర్ణాలు ఒకదానినొకటి సమద్విఖండనం చేస్తాయి",
    "t-e833483f52ce1c82": "సారూప్య నిష్పత్తులు, పొడవు, వైశాల్యం",
    "t-84fc0b760c8529ab": "పొడవు ×2 → వైశాల్యం ×4",
    "t-34ab66958e325c34": "త్రిభుజ సారూప్య నియమాలు",
    "t-2e5245048a1dcd76": "AA సారూప్యం",
    "t-3d7d8b957c82d6be": "సమాంతర రేఖలు, రేఖాఖండాల నిష్పత్తులు",
    "t-a0bf8487595291c7": "పైథాగరస్ సిద్ధాంతం",
    "t-25c55d476336b7b9": "త్రికోణమితి నిష్పత్తులు: సమాన కోణాలు, సమాన నిష్పత్తులు",
    "t-a3b1071ff6d65425": "sin θ = ఎదుటి భుజం / కర్ణం",
    "t-4bb1d9fee16a0ad5": "త్రికోణమితి నిష్పత్తులతో ఎత్తును కనుగొనడం",
    "t-ec4ac8b6f6b1d583": "ఎత్తు = దూరం × tan θ",
    "t-518fb0d6666775dd": "జ్యాల లంబ సమద్విఖండనలు",
    "t-77b1461a9707882c": "స్పర్శరేఖలు, వ్యాసార్థాలు",
    "t-26fb3d6f21a8b7a6": "వ్యాసార్థం ⟂ స్పర్శరేఖ",
    "t-5d295dcd9794c84b": "ఒకే చాపంపై వృత్త పరిధి కోణాలు",
    "t-32df77b28a64ae97": "కేంద్ర కోణం = 2 × వృత్త పరిధి కోణం",
    "t-d3101ed8a177c5f4": "మధ్యగతం: క్రమంలో మధ్య విలువ",
    "t-3979b4399729c966": "1, 2, 4, 6, 9 → మధ్యగతం 4",
    "t-46c099f2e5019106": "బాహుళకం: అత్యధికంగా వచ్చే విలువ",
    "t-af0a95ee2bbb2b28": "1, 2, 2, 3, 5 → బాహుళకం 2",
    "t-b78a08914c86042e": "కాండం–ఆకు చిత్రాలు",
    "t-919a11f948095f31": "కాండం",
    "t-5ed0a10b951bfe15": "ఆకులు",
    "t-fe0b9a0c0f71fd91": "పౌనఃపున్య విభాజనాలు, సోపాన చిత్రాలు",
    "t-882ebed1ca3cc8d8": "తరగతులు: [0,2), [2,4), [4,6)",
    "t-ae1a64b89a7eeb48": "మొత్తంలో భాగంగా సాపేక్ష పౌనఃపున్యం",
    "t-48a8b1bfbbbbcf95": "మొత్తం = 10",
    "t-f595987bba47b63f": "సాంఖ్యక పరిశోధనల్లో ప్రశ్నలు, నిర్ధారణలు",
    "t-cd11a18fd3e560ea": "ఆచరణాత్మక సాంఖ్యక శాస్త్రం",
    "t-f5c0d0c7f8981d02": "సాంఖ్యక సమస్య పరిష్కారంలో నాలుగు దశలు",
    "t-4aedf173f9b3fbbb": "ప్రశ్న → సేకరించు → విశ్లేషించు → వివరించు",
    "t-dade68a2e286be97": "ప్రతి అవకాశాన్ని లెక్కించడం",
    "t-cced28c6dc3f99c2": "ప్రారంభం",
    "t-50d04f8ade87c074": "సమాన అవకాశాల ఫలితాలతో సంభావ్యత",
    "t-11096c02efd2f177": "P(సరి సంఖ్య) = 3 / 6 = 1 / 2",
    "t-e58f65ad5352960c": "విచలనం: సగటు చుట్టూ వ్యాప్తి",
    "t-4cac6d57968e23c9": "2,4,6: సగటు 4; విచలనం 8/3",
    "t-06d55fc7c15247a2": "సగటు = 4",
    "t-5c2638f1de1b5f37": "ప్రమాణ విచలనం: విచలన వర్గమూలం",
    "t-f419bb071350e446": "పెట్టె చిత్రాలు, చతుర్థాంశాలు",
    "t-e81d731ebb380b56": "కనిష్ఠం 1; Q1 2; మధ్యగతం 4; Q3 6; గరిష్ఠం 9",
    "t-d12c9937e3eb661d": "విక్షేప చిత్రాలు, సహసంబంధం",
    "t-f7d24c14ba48767a": "సంబంధం ఉండటం కారణత్వాన్ని సూచించదు",
    "t-bf6989bf080fea53": "బహుపదుల కూడిక, తీసివేత, సజాతి పదాలు",
    "t-73eda82b7c4f978b": "బహుపదుల గుణకారం, భాగహారం",
    "t-a8924fee889bb505": "సర్వసమీకరణాలు: ప్రతి విలువకూ సమానం",
    "t-bff39a8b0014ccf6": "ప్రతి వాస్తవ xకు ఒకటే",
    "t-79ccee5c47b4637c": "శేష సిద్ధాంతం",
    "t-78c7d07115a2ceb3": "కారణాంక విభజన, దీర్ఘచతురస్రాలు",
    "t-9e6228a7d38cef36": "సంకీర్ణ సంఖ్యలు: వర్గం ఋణమయ్యే ప్రమాణం",
    "t-82321089f9414628": "దిశ, పరిమాణం, అంశాల మధ్య సంబంధాలను గమనించండి.",
    "t-976a34a089b32ceb": "సంకీర్ణ సంఖ్యల కూడిక, గుణకారం",
    "t-ed9337fa253e2844": "విచక్షణి, వాస్తవ మూలాల సంఖ్య",
    "t-f4b608bd5cb70efa": "D > 0: 2; D = 0: 1; D < 0: 0 వాస్తవ మూలాలు",
    "t-8b0f32dc162b8002": "వర్గ సమీకరణ మూలాలు, గుణకాలు",
    "t-68ecdf05e3e1708e": "మూలాలు: 2, 3",
    "t-322c8eb8ce255fbb": "మొత్తం 5; లబ్ధం 6",
    "t-79a80d252c08e2fd": "పరావలయం, సరళరేఖ కలిసే చోటు",
    "t-8c371d2103ad79e4": "వర్గ ప్రమేయ రేఖాచిత్రం, అక్షం",
    "t-ca7a929521c275a6": "y = x²; అక్షం x = 0",
    "t-198538d20949abd6": "ఘన, చతుర్ఘాత సమీకరణాల కారణాంకాలు",
    "t-f609b4e816e6e29c": "యుగపత్ వర్గ సమీకరణాల ఖండనలు",
    "t-ef9c758bba2e1bf0": "యుగపత్ అసమీకరణాల ఉమ్మడి పరిధి",
    "t-c966d3bf09f4f01d": "x > 1 మరియు x ≤ 4 → 1 < x ≤ 4",
    "t-4265e641c4d18da4": "రేఖీయ అసమీకరణాలు, సంఖ్యారేఖ",
    "t-9558a6b007e0b3af": "నిరపేక్ష విలువ దూరాన్ని తెలుపుతుంది",
    "t-383464b713a71b7a": "వర్గ అసమీకరణాలు, రేఖాచిత్ర చిహ్నం",
    "t-910a90ebb35c16f7": "లెక్కింపులో కూడిక, గుణకార నియమాలు",
    "t-a788247ba5441067": "ప్రస్తారాలు: క్రమం ముఖ్యమైన అమరికలు",
    "t-fe9c0f3990b8630a": "సంయోగాలు: క్రమంతో సంబంధంలేని ఎంపికలు",
    "t-9aea04a58eee26bd": "మాత్రికతో దత్తాంశ స్థానాలను చూపడం",
    "t-9236f598aa2867b6": "అడ్డు, నిలువు వరుసల స్థానాలను, అనురూప మూలకాల గణనను పరిశీలించండి.",
    "t-4dd23636f20cb52d": "aᵢⱼ: అడ్డు వరుస i, నిలువు వరుస j",
    "t-f7dae616f6b7f69b": "మాత్రికలను కూడడం",
    "t-f6a214f7a5fcda0c": "ఫలితం",
    "t-12c1fd46f15c4263": "మాత్రిక గుణకారం: అడ్డు, నిలువు వరుసల కలయిక",
    "t-553df96519d162ca": "ఆర్థిక గణితం",
    "t-e246d863be784cf9": "మాత్రికలతో ఉత్పత్తి పరిమాణాలను లెక్కించడం",
    "t-267ce5b6f61b71e4": "రెండు బిందువుల మధ్య దూరం",
    "t-6bdd086e0c1f58ae": "ఇచ్చిన నిష్పత్తిలో రేఖాఖండాన్ని అంతర్గతంగా విభజించడం",
    "t-c278cf485de307f5": "సరళరేఖ సమీకరణం",
    "t-68145f60b19a8807": "సమాంతర, లంబ రేఖల షరతులు",
    "t-1731fe7a383716a7": "సమాంతరం: m₁=m₂; లంబం: m₁m₂=−1",
    "t-bfb52ef7848ebd2b": "బిందువు నుంచి రేఖకు అతి తక్కువ దూరం",
    "t-b2aa64cc41c49b8f": "లంబ రేఖాఖండమే అతి చిన్నది",
    "t-bcedd635dbf400e6": "అతి చిన్నది",
    "t-a72fe14fc0fa5b49": "వృత్త సమీకరణం",
    "t-68734721d6b15406": "వృత్తం, రేఖ స్థాన సంబంధం",
    "t-739f1d0e52ffab9b": "d < r: 2; d = r: 1; d > r: 0 ఖండనలు",
    "t-66e9b7213aee5953": "నిరూపక తలంలో స్థానాంతరం",
    "t-50b46930ed0c91d0": "అక్షం లేదా మూలబిందువుకు సంబంధించి సౌష్ఠవం",
    "t-ca06028e37a95d82": "y=x రేఖకు సంబంధించి ప్రతిబింబం",
    "t-018e7681c6350b26": "సమితులు, మూలకాలు",
    "t-300890c76bf983c7": "ఉపసమితులు, అంతర్భావం",
    "t-132941db2812bf94": "సమ్మేళనం, ఛేదనం, భేద సమితి",
    "t-b244e794a3f041c4": "అన్నీ, కొన్ని మధ్య తేడా",
    "t-cc945c6642e26b17": "షరతులు, విరుద్ధ ఉదాహరణలు, వ్యతిరేక విలోమాలు, వాదన నిర్మాణాన్ని వేరు చేయండి.",
    "t-186a0048cae8ee41": "అన్ని x: P(x) ≠ కొన్ని x: P(x)",
    "t-bfac2af3beddd7d4": "ఒక విరుద్ధ ఉదాహరణ అన్ని సందర్భాల వాదనను ఖండిస్తుంది",
    "t-405ad069b9c6fe84": "ప్రవచన విలోమం, వ్యతిరేక విలోమం",
    "t-5cc0c49aa158659d": "P⇒Q ↔ Q కాదు⇒P కాదు",
    "t-045e3eadcf97bb78": "Q కాదు",
    "t-c85ebd4ac4889cb2": "P కాదు",
    "t-76aeaf3eed6f2b78": "చాలిన, అవసరమైన షరతులు",
    "t-9aa489632e555f15": "P ⊂ Q → Qకు P చాలిన షరతు",
    "t-130a73365e03b02d": "వ్యతిరేక విలోమం, విరోధ నిరూపణ నిర్మాణం",
    "t-f2b344ab8de0c07f": "ఊహ → విరోధం → ఊహను తిరస్కరించు",
    "t-d73111287d1d04a8": "P కాదు అని అనుకో",
    "t-77850c419156aafd": "విరోధాన్ని సాధించు",
    "t-eac20623287f8468": "అందువల్ల P",
    "t-af78325c4bbf3bed": "సార్వత్రిక అసమీకరణాలు, వర్గాల ఋణేతరత్వం",
    "t-f9ca564a47346765": "ప్రమేయ అనురూపతలు, రేఖాచిత్రాలు",
    "t-ba75417eea07f3d2": "సంయుక్త ప్రమేయం: వరుసగా రెండు యంత్రాలు",
    "t-507fe11cbf3d4c6d": "విలోమ ప్రమేయాలు: అనురూపతను వెనక్కి తిప్పడం",
    "t-20f04e3e4a493483": "పరిమేయ ప్రమేయాలు, అసింప్టోట్లు",
    "t-33f6c645da6cf9eb": "కరణీయ ప్రమేయాలు, వాటి ప్రమేయ క్షేత్రాలు",
    "t-e0dd699e10cb6bd5": "ఘాతాలు, మూలాలు",
    "t-e8ac906efb46e3e1": "బీజగణితం",
    "t-375a1b91a4ae1aa2": "పరిమేయ ఘాతాంకాల అర్థం",
    "t-3ee047ff3cd84fcb": "వాస్తవ ఘాతాంకాల ఘాత నియమాలు",
    "t-1e1a4f7f7b897775": "సంవర్గమానాలు: ఘాతాంకాన్ని కనుగొనడం",
    "t-469a5b552121a1f5": "సంవర్గమానాల ధర్మాలు",
    "t-ef4437904c2364fe": "సామాన్య సంవర్గమానాలు, పరిమాణ స్థాయిల పోలిక",
    "t-85730c0ba74a3aa7": "ఘాతీయ ప్రమేయాల రేఖాచిత్రాలు",
    "t-4b85dfcdb4c366f5": "సంవర్గమాన రేఖాచిత్రాలు, విలోమ సంబంధం",
    "t-8bbdff9a904db666": "ఘాతీయ, రేఖీయ పెరుగుదలను పోల్చడం",
    "t-3f058c5e333c5e0c": "పదాల క్రమం, పెరుగుదల నియమాలు, పాక్షిక మొత్తాలను వేరు చేయండి.",
    "t-453c72ff7ba851c7": "2ⁿతో 1+n పోలిక",
    "t-3de2368d1053a83e": "సాధారణ కోణాలు, రేడియన్ కొలత",
    "t-5f316ce5fcb08bb0": "θ = చాపం పొడవు / వ్యాసార్థం; π rad = 180°",
    "t-67d6b6a71d301b14": "ప్రమాణ వృత్తంపై సైన్, కొసైన్",
    "t-1e01db7bb48551b6": "సైన్, కొసైన్ ప్రమేయాల ఆవర్తనాలు",
    "t-2c771ff0af436fee": "టాంజెంట్ ప్రమేయం, నిర్వచించని స్థానాలు",
    "t-dc33cad417b7e2b2": "సైన్ నియమం",
    "t-2b34191338d4356f": "కొసైన్ నియమం",
    "t-b6288c3ccfd37195": "అనుక్రమాలు: క్రమబద్ధ సంఖ్యల జాబితాలు",
    "t-023b77831bc9e9ec": "అంకశ్రేఢి సామాన్య పదం",
    "t-72d5611f24c26b51": "అంకశ్రేఢి మొత్తం",
    "t-9a2b511aa11248ac": "గుణశ్రేఢి సామాన్య పదం",
    "t-69b2b73e2af20397": "గుణశ్రేఢి మొత్తం",
    "t-e7aaa1912615d631": "సిగ్మా సంజ్ఞ: మొత్తాలను సంక్షిప్తంగా రాయడం",
    "t-af29a62f387e1ed9": "భేదాలతో అనుక్రమ మొత్తాన్ని కనుగొనడం",
    "t-30152289e65aee41": "పక్కపక్క పదాలను రద్దు చేయండి",
    "t-7eac64ea89a1cacb": "అనుక్రమాల పునరావృత్త నిర్వచనాలు",
    "t-0874c299e0ab6ea0": "గణిత ఆగమనంలోని అనుసంధానాలు",
    "t-053070e3580f69cc": "P(1); P(k)⇒P(k+1) → అన్ని n≥1",
    "t-7d4090ba237acdaf": "P(k) అని అనుకో",
    "t-e01a8335c412f784": "P(k+1)ను నిరూపించు",
    "t-7bb753bd2c30c85d": "అన్ని n≥1",
    "t-6eaf10566bd0660e": "ప్రమేయ అవధి: విలువను సమీపించడం",
    "t-1d5cbe37286f7d0f": "మార్పు రేటు, సంచిత పరిమాణాల సంబంధాన్ని దృశ్యంగా పరిశీలించండి. పూర్తి నిరూపణకు మరింత అధ్యయనం అవసరం.",
    "t-e69a276a252877ea": "కలన గణితంⅠ",
    "t-af916d550e4f5b64": "రద్దు చేయడం ద్వారా అవధులను గణించడం",
    "t-3c33156e62c2f263": "(x²−1)/(x−1)=x+1, x≠1 అయితే; అవధి=2",
    "t-6b27327403e8123c": "x+1, x≠1 అయితే",
    "t-857a241549bca31c": "1 వద్ద అవధి = 2",
    "t-b0f8b48e77f77379": "అవిచ్ఛిన్నత: అవధి, ప్రమేయ విలువ ఒకటవడం",
    "t-921b544e77471d88": "మధ్యంతర విలువ సిద్ధాంతంపై అవగాహన",
    "t-e3abdcbe8e71ae94": "అవిచ్ఛిన్న వక్రం ప్రతి మధ్యంతర ఎత్తును దాటుతుంది",
    "t-5f2eee48892c267f": "ఛేదక రేఖల అవధిగా అవకలనం",
    "t-28e790ac0150b827": "అవిచ్ఛిన్న ప్రమేయం అవకలనీయంగా ఉండకపోవచ్చు",
    "t-ccb56abb31b8a9d4": "f(x)=abs(x): అవిచ్ఛిన్నం, 0 వద్ద అవకలనీయంకాదు",
    "t-29f3b9a58634e0db": "ఘాత ప్రమేయాల అవకలనాలు",
    "t-f1a93f14774e2e25": "మొత్తం, భేదం, లబ్ధాన్ని అవకలనం చేయడం",
    "t-2acb938aad09310e": "స్పర్శరేఖ సమీకరణం",
    "t-13b8cd3215301150": "మధ్యమ విలువ సిద్ధాంతం: ఛేదకానికి సమాంతర స్పర్శరేఖ",
    "t-deb0864b966a82d1": "అవకలన చిహ్నం, పెరిగే లేదా తగ్గే ప్రమేయాలు",
    "t-6ef37a57047c3694": "అవకలనాలతో రేఖాచిత్ర స్వరూపాన్ని తెలుసుకోవడం",
    "t-a84dc4b550503bb2": "f′ చిహ్నం: +, −, +",
    "t-a70b6eeaef9780f6": "అవకలనాలతో అసమీకరణ కనిష్ఠాన్ని కనుగొనడం",
    "t-3f466b118d99c455": "స్థానం, వేగం, త్వరణం",
    "t-72e08a0c04dae459": "ప్రతి అవకలనాలు: ఒకే అవకలనం గల కుటుంబం",
    "t-0f4eab376b33a3e4": "బహుపది ప్రమేయాలను సమాకలనం చేయడం",
    "t-da14478f4f8ca5e0": "నిశ్చిత సమాకలనాలు: చిహ్నం గల వైశాల్యం",
    "t-42c504fc40818f53": "కలన గణిత మౌలిక సిద్ధాంతం",
    "t-cb1cb5ee00d2e584": "రెండు వక్రాల మధ్య వైశాల్యం",
    "t-cd5378d758dbed07": "కలన గణితంⅡ",
    "t-e7131a64206e462f": "వక్రాల మధ్య వైశాల్యాన్ని సమాకలనం చేయడం",
    "t-e14b3a96f4e4b0db": "వేగ రేఖాచిత్రం, ప్రయాణించిన దూరం",
    "t-f7197e660b65943b": "పునరావృత ప్రస్తారాలు: ప్రతిసారీ మళ్లీ ఎంచుకోవడం",
    "t-582ec33ac5f979e1": "సంభావ్యత, సాంఖ్యక శాస్త్రం",
    "t-09a0e1a2c8fea255": "పునరావృత వస్తువుల ప్రస్తారాలు",
    "t-db04cfaae51882ff": "పునరావృత సంయోగాలు: విభాజకాలతో లెక్కించడం",
    "t-3709b420addc3d03": "ద్విపద సిద్ధాంతం, పాస్కల్ త్రిభుజం",
    "t-1d5fe4ed411fa63e": "శాంపిల్ ఆవరణాలు, ఘటనలు",
    "t-ee8c002dcd5dded6": "P(సరి సంఖ్య)=3/6",
    "t-824977e72937217d": "సంభావ్యత సంకలన నియమం",
    "t-bd83e4f4fa29c934": "పూరక ఘటన సంభావ్యత",
    "t-90d758a6ec843372": "సాపేక్ష సంభావ్యత: శాంపిల్ ఆవరణాన్ని తగ్గించడం",
    "t-e3efa9e7c35bfddc": "P(సరి సంఖ్య | >3)=2/3",
    "t-c1d4bcf1f8487fc2": "స్వతంత్రత, పరాధీనత",
    "t-e6adc6484a273761": "స్వతంత్రం: P(A∩B)=P(A)P(B)",
    "t-a2f6af5a8dc849c5": "సంభావ్యత గుణకార నియమం",
    "t-314396a9e3bc5f23": "P(A∩B)=P(A)P(B | A)",
    "t-246067e72984a1ed": "యాదృచ్ఛిక చలరాశులు, సంభావ్యత విభాజనాలు",
    "t-5145361d02865689": "సంభావ్యత విభాజనాలను, అంచనాలో అనిశ్చితిని పోల్చండి.",
    "t-6ea5dcfeb359319d": "ఆశించిన విలువ: సంభావ్యతలతో భారిత సగటు",
    "t-c645618d58147c78": "యాదృచ్ఛిక చలరాశి విచలనం, ప్రమాణ విచలనం",
    "t-d7ffb5f7e3f70142": "ద్విపద విభాజనం",
    "t-7627f59417d01367": "సాధారణ విభాజనం, ప్రమాణీకరణ",
    "t-767e873767ebd4fb": "ద్విపద విభాజనం, సాధారణ సన్నికటం",
    "t-244848ff4ac852c1": "B(n,1/2): పెద్ద n → గంట ఆకారం",
    "t-ef6c15b17c6b001e": "జనాభా నుంచి నమూనా తీసుకోవడం",
    "t-b7bc036c7b0f1e08": "జనాభాను, నమూనాలను వేరు చేసి నమూనా పద్ధతుల ప్రభావాన్ని పరిశీలించండి.",
    "t-8772d5cceda0e77b": "జనాభా → యాదృచ్ఛిక నమూనా",
    "t-4f9edc4d3ed0a0e5": "జనాభా",
    "t-af2bdbe1aa9b6ec1": "నమూనా",
    "t-bf2b84d832101ee7": "నమూనా సగటు, జనాభా సగటు",
    "t-c35835fee8a44989": "నమూనా నిష్పత్తి, జనాభా నిష్పత్తి",
    "t-2ef81624b9397db8": "p̂ = విజయాలు / n",
    "t-fee64e369f05068b": "జనాభా సగటుకు విశ్వాస అంతరాలు",
    "t-5062dc746b61b05d": "అంచనా ± దోష పరిమితి",
    "t-57da6bbaa98b54d2": "జనాభా నిష్పత్తి అంచనాలో అనిశ్చితి",
    "t-26c6dbdd824917fa": "పెద్ద n → తక్కువ నమూనా అనిశ్చితి",
    "t-0be5bda1d37bb3b4": "అనుక్రమాల అభిసరణం, అపసరణం",
    "t-4149f951b8413b5b": "అవధి 0",
    "t-1f5f143e5b7cdf2b": "అనుక్రమ అవధుల ధర్మాలు",
    "t-411442b772244dcb": "గుణశ్రేఢి ఎప్పుడు అభిసరిస్తుంది",
    "t-a170995309852bc9": "పాక్షిక మొత్తాల అవధిగా శ్రేణి",
    "t-e0ff8bb1db0e48aa": "అవధి 1",
    "t-d475f5f6ffec5811": "గుణ శ్రేణి మొత్తం",
    "t-b92de46e51d9dbea": "ఘాతీయ ప్రమేయాలను అవకలనం చేయడం",
    "t-3cc6e0d0ba500e7d": "సంవర్గమాన ప్రమేయాలను అవకలనం చేయడం",
    "t-bd91ee3785d1e619": "త్రికోణమితి సంకలన సూత్రాలు",
    "t-e84dd8aaede0430d": "సైన్ ప్రమేయ అవధి",
    "t-9921976af53969b7": "lim(x→0) sin x / x = 1; x రేడియన్లలో",
    "t-6fbeb7eeb609b2c6": "సైన్, కొసైన్ అవకలనం",
    "t-9df453368002d22c": "భాగఫల నియమం",
    "t-63abf2e82f561a1a": "శృంఖలా నియమం",
    "t-4ba3e8e3765f2970": "వర్గం",
    "t-3256881542d221f4": "పరామితీయ వక్రాలను అవకలనం చేయడం",
    "t-5ac6d4be2abb6d72": "అవ్యక్త అవకలనం",
    "t-c7f67ec53440de2f": "విలోమ ప్రమేయాన్ని అవకలనం చేయడం",
    "t-e9a68896ee15d99a": "సాధారణ వక్రాల స్పర్శరేఖలు",
    "t-40416cfa90872850": "0 వద్ద y=sin x → స్పర్శరేఖ y=x",
    "t-1471570c0f08877a": "రెండవ అవకలనాలు, వక్రత",
    "t-8c5904729d16852d": "f=x³; f″=6x; 0 వద్ద వక్రత మార్పు",
    "t-ac0de37f797c553b": "అవకలనాలతో ప్రమేయాలను పోల్చడం",
    "t-aeadf0c176617010": "తల చలనంలో వేగ సదిశలు",
    "t-894b750b0fe86bde": "ఘాతీయ, త్రికోణమితి ప్రమేయాలను సమాకలనం చేయడం",
    "t-9b0986be95d00b40": "eˣ, cos x",
    "t-ad9b338ab555c072": "సమాకలనం చేయి",
    "t-8210933840ecba15": "eˣ+C, sin x+C",
    "t-d43a9f055f58b0ef": "ప్రతిక్షేపణ సమాకలనం: చలరాశులను మార్చడం",
    "t-8e2d73cb65036734": "u పరంగా సమాకలనం చేయి",
    "t-a963eeb151659544": "భాగాల వారీ సమాకలనం: లబ్ధ నియమాన్ని వెనక్కి తిప్పడం",
    "t-f147ac02f7b0c673": "నిశ్చిత సమాకలనాలు, రీమన్ మొత్తాలు",
    "t-7096301428e928d7": "[0,1]పై y=x కుడి మొత్తాలు → 1/2",
    "t-8096e47380c29d28": "అడ్డుకోతల నుంచి ఘనపరిమాణాన్ని నిర్మించడం",
    "t-1e1559deda8567f4": "వడిని సమాకలనం చేసి దూరం కనుగొనడం",
    "t-639f9095fffcc6db": "దూరం=∫abs(v(t))dt; స్థానభ్రంశం=∫v(t)dt",
    "t-5d5b8eba2b160ff7": "పరావలయాలు: నాభికి, నియతరేఖకు సమాన దూరాలు",
    "t-7584b1ba27810b0a": "వక్రాన్ని దాని బిందువులు తృప్తిపరిచే దూర నిబంధనతో అనుసంధానించండి.",
    "t-a50e51d66fc43721": "జ్యామితి",
    "t-0079bc9f2bc03c8d": "దూరం(P,F)=దూరం(P,నియతరేఖ)",
    "t-0073bc8467c3c47b": "దీర్ఘవృత్తాలు: రెండు నాభుల నుంచి దూరాల మొత్తం స్థిరం",
    "t-5edb0981a8dd7f5a": "అతిపరావలయాలు: రెండు నాభుల నుంచి దూరాల భేదం స్థిరం",
    "t-77b16bc5e7e4046a": "శాంకవాల స్పర్శరేఖలు",
    "t-7f8d95f3899c1d53": "దీర్ఘవృత్తం x²/9+y²/4=1 వద్ద (3,0): x=3",
    "t-65fce4bcb1997a16": "అంతరాళంలో రేఖలు, తలాలు",
    "t-e1900e7cf0ac585d": "సమాంతర · ఖండించే · విషమ రేఖలు",
    "t-c1a388c2d31be5a5": "మూడు లంబాల సిద్ధాంత నిర్మాణం",
    "t-c0fe0321e479d5a4": "AO ⟂ తలం; OP ⟂ రేఖ → AP ⟂ రేఖ",
    "t-774e2bdf29f88780": "లంబ ప్రక్షేపణం, వైశాల్య మార్పులు",
    "t-161ff9890f59faf6": "ప్రక్షేప వైశాల్యం = వైశాల్యం × abs(cos θ)",
    "t-d3af3ffddae68fd0": "అంతరాళ నిరూపకాలు, బిందువుల మధ్య దూరం",
    "t-80470ed8bbe92a27": "దూరం = √(Δx²+Δy²+Δz²)",
    "t-147c3fac276d96a2": "అంతరాళంలో రేఖాఖండ అంతర్విభజన",
    "t-88cc9f282fa59acf": "AP:PB=1:2 అయితే P=(2A+B)/3",
    "t-86268171bd5a4b52": "గోళ సమీకరణం",
    "t-fb7b3b7d814b4671": "సదిశలను కూడడం, తీసివేయడం",
    "t-3501187294f06dea": "సదిశను అదిశతో గుణించడం",
    "t-91828df9a8d4b0d2": "స్థాన సదిశలు, నిరూపకాలు",
    "t-722e52c6df3d5243": "అదిశ లబ్ధం, సదిశల మధ్య కోణం",
    "t-c38be17b671d8e06": "సదిశలతో రేఖలను చూపడం",
    "t-7bb964a600ba0517": "తలానికి అభిలంబ సదిశలు",
    "t-8107368ac8846d11": "సదిశలతో గోళాలను చూపడం",
    "t-e0876667a4d0b8dc": "ఆర్థిక సూచికలు: ఆధార విలువలు, మార్పు రేట్లు",
    "t-3a1d8e3f5ae06450": "మారక రేట్లు, కరెన్సీ మార్పిడి",
    "t-2679940f11a10b02": "ఉదాహరణ విలువలతో నిష్పత్తులు, కాలం, ప్రమాణ ఖర్చులను పోల్చండి. ఇవి వాస్తవ ఆర్థిక నిబంధనలు లేదా అంచనాలు కావు.",
    "t-80acd79e408e519d": "ఊహాత్మక రేటు: 1 A = 2 B; 3 A = 6 B",
    "t-93c854ad9e7857ab": "పన్ను రేట్లు, పన్నులు",
    "t-2c68e9fee278879f": "ఆధారం 100 × రేటు 0.1 = పన్ను 10",
    "t-49ffc9a7498d5b2c": "సాధారణ, చక్రవడ్డిని పోల్చడం",
    "t-a9e8a174c31d15cb": "సాధారణ: 100(1+0.1n); చక్రవడ్డీ: 100(1.1)ⁿ",
    "t-a7a39b72f29718e6": "సాధారణ వడ్డీ",
    "t-ee0df97cece494b1": "చక్రవడ్డీ",
    "t-0b3b5b380cd883cb": "ప్రస్తుత విలువ, భవిష్యత్ విలువ",
    "t-70539435389f790b": "భవిష్యత్ చెల్లింపులు → తగ్గించిన విలువలు",
    "t-4ce927fbe6583a6f": "వార్షిక చెల్లింపుల ప్రస్తుత విలువ",
    "t-d425a3fb61984949": "ఖర్చు, రాబడి, లాభ ప్రమేయాలు",
    "t-3e27b14abf09b8e0": "R=3q; C=q+4; లాభం=2q−4",
    "t-91464c465e9be4db": "సరఫరా, డిమాండ్ వక్రాలు",
    "t-2a2e0512b3bd6cd7": "ప్రయోజనం, ఉపాంత ప్రయోజనం",
    "t-d948b89b4e468bc1": "U(q)=√q; ఉపాంత ప్రయోజనం తగ్గుతుంది",
    "t-411ccc296ad368ce": "సమతుల్య ధరలు, ఖండనలు",
    "t-db9e4674b652dcc7": "పన్ను సరఫరా వక్రాన్ని మార్చే విధానం",
    "t-34d33c8d55ff8e9b": "సరఫరా p=q+2 → p=q+3",
    "t-46189fcdf9cbf1fd": "అసమీకరణ ప్రాంతాలు, పరిమితులు",
    "t-948b7d5e1bf62ef6": "మాత్రికలతో ఆర్థిక దత్తాంశాన్ని చూపడం",
    "t-a687cfd2657762db": "అడ్డు వరుసలు: ఉత్పత్తులు; నిలువు వరుసలు: కాలాలు",
    "t-f4fab56feb1c568b": "విలోమ మాత్రికలు: రూపాంతరాన్ని వెనక్కి తిప్పడం",
    "t-d47f0db84f50ce94": "ఆర్థిక ప్రమేయాలను అవకలనం చేయడం",
    "t-dfafe14f30d923a3": "ఉపాంత మార్పులు, రేఖాచిత్రాలు",
    "t-f191b3c9d9b07f25": "ధన వాలు → పెరుగుదల",
    "t-40528f33c3dd8d96": "వ్యాకోచత్వం: సాపేక్ష మార్పుల నిష్పత్తి",
    "t-ec0449b9930fe222": "లాభాన్ని అనుకూలీకరించడం",
    "t-5f9e7597b6bcdbb7": "π(q)=−q²+4q; q=2 వద్ద గరిష్ఠం",
    "t-06e20ec26ce3a2a9": "ఉదాహరణలు, దోషాలతో కృత్రిమ మేధను నేర్చుకోవడం",
    "t-4277741dfa4b3c05": "కృత్రిమ మేధ కోసం గణితం",
    "t-7e0753725b5ff55a": "దత్తాంశం → అంచనా → దోషం → నవీకరణ",
    "t-c97c29c7a71b392b": "దత్తాంశం",
    "t-f9448742690600c9": "అంచనా వేయి",
    "t-d98ee0e5f9399db9": "దోషం",
    "t-6cb78ab1c6bdad28": "నవీకరించు",
    "t-adaacd54ee777f5b": "వర్గీకరణ నమూనాల వెనుక గణిత భావనలు",
    "t-b3b9e4ddf77dbbe2": "లక్షణాలు → హద్దు → వర్గీకరణ",
    "t-a764e16e7ac031f3": "భారీ దత్తాంశం, వైవిధ్య దత్తాంశ సమితులు",
    "t-80e0aa92910abac7": "పరిమాణం · వైవిధ్యం · వేగం",
    "t-f9b489fa6c4ac87b": "పరిమాణం",
    "t-87f9dc1335bfc962": "వైవిధ్యం",
    "t-b64b06c89e520988": "వేగం",
    "t-b7820e69e1518cc7": "నాణ్యతను తనిఖీ చేయి",
    "t-e30748e52d51e053": "సమితులు, సదిశలతో పాఠ్యాన్ని చూపడం",
    "t-52965309b7a639fc": "v=(A లెక్క, B లెక్క, C లెక్క)",
    "t-84ec6d616289521a": "పౌనఃపున్య సదిశలతో సంక్షిప్తీకరించడం",
    "t-7b165606ab9dc801": "పాఠ్య సదిశల మధ్య సారూప్యత",
    "t-df8b07db74390847": "చిత్రాలను పిక్సెల్ మాత్రికలుగా చూపడం",
    "t-b0296bc771c3f66c": "పిక్సెల్ తీవ్రత: 0…255",
    "t-35faf6f563bbf798": "పిక్సెల్ మాత్రిక",
    "t-0d1cc5e23528cd26": "మాత్రిక క్రియలతో ప్రకాశాన్ని మార్చడం",
    "t-a3600903f1ed6970": "చిత్ర లక్షణాలు, వర్గీకరణ",
    "t-3ce7d6451a6253bd": "పిక్సెల్లు → లక్షణాలు → వర్గం",
    "t-f96be8984050474f": "గమనించిన పౌనఃపున్యాలు, అంచనా సంభావ్యతలు",
    "t-b658146e330a90c3": "గమనించిన పౌనఃపున్యం ≠ నిశ్చితత్వం",
    "t-ac767c278a3813c4": "దత్తాంశ ధోరణి రేఖలు",
    "t-2ead3ad82a978193": "అంచనా y = ax+b",
    "t-614b884b81b1b356": "నష్ట ప్రమేయాలు: దోషాన్ని కొలవడం",
    "t-e0627db9e30c0e0f": "ప్రవణత అవరోహణం: నష్టాన్ని తగ్గించే దిశగా కదలడం",
    "t-19dd3defc3f6dcd5": "అంచనాలను నిర్ణయాలతో కలపడం",
    "t-d9bb95817317344e": "అంచనా → పరిమితి → నిర్ణయం → తనిఖీ",
    "t-d0b1a869600d2107": "ఎంపికలు",
    "t-7ceec0f95c2109fe": "పరిమితులు",
    "t-0eca21d7a66f55f2": "పోల్చు",
    "t-188a5356a091db74": "ధృవీకరించు",
    "t-c8f533fdaf6fa820": "కృత్రిమ మేధ గణిత పరిశోధనను ప్రణాళిక చేయడం",
    "t-10f9b40b7cff1066": "ప్రశ్న → దత్తాంశం → నమూనా → మూల్యాంకనం",
    "t-07a90324a7d3ead1": "ఊహించు",
    "t-94ee059335e587e5": "పరీక్షించు",
    "t-e5de447a88a90bc4": "సవరించు",
    "t-969b4a92fc30c776": "పని పరిమాణాలు, అంకగణితం",
    "t-1ddba48a07c5b588": "4 భాగాలు × 3 పెట్టెలు = 12 భాగాలు",
    "t-3a953afb965e807f": "పనిభారాన్ని అంచనా వేయడం, దోషాన్ని తనిఖీ చేయడం",
    "t-5995bb1dee8b235e": "పని ప్రదేశ ప్రమాణాలను మార్చడం",
    "t-a527e539e3d0fccb": "మిశ్రమ నిష్పత్తులు",
    "t-e683ced60fd8d500": "లోపాల రేట్లను శాతాలుగా చూపడం",
    "t-86c5301d5fc5641e": "పని సమయానికి, ఉత్పత్తికి సంబంధం",
    "t-03b7bce95730efd0": "పెరుగుదల, తగ్గుదల, చక్రాల రేఖాచిత్రాలు",
    "t-e1c732fca7bdc887": "ఆవర్తన మార్పు పునరావృతమవుతుంది",
    "t-aac8482b9fabf070": "బడ్జెట్ పరిమితులను అసమీకరణాలుగా చూపడం",
    "t-653c9efcd77cab3c": "ప్యాకింగ్ పెట్టె వల",
    "t-163dd18569b2759c": "ఆరు ముఖాలను మడిచి ఒక పెట్టెగా చేయండి",
    "t-ea5acd2e977fc530": "స్కేలు చిత్రాలు, సారూప్య నిష్పత్తులు",
    "t-f296ab4f7c68ae41": "పొడవు ×2; వైశాల్యం ×4",
    "t-c550a4388ab97811": "పదార్థాల చుట్టుకొలత, వైశాల్యం",
    "t-08fc252d34d22d8b": "4×3=12; చుట్టుకొలత=14",
    "t-018f9034306b8a8d": "ప్యాకింగ్ పదార్థం, పెట్టె సామర్థ్యం",
    "t-4206f6b464179236": "4×3×2 = 24 ఘన ప్రమాణాలు",
    "t-80faf425566e6d22": "సాధ్యమైన పని మార్గాలను లెక్కించడం",
    "t-8eb4660f96309dc5": "2 ఎంపికలు × 3 ఎంపికలు = 6",
    "t-f485c9c3dac4fb21": "అవకాశాన్ని నిష్పత్తిగా చూపడం",
    "t-d020b50e13bf4bc3": "ఈ నమూనాలో P(A)=3/4",
    "t-bb40baeab8904e7d": "పని ప్రదేశ దత్తాంశ పట్టికలు, రేఖాచిత్రాలు",
    "t-6d6c35c47aed0df1": "రేఖాచిత్ర అక్షాలు, ప్రమాణాలను తనిఖీ చేయడం",
    "t-2e3a349a2aebc225": "ఆధార రేఖను, స్కేలును తనిఖీ చేయండి",
    "t-8ba8496a2525ae17": "ఆధార రేఖ",
    "t-458d5690a7dcede8": "దత్తాంశంతో ప్రత్యామ్నాయాలను పోల్చడం",
    "t-a651d5060b99f42c": "పోల్చు → ఎంచుకో → ధృవీకరించు",
    "t-73ee7e5dbf8e4866": "సంగీతంలో ఆవర్తనాలు, కంపనాలు",
    "t-0235601ed43f7e32": "గణితం, సంస్కృతి",
    "t-3c9674b0a871c633": "y=sin x; ఒక ఆవర్తనం = 2π",
    "t-4bffaa5d66dd039f": "కళలో సౌష్ఠవం, పునరావృతం",
    "t-8ffd36f68b6b62e5": "స్థానాంతరం + ప్రతిబింబం",
    "t-9f68ef128fc59ef9": "సాహిత్యంలో సంయోగాలు, అమరికలు",
    "t-2437c439777eb4e7": "2 ఎంపికలు × 2 ఎంపికలు = 4 రూపాలు",
    "t-da58805c15213000": "సినిమా చిత్రాల్లో విస్తరణ, సారూప్యం",
    "t-a8e2e5508b41bfb7": "ఏకరీతి స్కేలింగ్‌లో అదే దృశ్య నిష్పత్తి",
    "t-6738b58281891e99": "క్రీడల్లో పరావలయ నమూనాలు",
    "t-e8379bafd6f54126": "y=−(x−2)²+4; సరళీకృత నమూనా",
    "t-8e2d028ce1252643": "ఆటల్లో న్యాయం, ఆశించిన విలువ",
    "t-02b61eb461cb0d63": "న్యాయమైన ఆట: ఆశించిన నికర లాభం = 0",
    "t-63208b854871ab5e": "డిజిటల్ సమాచారం, ద్విమాన సంఖ్యలు",
    "t-84b5e87d09481247": "ఓటింగ్ నియమాలు ఫలితాన్ని మార్చే విధానం",
    "t-58095865e79cd45a": "అత్యధిక ఓట్ల నియమం, జంటల పోలిక నియమం వేరవవచ్చు",
    "t-83df1774327a29fa": "ఓటర్లు",
    "t-ee6fb3167b02cd70": "ర్యాంకులు",
    "t-48aac060a2f747ef": "వాస్తు నమూనాల్లో సౌష్ఠవం, గణితం",
    "t-1219810454a05603": "పునరావృతం చేయి · ప్రతిబింబించు · తిప్పు",
    "t-7bb1dd94f438832a": "ఆరు బ్రెయిలీ చుక్కల సంయోగాలు",
    "t-c194045bc71d413e": "ఖాళీతో సహా 2⁶ = 64 నమూనాలు",
    "t-9431151b6cf0db2e": "6 స్థానాలు, ఒక్కొక్కటికి 2 స్థితులు",
    "t-32d90b05f2623aec": "మీడియా రేఖాచిత్రాల్లో అక్షాలను తనిఖీ చేయడం",
    "t-7caea51f786a8934": "అదే దత్తాంశం, వేర్వేరు అక్ష పరిధులు",
    "t-2024ec15b6d31c7f": "బాధ్యతాయుత వినియోగం: ప్రమాణ ఖర్చులను పోల్చడం",
    "t-1b2c43604b558aaa": "ఆహార దత్తాంశ నిష్పత్తులను విశ్లేషించడం",
    "t-62674d056365d821": "ఉదాహరణ వాటాలు: 25%,50%,25%",
    "t-1a5903060d2658ac": "గాలి నాణ్యత దత్తాంశ మార్పులను చదవడం",
    "t-f7ad5e19df5bc623": "ఉదాహరణ దత్తాంశం; నిజమైన గాలి నాణ్యత కొలతలు కావు",
    "t-e6d49a050b95e81c": "ఎడారీకరణ దత్తాంశంలో వైశాల్య నిష్పత్తులు",
    "t-7439bcd7e5cb36e3": "4 / 16 = 25%; వివరణాత్మక నమూనా",
    "t-7db42222960b41a8": "జాతుల విస్తరణలను పోల్చడం",
    "t-f4cb687db2f7b367": "అదే మొత్తం, వేర్వేరు వర్గ విభాజనాలు",
    "t-0f484924559fb7fd": "సాంఖ్యక శాస్త్రం: వ్యక్తిగత విలువల నుంచి మొత్తం నమూనాలకు",
    "t-06d6a615f5f8225d": "నమూనా → సారాంశం → అనిశ్చితి",
    "t-60fadc204183d7a8": "యాదృచ్ఛిక, పక్షపాత నమూనాలు",
    "t-d5725ce298253c2e": "ప్రాతినిధ్యం ముఖ్యం",
    "t-b50ebfa2d9e63071": "వర్గ దత్తాంశం, సంఖ్యా దత్తాంశం",
    "t-cc8141e59a3002f3": "వర్గం ≠ సంఖ్యా కొలత",
    "t-cf8432ea13ddcf77": "పరిశీలన, సర్వేలు, ప్రయోగాలు",
    "t-8eac8294a3566bdb": "గమనించు · సర్వే చేయి · ప్రయోగించు",
    "t-48dc0f9f94dc6184": "గమనించు",
    "t-c68e86d51238ff1b": "సర్వే",
    "t-11431be2501788c8": "ప్రయోగం",
    "t-b949f306936a8aa3": "దత్తాంశానికి తగిన రేఖాచిత్రాలను ఎంచుకోవడం",
    "t-f9178546e69b7923": "వర్గం → కమ్మీ; సమయం → రేఖ",
    "t-7ece4496f7f20bcd": "కేంద్రం, వ్యాప్తిని కలిపి పరిగణించడం",
    "t-50e905ef9cf22fa7": "అదే సగటు, వేర్వేరు వ్యాప్తి",
    "t-bce5238803a540f8": "సాధారణ, t విభాజనాల తోకలు",
    "t-6e248857052a1a07": "t(df=3)కు సాధారణ విభాజనం కంటే భారమైన తోకలు ఉన్నాయి",
    "t-4247e8bf5e437057": "జనాభా సగటు అంతర అంచనా",
    "t-721ecdc7df0bf789": "అంచనా ± పరిమితి; పద్ధతికి ఆవరించే రేటు ఉంది",
    "t-d91ca33eb1a62ef9": "జనాభా నిష్పత్తి అంతర అంచనా",
    "t-d9e8f61998fecbe8": "నమూనా నిష్పత్తి ± దోష పరిమితి",
    "t-d452ed0c3d72303c": "పరికల్పన పరీక్ష: శూన్య పరికల్పన, అరుదైన ఫలితాలు",
    "t-b0680cc97e37b856": "p-విలువ ≠ శూన్య పరికల్పన నిజమయ్యే సంభావ్యత",
    "t-396bd658dbe8e2b8": "తోక వైశాల్యం",
    "t-4f0ce5b6718ace71": "సాంఖ్యక పరిశోధనలతో నిర్ణయించడం",
    "t-07f4e2ce4fd9da7f": "ప్రశ్న → దత్తాంశం → విశ్లేషణ → పరిమితులతో నిర్ధారణ",
    "t-a4a773262946811a": "సాంఖ్యక నిర్ధారణల పరిమితులను సమీక్షించడం",
    "t-6baac975cf06d413": "పక్షపాతమా? అనిశ్చితా? ప్రత్యామ్నాయ వివరణా?",
    "t-a67d2a6c9087c1bc": "ఫలితం",
    "t-bc92d2d73fd8cc2a": "పక్షపాతమా?",
    "t-2a2dcd9bf79e103b": "పరిమితులా?",
    "t-846379d26f796bea": "తదుపరి ప్రశ్న",
    "t-609e2e88d472e380": "గణిత పరిశోధనలు: ప్రశ్నల నుంచి పరీక్షకు",
    "t-6e8dcc5bb6c222dc": "గణిత పరిశోధన ప్రాజెక్టులు",
    "t-bcd76720d5fc0b4a": "ప్రశ్న → ఊహ → పరీక్ష → సవరణ",
    "t-4be5b3913616e297": "పరిశోధన నైతికత: ఆధారాలు, మూలాలను నమోదు చేయడం",
    "t-6dac70bd5fe62564": "వాదన → ఆధారం → మూలం; కల్పిత దత్తాంశం వద్దు",
    "t-4cce2bfc9eb399b1": "వాదన",
    "t-c0f115f0523fb9b0": "ఆధారం",
    "t-56ccd012fa61dd4b": "మూలం",
    "t-2c12824b5f626268": "తనిఖీ",
    "t-8e904b7f430790f5": "సాహిత్య సమీక్ష: మూలాలను పోల్చడం",
    "t-78d6645e19e99dc4": "మూలం A + మూలం B → పోల్చు → ఉదహరించు",
    "t-86dcb205727a60ac": "మూలం A",
    "t-a466b2240ea9c55d": "మూలం B",
    "t-0aa8d2ac9ed26641": "ఉదహరించు",
    "t-ece52cf4c64a4b17": "కేస్ అధ్యయనాలు: పోలికలు, తేడాలు",
    "t-0210fa4b1110f063": "కేస్ A ↔ కేస్ B → నమూనా, పరిమితులు",
    "t-c28c2ef3268806d4": "కేస్ A",
    "t-fef65ec063450d3f": "కేస్ B",
    "t-d2faa2b29806a1d4": "పోలికలు",
    "t-e836108ef2b04d5e": "పరిమితులు",
    "t-c8e5c4e53553ae87": "గణిత ప్రయోగాలు: విరుద్ధ ఉదాహరణలను వెతకడం",
    "t-e27c9e700d7074ba": "అన్ని nకు ప్రధాన సంఖ్యా? n²+n+41; n=41 వద్ద సంయుక్త సంఖ్య",
    "t-06648c925ad07285": "అభివృద్ధి పరిశోధన: నిర్మించు, పరీక్షించు, మెరుగుపరచు",
    "t-2d92e00cd03cb8a4": "రూపకల్పన → నిర్మాణం → పరీక్ష → సవరణ",
    "t-195059f59e3a4fec": "రూపకల్పన చేయి",
    "t-3053677e4333a96b": "నిర్మించు",
    "t-3c31a2afef50d6d2": "పరిశోధించగల ప్రశ్నను రాయడం",
    "t-63c609f8c08f3e75": "విస్తృత అంశం → కొలవగల ప్రశ్న → ప్రణాళిక",
    "t-5341c7228b2734e8": "అంశం",
    "t-b0a93231fd989c28": "కొలవగలమా?",
    "t-0ff15403106fefda": "ప్రణాళిక",
    "t-5709b3e329a5ab90": "పరిశోధన విధానాలు, నమోదులు",
    "t-57f06c9cb27bb317": "పద్ధతి → పరిశీలన → నమోదు → తనిఖీ",
    "t-05a024367d526a72": "పద్ధతి",
    "t-1092e2e43a486c0a": "నమోదు",
    "t-ae836c51c1010ef5": "పునరుత్పత్తి చేయి",
    "t-280c8d7a1056bcb7": "రేఖాచిత్రాలు, ఆధారాలతో ఫలితాలను సమర్పించడం",
    "t-210bb708b7b1b563": "ఫలితం + ఆధారం + పరిమితులు → సమర్పణ",
    "t-83aaae26be52087d": "సమర్పించు",
    "t-4a1893490d323e22": "సమీక్షించి తదుపరి ప్రశ్న అడగడం",
    "t-23414622690ace14": "ఏది పనిచేసింది? ఏది విఫలమైంది? తరువాత ఏమిటి?",
    "t-e8d4b0098f31387f": "మోవా గణితం",
    "t-5b14e707f1c272e5": "కదలిక ద్వారా గణిత సూత్రాలను కనుగొనండి.",
    "t-19ff90338754af5d": "మోవాతో పరిమాణాలు, ఆకారాలు, రేఖాచిత్రాల నమూనాలను గమనించండి.",
    "t-be562142ef48d573": "వీడియోలు",
    "t-cb70eedc157ecd6b": "పాఠ్య ప్రణాళిక సూచనలు",
    "t-0980e08665d206d8": "ఉపాధ్యాయ సమీక్ష, మొత్తం 47 భాషల స్థానికీకరణ ఇంకా పూర్తికాలేదు.",
    "t-58e1ec855992d90b": "భావనలు లేదా పాఠ్య ప్రణాళిక సంకేతాలను వెతకండి",
    "t-1543e29ed6c84ba7": "అన్ని తరగతి స్థాయిలు, ఐచ్ఛిక పాఠ్యాంశాలు",
    "t-4c1083714a7fbe9a": "అన్ని పాఠ్య ప్రణాళిక కోర్సులు",
    "t-e5cbfdf1bdd38e92": "మునుపటి 12 వీడియోలు",
    "t-60dc1352b9389b7b": "తదుపరి 12 వీడియోలు",
    "t-6bf16321929884e2": "మళ్లీ ఆడించు",
    "t-086b74c4b4d5b44e": "ప్లేబ్యాక్ వేగం",
    "t-bf5501459d624bba": "వీడియోను భద్రపరచు",
    "t-2b8cf321cd01ca1b": "తదుపరి భావన",
    "t-9e4c4841263012a7": "ప్రస్తుత జాబితాలో ఇది చివరి భావన.",
    "t-5520161ffd45530d": "నిశ్చల చిత్రాలను దశలవారీగా చూడండి",
    "t-6b45ccaaef512736": "పాఠ్య ప్రణాళిక అనుసంధానాలకు స్వతంత్ర సమీక్ష జరగలేదు. ఒక వీడియో మాత్రమే పూర్తి ప్రమాణాన్ని బోధించదు.",
    "t-238388a218fae37c": "ఈ వడపోతలకు సరిపడే వీడియోలు లేవు.",
    "t-ca70d8781e5cc2d0": "నేర్చుకునే భాష",
    "t-9e63c0c1ad564acb": "వీడియోలోని గణిత సమాసం",
    "t-a82b1e0fa53dc039": "{total} వీడియోల్లో {start}–{end}",
    "t-2a764202c2446988": "తరగతి స్థాయిలు సేవ సూచించిన స్థానాలు. అధికారిక కోర్సులను ఎప్పుడు బోధించాలో పాఠశాలలు నిర్ణయిస్తాయి.",
    "t-340a677b77651ebb": "{seconds} సెకన్ల వద్ద నిశ్చల చిత్రం",
    "t-fce6baf55bd03401": "శబ్దం లేదు · స్వయంచాలక ప్లేబ్యాక్ లేదు · నెమ్మది ప్లేబ్యాక్, నిశ్చల చిత్రాలు అందుబాటులో ఉన్నాయి. వీడియో చూడటం సమస్యను పూర్తిచేసినట్లు కాదు.",
    "t-c9be69be196428a4": "అనువాదం సిద్ధమవుతోంది",
    "t-5725c79c430fcb5e": "ప్రాథమిక స్థాయి 1",
    "t-2a6fa34be927635c": "ప్రాథమిక స్థాయి 2",
    "t-6dfd5ad830737324": "ప్రాథమిక స్థాయి 3",
    "t-0963340b3fed6df9": "ప్రాథమిక స్థాయి 4",
    "t-9b211623026d17e7": "ప్రాథమిక స్థాయి 5",
    "t-63899911dcd1aaf7": "ప్రాథమిక స్థాయి 6",
    "t-763c090b220656fe": "మధ్య స్థాయి 1",
    "t-5de551342bfa2576": "మధ్య స్థాయి 2",
    "t-0e6b60ab5b32d425": "మధ్య స్థాయి 3",
    "t-d1292da55f01a6ba": "ఉన్నత స్థాయి 1",
    "t-ace3fedb75b2b630": "ఉన్నత పాఠశాల గణితం",
    "t-e123a39df655dfed": "ఉన్నత పాఠశాల: ఉన్నత గణితం",
    "t-aebb4b50834a12bb": "ఐచ్ఛిక కోర్సులు",
    "t-df23bee498e0c0e5": "సంఖ్యలు, గణిత క్రియలు",
    "t-94b48731c69a8861": "నమూనాలు, సంబంధాలు",
    "t-e441ffe0a4c960dd": "జ్యామితి, కొలత",
    "t-340eee070a3353ed": "దత్తాంశం, అవకాశం",
    "t-ee0f849c788b9bd7": "సామాన్య గణితం",
    "t-2143923eb40ecbf0": "ప్రాథమిక గణితం"
  }
}
