{"locale":"ta","status":"ai-translated-unreviewed","sourceCatalogSHA256":"068ebb2a7378d1953a57038344d31624bc2c362e89d5625d3a5cc5066992e07f","values":{"t-88f51c35f6abbb04":"0 உட்பட ஒவ்வொன்றாக எண்ணுதல்","t-40e15999ca86e3ed":"பொருள்களின் எண்ணிக்கைக்கும் அவற்றின் நகர்வுக்கும் உள்ள தொடர்பைக் கவனியுங்கள்.","t-5c67e8578836de39":"கணிதம்","t-c483d2e83e3c6c2c":"பத்துப் பத்தாக 100 வரை எண்ணுதல்","t-61268a8bf69a94bc":"இடமதிப்பைப் பயன்படுத்தி அதே அளவை மறுகுழுவாக்குங்கள்.","t-624e73f3c497b542":"ஒன்றுகள், பத்துகள், நூறுகள் மற்றும் ஆயிரங்கள்","t-59232a8ca029c131":"எண்களை வரிசைப்படுத்துதலும் ஒப்பிடுதலும்","t-cb6732cf0398f974":"எண் கோட்டில் இடம், திசை, எல்லைகள் ஆகியவற்றின் பொருளை ஒப்பிடுங்கள்.","t-57b6f15b4f43ed7f":"எண்களைப் பிரித்தலும் இணைத்தலும்","t-ae00c7f024c62e4f":"கூட்டல் மூலம் இணைத்தல்","t-d18b279af014d3d1":"கழித்தல் மூலம் நீக்குதல்","t-5468d87b3794655b":"ஒன்றுகளை ஒரு பத்தாக மறுகுழுவாக்குதல்","t-57b582cd1268322a":"10 ஒன்றுகள் = 1 பத்து","t-aac93eddd44d5ea3":"ஒரு பத்தை ஒன்றுகளாக மாற்றுதல்","t-82c4b038b33ae549":"கூட்டலும் கழித்தலும் எதிர்ச் செயல்கள்","t-4a5c8fe6c8c0b348":"மூன்று எண்களைத் திறம்படக் கூட்டுதல்","t-1ccfa54b58a811f5":"விடுபட்ட எண்ணைக் கண்டறிதல்","t-675768cf83cb5ebd":"இரு பக்கங்களிலும் ஒரே மாற்றம் செய்தால் சமத்துவம் நிலைத்திருக்கும்.","t-62fe583b2d62d91b":"இரு பக்கங்களிலும் −3","t-66fb47410686e310":"இரு பக்கங்களிலும் ஒரே செயல்","t-2d8039569ad289c5":"சமக் குழுக்களாகப் பெருக்கல்","t-d3a951a2c0be8ad7":"பொருள்களைக் குழுவாக்குங்கள் அல்லது பகிருங்கள்; ஒவ்வொரு குழுவையும் மொத்தத்துடன் ஒப்பிடுங்கள்.","t-f08906cfdce533ae":"செவ்வக அமைப்புகளும் பெருக்கல் வாய்பாடுகளும்","t-3972bc6e3ec0f774":"மீண்டும் வரும் கோலங்கள்","t-963fda52101495b1":"மீண்டும் வருவது அல்லது மாறாத அளவால் மாறுவது எது எனக் கண்டறியுங்கள்.","t-ce56f93e6b33bc9f":"ஒரு விதியைத் தேர்ந்தெடுத்து கோலத்தைத் தொடருங்கள்","t-a770806f03465613":"கனச்செவ்வகங்கள், உருளைகள் மற்றும் கோளங்கள்","t-cb742755d61dd692":"திண்ம வடிவங்களில் முகங்கள், விளிம்புகள், குறுக்குவெட்டுகள் மற்றும் கனஅளவைக் கவனியுங்கள்.","t-aedcca2a7e6244ad":"6 முகங்கள